{
  "en": {
    "description": {
      "mlbb_valir": {
        "name": "Valir",
        "attack": "Throws an ember that deals <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Direct spell hits apply Ablaze for <#ffb900ff>3s<>. The burn deals <#5ad0e6ff>0.8% max HP<> magic damage per second. At <#ffb900ff>3 stacks<>, it detonates for <#5ad0e6ff>4% max HP + 25% Magic Power<> magic damage and <#ef5350ff>stuns for 0.65s<>. Stun cooldown per target is <#ffb900ff>8s<>. Monster damage is capped. Bosses are immune to the stun.",
        "skill": "Fires a bolt that deals <#5ad0e6ff>70 + 65% Magic Power<> magic damage and <#ef5350ff>slows by 25% for 0.7s<>. The impact area bursts after <#ffb900ff>0.75s<> for <#5ad0e6ff>42 + 30% Magic Power<> magic damage. Stores <#ffb900ff>2 charges<> and restores one every <#ffb900ff>9s<>. A direct hit on a champion or boss refunds a charge up to once every <#ffb900ff>3.6s<>. Hitting a lane minion takes <#ffb900ff>2s<> off the recharge. Minimum recast is <#ffb900ff>1.8s<>.",
        "skill2": "Sends a wave that deals <#5ad0e6ff>95 + 65% Magic Power<> magic damage and <#ef5350ff>knocks back enemy champions, lane minions and regular jungle monsters<>. While empowered, it leaves a firewall for <#ffb900ff>3s<> that deals <#5ad0e6ff>27 + 22% Magic Power<> magic damage each second and briefly <#ef5350ff>slows by 20%<>. Cooldown is <#ffb900ff>10s<>.",
        "ult": "Can activate automatically when ready to <#ef5350ff>break a stun or other supported disable<>. Suppression still applies. Grants <#ffb900ff>30% Movement Speed<>, tapering over <#ffb900ff>3s<>. Empowers the next <#ffb900ff>4 casts<> within <#ffb900ff>9s<>. Fireball gains <#ffb900ff>30% projectile reach<> and Torrent leaves a firewall. Cooldown is <#ffb900ff>42s<>."
      },
      "mlbb_lesley": {
        "name": "Lesley",
        "attack": "Fires a rifle shot for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "<#5ad0e6ff>Lethal Shot<>. Casting a skill or going 5s without taking damage readies the next basic. It gains <#ffb900ff>17 range<> and deals <#ff9028ff>75 + 110% Attack<> true damage to champions or <#ff9028ff>75 + 125% Attack<> physical damage to lane and jungle enemies. Structures take normal basic damage.",
        "skill": "<#5ad0e6ff>Master of Camouflage<>. Camouflages for up to <#ffb900ff>2.5s<> and gains 30% Movement Speed. Enemies lose direct targeting, but area effects can still hit her. Attacking, casting another skill, or taking damage after the first 0.5s ends camouflage.",
        "skill2": "<#5ad0e6ff>Tactical Grenade<>. Deals <#ff9028ff>115 + 65% Attack<> physical damage in a short cone and pushes surviving enemy champions away. Lesley hops backward if the path is clear. During Ultimate Snipe, she fires an available round before ending the volley.",
        "ult": "<#e64a6aff>Ultimate Snipe<>. Locks onto an enemy champion and fires up to <#ffb900ff>four rounds<>. Each deals <#ff9028ff>70 + 32% Attack + 6% of the target’s missing HP<> as physical damage. Another enemy champion in the firing line can intercept a round."
      },
      "mlbb_aldous": {
        "name": "Aldous",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "skill": "<#5ad0e6ff>Contract: Soul Steal<>: Deals <#ffb900ff>40<> base physical damage, increasing with level, plus <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> and <#ffb900ff>2.5<> damage per Soul Steal stack. Nearby enemies take <#ffb900ff>40%<> of this damage.",
        "skill2": "<#5ad0e6ff>Contract: Explosion<>: Gains a <#ffb900ff>90<> shield and <#ffb900ff>25%<> Movement Speed for <#ffb900ff>2<>s, then detonates the barrier to deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70 + 100% AD<> physical damage and stun nearby enemies for <#ffb900ff>1<>s.",
        "ult": "<#e64a6aff>Contract: Chase Fate<>: Flies to an enemy hero and crashes into them, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>130 + 160% AD<> physical damage and stunning for <#ffb900ff>1.2<>s.",
        "passive": "<#5ad0e6ff>Contract: Transform<>: Gains <#ffb900ff>1<> Soul Steal stack every <#ffb900ff>5<>s, <#ffb900ff>10<> on a kill, and more when Contract: Soul Steal hits, up to <#ffb900ff>1,000<>. Every third basic attack grants a shield equal to <#ffb900ff>35<> + <#ffb900ff>5<> × level + <#ffb900ff>0.45<> × stacks for <#ffb900ff>2<>s. Shield cooldown: <#ffb900ff>5<>s. Stacks also increase Contract: Soul Steal’s damage."
      },
      "mlbb_fanny": {
        "name": "Fanny",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "skill": "<#5ad0e6ff>Tornado Strike<>: Spins to deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35 + 80% AD<> physical damage around her. Colliding with an enemy during Steel Cable triggers a mid-air strike for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 70% AD<> physical damage and marks enemy heroes.",
        "skill2": "<#5ad0e6ff>Steel Cable<>: Fires a cable at a wall or lane boundary and swings toward her target. Can chain wall swings without an energy cost. Prioritizes visible enemy heroes, then nearby jungle monsters.",
        "ult": "<#e64a6aff>Cut Throat<>: Dashes to an enemy and deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100 + 125% AD<> physical damage. Each Prey Mark adds <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35% AD<> damage, up to <#ffb900ff>2<> marks. Consumes the marks on hit.",
        "passive": "<#5ad0e6ff>Air Superiority<>: Gains <#ffb900ff>10–25%<> bonus damage while flying, based on flight speed. Hitting an enemy hero in flight triggers Tornado Strike and applies a Prey Mark for <#ffb900ff>5<>s, stacking up to <#ffb900ff>2<> times."
      },
      "mlbb_lancelot": {
        "name": "Lancelot",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "skill": "<#5ad0e6ff>Puncture<>: Dashes to an enemy, dealing <#ffb900ff>80–178<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40% AD<> physical damage. Marks the first unmarked enemy hit and resets this skill’s cooldown. Each cast grants a Soul Cutter stack.",
        "skill2": "<#5ad0e6ff>Thorned Rose<>: Strikes in three waves, each dealing <#ffb900ff>85–155<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30% AD<> physical damage and slowing by <#ffb900ff>20%<> for <#ffb900ff>0.5<>s. Damage falls to <#ffb900ff>30%<> when multiple enemies are in the strike area. Lancelot is immune to damage and crowd control during the sequence.",
        "ult": "<#e64a6aff>Phantom Execution<>: Dashes to an enemy hero, dealing <#ffb900ff>100–156<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on arrival and gaining a Soul Cutter stack. Lancelot is immune to damage and crowd control during the dash.",
        "passive": "<#5ad0e6ff>Soul Cutter<>: Puncture and Phantom Execution grant <#ffb900ff>7.5%<> bonus damage for <#ffb900ff>4<>s, stacking up to <#ffb900ff>4<> times for a <#ffb900ff>30%<> bonus."
      },
      "mlbb_estes": {
        "name": "Estes",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Scripture of the Moon Elf<>: Gains <#ffb900ff>1<> charge per second, or <#ffb900ff>2<> while linked by Moonlight Immersion. At <#ffb900ff>100<> charges, his next basic attack gains magic damage, bounces to up to <#ffb900ff>2<> nearby enemies and slows by <#ffb900ff>40%<> for <#ffb900ff>1.5<>s. Charges are shown on Skill <#ffb900ff>1<>.",
        "skill": "<#5ad0e6ff>Moonlight Immersion<>: Heals an allied hero for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>115 + 85% AP<>, then <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>24 + 18% AP<> every <#ffb900ff>0.5<>s for <#ffb900ff>5<>s. Grants the ally <#ffb900ff>7<> Armor and Magic Resist, and Estes <#ffb900ff>15%<> Movement Speed. Moving too far apart breaks the tether and its charge bonus; the healing continues.",
        "skill2": "<#5ad0e6ff>Domain of Moon Goddess<>: Creates a moonlight zone for <#ffb900ff>2.5<>s. Every <#ffb900ff>0.5<>s, enemies inside take <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>15 + 45% AP<> magic damage and are slowed by <#ffb900ff>35%<> for <#ffb900ff>0.75<>s.",
        "ult": "<#e64a6aff>Blessing of Moon Goddess<>: Heals nearby allies for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>150 + 65% AP<>, then <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>20 + 12% AP<> every <#ffb900ff>0.5<>s for <#ffb900ff>8<>s. Grants them <#ffb900ff>8<> Armor and Magic Resist."
      },
      "mlbb_gusion": {
        "name": "Gusion",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Dagger Specialist<>: Each skill cast grants a Rune, up to <#ffb900ff>4<>. The next basic attack consumes all Runes. Each adds magic damage equal to <#ffb900ff>3%<> of the target’s maximum HP and heals Gusion for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>50 + 25% AP<>.",
        "skill": "<#5ad0e6ff>Sword Spike<>: Throws a dagger at the first enemy hit, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>200 + 50% AP<> magic damage and marking them for <#ffb900ff>5<>s. Recast to dash behind the target and deal <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>200 + 100% AP<> magic damage.",
        "skill2": "<#5ad0e6ff>Shadowblade Slaughter<>: Throws <#ffb900ff>5<> daggers in a fan, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65 + 40% AP<> magic damage. Recast to recall them. After Incandescence resets this skill, he can throw a second set before recalling both sets.",
        "ult": "<#e64a6aff>Incandescence<>: Dashes behind an enemy and resets Skills <#ffb900ff>1<> and <#ffb900ff>2<>. If daggers are already out, Skill <#ffb900ff>2<> can throw a second set before recalling both. Recast within <#ffb900ff>2.5<>s to dash again."
      },
      "mlbb_karrie": {
        "name": "Karrie",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Lightwheel Mark<>: Basic attacks and Skills <#ffb900ff>1<> and <#ffb900ff>2<> apply a Lightwheel Mark. At <#ffb900ff>5<> marks, they burst for <#ffb900ff>4%<> of the target’s maximum HP + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% AD<> as true damage. Damage is capped at <#ffb900ff>250<> against heroes and <#ffb900ff>300<> against jungle and epic monsters.",
        "skill": "<#5ad0e6ff>Spinning Lightwheel<>: Throws a lightwheel that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60 + 80% AD<> physical damage to its target and <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>20 + 35% AD<> to nearby enemies except towers, slowing by <#ffb900ff>35%<> for <#ffb900ff>1<>s. Leaves a slowing zone for <#ffb900ff>1.5<>s, with two pulses of <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10 + 10% AD<> physical damage, <#ffb900ff>0.5<>s apart. The pulses do not apply Lightwheel Marks.",
        "skill2": "<#5ad0e6ff>Phantom Step<>: Dashes toward the chosen position and fires at an enemy near the landing point, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75 + 70% AD<> physical damage and applying a Lightwheel Mark. The Attack ratio increases to <#ffb900ff>100%<> during Speedy Lightwheel.",
        "ult": "<#e64a6aff>Speedy Lightwheel<>: Gains <#ffb900ff>20%<> Movement Speed and <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35% AD<> Speed for <#ffb900ff>6<>s. During this time, Phantom Step deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75 + 100% AD<> physical damage."
      },
      "mlbb_uranus": {
        "name": "Uranus",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. Does not apply Ionic Marks.",
        "passive": "<#5ad0e6ff>Radiance<>: Taking damage grants a Radiance stack for <#ffb900ff>10<>s, up to <#ffb900ff>12<>. Gains one stack per second. At <#ffb900ff>12<> stacks, restores <#ffb900ff>28–134<> HP every <#ffb900ff>0.8<>s, based on level.",
        "skill": "<#5ad0e6ff>Ionic Edge<>: Sends two blades outward and back. Each hits a target once for <#ffb900ff>79–131<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>18% AP<> magic damage and slows by <#ffb900ff>30%<> for <#ffb900ff>2<>s. Each cast applies one Ionic Mark per target for <#ffb900ff>6<>s. Marks increase later Ionic Edge damage by <#ffb900ff>20%<> each, up to <#ffb900ff>8<> marks. Buildings cannot be marked.",
        "skill2": "<#5ad0e6ff>Transcendent Ward<>: Dashes to the chosen position, dealing <#ffb900ff>48–120<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12% AP<> magic damage along the path and <#ffb900ff>96–240<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>48% AP<> near the endpoint, slowing nearby enemies by <#ffb900ff>25%<>. Gains a <#ffb900ff>300–750<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>200% AP<> shield for <#ffb900ff>4<>s. When it breaks or expires, it bursts for <#ffb900ff>156–390<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>78% AP<> magic damage.",
        "ult": "<#e64a6aff>Consecration<>: Removes all crowd control, restores <#ffb900ff>200–400<> HP and grants <#ffb900ff>60%<> Movement Speed, fading over <#ffb900ff>8<>s. Adds <#ffb900ff>5–12<> Radiance stacks. For <#ffb900ff>8<>s, increases HP regeneration and his own Transcendent Ward shield by <#ffb900ff>20%<>."
      },
      "mlbb_chou": {
        "name": "Chou",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Only Fast<>: Moving charges his next basic attack. When ready, it deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>180% AD<> physical damage, slows by <#ffb900ff>80%<> for <#ffb900ff>1<>s and reduces the target’s Armor by <#ffb900ff>10<> for <#ffb900ff>2<>s, stacking up to <#ffb900ff>2<> times.",
        "skill": "<#5ad0e6ff>Jeet Kune Do<>: Performs a three-part combo, each hit dealing <#ffb900ff>100–165<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45% AD<> physical damage. The first two casts refresh the skill; the third knocks enemies airborne and starts its cooldown. Hitting an enemy champion with the third cast resets Shunpo.",
        "skill2": "<#5ad0e6ff>Shunpo<>: Dashes in the chosen direction with crowd-control immunity. Gains a <#ffb900ff>200–300<> + <#ffb900ff>100%<> bonus Attack shield and <#ffb900ff>15<> Physical Penetration for <#ffb900ff>2.5<>s on arrival.",
        "ult": "<#e64a6aff>The Way of Dragon<>: Kicks an enemy hero away, dealing <#ffb900ff>275–420<> + <#ffb900ff>110%<> bonus Attack physical damage. If the same target stays in reach, Chou follows and strikes four times on arrival for a total of <#ffb900ff>330–500<> + <#ffb900ff>132%<> bonus Attack physical damage."
      },
      "mlbb_zhask": {
        "name": "Zhask",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Decimation<>: On death, summons a frenzied Spawn at his last position. It lasts up to <#ffb900ff>6<>s and loses <#ffb900ff>2%<> of its maximum HP each second.",
        "skill": "<#5ad0e6ff>Nightmaric Spawn<>: Summons a stationary Spawn for up to <#ffb900ff>12<>s, inheriting <#ffb900ff>55–100%<> of his HP, defenses and Magic Power, based on level. Its Death Ray deals <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 25% AP<> magic damage every <#ffb900ff>0.25<>s and slows by <#ffb900ff>30%<> for <#ffb900ff>0.6<>s. Aim again to reposition it. The ray pauses if Zhask moves too far away.",
        "skill2": "<#5ad0e6ff>Mind Eater<>: Fires a piercing projectile, dealing <#ffb900ff>87<> + <#ffb900ff>6<> × levels above <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>1 + 60% AP<> magic damage and stunning for <#ffb900ff>0.5<>s. His Spawn follows up on each enemy hit for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>35 + 50% AP<> bonus magic damage.",
        "ult": "<#e64a6aff>Dominator's Descent<>: Dominator’s Descent: Teleports to the chosen position and merges with an empowered Spawn for up to <#ffb900ff>10<>s. Zhask becomes untargetable and cannot act separately while merged. The Spawn inherits all his stats, and its Death Ray deals <#ffb900ff>1.8<> times its normal damage."
      },
      "mlbb_hanabi": {
        "name": "Hanabi",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Ninjutsu: Petal Barrage<>: Basic attacks and skill hits release Petal Blades that bounce between nearby enemies. While shielded, Hanabi is immune to crowd control. Gaining a shield does not remove control already affecting her.",
        "skill": "<#5ad0e6ff>Ninjutsu: Equinox<>: Gains a <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>120 + 35% AD<> shield for <#ffb900ff>5<>s, plus <#ffb900ff>12%<> Movement Speed and <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>20% AD<> Speed. While this shield lasts, <#ffb900ff>20%<> of damage dealt to heroes and <#ffb900ff>10%<> against other enemies becomes additional shielding. Damage stops adding shields once her total shielding reaches <#ffb900ff>50%<> maximum HP.",
        "skill2": "<#5ad0e6ff>Ninjutsu: Soul Scroll<>: Throws a piercing scroll, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>65 + 75% AD<> physical damage and slowing by <#ffb900ff>30%<> for <#ffb900ff>1<>s. Marks enemies for <#ffb900ff>5<>s. Her next basic-attack Petal bounce on a marked enemy deals an extra <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>20 + 50% AD<> damage without bounce reduction, consuming the mark.",
        "ult": "<#e64a6aff>Forbidden Jutsu: Higanbana<>: Throws Higanbana at the first enemy hero hit, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150 + 80% AD<> physical damage and rooting for <#ffb900ff>0.8<>s. It then blooms, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>105 + 55% AD<> physical damage nearby. Other enemies hit are slowed by <#ffb900ff>20%<> for <#ffb900ff>0.6<>s."
      },
      "mlbb_balmond": {
        "name": "Balmond",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Bloodthirst<>: Restores <#ffb900ff>5%<> maximum HP after killing a minion or jungle monster, and <#ffb900ff>10%<> after a hero kill or assist.",
        "skill": "<#5ad0e6ff>Soul Lock<>: Charges toward the chosen position, dealing <#ffb900ff>150–275<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60% AD<> physical damage along the path. Hits an enemy hero near the endpoint, briefly knocking them back and slowing by <#ffb900ff>40%<> for <#ffb900ff>3<>s.",
        "skill2": "<#5ad0e6ff>Cyclone Sweep<>: Spins for <#ffb900ff>3<>s, dealing <#ffb900ff>14<> hits of <#ffb900ff>24–44<> + <#ffb900ff>1.3%<> maximum HP + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25% AD<> physical damage. Each hit reduces the target’s Armor by <#ffb900ff>5%<>, stacking up to <#ffb900ff>8<> times. Gains <#ffb900ff>15%<> Movement Speed while spinning.",
        "ult": "<#e64a6aff>Lethal Counter<>: Strikes a wide area in front of him for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>150 + 70% AD<> + <#ffb900ff>30–45%<> of each target’s missing HP as true damage. Damage against non-heroes is capped at <#ffb900ff>1,000<> / <#ffb900ff>1,500<> / <#ffb900ff>2,000<>, based on level."
      },
      "mlbb_alpha": {
        "name": "Alpha",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Beta, Advance!<> Every third eligible hit on an enemy champion calls Beta’s laser for 30 + 3 per level after level 1 + 15% Attack as physical damage and slows by 30% for 1s.",
        "skill": "<#5ad0e6ff>Rotary Impact<> Sends a wave for 70 + 80% Attack physical damage and a 40% slow for 1s. Beta follows for 25 + 1 per level after level 1 + 20% Attack true damage.",
        "skill2": "<#5ad0e6ff>Force Swing<> Sweeps forward for 100 + 80% Attack physical damage. Beta follows for 25 + 1 per level after level 1 + 20% Attack true damage. Alpha heals for 100 + 20% Attack once per cast.",
        "ult": "<#e64a6aff>Spear of Alpha<> Beta’s dive deals 70 + 20% Attack physical damage and stuns for 1s. Alpha’s landing deals 130 + 80% Attack physical damage, knocks enemies airborne for 0.67s, and slows by 30% for 1.25s. Beta fires five physical hits of 8 + 10% Attack."
      },
      "mlbb_arlott": {
        "name": "Arlott",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Demon Gaze<>: Marks the nearest enemy hero every <#ffb900ff>7<>s. His crowd-control effects also apply a mark. Marks last <#ffb900ff>7<>s and empower Vengeance.",
        "skill": "<#5ad0e6ff>Dauntless Strike<>: Slams his lance in a line, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110 + 55% AD<> physical damage and applying Demon Gaze. Stuns for <#ffb900ff>0.5<>s nearby, increasing to <#ffb900ff>1<>s at the far edge.",
        "skill2": "<#5ad0e6ff>Vengeance<>: Dashes to an enemy with interruption immunity, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100 + 55% AD<> physical damage. Against a marked target, deals double damage, resets its cooldown and restores <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30% AD<> HP, halved against non-heroes. Also marks the target.",
        "ult": "<#e64a6aff>Final Slash<>: Sweeps his lances across a wide area, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160 + 75% AD<> physical damage and dragging enemies to his right. Applies Demon Gaze to displaced enemies."
      },
      "mlbb_franco": {
        "name": "Franco",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "skill": "<#5ad0e6ff>Iron Hook<>: Throws a hook at the first enemy hit, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>190 + 100% AD<> physical damage and pulling them toward Franco. Stuns before pulling. Enemies that cannot be pulled can still be stunned.",
        "skill2": "<#5ad0e6ff>Fury Shock<>: Deals <#ffb900ff>160<> + <#ffb900ff>4%<> maximum HP physical damage to nearby enemies and slows by <#ffb900ff>70%<> for <#ffb900ff>1.5<>s. Can target jungle monsters and objectives.",
        "ult": "<#e64a6aff>Bloody Hunt<>: Suppresses an enemy hero for <#ffb900ff>1.8<>s and strikes <#ffb900ff>6<> times, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50 + 70% AD<> physical damage. Ends early if Franco is crowd controlled.",
        "passive": "<#5ad0e6ff>Wasteland Force<>: After <#ffb900ff>5<>s without taking damage, gains <#ffb900ff>10%<> Movement Speed, restores <#ffb900ff>1%<> maximum HP per second and builds up to <#ffb900ff>10<> stacks. His next skill consumes them for up to <#ffb900ff>150%<> bonus skill damage."
      },
      "mlbb_obsidia": {
        "name": "Obsidia",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 65% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Return to Bone<>: Gains Bone Energy when dealing damage: <#ffb900ff>2<> per basic attack on a hero, <#ffb900ff>4<> per skill hit, or <#ffb900ff>1<> per hit on a minion or turret. Jungle monsters grant none. Every <#ffb900ff>30<> Energy creates a Bone Shard, up to <#ffb900ff>25<>. Each adds <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>7% AD<> to her basic attacks. Hero kills grant a shard immediately.",
        "skill": "<#5ad0e6ff>Abyssal Bone Needle<>: Fires a bone needle in a line, dealing <#ffb900ff>90–140<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60% AD<> physical damage. The first enemy hero hit grants Bone Energy.",
        "skill2": "<#5ad0e6ff>Phantom Shadowmeld<>: Dashes in the chosen direction and gains <#ffb900ff>20%<> Movement Speed for <#ffb900ff>0.3<>s.",
        "ult": "<#e64a6aff>Hunt of Bone<>: Fires a bone shot for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>55 + 50% AD<> physical damage, briefly stunning the first enemy hero hit and pulling Obsidia toward them. Tethers her to the target for <#ffb900ff>3<>s: they cannot dash, and their movement pulls her along. Grants a shield, <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>30% AD<> Speed and <#ffb900ff>5<> temporary Bone Shards beyond the cap. She can cross obstacles and attack while moving; Phantom Shadowmeld lasts <#ffb900ff>1<>s."
      },
      "mlbb_gord": {
        "name": "Gord",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Mystic Favor<>: After <#ffb900ff>3<> skill hits on an enemy, the next skill hit deals <#ffb900ff>12<> + <#ffb900ff>2<> × level + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>8% AP<> bonus true damage and slows by <#ffb900ff>20%<> for <#ffb900ff>1<>s. The slow stacks twice, up to <#ffb900ff>40%<>.",
        "skill": "<#5ad0e6ff>Mystic Projectile<>: Fires an energy orb that bursts on the first enemy hit, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>105 + 52% AP<> magic damage and stunning for <#ffb900ff>1<>s.",
        "skill2": "<#5ad0e6ff>Mystic Injunction<>: Creates an energy field for <#ffb900ff>4<>s, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>6 + 12% AP<> magic damage every <#ffb900ff>0.25<>s, up to <#ffb900ff>16<> hits.",
        "ult": "<#e64a6aff>Mystic Gush<>: Channels an energy beam for <#ffb900ff>3.2<>s, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12 + 17% AP<> magic damage every <#ffb900ff>0.2<>s, up to <#ffb900ff>16<> hits. Each wave aims toward the nearest enemy hero ahead of Gord."
      },
      "mlbb_belerick": {
        "name": "Belerick",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. While empowered by Nature’s Strike, instead deals <#ffb900ff>60<> magic damage, restores <#ffb900ff>150<> + <#ffb900ff>12%<> missing HP and slows by <#ffb900ff>60%<> for <#ffb900ff>1.4<>s.",
        "passive": "<#5ad0e6ff>Deadly Thorns<>: Every fourth hit of at least <#ffb900ff>10<> damage fires a thorn at the nearest enemy, dealing <#ffb900ff>10<> + level + <#ffb900ff>1%<> maximum HP magic damage. Can trigger once every <#ffb900ff>1.2<>s. Tower attacks do not count.",
        "skill": "<#5ad0e6ff>Ancient Seed<>: Sends vines forward for <#ffb900ff>115<> magic damage and a <#ffb900ff>25%<> slow lasting <#ffb900ff>2<>s. After <#ffb900ff>1.1<>s, seeds burst along the same path for another <#ffb900ff>115<> magic damage and taunt for <#ffb900ff>1.2<>s.",
        "skill2": "<#5ad0e6ff>Nature's Strike<>: Gains <#ffb900ff>60%<> Movement Speed for <#ffb900ff>1<>s, then <#ffb900ff>20%<> for <#ffb900ff>1<>s, and empowers his next basic attack for <#ffb900ff>3<>s. Each Deadly Thorns activation reduces this skill’s cooldown by <#ffb900ff>1<>s.",
        "ult": "<#e64a6aff>Wrath of Dryad<>: Releases spreading vines in <#ffb900ff>4<> waves, each dealing <#ffb900ff>55<> magic damage and taunting enemies for <#ffb900ff>1.5<>s."
      },
      "mlbb_cecilion": {
        "name": "Cecilion",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Overflowing<>: Skill hits grant a permanent stack, up to once per second. Each grants <#ffb900ff>3<> Magic Power. Stacks remain after death.",
        "skill": "<#5ad0e6ff>Bat Impact<>: Sends a giant bat forward, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 25% AP<> magic damage along its path. It dives at its destination for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>55 + 50% AP<> magic damage nearby.",
        "skill2": "<#5ad0e6ff>Sanguine Claws<>: Marks a location. After <#ffb900ff>0.6<>s, blood claws close in, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>60 + 60% AP<> magic damage, stunning for <#ffb900ff>1<>s and pulling enemies to the center.",
        "ult": "<#e64a6aff>Bats Feast<>: Releases <#ffb900ff>40<> blood bolts over <#ffb900ff>3<>s, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>5 + 8% AP<> magic damage to a nearby enemy hero and restoring <#ffb900ff>8<> HP. Cecilion can move while channeling and gains <#ffb900ff>60%<> Movement Speed for <#ffb900ff>1.5<>s."
      },
      "mlbb_johnson": {
        "name": "Johnson",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "passive": "<#5ad0e6ff>Electro Airbag<>: Dropping below <#ffb900ff>30%<> HP grants a <#ffb900ff>120<> + <#ffb900ff>240%<> Armor shield for <#ffb900ff>10<>s. Cooldown: <#ffb900ff>100<>s.",
        "skill": "<#5ad0e6ff>Impact Wrench<>: Throws his wrench, dealing <#ffb900ff>80<> + <#ffb900ff>110%<> Armor magic damage along its path and stunning enemies near the landing point for <#ffb900ff>0.8<>s.",
        "skill2": "<#5ad0e6ff>Electromagnetic Waves<>: Raises his shield, dealing <#ffb900ff>40<> + <#ffb900ff>45%<> Armor magic damage in front of him and reducing enemy Movement Speed and Magic Resist, stacking up to <#ffb900ff>3<> times.",
        "ult": "<#e64a6aff>Full Throttle<>: Transforms into a car and picks up a nearby allied hero. Crashing into an enemy hero deals <#ffb900ff>90<> + <#ffb900ff>150–220%<> Armor magic damage, stuns for <#ffb900ff>0.5–1<>s based on driving time and leaves an electrified zone. Can also drive his passenger to safety."
      },
      "mlbb_angela": {
        "name": "Angela",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "skill": "<#5ad0e6ff>Love Waves<>: Sends a wave that deals <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>80 + 30% AP<> magic damage to enemies and heals allies for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>46 + 40% AP<>. Each enemy hit gains a Lover’s Mark for <#ffb900ff>3<>s, up to <#ffb900ff>5<> stacks. Each adds <#ffb900ff>12%<> damage to later waves and Puppet-on-a-String’s final hit, and a <#ffb900ff>6%<> slow. Holds <#ffb900ff>5<> charges; the last cast starts a <#ffb900ff>5<>s cooldown.",
        "skill2": "<#5ad0e6ff>Puppet-on-a-String<>: Links to an enemy for <#ffb900ff>3<>s, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>95 + 25% AP<> magic damage and gradually slowing by up to <#ffb900ff>45%<>. If the link holds, deals another <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>140 + 35% AP<> magic damage, increased by Lover’s Marks, and roots for <#ffb900ff>0.7<>s. Moving too far apart or dying breaks the link without a final hit.",
        "ult": "<#e64a6aff>Heartguard<>: Shields an allied hero anywhere on the map for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>220 + 180% AP<> for <#ffb900ff>6<>s. Angela attaches to them for <#ffb900ff>12<>s, disappears from the battlefield and automatically casts Love Waves and Puppet-on-a-String from their position. A doll marks her ally. Recasting, the ally’s death or untargetability ends the attachment. Cooldown: <#ffb900ff>40<>s.",
        "passive": "<#5ad0e6ff>Smart Heart<>: Casting a skill grants Movement Speed for <#ffb900ff>4<>s, stacking up to <#ffb900ff>4<> times for <#ffb900ff>7%<>, <#ffb900ff>15%<>, <#ffb900ff>22%<> or <#ffb900ff>30%<> total. While attached, her ally receives the bonus. Charges and cooldowns carry over when attaching or leaving."
      },
      "mlbb_eudora": {
        "name": "Eudora",
        "attack": "Basic attacks launch a lightning bolt that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "skill": "<#5ad0e6ff>Forked Lightning<>: Strikes non-champions in a fan for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100 + 55% AP<> magic damage, doubled against lane minions. Enemies already marked are linked for up to <#ffb900ff>1<>s, taking <#ffb900ff>4<> pulses of <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>4 + 2% AP<> and a final hit of <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100 + 55% AP<> if the link holds. Eudora gains <#ffb900ff>20%<> Movement Speed while linked. A final hit reduces this skill’s cooldown by <#ffb900ff>1.5<>s, once per cast. The link breaks beyond <#ffb900ff>95,000<> range. Cooldown: <#ffb900ff>7<>s. Enemy champions take <#a974ffff>120 + 65% AP<> magic damage from the first hit.",
        "skill2": "<#5ad0e6ff>Ball Lightning<>: Launches an orb that reduces the target’s Magic Resistance by <#ffb900ff>8<> for <#ffb900ff>1.8<>s, deals <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>115 + 45% AP<> magic damage and stuns for <#ffb900ff>0.8<>s. Against an enemy already marked, the same effects also hit nearby enemies. Each enemy is hit once. Cooldown: <#ffb900ff>11<>s.",
        "ult": "<#e64a6aff>Thunder’s Wrath<>: Strikes a ground area for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>260 + 110% AP<> magic damage at the center or <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 55% AP<> in the outer ring. Enemies already marked leave warnings at their hit locations. After <#ffb900ff>0.6<>s, those areas explode for <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>160 + 72% AP<> magic damage. Overlapping explosions from this cast hit each enemy once. Cooldown: <#ffb900ff>32<>s.",
        "passive": "<#5ad0e6ff>Superconductor<>: Skill hits mark enemy heroes and jungle monsters for <#ffb900ff>5<>s. Skills gain additional effects against enemies already marked. Basic attacks do not apply the mark; marks do not stack."
      },
      "mlbb_julian": {
        "name": "Julian",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. For <#ffb900ff>2<>s after casting a skill, basic attacks instead deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 55% AP<> magic damage and pull the target toward Julian. Every hit also heals Julian for a share of the damage dealt.",
        "skill": "<#5ad0e6ff>Scythe<>: Hurls a scythe in the target direction, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>155 + 72% AP<> magic damage to enemies along the way and slowing them by <#ffb900ff>30<>% for <#ffb900ff>1<>s. It pierces lane minions and stops at the first other enemy. Enhanced: deals <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>215 + 100% AP<> and slows by <#ffb900ff>50<>%. At the first non-minion enemy or maximum range the scythes keep flying at reduced speed, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26 + 11% AP<> magic damage every <#ffb900ff>0.1<>s in an area for <#ffb900ff>1.6<>s, hitting each enemy repeatedly.",
        "skill2": "<#5ad0e6ff>Sword<>: Summons a flying sword and dashes in the target direction, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 52% AP<> magic damage to enemies along the path. Enhanced: summons a storm of swords, dealing <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 14% AP<> magic damage every <#ffb900ff>0.1<>s along the dash, up to <#ffb900ff>6<> times. Julian is untargetable and invisible during the dash, then reappears at the farthest end.",
        "ult": "<#e64a6aff>Chain<>: Casts chains at the target location. After <#ffb900ff>0.3<>s they deal <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>112 + 50% AP<> magic damage in an <#ffb900ff>18,000<>-unit radius and immobilize enemies for <#ffb900ff>1<>s. Enhanced: deals <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12 + 6% AP<> every <#ffb900ff>0.2<>s and slows by <#ffb900ff>30<>%, then enemies still inside take <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>205 + 88% AP<> and are knocked airborne for <#ffb900ff>0.8<>s. Before Chain is unlocked, Julian casts it automatically during a combo.",
        "passive": "<#5ad0e6ff>Smith’s Legacy<>: After casting two different skills, Julian enhances the remaining skill. The enhanced cast puts all three skills on a shared <#ffb900ff>9<>–<#ffb900ff>6<>s cooldown that decreases with level. A skill can be used once per sequence; an unfinished sequence expires after <#ffb900ff>4<>s. Hitting an enemy hero with a skill grants <#ffb900ff>10<>% hybrid lifesteal for <#ffb900ff>5<>s, up to <#ffb900ff>30<>%. Repeated hits from one cast grant only one stack. Skills and basic attacks also heal Julian for <#ffb900ff>12<>% of the damage dealt, increased by <#ffb900ff>6<>% per stack, up to <#ffb900ff>30<>%."
      },
      "mlbb_popol_kupa": {
        "name": "Popol & Kupa",
        "attack": "Popol throws a spear that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact. Kupa bites nearby enemies for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45% AD<> physical damage, increased to <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75% AD<> in Alpha Wolf Form. Kupa’s ordinary bites use Popol’s basic-attack item effects.",
        "skill": "<#5ad0e6ff>Bite ’em, Kupa!<>: Popol throws a spear for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50 + 50% AD<> physical damage and commands Kupa to bite the target for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60 + 60% AD<> physical damage, <#ef5350ff>slowing<> it by <#ffb900ff>50%<> for <#ffb900ff>1s<>. Alpha Wolf Form: the bite instead deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90 + 75% AD<> physical damage to nearby enemies and knocks them <#ef5350ff>airborne<> for <#ffb900ff>0.6s<>.",
        "skill2": "<#5ad0e6ff>Kupa, Help!<>: Popol gains a <#ffb900ff>90 + 50% AD<> shield for <#ffb900ff>3s<> and calls Kupa back. When Kupa arrives, Popol mounts him for up to <#ffb900ff>1.5s<>, gaining <#ffb900ff>50%<> Movement Speed while Kupa recovers <#ffb900ff>25%<> Max HP over the ride. Attacks, other skills and hard crowd control end the ride. Alpha Wolf Form: the shield increases to <#ffb900ff>140 + 70% AD<> and Kupa fully recovers HP at mount start.",
        "ult": "<#e64a6aff>We Are Angry!<>: Kupa fully recovers HP and enters <#5ad0e6ff>Alpha Wolf Form<> for <#ffb900ff>9s<>, gaining <#ffb900ff>35%<> Max HP and enhancing Bite ’em, Kupa! and Kupa, Help! Cooperative stack bonuses are doubled. Requires a living Kupa.",
        "passive": "<#5ad0e6ff>We Are Friends<>: When Popol and Kupa damage the same enemy within <#ffb900ff>2s<>, both gain <#ffb900ff>5%<> Attack Speed and <#ffb900ff>2%<> Movement Speed for <#ffb900ff>4s<>, stacking up to <#ffb900ff>3<> times. Each paired exchange grants one stack.\nKupa has <#ffb900ff>560 + 80 per level after Lv.1 + 50% of Popol’s bonus Max HP<> HP and inherits Popol’s current Armor, Magic Resist and Attack Speed. After <#ffb900ff>5s<> out of combat, Kupa recovers <#ffb900ff>8%<> Max HP per second. If Kupa falls, Popol begins a stationary <#ffb900ff>3s<> prayer after <#ffb900ff>3s<> without combat; movement, damage or another action interrupts it. Successful revival has a <#ffb900ff>30s<> cooldown.\n<#5ad0e6ff>Popol’s Surprise<>: During combat, Popol automatically places a trap every <#ffb900ff>10s<>, up to <#ffb900ff>2<>. Traps arm after <#ffb900ff>0.5s<> and last <#ffb900ff>15s<>. An enemy triggers <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25 + 20% AD<> physical damage and <#ffb900ff>0.6s<> of <#ef5350ff>immobilization<>, leaving frost for <#ffb900ff>3s<> that <#ef5350ff>slows<> enemies by <#ffb900ff>20%<> and reduces Armor by <#ffb900ff>12%<>. Frost from the same Popol does not stack. Placement pauses during casting, recall, riding and prayer."
      },
      "mlbb_granger": {
        "name": "Granger",
        "attack": "Fires a handgun round that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact.",
        "skill": "<#5ad0e6ff>Rhapsody<>: Locks onto an enemy and fires <#ffb900ff>6<> homing rounds over <#ffb900ff>1.5s<>, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>36 + 45% AD<> physical damage and consuming <#ffb900ff>70<> Gun Energy. Requires more than <#ffb900ff>420<> Gun Energy. Movement Speed increases by <#ffb900ff>10%<> while firing. Each hit reduces Rondo’s cooldown by <#ffb900ff>0.5s<>. The final round gains <#ffb900ff>100%<> Critical Chance for its impact. Rondo and Death Sonata can be used during the barrage.",
        "skill2": "<#5ad0e6ff>Rondo<>: Dashes a short distance and restores <#ffb900ff>15%<> of maximum Gun Energy. Walls and movement-disabling effects stop the dash. Equipment cooldown reduction increases Attack instead of shortening Rondo’s effective cooldown.",
        "ult": "<#5ad0e6ff>Death Sonata<>: Consumes <#ffb900ff>250<> Cannon Energy to fire a homing cannon round at an enemy champion. Impact triggers an explosion, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>155 + 110% AD<> physical damage to nearby enemies and <#ef5350ff>slowing<> them by <#ffb900ff>30%<> for <#ffb900ff>0.6s<>. Granger then rolls a short distance away from the firing direction.",
        "passive": "<#5ad0e6ff>Capriccio<>: Uses separate Gun and Cannon Energy pools, each starting at <#ffb900ff>800<>. Gun Energy regenerates at <#ffb900ff>8%<> of its maximum per second; Cannon Energy regenerates at <#ffb900ff>2%<>. Credited lane-minion kills increase maximum Gun Energy by <#ffb900ff>6<> and restore <#ffb900ff>5%<>; jungle kills grant the same benefit to Cannon Energy. Champion kills and assists increase both maxima by <#ffb900ff>12<> and restore <#ffb900ff>10%<>. Capacity growth persists through death. Equipment cooldown reduction grants <#ffb900ff>0.5<> Attack per percentage point, up to <#ffb900ff>20<> Attack."
      },
      "mlbb_hanzo": {
        "name": "Hanzo",
        "attack": "Strikes for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Attack<> physical damage and applies a mark.",
        "skill": "<#5ad0e6ff>Demon Feast<>: At <#ffb900ff>5 marks<>, bites champions for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200 + 7 per level after Lv.1 + 115% bonus Attack<> physical damage, heals and refunds <#ffb900ff>60%<> cooldown. Ordinary camps are devoured, healing <#66cc66ff>20% maximum Health<>.\n<#5ad0e6ff>Soul Snatch<>: Lunges for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>135 + 6 per level after Lv.1 + 95% bonus Attack<> physical damage, increased <#ffb900ff>24% per mark<> against champions and <#ffb900ff>20% per mark<> against other targets. At <#ffb900ff>5 marks<>, adds damage based on maximum Health and heals.\nCooldown: <#ffb900ff>12s / 10s<>.",
        "skill2": "<#5ad0e6ff>Dark Mist<>: Dashes and gains <#ffb900ff>15% Movement Speed<> for <#ffb900ff>2s<>. Leaves <#ffb900ff>5<> mist pulses.\n<#5ad0e6ff>Black Mist<>: Dashes through walls for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110 + 4 per level + 55% bonus Attack<> physical damage and <#ef5350ff>0.4s airborne<>. Leaves <#ffb900ff>4<> pulses.\nMist deals physical damage every <#ffb900ff>0.5s<>, applies marks and <#ef5350ff>slows 35%<>; it cannot critically strike. Cooldown: <#ffb900ff>10s per form<>.",
        "ult": "Projects Hanekage for up to <#ffb900ff>15s<>, leaving an invulnerable body. Gains <#ffb900ff>35% Movement Speed<>, <#ffb900ff>25% Attack Speed<> and wall traversal, with <#ffb900ff>30% less maximum Health<>.\nRecast returns and heals <#66cc66ff>90 + 50% bonus Attack<>. Empty Energy draws the body to Hanekage. Defeat forces a return to the body, <#ef5350ff>slows Hanzo 50% for 6s<> and sets a <#ffb900ff>52s<> cooldown (normally <#ffb900ff>26s<>).",
        "passive": "Basic attacks and mist hits apply up to <#ffb900ff>5 marks<> for <#ffb900ff>6s<>. New hits refresh them. Hanekage starts with <#ffb900ff>100 Energy<> and spends <#ffb900ff>10 per second<>; hits and nearby deaths restore Energy."
      },
      "mlbb_atlas": {
        "name": "Atlas",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Skill casts create a moving frost aura for <#ffb900ff>4s<> and grant <#66cc66ff>10 armor and magic resistance<>. Nearby enemy champions slow up to <#ef5350ff>25%<> and freeze for <#ef5350ff>0.5s<> after 2s of continuous exposure. Freeze cooldown per target: <#ffb900ff>4s<>.",
        "skill": "Slams three times for <#5ad0e6ff>30 + 10% Magic Power<> magic damage per pulse. The suit also slams while separated. Overlapping hits deal <#5ad0e6ff>45 + 15% Magic Power<> once per pulse. Cooldown: <#ffb900ff>7s<>.",
        "skill2": "Ejects for up to <#ffb900ff>2s<>, gaining <#ffb900ff>25% Movement Speed<> while the suit follows. Reunion deals <#5ad0e6ff>65 + 20% Magic Power<> magic damage and <#ef5350ff>stuns for 0.6s<>. Cooldown: <#ffb900ff>10s<>.",
        "ult": "Links nearby enemy champions for <#5ad0e6ff>35 + 10% Magic Power<> magic damage and <#ef5350ff>30% slow<>. After <#ffb900ff>0.4s<>, Atlas pulls them in for <#5ad0e6ff>105 + 25% Magic Power<> magic damage and <#ef5350ff>0.35s airborne<>. While ejected, reunites immediately with a <#ef5350ff>40% slow<> in place of the reunion hit. Cooldown: <#ffb900ff>34s<>."
      },
      "mlbb_yu_zhong": {
        "name": "Yu Zhong",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage. Soul Grip can empower the next basic attack.",
        "passive": "Basic attacks and direct skill hits apply Sha Residue to enemy heroes and jungle monsters, including Morgard and Serpen, for <#ffb900ff>5s<>. At three marks, the target pulses five times. Each pulse deals <#ff9028ff>32 + 18% Attack + 2% of the target’s missing HP<> as physical damage and heals Yu Zhong for <#66cc66ff>8% of his missing HP<>. Against jungle monsters, the missing-HP damage bonus is capped at 40 per pulse. When the eruption starts, Yu Zhong gains 15% Movement Speed for 1.5s.",
        "skill": "After 0.4s, sweeps nearby enemies for <#ff9028ff>80 + 65% Attack<> physical damage. The outer edge instead deals <#ff9028ff>138 + 95% Attack<> and applies two marks to eligible targets. Cooldown is 7s.",
        "skill2": "Sends a wave that deals <#ff9028ff>95 + 68% Attack<> physical damage and slows by 30% for 1s. On hit, the next basic attack within 3s deals <#ff9028ff>55 + 40% Attack<> extra physical damage and can lunge toward the champion struck by Soul Grip if the route is clear. Hitting a champion at a useful distance triggers Furious Dive if the landing is safe. The leap deals damage on landing and allows one short dash in his movement direction. After 0.4s, the original landing area erupts, knocking enemy champions airborne for 0.5s. Both hits deal a combined <#ff9028ff>64 + 45% Attack<> physical damage. Cooldown is 10s.",
        "ult": "Channels for 0.6s, then flies as a dragon for up to 3.5s with 35% Movement Speed, wall traversal and crowd-control immunity. Passing an enemy hero deals <#ff9028ff>125 + 85% Attack<> physical damage and knocks them back once. On landing, enters Dragonoid Form for 15s, increasing skill reach and width by 20%. Cooldown is 46s."
      }
    },
