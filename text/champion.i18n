  "ja": {
    "description": {
      "mlbb_valir": {
        "name": "Valir",
        "attack": "Throws an ember that deals <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Direct spell hits apply Ablaze for <#ffb900ff>3s<>. The burn deals <#5ad0e6ff>0.8% max HP<> magic damage per second. At <#ffb900ff>3 stacks<>, it detonates for <#5ad0e6ff>4% max HP + 25% Magic Power<> magic damage and <#ef5350ff>stuns for 0.65s<>. Stun cooldown per target is <#ffb900ff>8s<>. Monster damage is capped. Bosses are immune to the stun.",
        "skill": "Fires a bolt that deals <#5ad0e6ff>70 + 65% Magic Power<> magic damage and <#ef5350ff>slows by 25% for 0.7s<>. The impact area bursts after <#ffb900ff>0.75s<> for <#5ad0e6ff>42 + 30% Magic Power<> magic damage. Stores <#ffb900ff>2 charges<> and restores one every <#ffb900ff>9s<>. A direct hit on a champion or boss refunds a charge up to once every <#ffb900ff>3.6s<>. Hitting a lane minion takes <#ffb900ff>2s<> off the recharge. Minimum recast is <#ffb900ff>1.8s<>.",
        "skill2": "Sends a wave that deals <#5ad0e6ff>95 + 65% Magic Power<> magic damage and <#ef5350ff>knocks back enemy champions, lane minions and regular jungle monsters<>. While empowered, it leaves a firewall for <#ffb900ff>3s<> that deals <#5ad0e6ff>27 + 22% Magic Power<> magic damage each second and briefly <#ef5350ff>slows by 20%<>. Cooldown is <#ffb900ff>10s<>.",
        "ult": "Can activate automatically when ready to <#ef5350ff>break a stun or other supported disable<>. Suppression still applies. Grants <#ffb900ff>30% Movement Speed<>, tapering over <#ffb900ff>3s<>. Empowers the next <#ffb900ff>4 casts<> within <#ffb900ff>9s<>. Fireball gains <#ffb900ff>30% projectile reach<> and Torrent leaves a firewall. Cooldown is <#ffb900ff>42s<>."
      },
      "mlbb_lesley": {
        "name": "Lesley",
        "attack": "Fires a rifle shot for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "<#5ad0e6ff>Lethal Shot<>. Casting a skill or going 5s without taking damage readies the next basic. It gains <#ffb900ff>17 range<> and deals <#ff9028ff>75 + 110% Attack<> true damage to champions or <#ff9028ff>75 + 125% Attack<> physical damage to lane and jungle enemies. Structures take normal basic damage.",
        "skill": "<#5ad0e6ff>Master of Camouflage<>. Camouflages for up to <#ffb900ff>2.5s<> and gains 30% Movement Speed. Enemies lose direct targeting, but area effects can still hit her. Attacking, casting another skill, or taking damage after the first 0.5s ends camouflage.",
        "skill2": "<#5ad0e6ff>Tactical Grenade<>. Deals <#ff9028ff>115 + 65% Attack<> physical damage in a short cone and pushes surviving enemy champions away. Lesley hops backward if the path is clear. During Ultimate Snipe, she fires an available round before ending the volley.",
        "ult": "<#e64a6aff>Ultimate Snipe<>. Locks onto an enemy champion and fires up to <#ffb900ff>four rounds<>. Each deals <#ff9028ff>70 + 32% Attack + 6% of the target’s missing HP<> as physical damage. Another enemy champion in the firing line can intercept a round."
      },
      "mlbb_aldous": {
        "name": "オルダス",
        "attack": "溶岩の巨拳で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻撃力<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill": "<#ff9028ff>契約：ソウルスティール<>：主対象に<#ff9028ff>40 + レベル補正 + 攻撃力の100% + ソウルスティール1スタックごとに2.5<>の物理ダメージを与えます。周囲の敵は<#ff9028ff>40%<>の範囲ダメージを受けます。<#ffb900ff>1,000<>スタック時、スタックボーナスは防御適用前で<#ffb900ff>+2,500<>です。",
        "skill2": "<#ffb900ff>契約：エクスプロージョン<>：<#ffb900ff>2秒<>間シールド（<#ffb900ff>90<>）と移動速度（<#ffb900ff>+25%<>）を得てから爆発し、周囲に<#ff9028ff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻撃力<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1秒<><#ef5350ff>スタン<>を与える。",
        "ult": "<#e64a6aff>契約：チェイスフェイト<>：敵に<#e64a6aff>運命の眼<>を刻み溶岩ドリルとなって突撃、<#ff9028ff>130<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%攻撃力<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1.2秒<><#ef5350ff>スタン<>を与える。",
        "passive": "契約：変容 — アルダスは魂のエネルギーを吸収する：<#ffb900ff>5秒<>ごとに<#ffb900ff>+1<>、キルで<#ffb900ff>+10<>、<#5ad0e6ff>ソウルスティール<>命中時にも獲得（上限<#ffb900ff>1,000<>）。<#ffb900ff>3<>回目の通常攻撃ごとに（<#ffb900ff>5秒<>クールダウン）<#ffb900ff>2秒<>間のシールドを得る。数値は<#ffb900ff>35<>+レベル×<#ffb900ff>5<>+スタック×<#ffb900ff>0.45<>。スタックは<#5ad0e6ff>ソウルスティール<>も強化する。"
      },
      "mlbb_fanny": {
        "name": "ファニー",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "skill": "<#ff9028ff>トルネードストライク<>：半径<#ffb900ff>22,000<>以内の敵に<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の80%<>のダメージを与える。スチールケーブル飛行中に敵と衝突すると、<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の70%<>の空中トルネードストライクが自動で発動する。",
        "skill2": "<#ff9028ff>スチールケーブル<>：最適な壁または外周レーン境界へケーブル（射程<#ffb900ff>165,000<>）を投げ、エネルギー消費<#ffb900ff>0<>で連続壁乗りにより追撃または離脱する。視界内の敵英雄を最優先に狙い、敵英雄が視界にいない場合のみジャングルモンスターに使用する。",
        "ult": "<#ff9028ff>カットスロート<>：対象へ突進し<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の125%<>のダメージを与える。獲物の印1つごとに<#ff9028ff>攻撃力の35%<>の追加ダメージ（最大2スタック）。命中すると印を消費する。",
        "passive": "<#ff9028ff>空中優勢<>：ケーブル飛行中、移動速度に応じて<#ffb900ff>10–25%<>のダメージが増加する。飛行中に敵英雄へ命中すると<#ff9028ff>獲物の印<>を付与・強化（最大2スタック、<#ffb900ff>5秒<>）し、トルネードストライクを発動する。"
      },
      "mlbb_lancelot": {
        "name": "ランスロット",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
        "skill": "<#ff9028ff>パンクチャー<>：指定した敵へ突進し、<#ff9028ff>80–178 + 攻撃力の40%<>の物理ダメージを与えます。最初に命中した未マークの敵に<#5ad0e6ff>剣の印<>を付与し、新しい印を付けるとクールダウンがリセットされます。発動ごとに<#ffb900ff>ソウルカッター<>を1スタック得ます。",
        "skill2": "<#ffb900ff>ソーンローズ<>：3回攻撃し、各攻撃は<#ff9028ff>85–155 + 攻撃力の30%<>の物理ダメージを与え、命中した敵の移動速度を<#ffb900ff>20%<>低下させます（<#ffb900ff>0.5秒<>）。連続攻撃中はダメージと行動妨害を無効化し、複数命中には範囲ダメージ減衰が適用されます。",
        "ult": "<#e64a6aff>ファントムエグゼキューション<>：指定した敵ヒーローへ突進し、到達時に<#ff9028ff>100–156 + 攻撃力の100%<>の物理ダメージを与えます。突進中はダメージと行動妨害を無効化し、<#ffb900ff>ソウルカッター<>を1スタック得ます。",
        "passive": "<#5ad0e6ff>ソウルカッター<>：パンクチャーとファントムエグゼキューションで、スタックごとに与ダメージが<#ffb900ff>7.5%<>増加し、<#ffb900ff>4秒<>持続します。最大<#ffb900ff>4スタック（30%）<>です。"
      },
      "mlbb_estes": {
        "name": "エステス",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
        "passive": "<#5ad0e6ff>月のエルフの書<>：毎秒<#ffb900ff>1<>スタック、味方とリンク中は毎秒<#ffb900ff>2<>スタックを獲得。100スタックで次の通常攻撃が強化され、魔法ダメージを与えて最大2体の近くの敵に跳ね返り、40%スロウ（1.5秒）を与えます。スタックはスキル1のアイコンに表示されます。",
        "skill": "<#5ad0e6ff>月光の浸礼<>：味方ヒーロー1体を即座に<#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の85%<>回復し、その後<#ffb900ff>0.5秒<>ごとに<#5bd18aff>24<> + <#a974ffff>魔力の18%<>を5秒間回復します。味方は物理・魔法防御<#ffb900ff>+7<>、エステスは移動速度<#ffb900ff>+15%<>を得ます。距離が120,000を超えると視覚的なリンクとパッシブのチャージボーナスは止まりますが、データ設定の継続回復は残り時間中続きます。",
        "skill2": "<#5ad0e6ff>月の女神の領域<>：<#ffb900ff>2.5秒<>間、固定された月光領域を作ります。<#ffb900ff>0.5秒<>ごとに半径<#ffb900ff>52,000<>内の敵に<#a974ffff>15<> + <#a974ffff>魔力の45%<>魔法ダメージを与え、<#ffb900ff>35%<>スロウを与えます（0.75秒）。TFM2版では外周だけでなく領域内でスロウが発生します。",
        "ult": "<#5ad0e6ff>月の女神の祝福<>：半径<#ffb900ff>105,000<>内の味方を即座に<#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の65%<>回復し、8秒間<#ffb900ff>0.5秒<>ごとに<#5bd18aff>20<> + <#a974ffff>魔力の12%<>を回復。物理・魔法防御<#ffb900ff>+8<>も付与します。"
      },
      "mlbb_gusion": {
        "name": "グシオン",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "passive": "<#5ad0e6ff>Dagger Specialist<>: Each skill cast grants a <#ffb900ff>Rune<> stack, up to <#ffb900ff>4<>. The next basic attack consumes all stacks, dealing <#a974ffff>3% of the target’s max HP<> as magic damage per stack and restoring <#5bd18aff>50 + 25% Total Magic Power<> HP per stack.",
        "skill": "<#5ad0e6ff>ソードスパイク<>：短剣を投げ、最初に命中した敵に<#a974ffff>総魔法力の50% + 200<>の魔法ダメージを与え、<#ffb900ff>5秒<>間マークします。再発動でマークした敵の背後へ移動し、<#a974ffff>総魔法力の100% + 200<>の魔法ダメージを与えます。",
        "skill2": "<#a974ffff>シャドウブレードスローター<>：扇状に<#ffb900ff>短剣を5本<>投げ、1本ごとに<#a974ffff>総魔法力の40% + 65<>の魔法ダメージを与えます。再発動で短剣を呼び戻します。アルティメット後にもう一組を投げると、次の再発動で両方のセットを回収します。",
        "ult": "<#e64a6aff>インカンデセンス<>：選択した敵の背後へ移動し、スキル1と2のクールダウンをリセットします。スキル2の短剣が残っていれば、もう一組を投げてから両方を回収できます。<#ffb900ff>2.5秒<>以内に再発動してもう一度移動できます。"
      },
      "mlbb_karrie": {
        "name": "キャリー",
        "attack": "通常攻撃は単一のライトホイールで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "passive": "<#5ad0e6ff>ライトホイールの印<>：通常攻撃とスキル1・2が<#ffb900ff>印を1つ<>付与する。<#ffb900ff>5スタック<>で爆発し、対象の最大HPの<#ff9028ff>4%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の10%<>に相当する<#e64a6aff>真ダメージ<>を与える。英雄に対しては<#ffb900ff>250<>、ジャングル/エピックモンスターに対しては<#ffb900ff>300<>が上限となる。",
        "skill": "<#5ad0e6ff>スピニングライトホイール<>：指定方向へ環状のライトホイールを投げる。命中時、主対象に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の80%<>の物理ダメージ、周囲のタワー以外の敵に<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の35%<>の物理ダメージを与え、<#ffb900ff>1秒<>間<#ffb900ff>35%<>の移動速度低下を与える。命中地点には<#ffb900ff>1.5秒<>間、紫色の減速地帯が残り、範囲内の敵は再び<#ffb900ff>35%<>減速し、<#ffb900ff>0.5秒<>間隔で2回、<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の10%<>の物理ダメージを受ける。地帯の追加ダメージではライトホイールの印は付与されない。",
        "skill2": "<#5ad0e6ff>ファントムステップ<>：指定地点に向かって一定距離ダッシュし、着地点付近で最も近い有効な敵へライトホイールを放ちます。<#ff9028ff>75 + 総物理攻撃力の70%<>のダメージを与え、スピーディライトホイール中は係数が<#ff9028ff>100%<>になり、<#ffb900ff>ライトホイールの印を1つ<>付与します。",
        "ult": "<#e64a6aff>スピーディライトホイール<>：<#ffb900ff>6秒<>間、移動速度が<#ffb900ff>20%<>、攻撃速度が<#ffb900ff>35%<>上昇します。効果中、ファントムステップは<#ff9028ff>75 + 総物理攻撃力の100%<>のダメージを与えます。"
      },
      "mlbb_uranus": {
        "name": "ウラノス",
        "attack": "通常攻撃は腕を振り、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>に相当する<#ff9028ff>物理ダメージ<>を与えます。通常攻撃ではイオンエッジの印を<#ffb900ff>付与しません<>。",
        "passive": "<#5ad0e6ff>ラディアンス<>：ダメージを受けると<#ffb900ff>1スタック<>獲得（最大<#ffb900ff>12<>、各<#ffb900ff>10秒<>持続、<#ffb900ff>1秒<>につき最大1スタック）。<#ffb900ff>0.8秒<>ごとに回復し、12スタック時は<#5bd18aff>28～134 HP<>を回復します。",
        "skill": "<#5ad0e6ff>イオンエッジ<>：2枚のエネルギーブレードを外側へ放って戻し、命中ごとに<#a974ffff>79～131（総魔法力の18%加算）<>の魔法ダメージを与え、<#ffb900ff>30%<>のスロウを<#ffb900ff>2秒<>付与します。各刃は同じ対象に1回まで命中。1回の発動につき対象ごとに<#ffb900ff>イオンの印を1つ<>付与し、<#ffb900ff>6秒<>持続します。印1つにつき以降のスキル1ダメージが<#ffb900ff>20%<>増加し、最大<#ffb900ff>8スタック<>。タワーとネクサスには印を付与しません。",
        "skill2": "<#5ad0e6ff>超越の守護<>：指定地点へ突進します。経路上の敵に<#a974ffff>48～120（総魔法力の12%加算）<>、到着地点付近の敵に<#a974ffff>96～240（総魔法力の48%加算）<>の魔法ダメージを与え、<#ffb900ff>25%<>のスロウを付与。<#5bd18aff>300～750（総魔法力の200%加算）<>のシールドを<#ffb900ff>4秒<>獲得し、破壊または終了時に周囲へ<#a974ffff>156～390（総魔法力の78%加算）<>の魔法ダメージを与えます。",
        "ult": "<#e64a6aff>コンセクレーション<>：<#ef5350ff>すべての行動妨害<>を解除します（TFM2版。原作ではスロウのみ解除）。<#5bd18aff>200～400 HP<>を回復し、<#ffb900ff>60%<>の移動速度を得て<#ffb900ff>8秒<>かけて減衰します。ラディアンスを<#ffb900ff>5～12スタック<>獲得。8秒間、HP回復とウラノス自身の超越の守護シールドが<#ffb900ff>20%<>増加します。"
      },
      "mlbb_chou": {
        "name": "チョウ",
        "attack": "通常攻撃は物理攻撃力の100%の物理ダメージを与える。",
        "passive": "<#5ad0e6ff>迅速<>：TFM2ワールド距離で約<#ffb900ff>42,000<>移動すると、次の通常攻撃が<#ff9028ff>物理攻撃力の180%<>の物理ダメージを与え、<#ffb900ff>1秒<>間<#ffb900ff>80%<>減速させ、<#ffb900ff>2秒<>間物理防御を<#ffb900ff>10<>低下させる（最大<#ffb900ff>2<>スタック）。距離はTFM2のマップ規模に合わせて調整。",
        "skill": "<#ff9028ff>截拳道<>：最大<#ffb900ff>3<>回発動。上昇蹴り、突進アッパー、跳び上がって叩きつける蹴りの順に繰り出し、最後の一撃で敵を浮かせる。各攻撃は<#ff9028ff>100–165 + 総物理攻撃力の45%<>ダメージ。最初の2回は再発動でき、3回目でクールダウンが始まる。3回目が敵ヒーローに命中すると、瞬歩のクールダウンがリセットされる。",
        "skill2": "<#5ad0e6ff>瞬歩<>：指定方向へダッシュし、移動中は<#ffb900ff>行動妨害無効<>を得る。到着時に<#5bd18aff>200–300 + 追加物理攻撃力の100%<>のシールドと、<#ffb900ff>2.5秒<>間物理貫通<#ffb900ff>15<>を得る。",
        "ult": "<#e64a6aff>龍の道<>：敵ヒーローに回し蹴りを放ち、<#ff9028ff>275–420 + 追加物理攻撃力の110%<>ダメージを与えて吹き飛ばす。同じ対象が追撃範囲内にいれば、チョウは追いついてから4回攻撃し、合計<#ff9028ff>330–500 + 追加物理攻撃力の132%<>の物理ダメージを与える。"
      },
      "mlbb_zhask": {
        "name": "ザスク",
        "attack": "影の弾を放ち、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>にあたる<#ff9028ff>物理ダメージ<>を与える。",
        "passive": "<#5ad0e6ff>殲滅<>：ザスクが倒されると、死亡地点に狂暴化したスポーンを召喚する。最大<#ffb900ff>6秒<>持続し、毎秒最大HPの<#ffb900ff>2%<>を失う。",
        "skill": "<#5ad0e6ff>悪夢のスポーン<>：最大<#ffb900ff>12秒<>その場にとどまるスポーンを召喚する。レベルに応じてザスクのHP、防御力、魔力の<#ffb900ff>55～100%<>を継承する。デスレイは<#a974ffff>15ティック（0.25秒）<>ごとに命中し、<#a974ffff>30（魔力の25%）<>の魔法ダメージを与え、<#ffb900ff>36ティック（0.6秒）<>の間、移動速度を<#ffb900ff>30%<>低下させる。再度照準して位置を変更できる。ザスクから<#ffb900ff>120,000<>ユニット以上離れると、戻るまでビームが停止する。",
        "skill2": "<#5ad0e6ff>マインドイーター<>：指定方向へ貫通弾を放ち、軌道上の敵に<#a974ffff>87 +（レベル1超過分×6）（魔力の60%）<>の魔法ダメージを与える。スポーンが生存中なら、命中した敵ごとに<#a974ffff>35（魔力の50%）<>の追加ダメージを与え、<#ffb900ff>30ティック（0.5秒）<>スタンさせる。",
        "ult": "<#e64a6aff>支配者の降臨<>：指定地点へ瞬間移動し、最大<#ffb900ff>10秒<>融合スポーンを召喚する。融合中、ザスクは追放され、姿が見えず、対象指定と操作ができない。融合スポーンはザスクの能力値を100%継承し、デスレイのダメージは<#ffb900ff>×1.8<>になる。"
      },
      "mlbb_hanabi": {
        "name": "花火",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
        "passive": "<#5ad0e6ff>忍術・花弁乱舞<>：通常攻撃とスキル命中時に花弁刃を放ち、近くの敵へ跳ね返します。花火は<#ffb900ff>出所を問わずシールドがある間<>、行動妨害に免疫を得ます。すでに受けた行動妨害は解除しません。",
        "skill": "<#5ad0e6ff>忍術・エクリプス<>：<#ff9028ff>120 + 攻撃力の35%<>のシールドを<#ffb900ff>5秒<>間獲得し、移動速度が<#ffb900ff>12%<>、攻撃速度が<#ffb900ff>20%<>上昇します。シールド中はヒーローに与えたダメージの<#ffb900ff>20%<>、他のユニットに与えたダメージの<#ffb900ff>10%<>がシールドに変換されます。上限は最大HPの<#ffb900ff>50%<>で、この実装ではすべてのシールド層を上限に算入します。シールドがある間はパッシブの行動妨害耐性も発動します。",
        "skill2": "<#5ad0e6ff>忍術・ソウルスクロール<>：貫通するクナイと巻物を放ち、軌道上の敵に<#ff9028ff>65 + 攻撃力の75%<>の物理ダメージを与え、<#ffb900ff>1秒<>間<#ffb900ff>30%<>スロウにします。命中した敵に<#ffb900ff>5秒<>間印を付与します。次の通常攻撃の花弁が印の対象に跳ね返ると、通常の跳ね返り減衰を受けない<#ff9028ff>20 + 攻撃力の50%<>の追加ダメージを与えて印を消費します。",
        "ult": "<#e64a6aff>禁術・彼岸花<>：大輪の彼岸花を投げ、最初に命中した敵ヒーローに<#ff9028ff>150 + 攻撃力の80%<>の物理ダメージを与え、<#ffb900ff>0.8秒<>間束縛します。<#ffb900ff>0.8秒<>後、その位置で開花し、<#ffb900ff>34,000<>範囲の敵に<#ff9028ff>105 + 攻撃力の55%<>の物理ダメージを与えます。主対象以外の敵は<#ffb900ff>0.6秒<>間<#ffb900ff>20%<>スロウになります。"
      },
      "mlbb_alpha": {
        "name": "Alpha",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "passive": "<#5ad0e6ff>ベータ、前進！<> 敵ヒーローへの有効な攻撃が3回命中すると、ベータのレーザーが30 + Lv1以降のレベルごとに3 + 攻撃力の15%の物理ダメージを与え、1秒間30%スローを付与する。",
        "skill": "<#5ad0e6ff>ロータリーインパクト<> 前方に波を放ち、70 + 攻撃力の80%の物理ダメージと1秒間の40%スローを与える。ベータが25 + Lv1以降のレベルごとに1 + 攻撃力の20%の確定ダメージで追撃する。",
        "skill2": "<#5ad0e6ff>フォーススイング<> 前方を薙ぎ払い、100 + 攻撃力の80%の物理ダメージを与える。ベータが25 + Lv1以降のレベルごとに1 + 攻撃力の20%の確定ダメージで追撃する。発動ごとに1回、100 + 攻撃力の20%のHPを回復する。",
        "ult": "<#e64a6aff>アルファの槍<> ベータの突撃は70 + 攻撃力の20%の物理ダメージを与え、1秒間スタンさせる。アルファの着地は130 + 攻撃力の80%の物理ダメージ、0.67秒の打ち上げ、1.25秒間の30%スローを与える。ベータはさらに5回、各8 + 攻撃力の10%の物理ダメージを与える。"
      },
      "mlbb_arlott": {
        "name": "アーロット",
        "attack": "通常攻撃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
        "passive": "<#5ad0e6ff>悪魔の凝視<>：<#ffb900ff>7秒<>ごとに最も近い敵ヒーローをマークし、アーロットの行動妨害効果が当たった敵もマークします。<#e64a6aff>マーク<>された対象は復讐の効果が2倍になります。マークは<#ffb900ff>7秒<>間持続します。",
        "skill": "<#5ad0e6ff>無謀な一撃<>：槍を振り下ろし、直線上の敵に<#ff9028ff>110 + 総物理攻撃力の55%<>の物理ダメージを与えてスタンさせます。対象が<#ffb900ff>遠いほど<>スタンが<#ffb900ff>長く<>なり、至近距離で<#ffb900ff>0.5秒<>、最大射程で<#ffb900ff>1秒<>になります。振り下ろしは行動妨害した敵をマークします。",
        "skill2": "<#5ad0e6ff>復讐<>：敵へ突進し、<#ff9028ff>100 + 総物理攻撃力の55%<>の物理ダメージを与え、行動妨害効果で対象をマークします。突進中、アーロットは<#ffb900ff>中断されません<>。<#e64a6aff>マーク<>された対象には<#ffb900ff>2倍<>のダメージを与え、<#ffb900ff>自身のクールダウンをリセット<>し、<#ffb900ff>総物理攻撃力の30%<>のHPを回復します（非ヒーローには半分）。",
        "ult": "<#e64a6aff>最期の一閃<>：二本の槍で大きく薙ぎ払い、<#ff9028ff>160 + 総物理攻撃力の75%<>の物理ダメージを与え、すべての敵をアーロットの<#ffb900ff>右側<>へ<#ffb900ff>引き寄せます<>。引き寄せられた敵はすべて<#e64a6aff>マーク<>されます。"
      },
      "mlbb_franco": {
        "name": "フランコ",
        "attack": "戦槌を振り回し <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> の <#ff9028ff>物理ダメージ<>を与える。",
        "skill": "<#5ad0e6ff>アイアンフック<>：鉤爪を投げ、最初に当たった敵を引っ掛けて <#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> の <#ff9028ff>物理ダメージ<>を与え、フランコの元へ引き寄せる。フックは先に<#ef5350ff>スタン<>させ、その後に引くため、引き寄せられない相手も足止めされる。",
        "skill2": "<#5ad0e6ff>フューリーショック<>：周囲を薙ぎ払い、敵に <#ff9028ff>160<> + 自身の<#ffb900ff>最大HP<>の <#ff9028ff>4%<> の <#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>1.5秒<> の間 <#ffb900ff>70%<> <#ffb900ff>スロウ<>を付与する。ジャングルモンスターやオブジェクトにも使用可能。移動しながら使用できる。",
        "ult": "<#e64a6aff>ブラッディハント<>：敵チャンピオンを <#ffb900ff>1.8秒<> の間 <#ef5350ff>サプレッション<>し、<#ffb900ff>6<> 回攻撃する。ハンマーとフックを交互に使い、毎回 <#ff9028ff>50<> + <#ff9028ff>70% AD<> のダメージを与える。フランコが群衆制御を受けると途中で終了する。",
        "passive": "<#5ad0e6ff>ウェイストランドフォース<>：<#ffb900ff>5秒<> 間ダメージを受けないと、移動速度 <#ffb900ff>10%<>、毎秒最大HPの <#ffb900ff>1%<> を回復し、最大 <#ffb900ff>10<> スタックを蓄積する。次のスキルが全スタックを消費し、スキルダメージを最大 <#ffb900ff>+150%<> 増加させる。"
      },
      "mlbb_balmond": {
        "name": "バルモンド",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
        "passive": "<#5ad0e6ff>ブラッドサースト<>：ミニオンまたは中立モンスターを倒すと最大HPの<#ffb900ff>5%<>を、敵英雄の撃破またはアシストで<#ffb900ff>10%<>を回復する。",
        "skill": "<#5ad0e6ff>ソウルロック<>：選択した敵英雄へ突進し、直線上の敵に<#ff9028ff>150–275 + 総物理攻撃力の60%<>の物理ダメージを与える。命中した英雄は短くノックバックし、<#ffb900ff>3秒<>間<#ffb900ff>40%<>の移動速度低下を受ける。TFM2プロトタイプでは位置を指定して突進し、直線経路上のダメージは維持され、到着地点付近の最も近い敵英雄がダメージを受ける。",
        "skill2": "<#5ad0e6ff>サイクロンスイープ<>：<#ffb900ff>3秒<>間回転し、14回に分けてダメージを与える。各命中は<#ff9028ff>24–44 + 総HPの1.3% + 総物理攻撃力の25%<>の物理ダメージを与え、対象の物理防御を命中ごとに<#ffb900ff>5%<>低下させる（最大<#ffb900ff>8スタック<>）。持続中は移動速度が<#ffb900ff>15%<>上昇する。",
        "ult": "<#e64a6aff>リーサルカウンター<>：前方の広範囲に<#ff9028ff>150 + 総物理攻撃力の70% + 対象の減少HPの30–45%<>に相当する<#e64a6aff>真ダメージ<>を与える。英雄以外へのダメージは英雄レベル区分ごとに<#ffb900ff>1,000 / 1,500 / 2,000<>で上限となる。"
      },
      "mlbb_obsidia": {
        "name": "オブシディア",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 物理攻撃力の65%<>の物理ダメージを与える。",
        "passive": "<#5ad0e6ff>骨への回帰<>：敵にダメージを与えると骨力を獲得する——敵ヒーローへの通常攻撃で<#ffb900ff>2<>、スキル命中で<#ffb900ff>4<>、ミニオンまたはタワーへの攻撃で<#ffb900ff>1<>。ジャングルのモンスターでは獲得できない。骨力<#ffb900ff>30<>ごとに骨片が1枚鍛造され、最大<#ffb900ff>25<>枚。骨片1枚ごとに、通常攻撃が総物理攻撃力の<#ffb900ff>7%<>分だけ追加で命中する。敵ヒーローを倒すと即座に骨片を1枚獲得する。",
        "skill": "<#5ad0e6ff>深淵の骨針<>：直線上に骨の針を放ち、命中した敵に<#ff9028ff>90–140 + 総物理攻撃力の60%<>の物理ダメージを与え、最初に命中した敵ヒーローに骨力を付与する。",
        "skill2": "<#5ad0e6ff>幻影の影隠れ<>：深淵に沈み、対象方向へダッシュし、<#ffb900ff>0.3秒<>間<#ffb900ff>移動速度+20%<>を獲得する。",
        "ult": "<#e64a6aff>骨の狩り<>：憤怒の骨を放ち、<#ff9028ff>55 + 総物理攻撃力の50%<>の物理ダメージを与え、最初に命中した敵ヒーローを短時間<#ffb900ff>スタン<>させ、<#ffb900ff>自身をその近くへ引き寄せる<>。<#ffb900ff>3秒<>間拘束する：自身は<#ffb900ff>4ユニット<>以上離れられず、敵は移動スキルを使用できず、敵の移動に引きずられる。上限を超えて<#ffb900ff>5枚の仮骨片<>、<#ffb900ff>シールド<>、<#ffb900ff>攻撃速度+30%<>を獲得する。障害物をすり抜け、移動しながら通常攻撃が可能になり、幻影の影隠れは<#ffb900ff>1秒<>持続する。"
      },
      "mlbb_gord": {
        "name": "ゴード",
        "attack": "通常攻撃は <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<> の物理ダメージを与えます。射程が長い。",
        "passive": "<#5ad0e6ff>ミスティック・フェイバー<>: スキルで敵に <#ffb900ff>3<> 回命中させるごとに次のスキル命中が強化され、<#a974ffff>12 (+レベルごとに2) (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>魔力の8%) の確定ダメージ<>を追加で与え、対象を <#ffb900ff>1秒<> 間 <#ffb900ff>20%<> スロウにします。スロウは最大 <#ffb900ff>2<> 回まで重なり、<#ffb900ff>40%<> に達します。",
        "skill": "<#5ad0e6ff>ミスティック・プロジェクタイル<>: エネルギー弾を放ち、最初に当たった敵の位置で停止して爆発し、<#a974ffff>魔力の52% + 105<> の魔法ダメージを与え、<#ffb900ff>1秒<> 間 <#ffb900ff>スタン<>させます。",
        "skill2": "<#5ad0e6ff>ミスティック・インジャンクション<>: 指定地点に <#ffb900ff>4秒<> 間エネルギーフィールドを生成し、<#ffb900ff>0.25秒<> ごとに <#a974ffff>魔力の12% + 6<> の魔法ダメージを最大 <#ffb900ff>16<> 回与えます。",
        "ult": "<#e64a6aff>ミスティック・ガッシュ<>: <#ffb900ff>3.2秒<> 間エネルギービームを放ち、<#ffb900ff>0.2秒<> ごとに <#a974ffff>魔力の17% + 12<> の魔法ダメージを最大 <#ffb900ff>16<> 回与えます。各ウェーブは前方の最も近い敵チャンピオンを再照準します。"
      },
      "mlbb_belerick": {
        "name": "ベレリック",
        "attack": "通常攻撃は <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<> の物理ダメージを与えます。<#5ad0e6ff>ネイチャーズ・ストライク<> で強化されている間は代わりに <#a974ffff>60<> の魔法ダメージを与え、<#ffb900ff>150 + 減少HPの12%<> を回復し、対象を <#ffb900ff>1.4秒<> 間 <#ffb900ff>60%<> スロウにします。",
        "passive": "<#5ad0e6ff>デッドリー・ソーンズ<>: ベレリックが <#ffb900ff>4<> 回被弾するごとに最も近い敵へトゲを放ち、<#a974ffff>10 (+レベルごとに1) + 最大HPの1%<> の魔法ダメージを与えます。<#ffb900ff>10<> 未満のダメージはカウントされず、<#ffb900ff>1.2秒<> に一度しか発動しません。タワーの攻撃では発動しません。",
        "skill": "<#5ad0e6ff>エンシェント・シード<>: 直線上にツルを放ち、<#a974ffff>115<> の魔法ダメージを与え、命中した敵を <#ffb900ff>2秒<> 間 <#ffb900ff>25%<> スロウにします。<#ffb900ff>1.1秒<> 後に種が同じ軌道上で破裂し、<#a974ffff>115<> の魔法ダメージを与えて <#ffb900ff>1.2秒<> 間 <#ffb900ff>タウント<>します。",
        "skill2": "<#5ad0e6ff>ネイチャーズ・ストライク<>: <#ffb900ff>1秒<> 間移動速度が <#ffb900ff>+60%<>、その後 <#ffb900ff>1秒<> 間 <#ffb900ff>+20%<> 上昇し、<#ffb900ff>3秒<> 間次の通常攻撃を強化します。<#5ad0e6ff>デッドリー・ソーンズ<> が発動するたび、このスキルのクールダウンが <#ffb900ff>1秒<> 短縮されます。",
        "ult": "<#e64a6aff>ドライアドの怒り<>: 外側へ広がるツルを <#ffb900ff>4<> 波にわたって放ち、各波が <#a974ffff>55<> の魔法ダメージを与え、とらえた敵を <#ffb900ff>1.5秒<> 間 <#ffb900ff>タウント<>します。"
      },
      "mlbb_cecilion": {
        "name": "セシリオン",
        "attack": "通常攻撃で遠距離から <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> の物理ダメージを与えます。",
        "passive": "<#5ad0e6ff>オーバーフローイング<>: セシリオンのスキルが敵に命中するたび<#ffb900ff>1<> スタックを得る。これは <#ffb900ff>1 秒<> に 1 回までしか発生しない。スタックごとに <#a974ffff>魔力 +3<> を得て、試合終了まで持続し、デスしても失われない。",
        "skill": "<#5ad0e6ff>バット・インパクト<>: 巨大なコウモリを放ち、通り道の敵に <#a974ffff>30 + 総魔力の 25%<> の魔法ダメージを与える。目的地に到達するとコウモリが急降下し、<#a974ffff>55 + 総魔力の 50%<> の魔法ダメージを与える。",
        "skill2": "<#5ad0e6ff>サングイン・クロウズ<>: 地点を指定する。<#ffb900ff>0.6 秒<> 後、血の爪がその地点に迫り、捕らえた敵に <#a974ffff>60 + 総魔力の 60%<> の魔法ダメージを与え、<#ffb900ff>1 秒<> 間 <#ffb900ff>スタン<>させ、捕らえた敵を中心へ引き寄せる。",
        "ult": "<#e64a6aff>バット・フィースト<>: <#ffb900ff>3 秒<> にわたり <#ffb900ff>40<> の血の矢を放ち、それぞれ付近の敵チャンピオンに <#a974ffff>5 + 総魔力の 8%<> の魔法ダメージを与える。詠唱中も移動でき、<#ffb900ff>1.5 秒<> の間 <#a974ffff>移動速度 +60%<> を得て、矢1本ごとに <#a974ffff>8<> 回復する。"
      },
      "mlbb_johnson": {
        "name": "ジョンソン",
        "attack": "重いレンチを振り回し、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% AD<>の<#ff9028ff>物理ダメージ<>を与える。",
        "passive": "<#5ad0e6ff>エレクトロエアバッグ<>: HPが<#ffb900ff>30%<>を下回ると、<#a974ffff>120 (+物理防御の240%)<>のシールドを<#ffb900ff>10秒<>間獲得する。クールダウン<#ffb900ff>100秒<>。",
        "skill": "<#5ad0e6ff>インパクトレンチ<>: レンチを投げつけ、直線上の敵に<#a974ffff>80 (+物理防御の110%)<>の魔法ダメージを与える。着弾地点付近の敵は<#ffb900ff>0.8秒<>間スタンする。",
        "skill2": "<#5ad0e6ff>電磁波<>: 盾を掲げ、前方の敵に<#a974ffff>40 (+物理防御の45%)<>の魔法ダメージを与え、移動速度と魔法防御を低下させる。最大<#ffb900ff>3<>回までスタックする。",
        "ult": "<#5ad0e6ff>フルスロットル<>: 車に変形する。近くの味方英雄が乗り込む。敵英雄に命中すると爆発し、<#a974ffff>90 (+物理防御の150%~220%)<>の魔法ダメージを与え、走行時間に応じて<#ffb900ff>0.5秒~1秒<>間スタンさせ、電撃地帯を残す。味方を乗せたまま安全な場所へ走ることもできる。"
      },
      "mlbb_angela": {
        "name": "アンジェラ",
        "attack": "ハートの弾を放ち、射程<#ffb900ff>88,000<>で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
        "skill": "<#5ad0e6ff>ラブウェーブ<>：チャージを<#ffb900ff>1つ<>消費し、前方<#ffb900ff>92,000<>まで波を放ちます。敵に<#a974ffff>80 + 魔力の30%<>の魔法ダメージを与え、通過した味方を<#5bd18aff>46<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#5bd18aff>魔力の40%<>回復します。命中した敵は<#5ad0e6ff>恋人の刻印<>を<#ffb900ff>1スタック<>獲得し、<#ffb900ff>3秒<>持続します（最大<#ffb900ff>5<>）。スタックごとに以降の波とS2の最終打撃のダメージが<#ffb900ff>+12%<>増加し、移動速度が<#ffb900ff>6%<>低下します。最大<#ffb900ff>5回<>まで連続で発動でき、最後の発動で<#ffb900ff>5秒<>のクールダウンに入ります。",
        "skill2": "<#5ad0e6ff>パペットストリング<>：射程<#ffb900ff>95,000<>以内の敵を<#ffb900ff>3秒<>繋ぎ止め、<#a974ffff>95 + 魔力の25%<>の魔法ダメージを与え、持続中に移動速度を最大<#ffb900ff>45%<>まで低下させます。終了時に繋がったままであれば、さらに<#a974ffff>140 + 魔力の35%<>のダメージ（<#5ad0e6ff>恋人の刻印<>のスタックで増加）を与え、<#ffb900ff>0.7秒<>拘束します。距離が<#ffb900ff>150,000<>を超えるか、対象が死亡すると糸は切れ、最終打撃は発生しません。",
        "ult": "<#e64a6aff>ハートガード<>：マップ上の味方英雄1体に<#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の180%<>のシールドを<#ffb900ff>6秒<>付与します。アンジェラは姿を消し、<#ffb900ff>12秒<>その味方に憑依して、味方の位置からS1・S2を自動で使用します。頭上に現れる<#5ad0e6ff>人形<>が絆を示します。憑依は宿主の死亡または対象外化で終了し、再使用で即座に解除されます。クールダウン<#ffb900ff>40秒<>。",
        "passive": "<#5ad0e6ff>スマートハート<>：スキルを使用するたびに移動速度を<#ffb900ff>4秒<>獲得します（憑依中は宿主に付与）。最大<#ffb900ff>4スタック<>まで重なり、合計は<#ffb900ff>7%、15%、22%、30%<>。上限で更新しても上限は超えず、使用回数とクールダウンは憑依をまたいで引き継がれます。"
      },
      "mlbb_eudora": {
        "name": "エウドラ",
        "attack": "通常攻撃で雷の弾を放ち、<#ffb900ff>100%<> ADの物理ダメージを与える。",
        "skill": "<#5ad0e6ff>フォークライトニング<>: 扇状の範囲に<#ffb900ff>100<> + <#ffb900ff>55%<> APの魔法ダメージを与える。レーンミニオンにはダメージが<#ffb900ff>2<>倍になる。すでにマークのある敵と最大<#ffb900ff>1<>秒間つながり、<#ffb900ff>4<> + <#ffb900ff>2%<> APのダメージを<#ffb900ff>4<>回与える。接続が続くと最後に<#ffb900ff>100<> + <#ffb900ff>55%<> APのダメージを与える。接続中は移動速度が<#ffb900ff>20%<>増加する。最後の一撃が当たると、このスキルのCDが<#ffb900ff>1.5<>秒短縮される。<#ffb900ff>1<>回の発動につき<#ffb900ff>1<>度のみ。距離が<#ffb900ff>95,000<>を超えると接続が切れる。CD：<#ffb900ff>7<>秒。 初撃は敵チャンピオンに<#a974ffff>120 + 65% AP<>の魔法ダメージを与える。",
        "skill2": "<#5ad0e6ff>ボールライトニング<>: 雷球で対象の魔法防御を<#ffb900ff>1.8<>秒間<#ffb900ff>8<>低下させ、<#ffb900ff>115<> + <#ffb900ff>45%<> APの魔法ダメージと<#ffb900ff>0.8<>秒のスタンを与える。対象にすでにマークがあれば、周囲の敵にも同じ効果が発生する。各敵への命中は<#ffb900ff>1<>回のみ。CD：<#ffb900ff>11<>秒。",
        "ult": "<#e64a6aff>雷霆の怒り<>: 地面の範囲を雷で攻撃し、中心に<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>260 + 110% AP<>、外周に<#ffb900ff>130<> + <#ffb900ff>55%<> APの魔法ダメージを与える。すでにマークのある敵は命中地点に予告を残す。<#ffb900ff>0.6<>秒後、その地点が爆発して<#ffb900ff>160<> + <#ffb900ff>72%<> APの魔法ダメージを与える。同じ発動の爆発が重なっても、各敵への命中は<#ffb900ff>1<>回のみ。CD：<#ffb900ff>32<>秒。",
        "passive": "<#5ad0e6ff>超伝導<>: スキルが敵ヒーローやジャングルモンスターに当たると、<#ffb900ff>5<>秒間のマークを付与する。すでにマークのある敵にはスキルの追加効果が発生する。通常攻撃では付与せず、マークは重複しない。"
      },
      "mlbb_julian": {
        "name": "Julian",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>物理攻撃力100%<>の物理ダメージを与えます。スキル使用後<#ffb900ff>2<>秒間は通常攻撃が<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>物理攻撃力100%<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 55% AP<>の魔法ダメージとなり、対象をJulianの方向へ引き寄せます。",
        "skill": "<#5ad0e6ff>鎌<>：指定方向に鎌を投げ、経路上の敵に<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>155 + 72% AP<>の魔法ダメージを与え、<#ffb900ff>1<>秒間<#ffb900ff>30<>%減速させます。ミニオンは貫通し、ミニオン以外の最初の敵で停止します。強化：<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>215 + 100% AP<>の魔法ダメージを与え、<#ffb900ff>50<>%減速させます。ミニオン以外の敵に当たるか最大射程に達すると、鎌は低速で飛び続け、<#ffb900ff>1.6<>秒間<#ffb900ff>0.1<>秒ごとに範囲内へ<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26 + 11% AP<>の魔法ダメージを与えます。",
        "skill2": "<#5ad0e6ff>剣<>：飛剣を召喚して指定方向へ突進し、経路上の敵に<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 52% AP<>の魔法ダメージを与えます。強化：多数の剣を召喚し、突進中<#ffb900ff>0.1<>秒ごとに<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 14% AP<>の魔法ダメージを最大<#ffb900ff>6<>回与えます。突進中は標的不可かつ透明になり、最果てで再出現します。",
        "ult": "<#e64a6aff>鎖<>：指定位置に鎖を放ちます。<#ffb900ff>0.3<>秒後、<#ffb900ff>18,000<>範囲の敵に<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>112 + 50% AP<>の魔法ダメージを与え、<#ffb900ff>1<>秒間行動不能にします。強化：<#ffb900ff>0.2<>秒ごとに<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12 + 6% AP<>の魔法ダメージを与えて<#ffb900ff>30<>%減速させ、終了時に範囲内に残る敵へ<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>205 + 88% AP<>の魔法ダメージを与えて<#ffb900ff>0.8<>秒間打ち上げます。鎖が未解放の間はコンボ中に自動で使用されます。",
        "passive": "<#5ad0e6ff>鍛冶師の遺産<>：異なるスキルを2回使用すると、残りのスキルが強化されます。強化使用時、3つのスキルすべてが<#ffb900ff>9<>–<#ffb900ff>6<>秒の共有クールダウンに入り、レベルで短縮されます。各スキルは1コンボにつき1回のみ使用でき、未完成のコンボは<#ffb900ff>4<>秒で消滅します。スキルで敵ヒーローに命中すると<#ffb900ff>10<>%のハイブリッド生命吸収を<#ffb900ff>5<>秒得て、最大<#ffb900ff>30<>%まで重複します。"
      },
      "mlbb_popol_kupa": {
        "name": "Popol & Kupa",
        "attack": "Popol throws a spear that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact. Kupa bites nearby enemies for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45% AD<> physical damage, increased to <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75% AD<> in Alpha Wolf Form. Kupa’s ordinary bites use Popol’s basic-attack item effects.",
        "skill": "<#5ad0e6ff>Bite ’em, Kupa!<>: Popol throws a spear for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50 + 50% AD<> physical damage and commands Kupa to bite the target for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60 + 60% AD<> physical damage, <#ef5350ff>slowing<> it by <#ffb900ff>50%<> for <#ffb900ff>1s<>. Alpha Wolf Form: the bite instead deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90 + 75% AD<> physical damage to nearby enemies and knocks them <#ef5350ff>airborne<> for <#ffb900ff>0.6s<>.",
        "skill2": "<#5ad0e6ff>Kupa, Help!<>: Popol gains a <#ffb900ff>90 + 50% AD<> shield for <#ffb900ff>3s<> and calls Kupa back. When Kupa arrives, Popol mounts him for up to <#ffb900ff>1.5s<>, gaining <#ffb900ff>50%<> Movement Speed while Kupa recovers <#ffb900ff>25%<> Max HP over the ride. Attacks, other skills and hard crowd control end the ride. Alpha Wolf Form: the shield increases to <#ffb900ff>140 + 70% AD<> and Kupa fully recovers HP at mount start.",
        "ult": "<#e64a6aff>We Are Angry!<>: Kupa fully recovers HP and enters <#5ad0e6ff>Alpha Wolf Form<> for <#ffb900ff>9s<>, gaining <#ffb900ff>35%<> Max HP and enhancing Bite ’em, Kupa! and Kupa, Help! Cooperative stack bonuses are doubled. Requires a living Kupa.",
        "passive": "<#5ad0e6ff>We Are Friends<>: When Popol and Kupa damage the same enemy within <#ffb900ff>2s<>, both gain <#ffb900ff>5%<> Attack Speed and <#ffb900ff>2%<> Movement Speed for <#ffb900ff>4s<>, stacking up to <#ffb900ff>3<> times. Each paired exchange grants one stack.\nKupa has <#ffb900ff>560 + 80 per level after Lv.1 + 50% of Popol’s bonus Max HP<> HP and inherits Popol’s current Armor, Magic Resist and Attack Speed. After <#ffb900ff>5s<> out of combat, Kupa recovers <#ffb900ff>8%<> Max HP per second. If Kupa falls, Popol begins a stationary <#ffb900ff>3s<> prayer after <#ffb900ff>3s<> without combat; movement, damage or another action interrupts it. Successful revival has a <#ffb900ff>30s<> cooldown.\n<#5ad0e6ff>Popol’s Surprise<>: During combat, Popol automatically places a trap every <#ffb900ff>10s<>, up to <#ffb900ff>2<>. Traps arm after <#ffb900ff>0.5s<> and last <#ffb900ff>15s<>. An enemy triggers <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25 + 20% AD<> physical damage and <#ffb900ff>0.6s<> of <#ef5350ff>immobilization<>, leaving frost for <#ffb900ff>3s<> that <#ef5350ff>slows<> enemies by <#ffb900ff>20%<> and reduces Armor by <#ffb900ff>12%<>. Frost from the same Popol does not stack. Placement pauses during casting, recall, riding and prayer."
      },
      "mlbb_granger": {
        "name": "Granger",
        "attack": "Fires a handgun round that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact.",
        "skill": "<#5ad0e6ff>Rhapsody<>: Locks onto an enemy and fires <#ffb900ff>6<> homing rounds over <#ffb900ff>1.5s<>, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>36 + 45% AD<> physical damage and consuming <#ffb900ff>70<> Gun Energy. Requires more than <#ffb900ff>420<> Gun Energy. Movement Speed increases by <#ffb900ff>10%<> while firing. Each hit reduces Rondo’s cooldown by <#ffb900ff>0.5s<>. The final round gains <#ffb900ff>100%<> Critical Chance for its impact. Rondo and Death Sonata can be used during the barrage.",
        "skill2": "<#5ad0e6ff>Rondo<>: Dashes a short distance and restores <#ffb900ff>15%<> of maximum Gun Energy. Walls and movement-disabling effects stop the dash. Equipment cooldown reduction increases Attack instead of shortening Rondo’s effective cooldown.",
        "ult": "<#5ad0e6ff>Death Sonata<>: Consumes <#ffb900ff>250<> Cannon Energy to fire a homing cannon round at an enemy champion. Impact triggers an explosion, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>155 + 110% AD<> physical damage to nearby enemies and <#ef5350ff>slowing<> them by <#ffb900ff>30%<> for <#ffb900ff>0.6s<>. Granger then rolls a short distance away from the firing direction.",
        "passive": "<#5ad0e6ff>Capriccio<>: Uses separate Gun and Cannon Energy pools, each starting at <#ffb900ff>800<>. Gun Energy regenerates at <#ffb900ff>8%<> of its maximum per second; Cannon Energy regenerates at <#ffb900ff>2%<>. Credited lane-minion kills increase maximum Gun Energy by <#ffb900ff>6<> and restore <#ffb900ff>5%<>; jungle kills grant the same benefit to Cannon Energy. Champion kills and assists increase both maxima by <#ffb900ff>12<> and restore <#ffb900ff>10%<>. Capacity growth persists through death. Equipment cooldown reduction grants <#ffb900ff>0.5<> Attack per percentage point, up to <#ffb900ff>20<> Attack."
      },
      "mlbb_hanzo": {
        "name": "Hanzo",
        "attack": "Strikes for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Attack<> physical damage and applies a mark.",
        "skill": "<#5ad0e6ff>Demon Feast<>: At <#ffb900ff>5 marks<>, bites champions for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200 + 7 per level after Lv.1 + 115% bonus Attack<> physical damage, heals and refunds <#ffb900ff>60%<> cooldown. Ordinary camps are devoured, healing <#66cc66ff>20% maximum Health<>.\n<#5ad0e6ff>Soul Snatch<>: Lunges for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>135 + 6 per level after Lv.1 + 95% bonus Attack<> physical damage, increased <#ffb900ff>24% per mark<> against champions and <#ffb900ff>20% per mark<> against other targets. At <#ffb900ff>5 marks<>, adds damage based on maximum Health and heals.\nCooldown: <#ffb900ff>12s / 10s<>.",
        "skill2": "<#5ad0e6ff>Dark Mist<>: Dashes and gains <#ffb900ff>15% Movement Speed<> for <#ffb900ff>2s<>. Leaves <#ffb900ff>5<> mist pulses.\n<#5ad0e6ff>Black Mist<>: Dashes through walls for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110 + 4 per level + 55% bonus Attack<> physical damage and <#ef5350ff>0.4s airborne<>. Leaves <#ffb900ff>4<> pulses.\nMist deals physical damage every <#ffb900ff>0.5s<>, applies marks and <#ef5350ff>slows 35%<>; it cannot critically strike. Cooldown: <#ffb900ff>10s per form<>.",
        "ult": "Projects Hanekage for up to <#ffb900ff>15s<>, leaving an invulnerable body. Gains <#ffb900ff>35% Movement Speed<>, <#ffb900ff>25% Attack Speed<> and wall traversal, with <#ffb900ff>30% less maximum Health<>.\nRecast returns and heals <#66cc66ff>90 + 50% bonus Attack<>. Empty Energy draws the body to Hanekage. Defeat forces a return to the body, <#ef5350ff>slows Hanzo 50% for 6s<> and sets a <#ffb900ff>52s<> cooldown (normally <#ffb900ff>26s<>).",
        "passive": "Basic attacks and mist hits apply up to <#ffb900ff>5 marks<> for <#ffb900ff>6s<>. New hits refresh them. Hanekage starts with <#ffb900ff>100 Energy<> and spends <#ffb900ff>10 per second<>; hits and nearby deaths restore Energy."
      },
      "mlbb_atlas": {
        "name": "Atlas",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Skill casts create a moving frost aura for <#ffb900ff>4s<> and grant <#66cc66ff>10 armor and magic resistance<>. Nearby enemy champions slow up to <#ef5350ff>25%<> and freeze for <#ef5350ff>0.5s<> after 2s of continuous exposure. Freeze cooldown per target: <#ffb900ff>4s<>.",
        "skill": "Slams three times for <#5ad0e6ff>30 + 10% Magic Power<> magic damage per pulse. The suit also slams while separated. Overlapping hits deal <#5ad0e6ff>45 + 15% Magic Power<> once per pulse. Cooldown: <#ffb900ff>7s<>.",
        "skill2": "Ejects for up to <#ffb900ff>2s<>, gaining <#ffb900ff>25% Movement Speed<> while the suit follows. Reunion deals <#5ad0e6ff>65 + 20% Magic Power<> magic damage and <#ef5350ff>stuns for 0.6s<>. Cooldown: <#ffb900ff>10s<>.",
        "ult": "Links nearby enemy champions for <#5ad0e6ff>35 + 10% Magic Power<> magic damage and <#ef5350ff>30% slow<>. After <#ffb900ff>0.4s<>, Atlas pulls them in for <#5ad0e6ff>105 + 25% Magic Power<> magic damage and <#ef5350ff>0.35s airborne<>. While ejected, reunites immediately with a <#ef5350ff>40% slow<> in place of the reunion hit. Cooldown: <#ffb900ff>34s<>."
      },
      "mlbb_yu_zhong": {
        "name": "Yu Zhong",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage. Soul Grip can empower the next basic attack.",
        "passive": "Basic attacks and direct skill hits apply Sha Residue to enemy heroes and jungle monsters, including Morgard and Serpen, for <#ffb900ff>5s<>. At three marks, the target pulses five times. Each pulse deals <#ff9028ff>32 + 18% Attack + 2% of the target’s missing HP<> as physical damage and heals Yu Zhong for <#66cc66ff>8% of his missing HP<>. Against jungle monsters, the missing-HP damage bonus is capped at 40 per pulse. When the eruption starts, Yu Zhong gains 15% Movement Speed for 1.5s.",
        "skill": "After 0.4s, sweeps nearby enemies for <#ff9028ff>80 + 65% Attack<> physical damage. The outer edge instead deals <#ff9028ff>138 + 95% Attack<> and applies two marks to eligible targets. Cooldown is 7s.",
        "skill2": "Sends a wave that deals <#ff9028ff>95 + 68% Attack<> physical damage and slows by 30% for 1s. On hit, the next basic attack within 3s deals <#ff9028ff>55 + 40% Attack<> extra physical damage and can lunge toward the champion struck by Soul Grip if the route is clear. Hitting a champion at a useful distance triggers Furious Dive if the landing is safe. The leap deals damage on landing and allows one short dash in his movement direction. After 0.4s, the original landing area erupts, knocking enemy champions airborne for 0.5s. Both hits deal a combined <#ff9028ff>64 + 45% Attack<> physical damage. Cooldown is 10s.",
        "ult": "Channels for 0.6s, then flies as a dragon for up to 3.5s with 35% Movement Speed, wall traversal and crowd-control immunity. Passing an enemy hero deals <#ff9028ff>125 + 85% Attack<> physical damage and knocks them back once. On landing, enters Dragonoid Form for 15s, increasing skill reach and width by 20%. Cooldown is 46s."
      }
    },
