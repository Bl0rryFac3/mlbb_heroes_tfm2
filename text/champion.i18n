  "zh-hant": {
    "description": {
      "mlbb_valir": {
        "name": "Valir",
        "attack": "Throws an ember that deals <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Direct spell hits apply Ablaze for <#ffb900ff>3s<>. The burn deals <#5ad0e6ff>0.8% max HP<> magic damage per second. At <#ffb900ff>3 stacks<>, it detonates for <#5ad0e6ff>4% max HP + 25% Magic Power<> magic damage and <#ef5350ff>stuns for 0.65s<>. Stun cooldown per target is <#ffb900ff>8s<>. Monster damage is capped. Bosses are immune to the stun.",
        "skill": "Fires a bolt that deals <#5ad0e6ff>70 + 65% Magic Power<> magic damage and <#ef5350ff>slows by 25% for 0.7s<>. The impact area bursts after <#ffb900ff>0.75s<> for <#5ad0e6ff>42 + 30% Magic Power<> magic damage. Stores <#ffb900ff>2 charges<> and restores one every <#ffb900ff>9s<>. A direct hit on a champion or boss refunds a charge up to once every <#ffb900ff>3.6s<>. Hitting a lane minion takes <#ffb900ff>2s<> off the recharge. Minimum recast is <#ffb900ff>1.8s<>.",
        "skill2": "Sends a wave that deals <#5ad0e6ff>95 + 65% Magic Power<> magic damage and <#ef5350ff>knocks back enemy champions, lane minions and regular jungle monsters<>. While empowered, it leaves a firewall for <#ffb900ff>3s<> that deals <#5ad0e6ff>27 + 22% Magic Power<> magic damage each second and briefly <#ef5350ff>slows by 20%<>. Cooldown is <#ffb900ff>10s<>.",
        "ult": "Can activate automatically when ready to <#ef5350ff>break a stun or other supported disable<>. Suppression still applies. Grants <#ffb900ff>30% Movement Speed<>, tapering over <#ffb900ff>3s<>. Empowers the next <#ffb900ff>4 casts<> within <#ffb900ff>9s<>. Fireball gains <#ffb900ff>30% projectile reach<> and Torrent leaves a firewall. Cooldown is <#ffb900ff>42s<>."
      },
      "mlbb_lesley": {
        "name": "Lesley",
        "attack": "Fires a rifle shot for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "<#5ad0e6ff>Lethal Shot<>. Casting a skill or going 5s without taking damage readies the next basic. It gains <#ffb900ff>17 range<> and deals <#ff9028ff>75 + 110% Attack<> true damage to champions or <#ff9028ff>75 + 125% Attack<> physical damage to lane and jungle enemies. Structures take normal basic damage.",
        "skill": "<#5ad0e6ff>Master of Camouflage<>. Camouflages for up to <#ffb900ff>2.5s<> and gains 30% Movement Speed. Enemies lose direct targeting, but area effects can still hit her. Attacking, casting another skill, or taking damage after the first 0.5s ends camouflage.",
        "skill2": "<#5ad0e6ff>Tactical Grenade<>. Deals <#ff9028ff>115 + 65% Attack<> physical damage in a short cone and pushes surviving enemy champions away. Lesley hops backward if the path is clear. During Ultimate Snipe, she fires an available round before ending the volley.",
        "ult": "<#e64a6aff>Ultimate Snipe<>. Locks onto an enemy champion and fires up to <#ffb900ff>four rounds<>. Each deals <#ff9028ff>70 + 32% Attack + 6% of the target’s missing HP<> as physical damage. Another enemy champion in the firing line can intercept a round."
      },
      "mlbb_aldous": {
        "name": "奧爾德斯",
        "attack": "揮舞熔岩巨拳造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<><#ff9028ff>物理傷害<>。",
        "skill": "<#ff9028ff>契約：奪魂<>：主要目標受到<#ff9028ff>40 + 等級加成 + 100%攻擊力 + 每層奪魂2.5點<>物理傷害；附近敵人受到<#ff9028ff>40%<>濺射傷害。達到<#ffb900ff>1,000<>層時，層數額外提供<#ffb900ff>+2,500<>點原始傷害（護甲減免前）。",
        "skill2": "<#ffb900ff>契約：爆裂<>：展開符文護盾<#ffb900ff>2秒<>（<#ffb900ff>90<>護盾與<#ffb900ff>+25%<>移速），隨後引爆造成<#ff9028ff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<><#ff9028ff>物理傷害<>並<#ef5350ff>眩暈<>周圍敵人<#ffb900ff>1秒<>。",
        "ult": "<#e64a6aff>契約：追命<>：在敵方頭頂凝結<#e64a6aff>命運之眼<>並化作熔岩鑽頭衝撞目標，造成<#ff9028ff>130<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%攻擊力<><#ff9028ff>物理傷害<>與<#ffb900ff>1.2秒<><#ef5350ff>眩暈<>。",
        "passive": "契約·變換：奧杜斯吸取靈魂能量——每<#ffb900ff>5秒<>+1層，擊殺+10層，<#5ad0e6ff>靈魂竊取<>命中時額外獲得（上限<#ffb900ff>1000<>層）。每第<#ffb900ff>3<>次普攻（<#ffb900ff>5秒<>冷卻）將層數轉化為持續<#ffb900ff>2秒<>的護盾，數值為<#ffb900ff>35<>+<#ffb900ff>5<>/級+<#ffb900ff>0.45<>/層。層數同時強化<#5ad0e6ff>靈魂竊取<>。"
      },
      "mlbb_fanny": {
        "name": "芬妮",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>的物理傷害。",
        "skill": "<#ff9028ff>颶風突刺<>：造成<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%攻擊力<>傷害，範圍<#ffb900ff>22,000<>。鋼索飛行時撞到敵人會自動觸發空中颶風突刺，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%攻擊力<>傷害。",
        "skill2": "<#ff9028ff>鋼索<>：向最佳牆體或邊路外牆射出鋼索（射程<#ffb900ff>165,000<>），無能量消耗連續多段盪牆追擊或撤退。優先鎖定可見敵方英雄，無敵方英雄視野時可盪牆清理野怪。",
        "ult": "<#ff9028ff>割喉<>：衝向目標，造成<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125%攻擊力<>傷害；每層獵物印記額外造成<#ff9028ff>35%攻擊力<>（最多2層）。命中後消耗印記。",
        "passive": "<#ff9028ff>空中優勢<>：鋼索飛行時，芬妮根據飛行速度獲得<#ffb900ff>10–25%<>傷害加成。飛行中命中敵方英雄會施加或升級<#ff9028ff>獵物印記<>（最多2層，持續<#ffb900ff>5秒<>），並觸發颶風突刺。"
      },
      "mlbb_lancelot": {
        "name": "藍斯洛特",
        "attack": "普通攻擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>的物理傷害。",
        "skill": "<#ff9028ff>穿刺<>：突進至指定敵人，造成<#ff9028ff>80–178 + 40%攻擊力<>物理傷害。命中的第一個未標記敵人獲得<#5ad0e6ff>劍印<>；施加新劍印會重置穿刺冷卻。每次施放獲得一層<#ffb900ff>靈魂切割<>。",
        "skill2": "<#ffb900ff>刺玫瑰<>：連續攻擊三次，每次造成<#ff9028ff>85–155 + 30%攻擊力<>物理傷害，並使命中的敵人緩速<#ffb900ff>20%<>，持續<#ffb900ff>0.5秒<>。連招期間免疫傷害與控制；多目標重疊命中會受到群體傷害折減。",
        "ult": "<#e64a6aff>幻影處決<>：突進至指定敵方英雄，抵達時造成<#ff9028ff>100–156 + 100%攻擊力<>物理傷害。突進期間免疫傷害與控制，並獲得一層<#ffb900ff>靈魂切割<>。",
        "passive": "<#5ad0e6ff>靈魂切割<>：穿刺和幻影處決會使傷害每層提高<#ffb900ff>7.5%<>，持續<#ffb900ff>4秒<>，最多<#ffb900ff>4層（30%）<>。"
      },
      "mlbb_estes": {
        "name": "埃斯特斯",
        "attack": "普通攻擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>物理傷害。",
        "passive": "<#5ad0e6ff>月精靈之書<>：每秒獲得<#ffb900ff>1<>層充能；連結隊友時每秒獲得<#ffb900ff>2<>層。達到100層後，下次普攻強化，造成<#a974ffff>魔法傷害<>並彈射至最多2名附近敵人，同時緩速40%，持續1.5秒。層數顯示於一技能圖示。",
        "skill": "<#5ad0e6ff>月光浸禮<>：立即為一名友方英雄恢復<#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%法術強度<>生命值，之後每<#ffb900ff>0.5秒<>恢復<#5bd18aff>24<> + <#a974ffff>18%法術強度<>，持續<#ffb900ff>5秒<>。友軍獲得<#ffb900ff>+7<>物理與法術防禦，埃斯特斯獲得<#ffb900ff>+15%<>移速。超過120,000時，視覺連結與被動充能加成停止；資料驅動的持續治療仍會完成。",
        "skill2": "<#5ad0e6ff>月之女神領域<>：放置一個<#5ad0e6ff>固定<>月光區域，持續<#ffb900ff>2.5秒<>。每<#ffb900ff>0.5秒<>對<#ffb900ff>52,000<>範圍內敵人造成<#a974ffff>15<> + <#a974ffff>45%法術強度<>魔法傷害，並緩速<#ffb900ff>35%<>，持續<#ffb900ff>0.75秒<>。此版本在區域內緩速，而非只偵測外圈。",
        "ult": "<#5ad0e6ff>月之女神祝福<>：立即為<#ffb900ff>105,000<>範圍內友軍恢復<#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%法術強度<>；之後每<#ffb900ff>0.5秒<>恢復<#5bd18aff>20<> + <#a974ffff>12%法術強度<>，持續<#ffb900ff>8秒<>，並獲得<#ffb900ff>+8<>物理與法術防禦。"
      },
      "mlbb_gusion": {
        "name": "古辛",
        "attack": "普通攻擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>物理傷害。",
        "passive": "<#5ad0e6ff>匕首專精<>：每次施放技能獲得<#ffb900ff>1<>層符文，最多<#ffb900ff>4<>層。下次普攻消耗全部符文；每層造成目標最大生命值<#a974ffff>3%<>的魔法傷害，並回復<#5bd18aff>50 + 25%法術強度<>生命值。",
        "skill": "<#5ad0e6ff>劍鋒<>：投擲匕首，對首個命中的敵人造成<#a974ffff>200 + 50%總魔法強度<>魔法傷害並標記<#ffb900ff>5秒<>。再次施放可突進至標記目標身後，造成<#a974ffff>200 + 100%總魔法強度<>魔法傷害。",
        "skill2": "<#a974ffff>幻影劍舞<>：扇形投出<#ffb900ff>5把匕首<>，每把命中造成<#a974ffff>65 + 40%總魔法強度<>魔法傷害。再次施放召回匕首。大招刷新後可再投一組，並在下次施放技能2時一併召回。",
        "ult": "<#e64a6aff>刀鋒衝擊<>：突進至所選敵人身後並刷新技能1、2。若技能2匕首仍在場，可再投一組；再次施放技能2會召回兩組。<#ffb900ff>2.5秒<>內可再次突進。"
      },
      "mlbb_karrie": {
        "name": "凱莉",
        "attack": "普通攻擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>的<#ff9028ff>物理傷害<>，使用單個光輪。",
        "passive": "<#5ad0e6ff>光輪印記<>：普通攻擊、技能1和技能2施加<#ffb900ff>1層印記<>。達到<#ffb900ff>5層<>後爆發，造成目標最大生命值的<#ff9028ff>4%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10%攻擊力<>的<#e64a6aff>真實傷害<>；對英雄上限<#ffb900ff>250<>，對野怪／史詩野怪上限<#ffb900ff>300<>。",
        "skill": "<#5ad0e6ff>旋轉光輪<>：向指定方向投出環形光輪。命中時對主要目標造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%攻擊力<>物理傷害，並對附近非防禦塔敵人造成<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35%攻擊力<>物理傷害，使其減速<#ffb900ff>35%<>，持續<#ffb900ff>1秒<>。命中後留下紫色減速區域，持續<#ffb900ff>1.5秒<>；區域內敵人會再次受到<#ffb900ff>35%<>減速，並每隔<#ffb900ff>0.5秒<>受到一次<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10%攻擊力<>物理傷害，共兩次。區域脈衝不會額外施加光輪印記。",
        "skill2": "<#5ad0e6ff>幻步<>：朝指定位置衝刺固定距離，接著向落點附近最近的有效敵人發射光輪。造成<#ff9028ff>75 + 70%總物理攻擊<>傷害；迅捷光輪期間係數提高至<#ff9028ff>100%<>，並施加<#ffb900ff>1層光輪印記<>。",
        "ult": "<#e64a6aff>迅捷光輪<>：持續<#ffb900ff>6秒<>，獲得<#ffb900ff>+20%移動速度<>與<#ffb900ff>+35%攻擊速度<>。持續期間，幻步造成<#ff9028ff>75 + 100%總物理攻擊<>傷害。"
      },
      "mlbb_uranus": {
        "name": "烏瑞納斯",
        "attack": "普通攻擊以手臂揮擊造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>物理傷害<>。普通攻擊<#ffb900ff>不會<>施加離子之刃印記。",
        "passive": "<#5ad0e6ff>光輝<>：受到傷害時獲得<#ffb900ff>1層<>，最多<#ffb900ff>12層<>，每層持續<#ffb900ff>10秒<>，每<#ffb900ff>1秒<>最多獲得1層。每<#ffb900ff>0.8秒<>恢復生命；12層時恢復<#5bd18aff>28–134生命值<>，隨等級成長。",
        "skill": "<#5ad0e6ff>離子之刃<>：釋放兩枚能量刃，向外飛出後返回；每次命中造成<#a974ffff>79–131（+18%總魔法強度）<>魔法傷害，並使敵人<#ffb900ff>減速30%<>，持續<#ffb900ff>2秒<>。每枚刀刃對同一目標最多命中一次。每次施放對每個目標最多施加<#ffb900ff>1層離子印記<>，持續<#ffb900ff>6秒<>；每層使後續技能1傷害提高<#ffb900ff>20%<>，最多<#ffb900ff>8層<>；防禦塔與水晶不會獲得印記。",
        "skill2": "<#5ad0e6ff>超然護盾<>：衝向指定位置。路徑上的敵人受到<#a974ffff>48–120（+12%總魔法強度）<>魔法傷害；終點附近敵人受到<#a974ffff>96–240（+48%總魔法強度）<>並減速<#ffb900ff>25%<>。獲得<#5bd18aff>300–750（+200%總魔法強度）<>護盾，持續<#ffb900ff>4秒<>；護盾破裂或結束時，對附近造成<#a974ffff>156–390（+78%總魔法強度）<>魔法傷害。",
        "ult": "<#e64a6aff>奉獻<>：移除<#ef5350ff>所有控制效果<>（TFM2實作；原版僅移除緩速），恢復<#5bd18aff>200–400生命值<>並獲得<#ffb900ff>60%移速<>，持續<#ffb900ff>8秒<>且逐漸衰減。增加<#ffb900ff>5–12層光輝<>。持續<#ffb900ff>8秒<>，生命回復與烏瑞納斯自身的超然護盾提高<#ffb900ff>20%<>。"
      },
      "mlbb_chou": {
        "name": "周",
        "attack": "普通攻擊造成100%物理攻擊的物理傷害。",
        "passive": "<#5ad0e6ff>迅捷<>：移動約<#ffb900ff>42,000<>個TFM2世界單位後，下一次普攻造成<#ff9028ff>180%物理攻擊<>的物理傷害，使目標緩速<#ffb900ff>80%<>持續<#ffb900ff>1秒<>，並降低<#ffb900ff>10<>點物理防禦，持續<#ffb900ff>2秒<>，最多<#ffb900ff>2<>層。距離依TFM2地圖比例調整。",
        "skill": "<#ff9028ff>截拳道<>：最多施放<#ffb900ff>3<>次：上踢、突進上勾踢，最後躍起下砸並擊飛敵人。每次命中造成<#ff9028ff>100–165 + 45%總物理攻擊<>傷害。前兩次施放會重置技能以繼續連招；第三次後進入冷卻。第三次施放命中敵方英雄時重置瞬步的冷卻時間。",
        "skill2": "<#5ad0e6ff>瞬步<>：朝指定方向突進，突進期間獲得<#ffb900ff>控制免疫<>。抵達後獲得護盾，數值為<#5bd18aff>200–300 + 100%額外物理攻擊<>，並獲得<#ffb900ff>15<>點物理穿透，持續<#ffb900ff>2.5秒<>。",
        "ult": "<#e64a6aff>龍之道<>：迴旋踢擊敵方英雄，造成<#ff9028ff>275–420 + 110%額外物理攻擊<>傷害並將其擊退。若同一目標仍在追擊範圍內，周會追上並在抵達後連續攻擊四次，共造成<#ff9028ff>330–500 + 132%額外物理攻擊<>物理傷害。"
      },
      "mlbb_zhask": {
        "name": "澤斯",
        "attack": "發射暗影彈，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "passive": "<#5ad0e6ff>滅絕<>：澤斯陣亡時，會在死亡位置召喚狂暴的靈體，最多持續<#ffb900ff>6秒<>，每秒失去<#ffb900ff>2%<>最大生命值。",
        "skill": "<#5ad0e6ff>夢魘之靈<>：召喚一個固定位置的靈體，最多持續<#ffb900ff>12秒<>。靈體依等級繼承澤斯<#ffb900ff>55–100%<>的生命值、防禦與魔法強度。死亡射線每<#a974ffff>15個刻（0.25秒）<>命中一次，造成<#a974ffff>30（+25%魔法強度）<>魔法傷害，並緩速<#ffb900ff>30%<>，持續<#ffb900ff>36個刻（0.6秒）<>。再次瞄準可重新安置靈體；若澤斯離開<#ffb900ff>120,000<>單位範圍，射線會暫停，直到他返回。",
        "skill2": "<#5ad0e6ff>心靈吞噬<>：朝指定方向發射穿透彈，對路徑上的敵人造成<#a974ffff>87 + 每高於1級增加6（+60%魔法強度）<>魔法傷害。若靈體存活，它會追擊每個命中的敵人，造成<#a974ffff>35（+50%魔法強度）<>傷害並暈眩<#ffb900ff>30個刻（0.5秒）<>。",
        "ult": "<#e64a6aff>主宰降臨<>：傳送至目標位置並召喚融合靈體，最多持續<#ffb900ff>10秒<>。融合期間澤斯會被放逐、無法被選取且不能操作。融合靈體繼承澤斯100%的屬性；死亡射線傷害提高至<#ffb900ff>×1.8<>。"
      },
      "mlbb_hanabi": {
        "name": "花火",
        "attack": "普通攻擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>物理傷害。",
        "passive": "<#5ad0e6ff>忍術·花瓣彈幕<>：普通攻擊與技能命中後發射花瓣刃，在附近敵人間彈射。花火擁有<#ffb900ff>任何來源的護盾<>時免疫控制效果；不會移除已生效的控制。",
        "skill": "<#5ad0e6ff>忍術·陰陽<>：獲得<#ff9028ff>120 + 35%攻擊力<>的護盾，持續<#ffb900ff>5秒<>，並獲得<#ffb900ff>12%移動速度<>與<#ffb900ff>20%攻擊速度<>。護盾持續期間，對英雄造成傷害的<#ffb900ff>20%<>、對其他單位造成傷害的<#ffb900ff>10%<>會轉化為護盾。護盾上限為<#ffb900ff>最大生命值的50%<>；此版本會將所有護盾層一併計入上限。任何護盾也會觸發被動的控制免疫。",
        "skill2": "<#5ad0e6ff>忍術·靈紙<>：發射可穿透的苦無與卷軸，對路徑上的敵人造成<#ff9028ff>65 + 75%攻擊力<>物理傷害，並使其減速<#ffb900ff>30%<>，持續<#ffb900ff>1秒<>。命中的敵人會被標記<#ffb900ff>5秒<>。花火下一次普通攻擊花瓣彈射命中被標記目標時，額外造成<#ff9028ff>20 + 50%攻擊力<>傷害，不受一般彈射衰減影響，隨後消耗該標記。",
        "ult": "<#e64a6aff>禁術·彼岸花<>：投出大型彼岸花，命中首個敵方英雄時造成<#ff9028ff>150 + 80%攻擊力<>物理傷害並束縛<#ffb900ff>0.8秒<>。<#ffb900ff>0.8秒<>後於該位置綻放，對<#ffb900ff>34,000<>範圍內敵人造成<#ff9028ff>105 + 55%攻擊力<>物理傷害；其他命中的敵人減速<#ffb900ff>20%<>，持續<#ffb900ff>0.6秒<>。"
      },
      "mlbb_alpha": {
        "name": "Alpha",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>的物理傷害。",
        "passive": "<#5ad0e6ff>貝塔，前進！<> 對敵方英雄的每第三次有效命中召喚貝塔發射雷射，造成30 + 1級後每級3 + 15%攻擊力的物理傷害，並緩速30%，持續1秒。",
        "skill": "<#5ad0e6ff>迴旋衝擊<> 發射能量波，造成70 + 80%攻擊力的物理傷害，並緩速40%，持續1秒。貝塔追擊造成25 + 1級後每級1 + 20%攻擊力的真實傷害。",
        "skill2": "<#5ad0e6ff>強力揮擊<> 向前橫掃，造成100 + 80%攻擊力的物理傷害。貝塔追擊造成25 + 1級後每級1 + 20%攻擊力的真實傷害。每次施放回復100 + 20%攻擊力的生命值。",
        "ult": "<#e64a6aff>阿爾法之矛<> 貝塔俯衝造成70 + 20%攻擊力的物理傷害並暈眩1秒。阿爾法落地造成130 + 80%攻擊力的物理傷害，擊飛0.67秒並緩速30%，持續1.25秒。貝塔再攻擊5次，每次造成8 + 10%攻擊力的物理傷害。"
      },
      "mlbb_arlott": {
        "name": "阿爾洛特",
        "attack": "普通攻擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>物理傷害。",
        "passive": "<#5ad0e6ff>惡魔凝視<>：每<#ffb900ff>7秒<>標記最近的敵方英雄，被阿爾洛特控制效果命中的敵人也會被標記。被<#e64a6aff>標記<>的目標會受到復仇的雙倍效果。標記持續<#ffb900ff>7秒<>。",
        "skill": "<#5ad0e6ff>無畏突刺<>：長槍下劈，對一條直線上的敵人造成<#ff9028ff>110 + 55%總物理攻擊<>物理傷害並暈眩。目標<#ffb900ff>越遠<>，暈眩<#ffb900ff>越長<>——近身為<#ffb900ff>0.5秒<>，最遠可達<#ffb900ff>1秒<>。劈砍會標記被其控制的敵人。",
        "skill2": "<#5ad0e6ff>復仇<>：向敵人突進，造成<#ff9028ff>100 + 55%總物理攻擊<>物理傷害，並以控制效果標記目標。突進期間阿爾洛特<#ffb900ff>不會被打斷<>。對<#e64a6aff>標記<>目標造成<#ffb900ff>雙倍<>傷害、<#ffb900ff>刷新自身冷卻<>，並回復<#ffb900ff>30%總物理攻擊<>的生命值（對非英雄單位減半）。",
        "ult": "<#e64a6aff>終結斬<>：雙槍橫掃，造成<#ff9028ff>160 + 75%總物理攻擊<>物理傷害，並將所有敵人<#ffb900ff>拖曳<>至阿爾洛特的<#ffb900ff>右側<>。每個被拖曳的敵人都會被<#e64a6aff>標記<>。"
      },
      "mlbb_franco": {
        "name": "弗蘭克",
        "attack": "揮舞戰錘造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>物理傷害<>。",
        "skill": "<#5ad0e6ff>鐵鉤<>：擲出鐵鉤，鉤住命中的第一個敵人，造成 <#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>物理傷害<>並將其拖向弗蘭克。鐵鉤先<#ef5350ff>暈眩<>，再拉拽——即使目標無法被拖動，也會被定住。",
        "skill2": "<#5ad0e6ff>狂怒震懾<>：揮擊四周，對附近敵人造成 <#ff9028ff>160<> + 自身<#ffb900ff>最大生命值<>的 <#ff9028ff>4%<> 的 <#ff9028ff>物理傷害<>，並使其<#ffb900ff>減速<> <#ffb900ff>70%<>，持續 <#ffb900ff>1.5秒<>。可對野怪與遠古生物釋放。移動中可施放。",
        "ult": "<#e64a6aff>血獵<>：<#ef5350ff>壓制<>一名敵方英雄 <#ffb900ff>1.8秒<>，期間攻擊 <#ffb900ff>六<> 次，戰錘與鐵鉤交替，每次造成 <#ff9028ff>50<> + <#ff9028ff>70% AD<> 傷害。若弗蘭克被控制，技能會提前結束。",
        "passive": "<#5ad0e6ff>荒原之力<>：<#ffb900ff>5秒<>內未受到傷害後，弗蘭克獲得 <#ffb900ff>10%<> 移動速度、每秒回復 <#ffb900ff>1%<> 最大生命值，並最多累積 <#ffb900ff>10<> 層。下一次技能將消耗全部層數，最多提升 <#ffb900ff>+150%<> 技能傷害。"
      },
      "mlbb_balmond": {
        "name": "巴蒙德",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻擊力<>的物理傷害。",
        "passive": "<#5ad0e6ff>嗜血<>：擊殺小兵或野怪後恢復<#ffb900ff>5%<>最大生命值，擊殺或助攻英雄後恢復<#ffb900ff>10%<>。",
        "skill": "<#5ad0e6ff>靈魂鎖定<>：衝向選定的敵方英雄，沿直線對沿途敵人造成<#ff9028ff>150–275 + 60%總物理攻擊<>物理傷害。被擊中的英雄會被短暫擊退並減速<#ffb900ff>40%<>，持續<#ffb900ff>3秒<>。TFM2原型改為瞄準位置衝刺；保留直線路徑傷害，抵達後對最近的敵方英雄造成傷害。",
        "skill2": "<#5ad0e6ff>旋風掃擊<>：旋轉<#ffb900ff>3秒<>，共造成14段傷害。每段造成<#ff9028ff>24–44 + 1.3%總生命值 + 25%總物理攻擊<>物理傷害，並使目標的物理防禦降低<#ffb900ff>5%<>，最多<#ffb900ff>8層<>。持續期間獲得<#ffb900ff>15%<>移動速度。",
        "ult": "<#e64a6aff>致命反擊<>：對前方大範圍造成<#ff9028ff>150 + 70%總物理攻擊 + 每個目標已損失生命值的30–45%<>真實傷害。對非英雄單位的傷害上限為<#ffb900ff>1,000 / 1,500 / 2,000<>（按英雄等級段）。"
      },
      "mlbb_obsidia": {
        "name": "奧布西迪亞",
        "attack": "普通攻擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 65%物理攻擊<>物理傷害。",
        "passive": "<#5ad0e6ff>歸骨<>：傷害敵人會獲得骨能——對敵方英雄普攻<#ffb900ff>2<>點，技能命中<#ffb900ff>4<>點，攻擊小兵或防禦塔<#ffb900ff>1<>點。野怪不提供骨能。每<#ffb900ff>30<>點骨能鑄就一枚骨片，最多<#ffb900ff>25<>枚。每枚骨片使其普攻額外造成總物理攻擊<#ffb900ff>7%<>的傷害。擊殺敵方英雄立即獲得一枚骨片。",
        "skill": "<#5ad0e6ff>深淵骨針<>：沿直線射出一根骨針，對命中的敵人造成<#ff9028ff>90–140 + 60%總物理攻擊<>物理傷害，並對第一個被命中的敵方英雄給予骨能。",
        "skill2": "<#5ad0e6ff>幻影影遁<>：沉入深淵，向目標方向突進，並獲得<#ffb900ff>+20%移動速度<>，持續<#ffb900ff>0.3秒<>。",
        "ult": "<#e64a6aff>獵骨<>：射出憤怒之骨，造成<#ff9028ff>55 + 50%總物理攻擊<>物理傷害，短暫<#ffb900ff>眩暈<>第一個被命中的敵方英雄，並<#ffb900ff>將自身拉至其附近<>。束縛其<#ffb900ff>3秒<>：自身無法離開超過<#ffb900ff>4個單位<>，敵人無法使用位移技能，敵人移動時會拖動自身。獲得<#ffb900ff>5枚臨時骨片<>（可超過上限）、一層<#ffb900ff>護盾<>與<#ffb900ff>+30%攻擊速度<>。期間可穿越障礙並邊移動邊普攻，幻影影遁持續<#ffb900ff>1秒<>。"
      },
      "mlbb_gord": {
        "name": "戈爾",
        "attack": "普通攻擊造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻擊<> 的物理傷害，射程較遠。",
        "passive": "<#5ad0e6ff>神秘恩賜<>：以技能命中敵人 <#ffb900ff>3<> 次後，下一次技能命中將額外造成 <#a974ffff>12（每級 +2）（+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>8% 魔法力量）真實傷害<>，並使目標緩速 <#ffb900ff>20%<>，持續 <#ffb900ff>1 秒<>。緩速最多疊加 <#ffb900ff>2<> 層，最高 <#ffb900ff>40%<>。",
        "skill": "<#5ad0e6ff>神秘飛彈<>：發射一顆能量球，命中第一個敵人後停下並爆裂，造成 <#a974ffff>105 + 52% 魔法力量<> 的魔法傷害，並 <#ffb900ff>暈眩<> 目標 <#ffb900ff>1 秒<>。",
        "skill2": "<#5ad0e6ff>神秘禁制<>：在指定位置創造一片能量場，持續 <#ffb900ff>4 秒<>，每 <#ffb900ff>0.25 秒<> 造成 <#a974ffff>6 + 12% 魔法力量<> 的魔法傷害，最多 <#ffb900ff>16<> 次。",
        "ult": "<#e64a6aff>神秘噴湧<>：引導一道能量光束，持續 <#ffb900ff>3.2 秒<>，每 <#ffb900ff>0.2 秒<> 造成 <#a974ffff>12 + 17% 魔法力量<> 的魔法傷害，最多 <#ffb900ff>16<> 次。每一道波都會重新鎖定身前最近的敵方英雄。"
      },
      "mlbb_belerick": {
        "name": "貝拉里克",
        "attack": "普通攻擊造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻擊<> 的物理傷害。<#5ad0e6ff>自然之擊<> 強化期間，改為造成 <#a974ffff>60<> 的法術傷害，恢復 <#ffb900ff>150 + 12% 已損失生命值<> 的生命，並使目標緩速 <#ffb900ff>60%<>，持續 <#ffb900ff>1.4 秒<>。",
        "passive": "<#5ad0e6ff>致命荊棘<>：貝拉里克每被命中 <#ffb900ff>4<> 次，便向最近的敵人射出一根荊棘，造成 <#a974ffff>10（每級 +1）+ 1% 最大生命值<> 的法術傷害。低於 <#ffb900ff>10<> 點的傷害不計入，每 <#ffb900ff>1.2 秒<> 最多觸發一次，防禦塔不會觸發。",
        "skill": "<#5ad0e6ff>遠古之種<>：沿直線釋放藤蔓，造成 <#a974ffff>115<> 的法術傷害，並使被命中的敵人緩速 <#ffb900ff>25%<>，持續 <#ffb900ff>2 秒<>。<#ffb900ff>1.1 秒<> 後種子在同一路徑上爆裂，再次造成 <#a974ffff>115<> 的法術傷害，並 <#ffb900ff>嘲諷<> 目標 <#ffb900ff>1.2 秒<>。",
        "skill2": "<#5ad0e6ff>自然之擊<>：獲得 <#ffb900ff>+60%<> 移動速度，持續 <#ffb900ff>1 秒<>，隨後 <#ffb900ff>+20%<>，持續 <#ffb900ff>1 秒<>，並強化下一次普通攻擊，持續 <#ffb900ff>3 秒<>。每次 <#5ad0e6ff>致命荊棘<> 觸發，該技能冷卻時間減少 <#ffb900ff>1 秒<>。",
        "ult": "<#e64a6aff>樹妖之怒<>：召喚向外蔓延的藤蔓，分 <#ffb900ff>4<> 波，每波造成 <#a974ffff>55<> 的法術傷害，並 <#ffb900ff>嘲諷<> 被命中的敵人 <#ffb900ff>1.5 秒<>。"
      },
      "mlbb_cecilion": {
        "name": "塞西利翁",
        "attack": "普通攻擊造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻擊<>的遠程物理傷害。",
        "passive": "<#5ad0e6ff>滿溢<>：塞西利翁的技能每次命中敵人，便獲得 <#ffb900ff>1<> 層滿溢，每 <#ffb900ff>1 秒<>最多觸發一次。每層為他提供 <#a974ffff>+3 魔法力量<>，持續整場對局，且死亡後層數保留。",
        "skill": "<#5ad0e6ff>蝙蝠衝擊<>：放出一隻巨大的蝙蝠，對路徑上的敵人造成 <#a974ffff>30 + 25% 總魔法力量<>的魔法傷害。抵達終點時蝙蝠俯衝，造成 <#a974ffff>55 + 50% 總魔法力量<>的爆發魔法傷害。",
        "skill2": "<#5ad0e6ff>血腥之爪<>：標記一處地點。<#ffb900ff>0.6 秒<>後血爪收攏，對被捲入的敵人造成 <#a974ffff>60 + 60% 總魔法力量<>的魔法傷害，並<#ffb900ff>暈眩<><#ffb900ff>1 秒<>，並將被捲入的敵人拉向標記中心。",
        "ult": "<#e64a6aff>蝠群盛宴<>：在 <#ffb900ff>3 秒<>內釋放 <#ffb900ff>40<> 道血箭，每道對附近的敵方英雄造成 <#a974ffff>5 + 8% 總魔法力量<>的魔法傷害；施法期間可以移動，<#ffb900ff>1.5 秒<>內獲得 <#a974ffff>+60% 移動速度<>，每道血箭為其恢復 <#a974ffff>8<> 點生命。"
      },
      "mlbb_johnson": {
        "name": "強森",
        "attack": "揮動重型扳手,造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% 物理攻擊<>的<#ff9028ff>物理傷害<>。",
        "passive": "<#5ad0e6ff>電子安全氣囊<>: 生命值低於<#ffb900ff>30%<>時獲得<#a974ffff>120 (+240% 總物理防禦)<>的護盾,持續<#ffb900ff>10秒<>。冷卻<#ffb900ff>100秒<>。",
        "skill": "<#5ad0e6ff>衝擊扳手<>: 投擲扳手,對路徑上的敵人造成<#a974ffff>80 (+110% 總物理防禦)<>魔法傷害。落點附近的敵人被暈眩<#ffb900ff>0.8秒<>。",
        "skill2": "<#5ad0e6ff>電磁波<>: 舉起盾牌,對身前敵人造成<#a974ffff>40 (+45% 總物理防禦)<>魔法傷害,並降低其移動速度與魔法防禦。最多疊加<#ffb900ff>3<>層。",
        "ult": "<#5ad0e6ff>全速前進<>: 變身為賽車,附近友方英雄可上車。撞到敵方英雄時爆炸,造成<#a974ffff>90 (+150% 至 +220% 總物理防禦)<>魔法傷害,按行駛時間暈眩<#ffb900ff>0.5秒至1秒<>,並留下電磁區域。也可載著隊友駛向安全地帶。"
      },
      "mlbb_angela": {
        "name": "安琪拉",
        "attack": "發射心形飛彈，在<#ffb900ff>88,000<>射程內造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻擊<>的物理傷害。",
        "skill": "<#5ad0e6ff>愛意波動<>：消耗<#ffb900ff>1層<>充能，向前方<#ffb900ff>92,000<>釋放波動，對敵人造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術攻擊的30%<>法術傷害，並為經過的友方回復<#5bd18aff>46<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#5bd18aff>法術攻擊的40%<>生命。被命中的敵人獲得<#ffb900ff>1層<><#5ad0e6ff>戀人印記<>，持續<#ffb900ff>3秒<>（最多<#ffb900ff>5層<>），每層使後續波動與S2最終一擊的傷害提高<#ffb900ff>+12%<>，並降低<#ffb900ff>6%<>移動速度。最多可連續施放<#ffb900ff>5次<>，最後一次施放後進入<#ffb900ff>5秒<>冷卻。",
        "skill2": "<#5ad0e6ff>傀儡之線<>：牽連<#ffb900ff>95,000<>射程內的一名敵人<#ffb900ff>3秒<>，造成<#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術攻擊的25%<>法術傷害，並在持續期間最多降低其<#ffb900ff>45%<>移動速度。結束時若仍相連，則額外造成<#a974ffff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術攻擊的35%<>傷害（受<#5ad0e6ff>戀人印記<>層數提高），並<#ffb900ff>束縛0.7秒<>。相距超過<#ffb900ff>150,000<>或目標死亡則連線中斷，不會造成最終傷害。",
        "ult": "<#e64a6aff>真心守護<>：為全圖任意一名友方英雄提供<#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法術攻擊的180%<>護盾，持續<#ffb900ff>6秒<>。安琪拉隨之消失並在<#ffb900ff>12秒<>內附身於該友方，從其位置自動施放S1與S2，其頭頂的<#5ad0e6ff>人偶<>標示羈絆。宿主死亡或無法被選取時提前結束，再次施放可立即解除。冷卻<#ffb900ff>40秒<>。",
        "passive": "<#5ad0e6ff>靈心<>：每次施放技能獲得移動速度，持續<#ffb900ff>4秒<>；附身期間該加成歸於宿主。最多疊加<#ffb900ff>4層<>，合計<#ffb900ff>7%、15%、22%、30%<>。達到上限後刷新不會超過上限，使用次數與冷卻會跨附身保留。"
      },
      "mlbb_eudora": {
        "name": "尤朵拉",
        "attack": "普攻發射閃電，造成<#ffb900ff>100%<> AD物理傷害。",
        "skill": "<#5ad0e6ff>叉狀閃電<>: 以扇形閃電造成<#ffb900ff>100<> + <#ffb900ff>55%<> AP魔法傷害，對兵線小兵傷害加倍。已有標記的敵人會被連接最多<#ffb900ff>1<>秒，承受<#ffb900ff>4<>次<#ffb900ff>4<> + <#ffb900ff>2%<> AP傷害；連接維持至結束時，再造成<#ffb900ff>100<> + <#ffb900ff>55%<> AP傷害。連接期間，尤朵拉獲得<#ffb900ff>20%<>移速。終結命中使本技能冷卻減少<#ffb900ff>1.5<>秒，每次施放僅觸發一次。距離超過<#ffb900ff>95,000<>時連接中斷。冷卻：<#ffb900ff>7<>秒。 首擊對敵方英雄造成<#a974ffff>120 + 65%<> AP魔法傷害。",
        "skill2": "<#5ad0e6ff>雷電法球<>: 發射雷球，使目標魔抗降低<#ffb900ff>8<>點，持續<#ffb900ff>1.8<>秒，並造成<#ffb900ff>115<> + <#ffb900ff>45%<> AP魔法傷害及<#ffb900ff>0.8<>秒暈眩。若目標已有標記，附近敵人也受到相同效果。每個敵人僅命中一次。冷卻：<#ffb900ff>11<>秒。",
        "ult": "<#e64a6aff>雷霆之怒<>: 轟擊地面區域，中心造成<#ffb900ff>260<> + <#ffb900ff>110%<> AP魔法傷害，外環造成<#ffb900ff>130<> + <#ffb900ff>55%<> AP傷害，兩者不疊加。已有標記的敵人在命中位置留下預警，<#ffb900ff>0.6<>秒後爆炸，造成<#ffb900ff>160<> + <#ffb900ff>72%<> AP魔法傷害。同次施放的重疊爆炸對每個敵人僅命中一次。冷卻：<#ffb900ff>32<>秒。",
        "passive": "<#5ad0e6ff>超導<>: 技能命中敵方英雄及野怪時施加<#ffb900ff>5<>秒標記。技能對已有標記的敵人產生額外效果。普攻不施加標記，標記不疊層。"
      },
      "mlbb_julian": {
        "name": "Julian",
        "attack": "普通攻擊造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻擊<>的物理傷害。施放技能後<#ffb900ff>2<>秒內，普通攻擊改為造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻擊<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 55% AP<>魔法傷害，並將目標拉向Julian。",
        "skill": "<#5ad0e6ff>鐮刀<>：向指定方向擲出鐮刀，對路徑上的敵人造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>155 + 72% AP<>魔法傷害並使其減速<#ffb900ff>30<>%，持續<#ffb900ff>1<>秒。鐮刀會穿透小兵，並在第一個非小兵敵人處停止。強化：造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>215 + 100% AP<>魔法傷害，減速提升至<#ffb900ff>50<>%。在首個非小兵敵人處或達到最大距離後，鐮刀會以較低速度繼續飛行，在區域內每<#ffb900ff>0.1<>秒造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26 + 11% AP<>魔法傷害，持續<#ffb900ff>1.6<>秒，可反覆命中同一敵人。",
        "skill2": "<#5ad0e6ff>飛劍<>：召喚飛劍並向指定方向突進，對路徑上的敵人造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 52% AP<>魔法傷害。強化：召喚大量飛劍，突進途中每<#ffb900ff>0.1<>秒造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 14% AP<>魔法傷害，最多<#ffb900ff>6<>次。突進期間Julian無法被選中且隱身，隨後在最遠端現身。",
        "ult": "<#e64a6aff>鎖鏈<>：在指定位置施放鎖鏈。<#ffb900ff>0.3<>秒後對<#ffb900ff>18,000<>單位範圍內的敵人造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>112 + 50% AP<>魔法傷害並禁錮<#ffb900ff>1<>秒。強化：每<#ffb900ff>0.2<>秒造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12 + 6% AP<>魔法傷害並減速<#ffb900ff>30<>%，結束時仍在範圍內的敵人額外受到<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>205 + 88% AP<>魔法傷害並被擊飛<#ffb900ff>0.8<>秒。鎖鏈尚未解鎖時，Julian會在連招中自動施放。",
        "passive": "<#5ad0e6ff>鐵匠的遺產<>：施放兩個不同技能後，Julian會強化剩餘技能。強化施放後，三個技能共同進入<#ffb900ff>9<>–<#ffb900ff>6<>秒冷卻，冷卻隨等級降低。每個技能每套連招只能使用一次；未完成的連招在<#ffb900ff>4<>秒後失效。技能命中敵方英雄可獲得<#ffb900ff>10<>%混合吸血，持續<#ffb900ff>5<>秒，最多疊加<#ffb900ff>30<>%。同一次施放重複命中只計一層。"
      },
      "mlbb_popol_kupa": {
        "name": "Popol & Kupa",
        "attack": "Popol throws a spear that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact. Kupa bites nearby enemies for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45% AD<> physical damage, increased to <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75% AD<> in Alpha Wolf Form. Kupa’s ordinary bites use Popol’s basic-attack item effects.",
        "skill": "<#5ad0e6ff>Bite ’em, Kupa!<>: Popol throws a spear for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50 + 50% AD<> physical damage and commands Kupa to bite the target for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60 + 60% AD<> physical damage, <#ef5350ff>slowing<> it by <#ffb900ff>50%<> for <#ffb900ff>1s<>. Alpha Wolf Form: the bite instead deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90 + 75% AD<> physical damage to nearby enemies and knocks them <#ef5350ff>airborne<> for <#ffb900ff>0.6s<>.",
        "skill2": "<#5ad0e6ff>Kupa, Help!<>: Popol gains a <#ffb900ff>90 + 50% AD<> shield for <#ffb900ff>3s<> and calls Kupa back. When Kupa arrives, Popol mounts him for up to <#ffb900ff>1.5s<>, gaining <#ffb900ff>50%<> Movement Speed while Kupa recovers <#ffb900ff>25%<> Max HP over the ride. Attacks, other skills and hard crowd control end the ride. Alpha Wolf Form: the shield increases to <#ffb900ff>140 + 70% AD<> and Kupa fully recovers HP at mount start.",
        "ult": "<#e64a6aff>We Are Angry!<>: Kupa fully recovers HP and enters <#5ad0e6ff>Alpha Wolf Form<> for <#ffb900ff>9s<>, gaining <#ffb900ff>35%<> Max HP and enhancing Bite ’em, Kupa! and Kupa, Help! Cooperative stack bonuses are doubled. Requires a living Kupa.",
        "passive": "<#5ad0e6ff>We Are Friends<>: When Popol and Kupa damage the same enemy within <#ffb900ff>2s<>, both gain <#ffb900ff>5%<> Attack Speed and <#ffb900ff>2%<> Movement Speed for <#ffb900ff>4s<>, stacking up to <#ffb900ff>3<> times. Each paired exchange grants one stack.\nKupa has <#ffb900ff>560 + 80 per level after Lv.1 + 50% of Popol’s bonus Max HP<> HP and inherits Popol’s current Armor, Magic Resist and Attack Speed. After <#ffb900ff>5s<> out of combat, Kupa recovers <#ffb900ff>8%<> Max HP per second. If Kupa falls, Popol begins a stationary <#ffb900ff>3s<> prayer after <#ffb900ff>3s<> without combat; movement, damage or another action interrupts it. Successful revival has a <#ffb900ff>30s<> cooldown.\n<#5ad0e6ff>Popol’s Surprise<>: During combat, Popol automatically places a trap every <#ffb900ff>10s<>, up to <#ffb900ff>2<>. Traps arm after <#ffb900ff>0.5s<> and last <#ffb900ff>15s<>. An enemy triggers <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25 + 20% AD<> physical damage and <#ffb900ff>0.6s<> of <#ef5350ff>immobilization<>, leaving frost for <#ffb900ff>3s<> that <#ef5350ff>slows<> enemies by <#ffb900ff>20%<> and reduces Armor by <#ffb900ff>12%<>. Frost from the same Popol does not stack. Placement pauses during casting, recall, riding and prayer."
      },
      "mlbb_granger": {
        "name": "Granger",
        "attack": "Fires a handgun round that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact.",
        "skill": "<#5ad0e6ff>Rhapsody<>: Locks onto an enemy and fires <#ffb900ff>6<> homing rounds over <#ffb900ff>1.5s<>, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>36 + 45% AD<> physical damage and consuming <#ffb900ff>70<> Gun Energy. Requires more than <#ffb900ff>420<> Gun Energy. Movement Speed increases by <#ffb900ff>10%<> while firing. Each hit reduces Rondo’s cooldown by <#ffb900ff>0.5s<>. The final round gains <#ffb900ff>100%<> Critical Chance for its impact. Rondo and Death Sonata can be used during the barrage.",
        "skill2": "<#5ad0e6ff>Rondo<>: Dashes a short distance and restores <#ffb900ff>15%<> of maximum Gun Energy. Walls and movement-disabling effects stop the dash. Equipment cooldown reduction increases Attack instead of shortening Rondo’s effective cooldown.",
        "ult": "<#5ad0e6ff>Death Sonata<>: Consumes <#ffb900ff>250<> Cannon Energy to fire a homing cannon round at an enemy champion. Impact triggers an explosion, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>155 + 110% AD<> physical damage to nearby enemies and <#ef5350ff>slowing<> them by <#ffb900ff>30%<> for <#ffb900ff>0.6s<>. Granger then rolls a short distance away from the firing direction.",
        "passive": "<#5ad0e6ff>Capriccio<>: Uses separate Gun and Cannon Energy pools, each starting at <#ffb900ff>800<>. Gun Energy regenerates at <#ffb900ff>8%<> of its maximum per second; Cannon Energy regenerates at <#ffb900ff>2%<>. Credited lane-minion kills increase maximum Gun Energy by <#ffb900ff>6<> and restore <#ffb900ff>5%<>; jungle kills grant the same benefit to Cannon Energy. Champion kills and assists increase both maxima by <#ffb900ff>12<> and restore <#ffb900ff>10%<>. Capacity growth persists through death. Equipment cooldown reduction grants <#ffb900ff>0.5<> Attack per percentage point, up to <#ffb900ff>20<> Attack."
      },
      "mlbb_hanzo": {
        "name": "Hanzo",
        "attack": "Strikes for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Attack<> physical damage and applies a mark.",
        "skill": "<#5ad0e6ff>Demon Feast<>: At <#ffb900ff>5 marks<>, bites champions for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200 + 7 per level after Lv.1 + 115% bonus Attack<> physical damage, heals and refunds <#ffb900ff>60%<> cooldown. Ordinary camps are devoured, healing <#66cc66ff>20% maximum Health<>.\n<#5ad0e6ff>Soul Snatch<>: Lunges for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>135 + 6 per level after Lv.1 + 95% bonus Attack<> physical damage, increased <#ffb900ff>24% per mark<> against champions and <#ffb900ff>20% per mark<> against other targets. At <#ffb900ff>5 marks<>, adds damage based on maximum Health and heals.\nCooldown: <#ffb900ff>12s / 10s<>.",
        "skill2": "<#5ad0e6ff>Dark Mist<>: Dashes and gains <#ffb900ff>15% Movement Speed<> for <#ffb900ff>2s<>. Leaves <#ffb900ff>5<> mist pulses.\n<#5ad0e6ff>Black Mist<>: Dashes through walls for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110 + 4 per level + 55% bonus Attack<> physical damage and <#ef5350ff>0.4s airborne<>. Leaves <#ffb900ff>4<> pulses.\nMist deals physical damage every <#ffb900ff>0.5s<>, applies marks and <#ef5350ff>slows 35%<>; it cannot critically strike. Cooldown: <#ffb900ff>10s per form<>.",
        "ult": "Projects Hanekage for up to <#ffb900ff>15s<>, leaving an invulnerable body. Gains <#ffb900ff>35% Movement Speed<>, <#ffb900ff>25% Attack Speed<> and wall traversal, with <#ffb900ff>30% less maximum Health<>.\nRecast returns and heals <#66cc66ff>90 + 50% bonus Attack<>. Empty Energy draws the body to Hanekage. Defeat forces a return to the body, <#ef5350ff>slows Hanzo 50% for 6s<> and sets a <#ffb900ff>52s<> cooldown (normally <#ffb900ff>26s<>).",
        "passive": "Basic attacks and mist hits apply up to <#ffb900ff>5 marks<> for <#ffb900ff>6s<>. New hits refresh them. Hanekage starts with <#ffb900ff>100 Energy<> and spends <#ffb900ff>10 per second<>; hits and nearby deaths restore Energy."
      },
      "mlbb_atlas": {
        "name": "Atlas",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Skill casts create a moving frost aura for <#ffb900ff>4s<> and grant <#66cc66ff>10 armor and magic resistance<>. Nearby enemy champions slow up to <#ef5350ff>25%<> and freeze for <#ef5350ff>0.5s<> after 2s of continuous exposure. Freeze cooldown per target: <#ffb900ff>4s<>.",
        "skill": "Slams three times for <#5ad0e6ff>30 + 10% Magic Power<> magic damage per pulse. The suit also slams while separated. Overlapping hits deal <#5ad0e6ff>45 + 15% Magic Power<> once per pulse. Cooldown: <#ffb900ff>7s<>.",
        "skill2": "Ejects for up to <#ffb900ff>2s<>, gaining <#ffb900ff>25% Movement Speed<> while the suit follows. Reunion deals <#5ad0e6ff>65 + 20% Magic Power<> magic damage and <#ef5350ff>stuns for 0.6s<>. Cooldown: <#ffb900ff>10s<>.",
        "ult": "Links nearby enemy champions for <#5ad0e6ff>35 + 10% Magic Power<> magic damage and <#ef5350ff>30% slow<>. After <#ffb900ff>0.4s<>, Atlas pulls them in for <#5ad0e6ff>105 + 25% Magic Power<> magic damage and <#ef5350ff>0.35s airborne<>. While ejected, reunites immediately with a <#ef5350ff>40% slow<> in place of the reunion hit. Cooldown: <#ffb900ff>34s<>."
      },
      "mlbb_yu_zhong": {
        "name": "Yu Zhong",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage. Soul Grip can empower the next basic attack.",
        "passive": "Basic attacks and direct skill hits apply Sha Residue to enemy heroes and jungle monsters, including Morgard and Serpen, for <#ffb900ff>5s<>. At three marks, the target pulses five times. Each pulse deals <#ff9028ff>32 + 18% Attack + 2% of the target’s missing HP<> as physical damage and heals Yu Zhong for <#66cc66ff>8% of his missing HP<>. Against jungle monsters, the missing-HP damage bonus is capped at 40 per pulse. When the eruption starts, Yu Zhong gains 15% Movement Speed for 1.5s.",
        "skill": "After 0.4s, sweeps nearby enemies for <#ff9028ff>80 + 65% Attack<> physical damage. The outer edge instead deals <#ff9028ff>138 + 95% Attack<> and applies two marks to eligible targets. Cooldown is 7s.",
        "skill2": "Sends a wave that deals <#ff9028ff>95 + 68% Attack<> physical damage and slows by 30% for 1s. On hit, the next basic attack within 3s deals <#ff9028ff>55 + 40% Attack<> extra physical damage and can lunge toward the champion struck by Soul Grip if the route is clear. Hitting a champion at a useful distance triggers Furious Dive if the landing is safe. The leap deals damage on landing and allows one short dash in his movement direction. After 0.4s, the original landing area erupts, knocking enemy champions airborne for 0.5s. Both hits deal a combined <#ff9028ff>64 + 45% Attack<> physical damage. Cooldown is 10s.",
        "ult": "Channels for 0.6s, then flies as a dragon for up to 3.5s with 35% Movement Speed, wall traversal and crowd-control immunity. Passing an enemy hero deals <#ff9028ff>125 + 85% Attack<> physical damage and knocks them back once. On landing, enters Dragonoid Form for 15s, increasing skill reach and width by 20%. Cooldown is 46s."
      }
    },
