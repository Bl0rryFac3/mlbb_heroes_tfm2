  "ko": {
    "description": {
      "mlbb_valir": {
        "name": "Valir",
        "attack": "Throws an ember that deals <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Direct spell hits apply Ablaze for <#ffb900ff>3s<>. The burn deals <#5ad0e6ff>0.8% max HP<> magic damage per second. At <#ffb900ff>3 stacks<>, it detonates for <#5ad0e6ff>4% max HP + 25% Magic Power<> magic damage and <#ef5350ff>stuns for 0.65s<>. Stun cooldown per target is <#ffb900ff>8s<>. Monster damage is capped. Bosses are immune to the stun.",
        "skill": "Fires a bolt that deals <#5ad0e6ff>70 + 65% Magic Power<> magic damage and <#ef5350ff>slows by 25% for 0.7s<>. The impact area bursts after <#ffb900ff>0.75s<> for <#5ad0e6ff>42 + 30% Magic Power<> magic damage. Stores <#ffb900ff>2 charges<> and restores one every <#ffb900ff>9s<>. A direct hit on a champion or boss refunds a charge up to once every <#ffb900ff>3.6s<>. Hitting a lane minion takes <#ffb900ff>2s<> off the recharge. Minimum recast is <#ffb900ff>1.8s<>.",
        "skill2": "Sends a wave that deals <#5ad0e6ff>95 + 65% Magic Power<> magic damage and <#ef5350ff>knocks back enemy champions, lane minions and regular jungle monsters<>. While empowered, it leaves a firewall for <#ffb900ff>3s<> that deals <#5ad0e6ff>27 + 22% Magic Power<> magic damage each second and briefly <#ef5350ff>slows by 20%<>. Cooldown is <#ffb900ff>10s<>.",
        "ult": "Can activate automatically when ready to <#ef5350ff>break a stun or other supported disable<>. Suppression still applies. Grants <#ffb900ff>30% Movement Speed<>, tapering over <#ffb900ff>3s<>. Empowers the next <#ffb900ff>4 casts<> within <#ffb900ff>9s<>. Fireball gains <#ffb900ff>30% projectile reach<> and Torrent leaves a firewall. Cooldown is <#ffb900ff>42s<>."
      },
      "mlbb_lesley": {
        "name": "Lesley",
        "attack": "Fires a rifle shot for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "<#5ad0e6ff>Lethal Shot<>. Casting a skill or going 5s without taking damage readies the next basic. It gains <#ffb900ff>17 range<> and deals <#ff9028ff>75 + 110% Attack<> true damage to champions or <#ff9028ff>75 + 125% Attack<> physical damage to lane and jungle enemies. Structures take normal basic damage.",
        "skill": "<#5ad0e6ff>Master of Camouflage<>. Camouflages for up to <#ffb900ff>2.5s<> and gains 30% Movement Speed. Enemies lose direct targeting, but area effects can still hit her. Attacking, casting another skill, or taking damage after the first 0.5s ends camouflage.",
        "skill2": "<#5ad0e6ff>Tactical Grenade<>. Deals <#ff9028ff>115 + 65% Attack<> physical damage in a short cone and pushes surviving enemy champions away. Lesley hops backward if the path is clear. During Ultimate Snipe, she fires an available round before ending the volley.",
        "ult": "<#e64a6aff>Ultimate Snipe<>. Locks onto an enemy champion and fires up to <#ffb900ff>four rounds<>. Each deals <#ff9028ff>70 + 32% Attack + 6% of the target’s missing HP<> as physical damage. Another enemy champion in the firing line can intercept a round."
      },
      "mlbb_aldous": {
        "name": "올더스",
        "attack": "거대한 용암 건틀릿으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 공격력<>의 <#ff9028ff>물리 피해<>를 입힙니다.",
        "skill": "<#ff9028ff>계약: 영혼 탈취<>: 주 대상에게 <#ff9028ff>40 + 레벨 보정 + 공격력의 100% + 영혼 탈취 중첩당 2.5<>의 물리 피해를 줍니다. 주변 적은 <#ff9028ff>40%<>의 광역 피해를 받습니다. <#ffb900ff>1,000<>중첩에서는 중첩 보너스가 방어력 적용 전 <#ffb900ff>+2,500<>입니다.",
        "skill2": "<#ffb900ff>계약: 폭발<>: <#ffb900ff>2초<>간 보호막(<#ffb900ff>90<>)과 이동 속도(<#ffb900ff>+25%<>)를 얻은 뒤 폭발하여 <#ff9028ff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 공격력<>의 <#ff9028ff>물리 피해<>와 <#ffb900ff>1초<> <#ef5350ff>기절<>을 부여합니다.",
        "ult": "<#e64a6aff>계약: 운명 추적<>: 적에게 <#e64a6aff>운명의 눈<>을 각인하고 용암 운석으로 돌진해 <#ff9028ff>130<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160% 공격력<>의 <#ff9028ff>물리 피해<>와 <#ffb900ff>1.2초<> <#ef5350ff>기절<>을 입힙니다.",
        "passive": "계약: 변환 — 알두스는 영혼 에너지를 흡수합니다. <#ffb900ff>5초<>마다 <#ffb900ff>+1<>중첩, 처치 시 <#ffb900ff>+10<>중첩, <#5ad0e6ff>영혼 강탈<>이 적중할 때 추가 중첩(최대 <#ffb900ff>1,000<>). <#ffb900ff>3<>번째 기본 공격마다(<#ffb900ff>5초<> 재사용 대기) 이 중첩을 <#ffb900ff>2초<>간 유지되는 보호막으로 전환하며, 수치는 <#ffb900ff>35<> + 레벨당 <#ffb900ff>5<> + 중첩당 <#ffb900ff>0.45<>입니다. 중첩은 <#5ad0e6ff>영혼 강탈<>도 강화합니다."
      },
      "mlbb_fanny": {
        "name": "파니",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다.",
        "skill": "<#ff9028ff>토네이도 스트라이크<>: 반경<#ffb900ff>22,000<> 안의 적에게 <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 80%<> 피해를 줍니다. 케이블 비행 중 적과 충돌하면 <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 70%<> 토네이도 스트라이크를 자동 발동합니다.",
        "skill2": "<#ff9028ff>스틸 케이블<>: 최적의 벽이나 외곽 라인 경계로 케이블(사거리 <#ffb900ff>165,000<>)을 발사해 에너지 소모 없이 연속 다중 벽 타기로 추격하거나 탈출합니다. 시야 내 적 영웅을 최우선으로 조준하며, 적 영웅이 없을 때만 정글 몬스터에게 케이블을 사용합니다.",
        "ult": "<#ff9028ff>컷 스로트<>: 대상에게 돌진해<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 125%<> 피해를 줍니다. 먹잇감 표식마다<#ff9028ff>공격력의 35%<> 추가 피해 (최대 2중첩). 적중하면 표식을 소모합니다.",
        "passive": "<#ff9028ff>공중 우세<>: 케이블 비행 중 이동 속도에 따라<#ffb900ff>10–25%<> 피해가 증가합니다. 비행 중 적 영웅을 맞히면<#ff9028ff>먹잇감 표식<>을 적용/강화(최대 2중첩,<#ffb900ff>5초<>)하고 토네이도 스트라이크를 발동합니다."
      },
      "mlbb_lancelot": {
        "name": "랜슬롯",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다.",
        "skill": "<#ff9028ff>펑처<>: 지정한 적에게 돌진해 <#ff9028ff>80–178 + 공격력의 40%<> 물리 피해를 줍니다. 처음 적중한 미표식 적에게 <#5ad0e6ff>검 표식<>을 남기며, 새 표식을 적용하면 펑처의 재사용 대기시간이 초기화됩니다. 시전할 때마다 <#ffb900ff>소울 커터<> 중첩을 얻습니다.",
        "skill2": "<#ffb900ff>가시 장미<>: 세 번 공격하며, 각 타격은 <#ff9028ff>85–155 + 공격력의 30%<> 물리 피해를 주고 적중한 적의 이동 속도를 <#ffb900ff>20%<> 낮춥니다(<#ffb900ff>0.5초<>). 연속 공격 중 피해와 군중 제어에 면역이며, 다수 적중 시 광역 피해 감소가 적용됩니다.",
        "ult": "<#e64a6aff>팬텀 처형<>: 지정한 적 영웅에게 돌진해 도착 시 <#ff9028ff>100–156 + 공격력의 100%<> 물리 피해를 줍니다. 돌진 중 피해와 군중 제어에 면역이며 <#ffb900ff>소울 커터<> 중첩을 얻습니다.",
        "passive": "<#5ad0e6ff>소울 커터<>: 펑처와 팬텀 처형은 중첩당 피해를 <#ffb900ff>7.5%<> 증가시키며 <#ffb900ff>4초<> 동안 지속됩니다. 최대 <#ffb900ff>4중첩(30%)<>입니다."
      },
      "mlbb_estes": {
        "name": "에스테스",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다.",
        "passive": "<#5ad0e6ff>달의 요정 서약<>: 초당<#ffb900ff>1<>중첩, 아군 연결 중 초당<#ffb900ff>2<>중첩을 얻습니다. 100중첩에서 다음 기본 공격이 강화되어 마법 피해를 주고 최대 2명의 주변 적에게 튕기며 40% 둔화(1.5초)를 부여합니다. 중첩은 스킬 1 아이콘에 표시됩니다.",
        "skill": "<#5ad0e6ff>달빛의 강림<>: 아군 영웅 하나를 즉시<#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 85%<>만큼 치유하고, 이후<#ffb900ff>0.5초<>마다<#5bd18aff>24<> + <#a974ffff>주문력의 18%<>를 5초간 회복시킵니다. 아군은 물리/마법 방어력<#ffb900ff>+7<>을, 에스테스는 이동 속도<#ffb900ff>+15%<>를 얻습니다. 거리가 120,000을 넘으면 시각 연결과 패시브 충전 보너스가 멈추며, 데이터 기반 지속 치유는 남은 시간 동안 계속됩니다.",
        "skill2": "<#5ad0e6ff>달의 여신 영역<>: <#ffb900ff>2.5초<> 동안 고정된 달빛 영역을 생성합니다. 매<#ffb900ff>0.5초<>마다 반경<#ffb900ff>52,000<> 안의 적에게<#a974ffff>15<> + <#a974ffff>주문력의 45%<> 마법 피해를 주고<#ffb900ff>35%<> 둔화시킵니다(0.75초). TFM2 버전은 바깥 가장자리만이 아니라 영역 안에서 둔화를 적용합니다.",
        "ult": "<#5ad0e6ff>달의 여신의 축복<>: 반경<#ffb900ff>105,000<> 안의 아군을 즉시<#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 65%<> 치유하고, 이후 8초 동안 매 0.5초마다<#5bd18aff>20<> + <#a974ffff>주문력의 12%<>를 회복시키며 물리/마법 방어력<#ffb900ff>+8<>을 부여합니다."
      },
      "mlbb_gusion": {
        "name": "구시온",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다.",
        "passive": "<#5ad0e6ff>Dagger Specialist<>: Each skill cast grants a <#ffb900ff>Rune<> stack, up to <#ffb900ff>4<>. The next basic attack consumes all stacks, dealing <#a974ffff>3% of the target’s max HP<> as magic damage per stack and restoring <#5bd18aff>50 + 25% Total Magic Power<> HP per stack.",
        "skill": "<#5ad0e6ff>소드 스파이크<>: 단검을 던져 처음 적중한 적에게<#a974ffff> 총 마법력의 50% + 200<> 마법 피해를 주고<#ffb900ff> 5초<> 동안 표식을 남깁니다. 다시 사용하면 표식 대상 뒤로 돌진해<#a974ffff> 총 마법력의 100% + 200<> 마법 피해를 줍니다.",
        "skill2": "<#a974ffff>섀도블레이드 슬로터<>: 부채꼴로<#ffb900ff> 단검 5개<>를 던져 각각<#a974ffff> 총 마법력의 40% + 65<> 마법 피해를 줍니다. 다시 사용하면 단검을 회수합니다. 궁극기로 재사용하면 한 묶음을 더 던진 뒤 두 묶음을 함께 회수할 수 있습니다.",
        "ult": "<#e64a6aff>인칸데센스<>: 선택한 적 뒤로 돌진하며 스킬 1과 2의 재사용 대기시간을 초기화합니다. 스킬 2 단검이 남아 있으면 한 묶음을 더 던질 수 있으며, 다음 스킬 2로 두 묶음을 회수합니다.<#ffb900ff> 2.5초<> 안에 다시 사용해 재차 돌진할 수 있습니다."
      },
      "mlbb_karrie": {
        "name": "캐리",
        "attack": "기본 공격은 단일 라이트휠로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<>의 <#ff9028ff>물리 피해<>를 줍니다.",
        "passive": "<#5ad0e6ff>라이트휠 표식<>：기본 공격과 스킬 1, 2가 <#ffb900ff>표식 1개<>를 부여합니다. <#ffb900ff>5중첩<>이 되면 대상 최대 체력의 <#ff9028ff>4%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 10%<>에 해당하는 <#e64a6aff>고정 피해<>로 폭발하며, 영웅에게는 <#ffb900ff>250<>、정글/에픽 몬스터에게는 <#ffb900ff>300<>으로 제한됩니다.",
        "skill": "<#5ad0e6ff>스피닝 라이트휠<>：지정한 방향으로 고리 형태의 라이트휠을 던집니다. 명중 시 주 대상에게 <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 80%<> 물리 피해를, 주변의 포탑이 아닌 적에게 <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 35%<> 물리 피해를 주고 <#ffb900ff>1초<> 동안 <#ffb900ff>35%<> 둔화시킵니다. 명중 지점에는 <#ffb900ff>1.5초<> 동안 보라색 둔화 지대가 남아, 범위 안의 적은 다시 <#ffb900ff>35%<> 둔화되고 <#ffb900ff>0.5초<> 간격으로 두 번에 걸쳐 <#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 10%<> 물리 피해를 받습니다. 지대의 추가 타격은 라이트휠 표식을 부여하지 않습니다.",
        "skill2": "<#5ad0e6ff>팬텀 스텝<>: 지정한 위치를 향해 일정 거리를 돌진한 뒤, 착지 지점 근처에서 가장 가까운 유효 적에게 광륜을 발사합니다.<#ff9028ff> 75 + 총 물리 공격력의 70%<> 피해를 주며, 스피디 라이트휠 중에는 계수가<#ff9028ff> 100%<>가 되고<#ffb900ff> 라이트휠 표식 1개<>를 부여합니다.",
        "ult": "<#e64a6aff>스피디 라이트휠<>: <#ffb900ff>6초<> 동안 이동 속도가<#ffb900ff> 20%<> 증가하고 공격 속도가<#ffb900ff> 35%<> 증가합니다. 지속 중 팬텀 스텝은<#ff9028ff> 75 + 총 물리 공격력의 100%<> 피해를 줍니다."
      },
      "mlbb_uranus": {
        "name": "우라노스",
        "attack": "기본 공격은 팔을 휘둘러 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<>에 해당하는 <#ff9028ff>물리 피해<>를 줍니다. 기본 공격은 이온 엣지 표식을<#ffb900ff> 적용하지 않습니다<>.",
        "passive": "<#5ad0e6ff>라디언스<>: 피해를 받으면<#ffb900ff> 1중첩<>을 얻으며 최대<#ffb900ff> 12중첩<>까지 쌓이며, 각 중첩은<#ffb900ff> 10초<> 지속됩니다. <#ffb900ff> 1초<>에 최대 1중첩만 얻습니다. 매<#ffb900ff> 0.8초<>마다 회복하며 12중첩에서<#5bd18aff> 28–134 HP<>를 회복합니다.",
        "skill": "<#5ad0e6ff>이온 엣지<>: 에너지 칼날 두 개를 바깥으로 발사해 되돌립니다. 명중할 때마다<#a974ffff> 79–131(+총 마법력의 18%)<> 마법 피해를 주고<#ffb900ff> 30%<> 둔화시킵니다(<#ffb900ff>2초<>). 각 칼날은 같은 대상을 한 번만 타격합니다. 한 번 시전할 때 대상마다<#ffb900ff> 이온 표식 1개<>까지만 부여하며, 표식은<#ffb900ff> 6초<> 동안 지속됩니다. 표식 하나당 이후 스킬 1 피해가<#ffb900ff> 20%<> 증가하며 최대<#ffb900ff> 8중첩<>입니다. 포탑과 넥서스에는 표식을 남기지 않습니다.",
        "skill2": "<#5ad0e6ff>초월의 보호<>: 지정 위치로 돌진합니다. 경로상의 적은<#a974ffff> 48–120(+총 마법력의 12%)<> 마법 피해를 받고, 도착 지점 근처 적은<#a974ffff> 96–240(+총 마법력의 48%)<> 피해와<#ffb900ff> 25%<> 둔화를 받습니다.<#5bd18aff> 300–750(+총 마법력의 200%)<> 보호막을<#ffb900ff> 4초<> 동안 얻으며, 보호막이 깨지거나 끝나면 주변에<#a974ffff> 156–390(+총 마법력의 78%)<> 마법 피해를 줍니다.",
        "ult": "<#e64a6aff>컨세크레이션<>: <#ef5350ff>모든 군중 제어<>를 해제합니다(TFM2 구현; 원본은 둔화만 해제).<#5bd18aff> 200–400 HP<>를 회복하고<#ffb900ff> 60%<> 이동 속도를 얻어<#ffb900ff> 8초<> 동안 감소합니다. 라디언스<#ffb900ff> 5–12중첩<>을 얻습니다. 8초 동안 HP 회복과 우라노스 자신의 초월 보호막이<#ffb900ff> 20%<> 증가합니다."
      },
      "mlbb_chou": {
        "name": "초우",
        "attack": "기본 공격은 물리 공격력의 100%에 해당하는 물리 피해를 줍니다.",
        "passive": "<#5ad0e6ff>일섬<>: TFM2 월드 거리 약 <#ffb900ff>42,000<>만큼 이동하면 다음 기본 공격이 <#ff9028ff>물리 공격력의 180%<> 물리 피해를 주고 <#ffb900ff>1초<> 동안 <#ffb900ff>80%<> 둔화시키며, <#ffb900ff>2초<> 동안 물리 방어력을 <#ffb900ff>10<> 감소시킵니다(최대 <#ffb900ff>2<>중첩). 이동 거리는 TFM2 맵 규모에 맞춰 조정됩니다.",
        "skill": "<#ff9028ff>절권도<>: 최대 <#ffb900ff>3<>회 시전합니다. 올려차기, 돌진 어퍼컷, 도약 후 내려찍기 순서이며 마지막 타격은 적을 공중에 띄웁니다. 각 타격은 <#ff9028ff>100–165 + 총 물리 공격력의 45%<> 피해를 줍니다. 처음 두 시전은 기술을 초기화하며 세 번째 시전 후 재사용 대기시간이 시작됩니다. 세 번째 시전으로 적 영웅을 적중하면 순보의 재사용 대기시간이 초기화됩니다.",
        "skill2": "<#5ad0e6ff>순보<>: 지정 방향으로 돌진하며 이동 중 <#ffb900ff>제어 면역<>을 얻습니다. 도착 시 <#5bd18aff>200–300 + 추가 물리 공격력의 100%<>만큼 보호막을 얻고, <#ffb900ff>2.5초<> 동안 물리 관통력 <#ffb900ff>15<>를 얻습니다.",
        "ult": "<#e64a6aff>용의 길<>: 적 영웅을 돌려차기해 <#ff9028ff>275–420 + 추가 물리 공격력의 110%<> 피해를 주고 밀쳐냅니다. 같은 대상이 추격 범위 내에 있으면 초우가 따라가 도착 후 4회 공격해 총 <#ff9028ff>330–500 + 추가 물리 공격력의 132%<> 물리 피해를 줍니다."
      },
      "mlbb_zhask": {
        "name": "자스크",
        "attack": "그림자 탄환을 발사해 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<>에 해당하는 <#ff9028ff>물리 피해<>를 줍니다.",
        "passive": "<#5ad0e6ff>말살<>: 자스크가 사망하면 사망 위치에 광폭한 소환체를 부릅니다. 최대<#ffb900ff>6초<> 동안 지속되며 매초 최대 체력의<#ffb900ff>2%<>를 잃습니다.",
        "skill": "<#5ad0e6ff>악몽의 소환체<>: 최대<#ffb900ff>12초<> 동안 한곳에 머무는 소환체를 부릅니다. 레벨에 따라 자스크의 체력, 방어력, 마법력을<#ffb900ff>55–100%<> 계승합니다. 죽음의 광선은<#a974ffff>15틱(0.25초)<>마다 적중해<#a974ffff>30(+마법력의 25%)<>의 마법 피해를 주고<#ffb900ff>36틱(0.6초)<> 동안 이동 속도를<#ffb900ff>30%<> 감소시킵니다. 다시 조준해 위치를 바꿀 수 있습니다. 자스크가<#ffb900ff>120,000<> 유닛보다 멀어지면 돌아올 때까지 광선이 멈춥니다.",
        "skill2": "<#5ad0e6ff>정신 포식자<>: 지정 방향으로 관통 투사체를 발사해 경로상의 적에게<#a974ffff>87 + 1레벨 초과분당 6(+마법력의 60%)<>의 마법 피해를 줍니다. 소환체가 살아 있으면 적중한 적마다 추가로<#a974ffff>35(+마법력의 50%)<>의 피해를 주고<#ffb900ff>30틱(0.5초)<> 동안 기절시킵니다.",
        "ult": "<#e64a6aff>지배자의 강림<>: 대상 지점으로 순간이동해 최대<#ffb900ff>10초<> 동안 융합 소환체를 부릅니다. 융합 중 자스크는 추방되어 보이지 않고, 대상 지정 및 입력이 차단됩니다. 융합 소환체는 자스크 능력치의 100%를 계승하고 죽음의 광선 피해가<#ffb900ff>×1.8<>이 됩니다."
      },
      "mlbb_hanabi": {
        "name": "하나비",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<>에 해당하는 물리 피해를 줍니다.",
        "passive": "<#5ad0e6ff>인술: 꽃잎 난무<>: 기본 공격과 스킬 적중 시 꽃잎 칼날을 발사해 주변 적에게 튕깁니다. 하나비는<#ffb900ff>어떤 출처든 보호막이 있으면<> 군중 제어 효과에 면역이 됩니다. 이미 적용된 제어 효과를 해제하지는 않습니다.",
        "skill": "<#5ad0e6ff>인술: 이클립스<>: <#ff9028ff>120 + 공격력의 35%<> 보호막을 <#ffb900ff>5초<> 동안 얻고, 이동 속도<#ffb900ff>12%<>와 공격 속도<#ffb900ff>20%<>가 증가합니다. 보호막 지속 중 영웅에게 준 피해의<#ffb900ff>20%<>, 다른 유닛에게 준 피해의<#ffb900ff>10%<>가 보호막으로 전환됩니다. 보호막 상한은 최대 HP의<#ffb900ff>50%<>이며 이 구현에서는 모든 보호막 층을 상한 계산에 포함합니다. 보호막이 있으면 패시브 제어 면역도 발동합니다.",
        "skill2": "<#5ad0e6ff>인술: 소울 스크롤<>: 관통하는 쿠나이와 두루마리를 발사해 경로상의 적에게<#ff9028ff>65 + 공격력의 75%<> 물리 피해를 주고<#ffb900ff>1초<> 동안<#ffb900ff>30%<> 둔화시킵니다. 적중한 대상은<#ffb900ff>5초<> 동안 표식이 남습니다. 다음 기본 공격 꽃잎 튕김이 표식 대상에게 적중하면 일반 튕김 감소를 받지 않는<#ff9028ff>20 + 공격력의 50%<> 추가 피해를 주고 표식을 소모합니다.",
        "ult": "<#e64a6aff>금단의 술법: 히간바나<>: 큰 히간바나를 던져 처음 적중한 적 영웅에게<#ff9028ff>150 + 공격력의 80%<> 물리 피해를 주고<#ffb900ff>0.8초<> 동안 속박합니다.<#ffb900ff>0.8초<> 뒤 해당 위치에 꽃이 피어<#ffb900ff>34,000<> 범위의 적에게<#ff9028ff>105 + 공격력의 55%<> 물리 피해를 줍니다. 주 대상 외의 적은<#ffb900ff>0.6초<> 동안<#ffb900ff>20%<> 둔화됩니다."
      },
      "mlbb_alpha": {
        "name": "Alpha",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다.",
        "passive": "<#5ad0e6ff>베타, 전진!<> 적 영웅에게 유효한 타격을 세 번 적중시키면 베타가 30 + 1레벨 이후 레벨당 3 + 공격력의 15%의 물리 피해를 주고 1초 동안 30% 둔화시킵니다.",
        "skill": "<#5ad0e6ff>로터리 임팩트<> 파동으로 70 + 공격력의 80%의 물리 피해를 주고 1초 동안 40% 둔화시킵니다. 베타가 25 + 1레벨 이후 레벨당 1 + 공격력의 20%의 고정 피해를 줍니다.",
        "skill2": "<#5ad0e6ff>포스 스윙<> 전방을 휩쓸어 100 + 공격력의 80%의 물리 피해를 줍니다. 베타가 25 + 1레벨 이후 레벨당 1 + 공격력의 20%의 고정 피해를 줍니다. 시전당 한 번 100 + 공격력의 20%만큼 회복합니다.",
        "ult": "<#e64a6aff>알파의 창<> 베타가 돌진하여 70 + 공격력의 20%의 물리 피해를 주고 1초 기절시킵니다. 알파는 착지 시 130 + 공격력의 80%의 물리 피해, 0.67초 공중에 뜸, 1.25초 동안 30% 둔화를 적용합니다. 베타가 8 + 공격력의 10%의 물리 피해를 다섯 번 줍니다."
      },
      "mlbb_arlott": {
        "name": "알로트",
        "attack": "기본 공격 시 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<>에 해당하는 물리 피해를 줍니다.",
        "passive": "<#5ad0e6ff>악마의 시선<>: <#ffb900ff>7초<>마다 가장 가까운 적 영웅을 표식하고, 알로트의 군중 제어 효과에 맞은 적도 표식됩니다. <#e64a6aff>표식<>된 대상은 복수의 효과를 두 배로 받습니다. 표식은 <#ffb900ff>7초<> 동안 유지됩니다.",
        "skill": "<#5ad0e6ff>무모한 일격<>: 창을 아래로 내리쳐 일직선상의 적에게 <#ff9028ff>110 + 총 물리 공격력의 55%<> 물리 피해를 주고 기절시킵니다. 대상이 <#ffb900ff>멀수록<> 기절이 <#ffb900ff>길어지며<>, 근거리에서 <#ffb900ff>0.5초<>, 최대 사거리에서 <#ffb900ff>1초<>가 됩니다. 내리치는 공격은 제어한 적을 표식합니다.",
        "skill2": "<#5ad0e6ff>복수<>: 적에게 돌진해 <#ff9028ff>100 + 총 물리 공격력의 55%<> 물리 피해를 주고, 군중 제어 효과로 대상을 표식합니다. 돌진하는 동안 알로트는 <#ffb900ff>방해받지 않습니다<>. <#e64a6aff>표식<>된 대상에게는 <#ffb900ff>두 배<>의 피해를 주고 <#ffb900ff>재사용 대기시간을 초기화<>하며 <#ffb900ff>총 물리 공격력의 30%<>만큼 체력을 회복합니다(비영웅 대상은 절반).",
        "ult": "<#e64a6aff>최후의 일격<>: 두 개의 창으로 크게 휘둘러 <#ff9028ff>160 + 총 물리 공격력의 75%<> 물리 피해를 주고 모든 적을 알로트의 <#ffb900ff>오른쪽<>으로 <#ffb900ff>끌어옵니다<>. 끌려온 적은 모두 <#e64a6aff>표식<>됩니다."
      },
      "mlbb_franco": {
        "name": "프랑코",
        "attack": "전투 망치를 휘둘러 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>물리 피해<>를 입힙니다.",
        "skill": "<#5ad0e6ff>강철 갈고리<>: 갈고리를 던져 처음 맞는 적을 걸고, <#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>물리 피해<>를 입힌 뒤 프랑코 쪽으로 끌어옵니다. 갈고리는 먼저 <#ef5350ff>기절<>시키고 그다음 끌어오므로, 끌 수 없는 대상도 이동이 봉쇄됩니다.",
        "skill2": "<#5ad0e6ff>분노의 진동<>: 주변을 후려쳐 적에게 <#ff9028ff>160<> + 프랑코 <#ffb900ff>최대 체력<>의 <#ff9028ff>4%<> 만큼의 <#ff9028ff>물리 피해<>를 입히고 <#ffb900ff>1.5초<> 동안 <#ffb900ff>70%<> <#ffb900ff>둔화<>시킵니다. 정글 몬스터와 오브젝트에도 사용할 수 있습니다. 이동 중 시전 가능.",
        "ult": "<#e64a6aff>피의 사냥<>: 적 챔피언을 <#ffb900ff>1.8초<> 동안 <#ef5350ff>제압<>하고 <#ffb900ff>6<> 회 공격하며 망치와 갈고리를 번갈아 사용해 매회 <#ff9028ff>50<> + <#ff9028ff>70% AD<> 피해를 입힙니다. 프랑코가 군중 제어에 걸리면 스킬이 조기 종료됩니다.",
        "passive": "<#5ad0e6ff>황야의 힘<>: <#ffb900ff>5초<> 동안 피해를 받지 않으면 이동 속도 <#ffb900ff>10%<>, 초당 최대 체력 <#ffb900ff>1%<> 회복, 최대 <#ffb900ff>10<>중첩을 쌓습니다. 다음 스킬이 중첩을 모두 소모해 스킬 피해를 최대 <#ffb900ff>+150%<> 높입니다."
      },
      "mlbb_balmond": {
        "name": "발몬드",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다.",
        "passive": "<#5ad0e6ff>흡혈<>：미니언 또는 정글 몬스터 처치 시 최대 체력의 <#ffb900ff>5%<>를, 적 영웅 처치 또는 어시스트 시 <#ffb900ff>10%<>를 회복합니다.",
        "skill": "<#5ad0e6ff>소울 락<>：선택한 적 영웅에게 돌진하며 직선 경로의 적에게 <#ff9028ff>150–275 + 총 물리 공격력의 60%<> 물리 피해를 줍니다. 맞은 영웅은 짧게 밀려나며 <#ffb900ff>3초<> 동안 <#ffb900ff>40%<> 둔화됩니다. TFM2 프로토타입은 위치를 지정해 돌진하며, 직선 경로 피해는 유지되고 도착 지점 근처의 가장 가까운 적 영웅이 피해를 받습니다.",
        "skill2": "<#5ad0e6ff>사이클론 스윕<>: <#ffb900ff>3초<> 동안 회전하며 14회 피해를 줍니다. 각 타격은 <#ff9028ff>24–44 + 총 체력의 1.3% + 총 물리 공격력의 25%<> 물리 피해를 주고 대상의 물리 방어력을 회당 <#ffb900ff>5%<> 감소시킵니다(최대 <#ffb900ff>8중첩<>). 지속 중 이동 속도가 <#ffb900ff>15%<> 증가합니다.",
        "ult": "<#e64a6aff>리탈 카운터<>：전방 넓은 범위에 <#ff9028ff>150 + 총 물리 공격력의 70% + 대상이 잃은 체력의 30–45%<>에 해당하는 고정 피해를 줍니다. 영웅이 아닌 대상에게는 영웅 레벨 구간별로 <#ffb900ff>1,000 / 1,500 / 2,000<>으로 제한됩니다."
      },
      "mlbb_obsidia": {
        "name": "옵시디아",
        "attack": "기본 공격으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 물리 공격력의 65%<>에 해당하는 물리 피해를 입힙니다.",
        "passive": "<#5ad0e6ff>뼈로의 귀환<>：적에게 피해를 입히면 뼈의 기운을 얻습니다 — 적 영웅에게 기본 공격으로 <#ffb900ff>2<>, 스킬 적중으로 <#ffb900ff>4<>, 미니언이나 포탑 공격으로 <#ffb900ff>1<>. 정글 몬스터는 주지 않습니다. 기운 <#ffb900ff>30<>마다 뼈 조각 하나가 만들어지며 최대 <#ffb900ff>25<>개입니다. 조각 하나마다 기본 공격이 총 물리 공격력의 <#ffb900ff>7%<>만큼 추가로 타격합니다. 적 영웅을 처치하면 즉시 조각을 얻습니다.",
        "skill": "<#5ad0e6ff>심연의 뼈바늘<>：직선으로 뼈바늘을 발사하여 적중한 적에게 <#ff9028ff>90–140 + 총 물리 공격력의 60%<>의 물리 피해를 입히고, 처음 적중한 적 영웅에게 뼈의 기운을 부여합니다.",
        "skill2": "<#5ad0e6ff>환영의 은신<>：심연으로 가라앉아 대상 방향으로 돌진하며 <#ffb900ff>0.3초<> 동안 <#ffb900ff>이동 속도 +20%<>를 얻습니다.",
        "ult": "<#e64a6aff>뼈의 사냥<>：분노의 뼈를 발사하여 <#ff9028ff>55 + 총 물리 공격력의 50%<>의 물리 피해를 입히고, 처음 적중한 적 영웅을 짧게 <#ffb900ff>기절<>시키며 <#ffb900ff>자신을 그 곁으로 끌어당깁니다<>. <#ffb900ff>3초<> 동안 묶어 둡니다: 자신은 <#ffb900ff>4유닛<> 이상 멀어질 수 없고, 적은 이동기를 사용할 수 없으며, 적이 이동하면 자신도 끌려갑니다. 상한을 넘어 <#ffb900ff>임시 뼈 조각 5개<>와 <#ffb900ff>보호막<>, <#ffb900ff>공격 속도 +30%<>를 얻습니다. 장애물을 통과할 수 있고 이동하며 기본 공격을 할 수 있으며, 환영의 은신이 <#ffb900ff>1초<> 지속됩니다."
      },
      "mlbb_gord": {
        "name": "고르드",
        "attack": "기본 공격으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 에 해당하는 물리 피해를 줍니다. 사거리가 깁니다.",
        "passive": "<#5ad0e6ff>신비로운 은총<>: 스킬로 적을 <#ffb900ff>3<>회 적중시키면 다음 스킬 적중 시 <#a974ffff>12 (+레벨당 2) (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>주문력의 8%) 고정 피해<>를 추가로 주고 대상을 <#ffb900ff>1초<> 동안 <#ffb900ff>20%<> 둔화시킵니다. 둔화는 최대 <#ffb900ff>2<>회 중첩되어 <#ffb900ff>40%<>까지 올라갑니다.",
        "skill": "<#5ad0e6ff>신비한 투사체<>: 에너지 구체를 발사해 첫 번째 적에게 닿는 순간 멈추며 폭발하여 <#a974ffff>주문력의 52% + 105<> 의 마법 피해를 주고 <#ffb900ff>1초<> 동안 <#ffb900ff>기절<>시킵니다.",
        "skill2": "<#5ad0e6ff>신비한 금지<>: 지정한 위치에 <#ffb900ff>4초<> 동안 에너지 장판을 만들어 <#ffb900ff>0.25초<>마다 <#a974ffff>주문력의 12% + 6<> 의 마법 피해를 최대 <#ffb900ff>16<>회 줍니다.",
        "ult": "<#e64a6aff>신비한 분출<>: <#ffb900ff>3.2초<> 동안 에너지 광선을 발사하여 <#ffb900ff>0.2초<>마다 <#a974ffff>주문력의 17% + 12<> 의 마법 피해를 최대 <#ffb900ff>16<>회 줍니다. 매번 전방의 가장 가까운 적 챔피언을 다시 조준합니다."
      },
      "mlbb_belerick": {
        "name": "벨레릭",
        "attack": "기본 공격으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 에 해당하는 물리 피해를 줍니다. <#5ad0e6ff>자연의 일격<>으로 강화된 동안에는 대신 <#a974ffff>60<> 마법 피해를 주고, <#ffb900ff>150 + 잃은 체력의 12%<>만큼 회복하며 대상을 <#ffb900ff>1.4초<> 동안 <#ffb900ff>60%<> 둔화시킵니다.",
        "passive": "<#5ad0e6ff>치명적인 가시<>: 벨레릭이 <#ffb900ff>4<>회 피격될 때마다 가장 가까운 적을 향해 가시를 발사해 <#a974ffff>10 (+레벨당 1) + 최대 체력의 1%<> 마법 피해를 줍니다. <#ffb900ff>10<> 미만의 피해는 집계되지 않고, <#ffb900ff>1.2초<>에 한 번만 발동하며 포탑은 발동시키지 않습니다.",
        "skill": "<#5ad0e6ff>고대의 씨앗<>: 직선으로 덩굴을 뻗어 <#a974ffff>115<> 마법 피해를 주고 적중한 적을 <#ffb900ff>2초<> 동안 <#ffb900ff>25%<> 둔화시킵니다. <#ffb900ff>1.1초<> 후 씨앗이 같은 경로에서 터져 <#a974ffff>115<> 마법 피해를 추가로 주고 <#ffb900ff>1.2초<> 동안 <#ffb900ff>도발<>합니다.",
        "skill2": "<#5ad0e6ff>자연의 일격<>: <#ffb900ff>1초<> 동안 이동 속도가 <#ffb900ff>+60%<>, 그 후 <#ffb900ff>1초<> 동안 <#ffb900ff>+20%<> 증가하고 <#ffb900ff>3초<> 동안 다음 기본 공격이 강화됩니다. <#5ad0e6ff>치명적인 가시<>가 발동할 때마다 이 스킬의 재사용 대기시간이 <#ffb900ff>1초<> 감소합니다.",
        "ult": "<#e64a6aff>드라이어드의 분노<>: 바깥으로 퍼지는 덩굴을 <#ffb900ff>4<>회 소환하며, 매회 <#a974ffff>55<> 마법 피해를 주고 적중한 적을 <#ffb900ff>1.5초<> 동안 <#ffb900ff>도발<>합니다."
      },
      "mlbb_cecilion": {
        "name": "세실리온",
        "attack": "기본 공격으로 원거리에서 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<>의 물리 피해를 입힙니다.",
        "passive": "<#5ad0e6ff>넘쳐흐름<>: 세실리온의 스킬이 적에게 적중할 때마다 <#ffb900ff>1<>중첩을 얻으며, <#ffb900ff>1초<>에 한 번만 발동합니다. 중첩마다 <#a974ffff>+3 마법력<>을 얻으며, 게임이 끝날 때까지 유지되고 사망해도 사라지지 않습니다.",
        "skill": "<#5ad0e6ff>박쥐 강타<>: 거대한 박쥐를 보내 경로상의 적에게 <#a974ffff>30 + 총 마법력의 25%<>에 해당하는 마법 피해를 입힙니다. 목표 지점에 도달하면 박쥐가 급강하하여 <#a974ffff>55 + 총 마법력의 50%<>의 마법 피해를 입힙니다.",
        "skill2": "<#5ad0e6ff>핏빛 발톱<>: 지점을 표시합니다. <#ffb900ff>0.6초<> 후 피의 발톱이 그 지점을 덮쳐 적중한 적에게 <#a974ffff>60 + 총 마법력의 60%<>의 마법 피해를 입히고 <#ffb900ff>1초<> 동안 <#ffb900ff>기절<>시키고 표시한 지점의 중앙으로 끌어당깁니다.",
        "ult": "<#e64a6aff>박쥐 향연<>: <#ffb900ff>3초<>에 걸쳐 <#ffb900ff>40<>개의 피의 화살을 발사하며, 각각 주변 적 챔피언에게 <#a974ffff>5 + 총 마법력의 8%<>의 마법 피해를 입힙니다. 시전 중에도 이동할 수 있으며, <#ffb900ff>1.5초<> 동안 <#a974ffff>이동 속도 +60%<>를 얻고 화살 하나당 <#a974ffff>8<>의 체력을 회복합니다."
      },
      "mlbb_johnson": {
        "name": "존슨",
        "attack": "무거운 렌치를 휘둘러 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% AD<>의 <#ff9028ff>물리 피해<>를 입힙니다.",
        "passive": "<#5ad0e6ff>전자 에어백<>: 체력이 <#ffb900ff>30%<> 이하로 떨어지면 <#a974ffff>120 (+총 물리 방어력의 240%)<>에 해당하는 보호막을 <#ffb900ff>10초<>간 얻습니다. 재사용 대기시간 <#ffb900ff>100초<>.",
        "skill": "<#5ad0e6ff>임팩트 렌치<>: 렌치를 던져 경로상의 적에게 <#a974ffff>80 (+총 물리 방어력의 110%)<>의 마법 피해를 입힙니다. 착지 지점 주변의 적은 <#ffb900ff>0.8초<>간 기절합니다.",
        "skill2": "<#5ad0e6ff>전자기파<>: 방패를 들어 앞의 적에게 <#a974ffff>40 (+총 물리 방어력의 45%)<>의 마법 피해를 입히고 이동 속도와 마법 방어력을 낮춥니다. 최대 <#ffb900ff>3<>회 중첩됩니다.",
        "ult": "<#5ad0e6ff>풀 스로틀<>: 자동차로 변신합니다. 주변 아군 영웅이 탑승합니다. 적 영웅과 충돌하면 폭발하여 <#a974ffff>90 (+총 물리 방어력의 150%~220%)<>의 마법 피해를 입히고 주행 시간에 따라 <#ffb900ff>0.5초~1초<>간 기절시킨 뒤 전자기 지대를 남깁니다. 아군을 태우고 안전한 곳으로 이동할 수도 있습니다."
      },
      "mlbb_angela": {
        "name": "안젤라",
        "attack": "하트 탄환을 발사해 <#ffb900ff>88,000<> 사거리에서 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<>만큼 물리 피해를 입힙니다.",
        "skill": "<#5ad0e6ff>러브 웨이브<>: 충전을 <#ffb900ff>1회<> 소모해 전방 <#ffb900ff>92,000<>까지 파동을 보내, 적에게 <#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>마법력의 30%<>만큼 마법 피해를 입히고 통과한 아군을 <#5bd18aff>46<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#5bd18aff>마법력의 40%<>만큼 회복시킵니다. 적중한 적은 <#5ad0e6ff>연인 표식<>을 <#ffb900ff>1중첩<> 얻고 <#ffb900ff>3초<> 동안 유지되며(최대 <#ffb900ff>5중첩<>), 중첩마다 이후 파동과 S2 최종 타격의 피해가 <#ffb900ff>+12%<> 증가하고 이동 속도가 <#ffb900ff>6%<> 감소합니다. 최대 <#ffb900ff>5회<>까지 연속 사용할 수 있으며, 마지막 사용 후 <#ffb900ff>5초<>의 재사용 대기시간에 들어갑니다.",
        "skill2": "<#5ad0e6ff>꼭두각시 인형<>: 사거리 <#ffb900ff>95,000<> 내의 적을 <#ffb900ff>3초<> 동안 연결해 <#a974ffff>95 + 마법력의 25%<>만큼 마법 피해를 입히고, 지속 중 이동 속도를 최대 <#ffb900ff>45%<>까지 감소시킵니다. 종료 시 연결이 유지되어 있으면 <#a974ffff>140 + 마법력의 35%<>만큼의 추가 피해(<#5ad0e6ff>연인 표식<> 중첩으로 증가)를 입히고 <#ffb900ff>0.7초<> 동안 속박합니다. <#ffb900ff>150,000<> 이상 벌어지거나 대상이 사망하면 실이 끊기며 최종 피해는 발생하지 않습니다.",
        "ult": "<#e64a6aff>하트 가드<>: 맵 어디에 있든 아군 영웅 1명에게 <#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>마법력의 180%<>만큼의 보호막을 <#ffb900ff>6초<> 동안 부여합니다. 안젤라는 사라져 <#ffb900ff>12초<> 동안 그 아군에게 깃들어 아군의 위치에서 S1과 S2를 자동으로 사용하며, 머리 위의 <#5ad0e6ff>인형<>이 유대를 표시합니다. 숙주가 사망하거나 대상으로 지정될 수 없으면 조기 종료되고, 재사용하면 즉시 해제됩니다. 재사용 대기시간 <#ffb900ff>40초<>.",
        "passive": "<#5ad0e6ff>스마트 하트<>: 스킬을 사용할 때마다 이동 속도를 <#ffb900ff>4초<> 동안 얻습니다(깃든 동안에는 숙주가 받습니다). 최대 <#ffb900ff>4중첩<>까지 쌓여 합계 <#ffb900ff>7%, 15%, 22%, 30%<>이며, 상한에서 갱신해도 상한을 넘지 않고 사용 횟수와 재사용 대기시간은 깃듦을 넘어 유지됩니다."
      },
      "mlbb_eudora": {
        "name": "유도라",
        "attack": "기본 공격이 번개를 발사해 <#ffb900ff>100%<> AD의 물리 피해를 준다.",
        "skill": "<#5ad0e6ff>갈래 번개<>: 부채꼴 범위에 <#ffb900ff>100<> + <#ffb900ff>55%<> AP의 마법 피해를 준다. 라인 미니언에게는 피해가 두 배다. 이미 표식이 있는 적을 최대 <#ffb900ff>1<>초 동안 연결해 <#ffb900ff>4<> + <#ffb900ff>2%<> AP의 피해를 <#ffb900ff>4<>회 주고, 연결이 유지되면 마지막으로 <#ffb900ff>100<> + <#ffb900ff>55%<> AP의 피해를 준다. 연결 중 이동 속도가 <#ffb900ff>20%<> 증가한다. 마지막 타격 적중 시 재사용 대기시간이 <#ffb900ff>1.5<>초 감소하며, 시전당 한 번만 적용된다. 거리가 <#ffb900ff>95,000<>을 넘으면 연결이 끊어진다. 재사용 대기시간: <#ffb900ff>7<>초. 첫 타격은 적 챔피언에게 <#a974ffff>120 + 65% AP<>의 마법 피해를 준다.",
        "skill2": "<#5ad0e6ff>번개 구체<>: 번개 구체가 대상의 마법 저항력을 <#ffb900ff>1.8<>초 동안 <#ffb900ff>8<> 낮추고, <#ffb900ff>115<> + <#ffb900ff>45%<> AP의 마법 피해와 <#ffb900ff>0.8<>초 기절을 준다. 대상에게 이미 표식이 있으면 주변 적에게도 같은 효과가 적용된다. 각 적은 한 번만 맞는다. 재사용 대기시간: <#ffb900ff>11<>초.",
        "ult": "<#e64a6aff>천둥의 분노<>: 지면을 강타해 중심에 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>260 + 110% AP<>, 바깥 고리에 <#ffb900ff>130<> + <#ffb900ff>55%<> AP의 마법 피해를 준다. 이미 표식이 있던 적의 피격 위치에 경고가 남고, <#ffb900ff>0.6<>초 후 폭발해 <#ffb900ff>160<> + <#ffb900ff>72%<> AP의 마법 피해를 준다. 같은 시전의 폭발이 겹쳐도 각 적은 한 번만 맞는다. 재사용 대기시간: <#ffb900ff>32<>초.",
        "passive": "<#5ad0e6ff>초전도<>: 스킬 적중 시 적 영웅과 정글 몬스터에게 <#ffb900ff>5<>초 동안 표식을 남긴다. 이미 표식이 있는 적에게 스킬의 추가 효과가 발동한다. 기본 공격은 표식을 남기지 않으며 표식은 중첩되지 않는다."
      },
      "mlbb_julian": {
        "name": "Julian",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 물리 공격력<>의 물리 피해를 줍니다. 스킬 사용 후 <#ffb900ff>2<>초 동안 기본 공격이 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 물리 공격력<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 55% AP<> 마법 피해를 주며 대상을 Julian 쪽으로 끌어당깁니다.",
        "skill": "<#5ad0e6ff>낫<>: 지정 방향으로 낫을 던져 경로상의 적에게 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>155 + 72% AP<> 마법 피해를 주고 <#ffb900ff>30<>% 둔화시킵니다(<#ffb900ff>1<>초). 미니언은 관통하며 첫 번째 미니언이 아닌 적에서 멈춥니다. 강화: <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>215 + 100% AP<> 마법 피해를 주고 <#ffb900ff>50<>% 둔화시킵니다. 첫 미니언이 아닌 적 또는 최대 사거리에서 낫이 느린 속도로 계속 날아가며 <#ffb900ff>0.1<>초마다 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26 + 11% AP<> 마법 피해를 <#ffb900ff>1.6<>초 동안 줍니다.",
        "skill2": "<#5ad0e6ff>검<>: 비검을 소환해 지정 방향으로 돌진하며 경로상의 적에게 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 52% AP<> 마법 피해를 줍니다. 강화: 다수의 검을 소환해 돌진하는 동안 <#ffb900ff>0.1<>초마다 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 14% AP<> 마법 피해를 최대 <#ffb900ff>6<>회 줍니다. 돌진 중 Julian은 대상 지정 불가 및 은신 상태가 되며 가장 먼 지점에서 다시 나타납니다.",
        "ult": "<#e64a6aff>사슬<>: 지정 위치에 사슬을 내립니다. <#ffb900ff>0.3<>초 후 <#ffb900ff>18,000<> 범위의 적에게 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>112 + 50% AP<> 마법 피해를 주고 <#ffb900ff>1<>초 동안 이동 불가로 만듭니다. 강화: <#ffb900ff>0.2<>초마다 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12 + 6% AP<> 마법 피해를 주고 <#ffb900ff>30<>% 둔화시키며, 종료 시 범위 안에 남은 적에게 <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>205 + 88% AP<> 마법 피해를 주고 <#ffb900ff>0.8<>초 동안 띄웁니다. 사슬이 해금되기 전에는 콤보 중 자동으로 사용됩니다.",
        "passive": "<#5ad0e6ff>대장장이의 유산<>: 서로 다른 스킬을 두 번 사용하면 남은 스킬이 강화됩니다. 강화 사용 시 세 스킬이 모두 <#ffb900ff>9<>–<#ffb900ff>6<>초의 공유 재사용 대기시간에 들어가며 레벨에 따라 감소합니다. 각 스킬은 한 번의 연계에서 한 번만 사용할 수 있고, 미완성 연계는 <#ffb900ff>4<>초 후 사라집니다. 스킬로 적 영웅을 맞히면 <#ffb900ff>10<>% 하이브리드 흡혈을 <#ffb900ff>5<>초 동안 얻으며 최대 <#ffb900ff>30<>%까지 중첩됩니다."
      },
      "mlbb_popol_kupa": {
        "name": "Popol & Kupa",
        "attack": "Popol throws a spear that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact. Kupa bites nearby enemies for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45% AD<> physical damage, increased to <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75% AD<> in Alpha Wolf Form. Kupa’s ordinary bites use Popol’s basic-attack item effects.",
        "skill": "<#5ad0e6ff>Bite ’em, Kupa!<>: Popol throws a spear for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50 + 50% AD<> physical damage and commands Kupa to bite the target for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60 + 60% AD<> physical damage, <#ef5350ff>slowing<> it by <#ffb900ff>50%<> for <#ffb900ff>1s<>. Alpha Wolf Form: the bite instead deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90 + 75% AD<> physical damage to nearby enemies and knocks them <#ef5350ff>airborne<> for <#ffb900ff>0.6s<>.",
        "skill2": "<#5ad0e6ff>Kupa, Help!<>: Popol gains a <#ffb900ff>90 + 50% AD<> shield for <#ffb900ff>3s<> and calls Kupa back. When Kupa arrives, Popol mounts him for up to <#ffb900ff>1.5s<>, gaining <#ffb900ff>50%<> Movement Speed while Kupa recovers <#ffb900ff>25%<> Max HP over the ride. Attacks, other skills and hard crowd control end the ride. Alpha Wolf Form: the shield increases to <#ffb900ff>140 + 70% AD<> and Kupa fully recovers HP at mount start.",
        "ult": "<#e64a6aff>We Are Angry!<>: Kupa fully recovers HP and enters <#5ad0e6ff>Alpha Wolf Form<> for <#ffb900ff>9s<>, gaining <#ffb900ff>35%<> Max HP and enhancing Bite ’em, Kupa! and Kupa, Help! Cooperative stack bonuses are doubled. Requires a living Kupa.",
        "passive": "<#5ad0e6ff>We Are Friends<>: When Popol and Kupa damage the same enemy within <#ffb900ff>2s<>, both gain <#ffb900ff>5%<> Attack Speed and <#ffb900ff>2%<> Movement Speed for <#ffb900ff>4s<>, stacking up to <#ffb900ff>3<> times. Each paired exchange grants one stack.\nKupa has <#ffb900ff>560 + 80 per level after Lv.1 + 50% of Popol’s bonus Max HP<> HP and inherits Popol’s current Armor, Magic Resist and Attack Speed. After <#ffb900ff>5s<> out of combat, Kupa recovers <#ffb900ff>8%<> Max HP per second. If Kupa falls, Popol begins a stationary <#ffb900ff>3s<> prayer after <#ffb900ff>3s<> without combat; movement, damage or another action interrupts it. Successful revival has a <#ffb900ff>30s<> cooldown.\n<#5ad0e6ff>Popol’s Surprise<>: During combat, Popol automatically places a trap every <#ffb900ff>10s<>, up to <#ffb900ff>2<>. Traps arm after <#ffb900ff>0.5s<> and last <#ffb900ff>15s<>. An enemy triggers <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25 + 20% AD<> physical damage and <#ffb900ff>0.6s<> of <#ef5350ff>immobilization<>, leaving frost for <#ffb900ff>3s<> that <#ef5350ff>slows<> enemies by <#ffb900ff>20%<> and reduces Armor by <#ffb900ff>12%<>. Frost from the same Popol does not stack. Placement pauses during casting, recall, riding and prayer."
      },
      "mlbb_granger": {
        "name": "Granger",
        "attack": "Fires a handgun round that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact.",
        "skill": "<#5ad0e6ff>Rhapsody<>: Locks onto an enemy and fires <#ffb900ff>6<> homing rounds over <#ffb900ff>1.5s<>, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>36 + 45% AD<> physical damage and consuming <#ffb900ff>70<> Gun Energy. Requires more than <#ffb900ff>420<> Gun Energy. Movement Speed increases by <#ffb900ff>10%<> while firing. Each hit reduces Rondo’s cooldown by <#ffb900ff>0.5s<>. The final round gains <#ffb900ff>100%<> Critical Chance for its impact. Rondo and Death Sonata can be used during the barrage.",
        "skill2": "<#5ad0e6ff>Rondo<>: Dashes a short distance and restores <#ffb900ff>15%<> of maximum Gun Energy. Walls and movement-disabling effects stop the dash. Equipment cooldown reduction increases Attack instead of shortening Rondo’s effective cooldown.",
        "ult": "<#5ad0e6ff>Death Sonata<>: Consumes <#ffb900ff>250<> Cannon Energy to fire a homing cannon round at an enemy champion. Impact triggers an explosion, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>155 + 110% AD<> physical damage to nearby enemies and <#ef5350ff>slowing<> them by <#ffb900ff>30%<> for <#ffb900ff>0.6s<>. Granger then rolls a short distance away from the firing direction.",
        "passive": "<#5ad0e6ff>Capriccio<>: Uses separate Gun and Cannon Energy pools, each starting at <#ffb900ff>800<>. Gun Energy regenerates at <#ffb900ff>8%<> of its maximum per second; Cannon Energy regenerates at <#ffb900ff>2%<>. Credited lane-minion kills increase maximum Gun Energy by <#ffb900ff>6<> and restore <#ffb900ff>5%<>; jungle kills grant the same benefit to Cannon Energy. Champion kills and assists increase both maxima by <#ffb900ff>12<> and restore <#ffb900ff>10%<>. Capacity growth persists through death. Equipment cooldown reduction grants <#ffb900ff>0.5<> Attack per percentage point, up to <#ffb900ff>20<> Attack."
      },
      "mlbb_hanzo": {
        "name": "Hanzo",
        "attack": "Strikes for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Attack<> physical damage and applies a mark.",
        "skill": "<#5ad0e6ff>Demon Feast<>: At <#ffb900ff>5 marks<>, bites champions for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200 + 7 per level after Lv.1 + 115% bonus Attack<> physical damage, heals and refunds <#ffb900ff>60%<> cooldown. Ordinary camps are devoured, healing <#66cc66ff>20% maximum Health<>.\n<#5ad0e6ff>Soul Snatch<>: Lunges for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>135 + 6 per level after Lv.1 + 95% bonus Attack<> physical damage, increased <#ffb900ff>24% per mark<> against champions and <#ffb900ff>20% per mark<> against other targets. At <#ffb900ff>5 marks<>, adds damage based on maximum Health and heals.\nCooldown: <#ffb900ff>12s / 10s<>.",
        "skill2": "<#5ad0e6ff>Dark Mist<>: Dashes and gains <#ffb900ff>15% Movement Speed<> for <#ffb900ff>2s<>. Leaves <#ffb900ff>5<> mist pulses.\n<#5ad0e6ff>Black Mist<>: Dashes through walls for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110 + 4 per level + 55% bonus Attack<> physical damage and <#ef5350ff>0.4s airborne<>. Leaves <#ffb900ff>4<> pulses.\nMist deals physical damage every <#ffb900ff>0.5s<>, applies marks and <#ef5350ff>slows 35%<>; it cannot critically strike. Cooldown: <#ffb900ff>10s per form<>.",
        "ult": "Projects Hanekage for up to <#ffb900ff>15s<>, leaving an invulnerable body. Gains <#ffb900ff>35% Movement Speed<>, <#ffb900ff>25% Attack Speed<> and wall traversal, with <#ffb900ff>30% less maximum Health<>.\nRecast returns and heals <#66cc66ff>90 + 50% bonus Attack<>. Empty Energy draws the body to Hanekage. Defeat forces a return to the body, <#ef5350ff>slows Hanzo 50% for 6s<> and sets a <#ffb900ff>52s<> cooldown (normally <#ffb900ff>26s<>).",
        "passive": "Basic attacks and mist hits apply up to <#ffb900ff>5 marks<> for <#ffb900ff>6s<>. New hits refresh them. Hanekage starts with <#ffb900ff>100 Energy<> and spends <#ffb900ff>10 per second<>; hits and nearby deaths restore Energy."
      },
      "mlbb_atlas": {
        "name": "Atlas",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Skill casts create a moving frost aura for <#ffb900ff>4s<> and grant <#66cc66ff>10 armor and magic resistance<>. Nearby enemy champions slow up to <#ef5350ff>25%<> and freeze for <#ef5350ff>0.5s<> after 2s of continuous exposure. Freeze cooldown per target: <#ffb900ff>4s<>.",
        "skill": "Slams three times for <#5ad0e6ff>30 + 10% Magic Power<> magic damage per pulse. The suit also slams while separated. Overlapping hits deal <#5ad0e6ff>45 + 15% Magic Power<> once per pulse. Cooldown: <#ffb900ff>7s<>.",
        "skill2": "Ejects for up to <#ffb900ff>2s<>, gaining <#ffb900ff>25% Movement Speed<> while the suit follows. Reunion deals <#5ad0e6ff>65 + 20% Magic Power<> magic damage and <#ef5350ff>stuns for 0.6s<>. Cooldown: <#ffb900ff>10s<>.",
        "ult": "Links nearby enemy champions for <#5ad0e6ff>35 + 10% Magic Power<> magic damage and <#ef5350ff>30% slow<>. After <#ffb900ff>0.4s<>, Atlas pulls them in for <#5ad0e6ff>105 + 25% Magic Power<> magic damage and <#ef5350ff>0.35s airborne<>. While ejected, reunites immediately with a <#ef5350ff>40% slow<> in place of the reunion hit. Cooldown: <#ffb900ff>34s<>."
      },
      "mlbb_yu_zhong": {
        "name": "Yu Zhong",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage. Soul Grip can empower the next basic attack.",
        "passive": "Basic attacks and direct skill hits apply Sha Residue to enemy heroes and jungle monsters, including Morgard and Serpen, for <#ffb900ff>5s<>. At three marks, the target pulses five times. Each pulse deals <#ff9028ff>32 + 18% Attack + 2% of the target’s missing HP<> as physical damage and heals Yu Zhong for <#66cc66ff>8% of his missing HP<>. Against jungle monsters, the missing-HP damage bonus is capped at 40 per pulse. When the eruption starts, Yu Zhong gains 15% Movement Speed for 1.5s.",
        "skill": "After 0.4s, sweeps nearby enemies for <#ff9028ff>80 + 65% Attack<> physical damage. The outer edge instead deals <#ff9028ff>138 + 95% Attack<> and applies two marks to eligible targets. Cooldown is 7s.",
        "skill2": "Sends a wave that deals <#ff9028ff>95 + 68% Attack<> physical damage and slows by 30% for 1s. On hit, the next basic attack within 3s deals <#ff9028ff>55 + 40% Attack<> extra physical damage and can lunge toward the champion struck by Soul Grip if the route is clear. Hitting a champion at a useful distance triggers Furious Dive if the landing is safe. The leap deals damage on landing and allows one short dash in his movement direction. After 0.4s, the original landing area erupts, knocking enemy champions airborne for 0.5s. Both hits deal a combined <#ff9028ff>64 + 45% Attack<> physical damage. Cooldown is 10s.",
        "ult": "Channels for 0.6s, then flies as a dragon for up to 3.5s with 35% Movement Speed, wall traversal and crowd-control immunity. Passing an enemy hero deals <#ff9028ff>125 + 85% Attack<> physical damage and knocks them back once. On landing, enters Dragonoid Form for 15s, increasing skill reach and width by 20%. Cooldown is 46s."
      }
    },
