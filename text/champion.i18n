  "ru": {
    "description": {
      "mlbb_valir": {
        "name": "Valir",
        "attack": "Throws an ember that deals <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Direct spell hits apply Ablaze for <#ffb900ff>3s<>. The burn deals <#5ad0e6ff>0.8% max HP<> magic damage per second. At <#ffb900ff>3 stacks<>, it detonates for <#5ad0e6ff>4% max HP + 25% Magic Power<> magic damage and <#ef5350ff>stuns for 0.65s<>. Stun cooldown per target is <#ffb900ff>8s<>. Monster damage is capped. Bosses are immune to the stun.",
        "skill": "Fires a bolt that deals <#5ad0e6ff>70 + 65% Magic Power<> magic damage and <#ef5350ff>slows by 25% for 0.7s<>. The impact area bursts after <#ffb900ff>0.75s<> for <#5ad0e6ff>42 + 30% Magic Power<> magic damage. Stores <#ffb900ff>2 charges<> and restores one every <#ffb900ff>9s<>. A direct hit on a champion or boss refunds a charge up to once every <#ffb900ff>3.6s<>. Hitting a lane minion takes <#ffb900ff>2s<> off the recharge. Minimum recast is <#ffb900ff>1.8s<>.",
        "skill2": "Sends a wave that deals <#5ad0e6ff>95 + 65% Magic Power<> magic damage and <#ef5350ff>knocks back enemy champions, lane minions and regular jungle monsters<>. While empowered, it leaves a firewall for <#ffb900ff>3s<> that deals <#5ad0e6ff>27 + 22% Magic Power<> magic damage each second and briefly <#ef5350ff>slows by 20%<>. Cooldown is <#ffb900ff>10s<>.",
        "ult": "Can activate automatically when ready to <#ef5350ff>break a stun or other supported disable<>. Suppression still applies. Grants <#ffb900ff>30% Movement Speed<>, tapering over <#ffb900ff>3s<>. Empowers the next <#ffb900ff>4 casts<> within <#ffb900ff>9s<>. Fireball gains <#ffb900ff>30% projectile reach<> and Torrent leaves a firewall. Cooldown is <#ffb900ff>42s<>."
      },
      "mlbb_lesley": {
        "name": "Lesley",
        "attack": "Fires a rifle shot for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "<#5ad0e6ff>Lethal Shot<>. Casting a skill or going 5s without taking damage readies the next basic. It gains <#ffb900ff>17 range<> and deals <#ff9028ff>75 + 110% Attack<> true damage to champions or <#ff9028ff>75 + 125% Attack<> physical damage to lane and jungle enemies. Structures take normal basic damage.",
        "skill": "<#5ad0e6ff>Master of Camouflage<>. Camouflages for up to <#ffb900ff>2.5s<> and gains 30% Movement Speed. Enemies lose direct targeting, but area effects can still hit her. Attacking, casting another skill, or taking damage after the first 0.5s ends camouflage.",
        "skill2": "<#5ad0e6ff>Tactical Grenade<>. Deals <#ff9028ff>115 + 65% Attack<> physical damage in a short cone and pushes surviving enemy champions away. Lesley hops backward if the path is clear. During Ultimate Snipe, she fires an available round before ending the volley.",
        "ult": "<#e64a6aff>Ultimate Snipe<>. Locks onto an enemy champion and fires up to <#ffb900ff>four rounds<>. Each deals <#ff9028ff>70 + 32% Attack + 6% of the target’s missing HP<> as physical damage. Another enemy champion in the firing line can intercept a round."
      },
      "mlbb_aldous": {
        "name": "Алдус",
        "attack": "Бьёт огромной lava-перчаткой, нанося <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>физического урона<>.",
        "skill": "<#ff9028ff>Контракт: Кража душ<> : основная цель получает <#ff9028ff>40 + уровень + 100% AD + 2,5 урона за заряд Кражи душ<> физического урона; ближайшие враги получают <#ff9028ff>40%<>splash-урона. При <#ffb900ff>1 000<> зарядах бонус — <#ffb900ff>+2 500 чистого урона<> до защиты.",
        "skill2": "<#ffb900ff>Контракт: Взрыв<> : призывает пылающий рунический барьер на <#ffb900ff>2 с<> (<#ffb900ff>90<> щита, <#ffb900ff>+25%<> скорости), затем взрывается, нанося <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>физического урона<> и <#ef5350ff>оглушая<> врагов на <#ffb900ff>1 с<>.",
        "ult": "<#e64a6aff>Контракт: Погоня за судьбой<> : фиксирует <#e64a6aff>Око судьбы<> на враге и пронзает арену lava-метеором, нанося <#ff9028ff>130<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160% AD<> <#ff9028ff>физического урона<> и <#ef5350ff>оглушение<> на <#ffb900ff>1,2 с<>.",
        "passive": "Контракт: Трансформация — Алдус поглощает энергию душ: <#ffb900ff>+1<> заряд каждые <#ffb900ff>5 с<>, <#ffb900ff>+10<> за убийство и больше при попадании <#5ad0e6ff>Кражи души<> (максимум <#ffb900ff>1 000<>). Каждая <#ffb900ff>3-я<> базовая атака (перезарядка <#ffb900ff>5 с<>) превращает заряды в щит на <#ffb900ff>2 с<>: <#ffb900ff>35<> + <#ffb900ff>5<> за уровень + <#ffb900ff>0,45<> за заряд. Заряды также усиливают <#5ad0e6ff>Кражу души<>."
      },
      "mlbb_alpha": {
        "name": "Альфа",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "passive": "<#5ad0e6ff>Бета, вперёд!<> Каждое третье подходящее попадание по вражескому герою вызывает лазер Беты. Он наносит 30 + 3 за уровень после первого + 15% атаки физического урона и замедляет на 30% на 1 с.",
        "skill": "<#5ad0e6ff>Роторный удар<> Волна наносит 70 + 80% атаки физического урона и замедляет на 40% на 1 с. Бета дополнительно наносит 25 + 1 за уровень после первого + 20% атаки чистого урона.",
        "skill2": "<#5ad0e6ff>Силовой замах<> Взмах наносит 100 + 80% атаки физического урона. Бета наносит ещё 25 + 1 за уровень после первого + 20% атаки чистого урона. Альфа восстанавливает 100 + 20% атаки здоровья один раз за применение.",
        "ult": "<#e64a6aff>Копьё Альфы<> Бета пикирует, нанося 70 + 20% атаки физического урона и оглушая на 1 с. Приземление Альфы наносит 130 + 80% атаки физического урона, подбрасывает на 0,67 с и замедляет на 30% на 1,25 с. Бета наносит пять ударов по 8 + 10% атаки физического урона."
      },
      "mlbb_arlott": {
        "name": "Арлотт",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "passive": "<#5ad0e6ff>Взор демона<> : помечает ближайшего вражеского героя каждые <#ffb900ff>7 с<>, а также любого врага, задетого эффектами контроля Арлотта. По <#e64a6aff>меченой<> цели Возмездие наносит двойной урон. Метка длится <#ffb900ff>7 с<>.",
        "skill": "<#5ad0e6ff>Бесстрашный удар<> : опускает копьё вниз, нанося <#ff9028ff>110 + 55% общей физической атаки<> физического урона по линии и <#ef5350ff>оглушая<>. Чем <#ffb900ff>дальше<> цель, тем <#ffb900ff>дольше<> оглушение — от <#ffb900ff>0,5 с<> вблизи до <#ffb900ff>1 с<> на краю. Удар помечает задетых.",
        "skill2": "<#5ad0e6ff>Возмездие<> : бросается к врагу, нанося <#ff9028ff>100 + 55% общей физической атаки<> физического урона и помечая цель. Арлотта <#ffb900ff>нельзя прервать<> во время рывка. По <#e64a6aff>меченой<> цели наносит <#ffb900ff>двойной<> урон, <#ffb900ff>сбрасывает перезарядку<> и исцеляет на <#ffb900ff>30% общей физической атаки<> (половина против не-героев).",
        "ult": "<#e64a6aff>Финальный разрез<> : широкий взмах двумя копьями, наносящий <#ff9028ff>160 + 75% общей физической атаки<> физического урона и <#ffb900ff>притягивающий<> всех врагов к <#ffb900ff>правой стороне<> Арлотта. Каждый перемещённый враг остаётся <#e64a6aff>меченым<>."
      },
      "mlbb_balmond": {
        "name": "Балмонд",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "passive": "<#5ad0e6ff>Жажда крови<> : восстанавливает <#ffb900ff>5%<> макс. HP после убийства миньона или монстра и <#ffb900ff>10%<> после убийства героя или ассиста.",
        "skill": "<#5ad0e6ff>Оковы души<> : бросается к выбранному вражескому герою, раня врагов на прямой траектории на <#ff9028ff>150–275 + 60% общей физической атаки<> физического урона. Задетый герой ненадолго отбрасывается и замедляется на <#ffb900ff>40%<> на <#ffb900ff>3 с<>. Прототип TFM2 целится в точку и бросается туда; урон по прямой сохраняется, удар получает ближайший враг у точки прибытия.",
        "skill2": "<#5ad0e6ff>Вихрь-сметание<> : крутится <#ffb900ff>3 с<>, нанося урон 14 импульсами. Каждое попадание наносит <#ff9028ff>24–44 + 1,3% общего HP + 25% общей физической атаки<> физического урона и снижает физическую защиту цели на <#ffb900ff>5%<> за попадание, до <#ffb900ff>8 зарядов<>. Даёт <#ffb900ff>15%<> скорости передвижения.",
        "ult": "<#e64a6aff>Смертельный ответ<> : бьёт по широкой зоне впереди, нанося <#ff9028ff>150 + 70% общей физической атаки + 30–45% потерянного HP каждой цели<> чистым уроном. Урон не-героям ограничен <#ffb900ff>1 000 / 1 500 / 2 000<> по уровню героя."
      },
      "mlbb_chou": {
        "name": "Чоу",
        "attack": "Обычные атаки наносят 100% AD физического урона.",
        "passive": "<#5ad0e6ff>Только быстро<> : пройдя около <#ffb900ff>42 000<> единиц мира TFM2, следующая обычная атака Чоу наносит <#ff9028ff>180% AD<> физического урона, замедляет на <#ffb900ff>80%<> на <#ffb900ff>1 с<> и снижает физическую защиту на <#ffb900ff>10<> на <#ffb900ff>2 с<> (до <#ffb900ff>2<> зарядов). Дистанция подстроена под масштаб карты TFM2.",
        "skill": "<#ff9028ff>Джит Кун-До<> : до <#ffb900ff>3<> применений: восходящий удар ногой, рывок-апперкот, затем прыжок с ударом вниз, подбрасывающий врагов. Каждое попадание наносит <#ff9028ff>100–165 + 45% общей физической атаки<>. Первые два применения сбрасывают навык, продолжая комбо; третье запускает перезарядку. Если третье применение попадает по вражескому чемпиону, перезарядка Шунпо сбрасывается.",
        "skill2": "<#5ad0e6ff>Шунпо<> : рывок в выбранном направлении с <#ffb900ff>иммунитетом к контролю<> во время рывка. По прибытии даёт щит <#5bd18aff>200–300 + 100% доп. физической атаки<> и <#ffb900ff>15<> физического пробивания на <#ffb900ff>2,5 с<>.",
        "ult": "<#e64a6aff>Путь дракона<> : круговой удар ногой по вражескому чемпиону на <#ff9028ff>275–420 + 110% доп. физической атаки<> с отбрасыванием. Если та же цель остаётся в пределах досягаемости, Чоу догоняет её и наносит четыре удара, суммарно нанося <#ff9028ff>330–500 + 132% доп. физической атаки<> физического урона."
      },
      "mlbb_estes": {
        "name": "Эстес",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "passive": "<#5ad0e6ff>Писание лунного эльфа<> : даёт <#ffb900ff>1<> заряд в секунду, или <#ffb900ff>2<> пока активна связь «Лунное погружение». При 100 зарядах следующая обычная атака усиливается: <#a974ffff>магический урон<>, до 2 рикошетов и замедление на <#ffb900ff>40%<> на <#ffb900ff>1,5 с<>. Шкала отображается на навыке 1.",
        "skill": "<#5ad0e6ff>Лунное погружение<> : исцеляет союзного героя на <#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85% AP<> сразу, затем <#5bd18aff>24<> + <#a974ffff>18% AP<> каждые <#ffb900ff>0,5 с<> в течение <#ffb900ff>5 с<>. Даёт союзнику <#ffb900ff>+7<> физ. и маг. защиты, а Эстесу <#ffb900ff>+15%<> скорости. Связь и бонус заряда пропадают дальше <#ffb900ff>120 000<>; лечение-в-время завершает свою длительность.",
        "skill2": "<#5ad0e6ff>Владение Лунной богини<> : создаёт <#5ad0e6ff>неподвижную<> зону лунного света на <#ffb900ff>2,5 с<>. Каждые <#ffb900ff>0,5 с<> враги в радиусе <#ffb900ff>52 000<> получают <#a974ffff>15<> + <#a974ffff>45% AP<> магического урона и замедляются на <#ffb900ff>35%<> на <#ffb900ff>0,75 с<>. Версия TFM2 замедляет внутри зоны, а не только по внешнему краю.",
        "ult": "<#5ad0e6ff>Благословение Лунной богини<> : мгновенно исцеляет союзников в радиусе <#ffb900ff>105 000<> на <#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65% AP<>; затем восстанавливает <#5bd18aff>20<> + <#a974ffff>12% AP<> каждые <#ffb900ff>0,5 с<> в течение <#ffb900ff>8 с<> и даёт <#ffb900ff>+8<> физ. и маг. защиты."
      },
      "mlbb_fanny": {
        "name": "Фанни",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "passive": "<#ff9028ff>Воздушное превосходство<> : во время полёта на тросе Фанни получает <#ffb900ff>10–25%<> доп. урона в зависимости от скорости полёта. Попадание по вражескому чемпиону в полёте накладывает или усиливает <#ff9028ff>Метку добычи<> (макс. 2 заряда, <#ffb900ff>5 с<>) и вызывает Удар торнадо.",
        "skill": "<#ff9028ff>Удар торнадо<> : наносит <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<> в радиусе <#ffb900ff>22 000<>. Во время полёта на Стальном тросе столкновение с врагом автоматически вызывает Удар торнадо в воздухе на <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70% AD<> и накладывает Метку добычи на вражеских чемпионов.",
        "skill2": "<#ff9028ff>Стальной трос<> : бросает трос (дальность <#ffb900ff>165 000<>) к лучшей стене или внешней границе линии и проносит Фанни через препятствие к цели, совершая серию прыжков через стены по карте с затратой <#ffb900ff>0<> энергии. В приоритете видимые вражеские чемпионы, иначе — ближайшие монстры джунглей.",
        "ult": "<#ff9028ff>Перерезание горла<> : бросается к цели и наносит <#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125% AD<>; каждая Метка добычи добавляет <#ff9028ff>35% AD<> (до 2 меток). Успешное попадание расходует метки."
      },
      "mlbb_franco": {
        "name": "Франко",
        "attack": "Размахивает боевым молотом, нанося <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>физического урона<>.",
        "passive": "<#5ad0e6ff>Сила пустошей<> : после <#ffb900ff>5 с<> без получения урона Франко получает <#ffb900ff>10%<> скорости передвижения, восстанавливает <#ffb900ff>1%<> макс. HP в секунду и копит до <#ffb900ff>10<> зарядов. Следующий навык расходует их все, давая до <#ffb900ff>+150%<> урона.",
        "skill": "<#5ad0e6ff>Железный крюк<> : запускает крюк, цепляющий первого врага, нанося <#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>физического урона<> и притягивая его к Франко. Крюк сначала <#ef5350ff>оглушает<>, затем тянет — цель, которую нельзя сдвинуть, всё равно обездвижена.",
        "skill2": "<#5ad0e6ff>Яростный разряд<> : бьёт, нанося <#ff9028ff>160<> + <#ff9028ff>4%<> от <#ffb900ff>макс. HP<> Франко <#ff9028ff>физического урона<> ближайшим врагам и <#ffb900ff>замедляя<> их на <#ffb900ff>70%<> на <#ffb900ff>1,5 с<>. Применимо к монстрам джунглей и объектам.",
        "ult": "<#e64a6aff>Кровавая охота<> : <#ef5350ff>подавляет<> вражеского героя на <#ffb900ff>1,8 с<> и бьёт его <#ffb900ff>шесть<> раз, чередуя молот и крюк, по <#ff9028ff>50<> + <#ff9028ff>70% AD<> за удар. Способность прерывается, если Франко попадает под контроль."
      },
      "mlbb_gusion": {
        "name": "Гусион",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "passive": "<#5ad0e6ff>Мастер клинков<> : каждое применение навыка даёт <#ffb900ff>1 Руну<>, до <#ffb900ff>4<>. Следующая обычная атака расходует все Руны; каждая наносит <#a974ffff>3% макс. HP цели<> магическим уроном и восстанавливает <#5bd18aff>50 + 25% AP<> HP (до 12% макс. HP урона и 200 + 100% AP лечения).",
        "skill": "<#5ad0e6ff>Клинок-шип<> : бросает кинжал в первого врага, нанося <#a974ffff>200 + 50% общей магической силы<> магического урона и помечая его на <#ffb900ff>5 с<>. Повторное применение — рывок за спину меченой цели и <#a974ffff>200 + 100% общей магической силы<> магического урона.",
        "skill2": "<#a974ffff>Резня теневого клинка<> : бросает <#ffb900ff>5 кинжалов<> веером; каждое попадание наносит <#a974ffff>65 + 40% общей магической силы<> магического урона. Повторное применение возвращает их. После сброса ультимейтом навык 2 может метнуть второй веер, прежде чем вернуть оба набора.",
        "ult": "<#e64a6aff>Накал<> : бросается за спину выбранного врага и сбрасывает навыки 1 и 2. Если кинжалы навыка 2 уже выпущены, примените его снова для второго набора; следующее применение вернёт оба набора. Повторное применение в течение <#ffb900ff>2,5 с<> — ещё один рывок."
      },
      "mlbb_hanabi": {
        "name": "Ханаби",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "passive": "<#5ad0e6ff>Ниндзюцу: Шквал лепестков<> : обычные атаки и попадания навыков запускают Лепестковые клинки, рикошетящие по ближайшим врагам. Пока у Ханаби есть <#ffb900ff>любой источник щита<>, она невосприимчива к эффектам контроля. Это не снимает уже наложенный контроль.",
        "skill": "<#5ad0e6ff>Ниндзюцу: Равноденствие<> : получает щит <#ff9028ff>120 + 35% AD<> на <#ffb900ff>5 с<> плюс <#ffb900ff>12%<> скорости передвижения и <#ffb900ff>20%<> скорости атаки. Пока щит активен, <#ffb900ff>20%<> урона по героям и <#ffb900ff>10%<> урона по прочим целям добавляются к щиту. Лимит щита — <#ffb900ff>50% макс. HP<>; в реализации все слои щита считаются в этом лимите. Любой щит также даёт пассивную невосприимчивость к контролю.",
        "skill2": "<#5ad0e6ff>Ниндзюцу: Свиток души<> : выпускает пробивающий снаряд из куная и свитка, нанося <#ff9028ff>65 + 75% AD<> физического урона врагам на пути и замедляя их на <#ffb900ff>30%<> на <#ffb900ff>1 с<>. Каждая цель помечается на <#ffb900ff>5 с<>. Следующий рикошет лепестка от обычной атаки по меченой цели добавляет <#ff9028ff>20 + 50% AD<> урона без обычного затухания, затем расходует метку.",
        "ult": "<#e64a6aff>Запретное дзюцу: Хиганбана<> : бросает большую Хиганбану в первого вражеского героя, нанося <#ff9028ff>150 + 80% AD<> физического урона и связывая его на <#ffb900ff>0,8 с<>. Через <#ffb900ff>0,8 с<> она расцветает в этой точке, нанося <#ff9028ff>105 + 55% AD<> физического урона в радиусе <#ffb900ff>34 000<>. Остальные задетые враги замедляются на <#ffb900ff>20%<> на <#ffb900ff>0,6 с<>."
      },
      "mlbb_karrie": {
        "name": "Керри",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>физического урона<> одним светоколесом.",
        "passive": "<#5ad0e6ff>Метка светоколеса<> : обычные атаки и навыки 1 и 2 добавляют <#ffb900ff>1 метку<>. При <#ffb900ff>5 метках<> они взрываются, нанося <#ff9028ff>4% макс. HP цели<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% AD<> <#e64a6aff>чистым уроном<>, с лимитом <#ffb900ff>250<> по героям и <#ffb900ff>300<> по монстрам джунглей/эпическим.",
        "skill": "<#5ad0e6ff>Вращающееся светоколесо<> : бросает кольцевое светоколесо в выбранном направлении. При попадании наносит <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<> физического урона основной цели и <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35% AD<> физического урона ближайшим врагам, кроме башен, замедляя их на <#ffb900ff>35%<> на <#ffb900ff>1 с<>. Попадание оставляет фиолетовую зону замедления на <#ffb900ff>1,5 с<>; враги внутри снова замедляются на <#ffb900ff>35%<> и получают два импульса по <#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% AD<> физического урона с интервалом <#ffb900ff>0,5 с<>. Эти импульсы не дают дополнительных Меток.",
        "skill2": "<#5ad0e6ff>Призрачный шаг<> : рывок на фиксированное расстояние к выбранной точке, затем выстрел по ближайшей цели у места приземления. Наносит <#ff9028ff>75 + 70% общей физической атаки<>; пока активно Быстрое светоколесо, коэффициент становится <#ff9028ff>100%<>. Накладывает <#ffb900ff>1 Метку светоколеса<>.",
        "ult": "<#e64a6aff>Быстрое светоколесо<> : на <#ffb900ff>6 с<> даёт <#ffb900ff>+20%<> скорости передвижения и <#ffb900ff>+35%<> скорости атаки. Пока активно, Призрачный шаг наносит <#ff9028ff>75 + 100% общей физической атаки<>."
      },
      "mlbb_lancelot": {
        "name": "Ланселот",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "passive": "<#5ad0e6ff>Рассекатель душ<> : Пронзание и Призрачная казнь дают <#ffb900ff>7,5%<> доп. урона на <#ffb900ff>4 с<> за заряд, до <#ffb900ff>4 зарядов (30%)<>.",
        "skill": "<#ff9028ff>Пронзание<> : рывок к выбранному врагу, нанося <#ff9028ff>80–178 + 40% AD<> физического урона. Первый немеченый враг получает <#5ad0e6ff>Метку клинка<>; новая метка сбрасывает Пронзание. Каждое применение даёт заряд <#ffb900ff>Рассекателя душ<>.",
        "skill2": "<#ffb900ff>Тернистая роза<> : три волны ударов, каждая наносит <#ff9028ff>85–155 + 30% AD<> физического урона и замедляет задетых врагов на <#ffb900ff>20%<> на <#ffb900ff>0,5 с<>. Ланселот невосприимчив к урону и контролю во время серии; наложения используют штраф за толпу.",
        "ult": "<#e64a6aff>Призрачная казнь<> : рывок к выбранному вражескому чемпиону и <#ff9028ff>100–156 + 100% AD<> физического урона по прибытии. Ланселот невосприимчив к урону и контролю во время рывка и получает заряд <#ffb900ff>Рассекателя душ<>."
      },
      "mlbb_uranus": {
        "name": "Уран",
        "attack": "Обычные атаки бьют рукой Урана, нанося <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>физического урона<>. Обычные атаки <#ffb900ff>не накладывают<> метки Ионного лезвия.",
        "passive": "<#5ad0e6ff>Сияние<> : получение урона даёт <#ffb900ff>1 заряд<> (до <#ffb900ff>12<>, каждый длится <#ffb900ff>10 с<>, не более одного за <#ffb900ff>1 с<>). Каждые <#ffb900ff>0,8 с<> Уран исцеляется на <#5bd18aff>28–134 HP при 12 зарядах<>, в зависимости от уровня.",
        "skill": "<#5ad0e6ff>Ионное лезвие<> : пускает два клинка вперёд и обратно; каждое попадание наносит <#a974ffff>79–131 (+18% общей магической силы)<> магического урона и замедляет на <#ffb900ff>30%<> на <#ffb900ff>2 с<>. Каждый клинок может попасть по цели один раз. За применение накладывается не более <#ffb900ff>1 Ионной метки на цель<> на <#ffb900ff>6 с<>; каждая метка повышает последующий урон навыка 1 на <#ffb900ff>20%<>, до <#ffb900ff>8 меток<>; Башни и Нексус не помечаются.",
        "skill2": "<#5ad0e6ff>Трансцендентный доспех<> : рывок к выбранной точке. Враги на пути получают <#a974ffff>48–120 (+12% общей магической силы)<> магического урона; враги у точки прибытия — <#a974ffff>96–240 (+48% общей магической силы)<> и замедление на <#ffb900ff>25%<>. Даёт щит <#5bd18aff>300–750 (+200% общей магической силы)<> на <#ffb900ff>4 с<>. При разрушении или истечении он взрывается, нанося <#a974ffff>156–390 (+78% общей магической силы)<> магического урона рядом.",
        "ult": "<#e64a6aff>Освящение<> : снимает <#ef5350ff>весь контроль<> (версия TFM2; в исходнике снимаются только замедления), восстанавливает <#5bd18aff>200–400 HP<> и даёт <#ffb900ff>60%<> скорости передвижения, спадающей за <#ffb900ff>8 с<>. Добавляет <#ffb900ff>5–12 зарядов Сияния<>. На <#ffb900ff>8 с<> повышает реген HP и щит Трансцендентного доспеха Урана на <#ffb900ff>20%<>."
      },
      "mlbb_zhask": {
        "name": "Жаск",
        "attack": "Выпускает теневую стрелу, нанося <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>физического урона<>.",
        "passive": "<#5ad0e6ff>Истребление<> : при смерти Жаск призывает неистового Потомка на месте гибели. Тот живёт до <#ffb900ff>6 с<> и теряет <#ffb900ff>2%<> макс. HP каждую секунду.",
        "skill": "<#5ad0e6ff>Кошмарный потомок<> : призывает неподвижного Потомка до <#ffb900ff>12 с<>. Он наследует <#ffb900ff>55–100%<> HP, защиты и магической силы Жаска по уровню. Его Луч смерти бьёт каждые <#a974ffff>15 тиков (0,25 с)<> на <#a974ffff>30 (+25% магической силы)<> магического урона и замедляет на <#ffb900ff>30%<> на <#ffb900ff>36 тиков (0,6 с)<>. Прицельтесь снова, чтобы переместить его. Если Жаск отойдёт дальше <#ffb900ff>120 000<> единиц, Луч приостанавливается до его возвращения в радиус.",
        "skill2": "<#5ad0e6ff>Пожиратель разума<> : выпускает пробивающий снаряд, нанося <#a974ffff>87 + 6 за уровень выше 1-го (+60% магической силы)<> магического урона и <#ef5350ff>оглушая<> задетых врагов на <#ffb900ff>30 тиков (0,5 с)<>. Если Потомок жив, он добивает каждого задетого врага на <#a974ffff>35 (+50% магической силы)<> доп. магического урона.",
        "ult": "<#e64a6aff>Нисхождение Властителя<> : телепортируется в точку и создаёт слитого Потомка до <#ffb900ff>10 с<>. Жаск исчезает из виду, по нему нельзя попасть, и управление блокируется на время слияния. Слитый Потомок наследует 100% характеристик Жаска; урон его Луча смерти умножен на <#ffb900ff>×1,8<>."
      },
      "mlbb_obsidia": {
        "name": "Обсидия",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 65% физической атаки<> физического урона.",
        "passive": "<#5ad0e6ff>Возвращение в кость<>：нанесение урона врагу даёт Костную энергию — <#ffb900ff>2<> за обычную атаку по герою, <#ffb900ff>4<> за попадание навыка, <#ffb900ff>1<> за удар по миньону или башне. Монстры джунглей не дают энергии. Каждые <#ffb900ff>30<> энергии выковывают осколок кости, максимум <#ffb900ff>25<>. Каждый осколок добавляет к её обычной атаке <#ffb900ff>7%<> от общей физической атаки. Убийство вражеского героя сразу даёт осколок.",
        "skill": "<#5ad0e6ff>Бездонная костяная игла<>：запускает костяную иглу по прямой, нанося задетым врагам <#ff9028ff>90–140 + 60% общей физической атаки<> физического урона и давая Костную энергию за первого задетого вражеского героя.",
        "skill2": "<#5ad0e6ff>Призрачный уход в тень<>：погружается в Бездну, совершая рывок в указанном направлении и получая <#ffb900ff>+20% к скорости передвижения<> на <#ffb900ff>0,3 с<>.",
        "ult": "<#e64a6aff>Охота за костью<>：выпускает Кости гнева, нанося <#ff9028ff>55 + 50% общей физической атаки<> физического урона, ненадолго <#ffb900ff>оглушая<> первого задетого вражеского героя и <#ffb900ff>притягивая себя к нему<>. Сковывает его на <#ffb900ff>3 с<>：она не может отойти дальше чем на <#ffb900ff>4 единицы<>, враг не может использовать навыки перемещения, и его движение тянет её за собой. Она получает <#ffb900ff>5 временных осколков кости<> сверх предела, <#ffb900ff>щит<> и <#ffb900ff>+30% к скорости атаки<>. Может проходить сквозь препятствия и наносить обычные атаки в движении, а Призрачный уход в тень длится <#ffb900ff>1 с<>."
      },
      "mlbb_gord": {
        "name": "Горд",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% силы атаки<> физического урона на большой дистанции.",
        "passive": "<#5ad0e6ff>Мистическая милость<>: каждые <#ffb900ff>3<> попадания умениями по врагу заряжают следующее попадание, которое наносит дополнительно <#a974ffff>12 (+2 за уровень) (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>8% магической силы) истинного урона<> и замедляет цель на <#ffb900ff>20%<> на <#ffb900ff>1 с<>. Замедление складывается до <#ffb900ff>2<> раз, до <#ffb900ff>40%<>.",
        "skill": "<#5ad0e6ff>Мистический снаряд<>: выпускает сгусток энергии, который останавливается на первом задетом враге и взрывается, нанося <#a974ffff>105 + 52% магической силы<> магического урона и <#ffb900ff>оглушая<> на <#ffb900ff>1 с<>.",
        "skill2": "<#5ad0e6ff>Мистический запрет<>: создаёт в указанной точке поле энергии на <#ffb900ff>4 с<>, нанося <#a974ffff>6 + 12% магической силы<> магического урона каждые <#ffb900ff>0,25 с<> — до <#ffb900ff>16<> раз.",
        "ult": "<#e64a6aff>Мистический поток<>: выпускает луч энергии в течение <#ffb900ff>3,2 с<>, нанося <#a974ffff>12 + 17% магической силы<> магического урона каждые <#ffb900ff>0,2 с<> — до <#ffb900ff>16<> раз. Каждая волна заново наводится на ближайшего вражеского чемпиона впереди."
      },
      "mlbb_belerick": {
        "name": "Белерик",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% силы атаки<> физического урона. Пока действует <#5ad0e6ff>Удар природы<>, атака вместо этого наносит <#a974ffff>60<> магического урона, восстанавливает <#ffb900ff>150 + 12% потерянного HP<> и замедляет цель на <#ffb900ff>60%<> на <#ffb900ff>1,4 с<>.",
        "passive": "<#5ad0e6ff>Смертельные шипы<>: каждый <#ffb900ff>4-й<> раз, когда Белерика ударяют, он выпускает шип в ближайшего врага, нанося <#a974ffff>10 (+1 за уровень) + 1% макс. HP<> магического урона. Урон меньше <#ffb900ff>10<> не учитывается, срабатывает не чаще раза в <#ffb900ff>1,2 с<>, башни его не вызывают.",
        "skill": "<#5ad0e6ff>Древнее семя<>: выпускает лозы по прямой, нанося <#a974ffff>115<> магического урона и замедляя задетых врагов на <#ffb900ff>25%<> на <#ffb900ff>2 с<>. Через <#ffb900ff>1,1 с<> семена лопаются на том же пути, нанося <#a974ffff>115<> магического урона и <#ffb900ff>провоцируя<> их на <#ffb900ff>1,2 с<>.",
        "skill2": "<#5ad0e6ff>Удар природы<>: получает <#ffb900ff>+60%<> скорости передвижения на <#ffb900ff>1 с<>, затем <#ffb900ff>+20%<> на <#ffb900ff>1 с<> и усиливает следующую обычную атаку на <#ffb900ff>3 с<>. Каждый раз, когда срабатывают <#5ad0e6ff>Смертельные шипы<>, перезарядка уменьшается на <#ffb900ff>1 с<>.",
        "ult": "<#e64a6aff>Гнев дриады<>: призывает лозы, расходящиеся <#ffb900ff>4<> волнами; каждая наносит <#a974ffff>55<> магического урона и <#ffb900ff>провоцирует<> задетых врагов на <#ffb900ff>1,5 с<>."
      },
      "mlbb_cecilion": {
        "name": "Сесилион",
        "attack": "Обычные атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона на большой дистанции.",
        "passive": "<#5ad0e6ff>Переполнение<>: каждый раз, когда умение Сесилиона попадает по врагу, он получает <#ffb900ff>1<> заряд, не чаще одного раза в <#ffb900ff>1 с<>. Каждый заряд даёт ему <#a974ffff>+3 к силе магии<> до конца матча, и заряды сохраняются после смерти.",
        "skill": "<#5ad0e6ff>Удар летучей мыши<>: посылает гигантскую летучую мышь, которая наносит <#a974ffff>30 + 25% от общей силы магии<> магического урона врагам на пути. Достигнув цели, мышь пикирует и наносит <#a974ffff>55 + 50% от общей силы магии<> магического урона.",
        "skill2": "<#5ad0e6ff>Кровавые когти<>: отмечает область. Через <#ffb900ff>0,6 с<> когти крови смыкаются на ней, нанося <#a974ffff>60 + 60% от общей силы магии<> магического урона задетым врагам и <#ffb900ff>оглушая<> их на <#ffb900ff>1 с<> и притягивает к центру области.",
        "ult": "<#e64a6aff>Пир летучих мышей<>: выпускает <#ffb900ff>40<> кровавых снарядов за <#ffb900ff>3 с<>, каждый из которых поражает ближайшего вражеского чемпиона, нанося <#a974ffff>5 + 8% от общей силы магии<> магического урона; он может двигаться во время применения, получает <#a974ffff>+60% к скорости передвижения<> на <#ffb900ff>1,5 с<> и восстанавливает <#a974ffff>8<> здоровья за каждый снаряд."
      },
      "mlbb_johnson": {
        "name": "Джонсон",
        "attack": "Размахивает тяжёлым ключом, нанося <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% AD<> <#ff9028ff>физического урона<>.",
        "passive": "<#5ad0e6ff>Электронная подушка<>: когда здоровье Джонсона падает ниже <#ffb900ff>30%<>, он получает щит на <#a974ffff>120 (+240% от общей физической защиты)<> на <#ffb900ff>10 с<>. Перезарядка <#ffb900ff>100 с<>.",
        "skill": "<#5ad0e6ff>Ударный ключ<>: бросает ключ, нанося <#a974ffff>80 (+110% от общей физической защиты)<> магического урона врагам на пути. Враги у точки приземления оглушаются на <#ffb900ff>0,8 с<>.",
        "skill2": "<#5ad0e6ff>Электромагнитные волны<>: поднимает щит, нанося <#a974ffff>40 (+45% от общей физической защиты)<> магического урона перед собой и снижая скорость передвижения и магическую защиту врагов. Складывается до <#ffb900ff>3<> раз.",
        "ult": "<#5ad0e6ff>Полный газ<>: превращается в автомобиль. Ближайший союзный герой может сесть в него. При столкновении с вражеским героем машина взрывается, нанося <#a974ffff>90 (+150% до +220% от общей физической защиты)<> магического урона, оглушая на <#ffb900ff>0,5–1 с<> в зависимости от времени езды и оставляя электризованную зону. Он также может увезти пассажира в безопасное место."
      },
      "mlbb_angela": {
        "name": "Анжела",
        "attack": "Выпускает сердечный снаряд, нанося <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% силы атаки<> физического урона на дистанции <#ffb900ff>88 000<>.",
        "skill": "<#5ad0e6ff>Волны любви<>: тратит заряд и посылает волну на <#ffb900ff>92 000<> вперёд, нанося врагам <#a974ffff>80 + 30% силы магии<> магического урона и исцеляя союзников на пути на <#5bd18aff>46 + 40% силы магии<>. Задетые враги получают стак <#5ad0e6ff>Клеймо возлюбленной<> на <#ffb900ff>3 с<> (максимум <#ffb900ff>5<>): каждый добавляет <#ffb900ff>+12%<> урона следующим волнам и финальному удару S2 и замедляет на <#ffb900ff>6%<>. До <#ffb900ff>5 применений<> подряд; последнее запускает перезарядку <#ffb900ff>5 с<>.",
        "skill2": "<#5ad0e6ff>Кукла на нитях<>: связывает врага в пределах <#ffb900ff>95 000<> на <#ffb900ff>3 с<>, нанося <#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25% силы магии<> магического урона и замедляя его вплоть до <#ffb900ff>45%<>. Если связь дожила до конца, она наносит ещё <#a974ffff>140 + 35% силы магии<> (усиливается стаками <#5ad0e6ff>Клеймо возлюбленной<>) и обездвиживает на <#ffb900ff>0,7 с<>. Рвётся без эффекта дальше <#ffb900ff>150 000<> или при смерти; разорванная связь финального удара не наносит.",
        "ult": "<#e64a6aff>Хранитель сердца<>: даёт союзному герою в любой точке карты щит на <#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>180% силы магии<> на <#ffb900ff>6 с<>. Анжела исчезает в этом союзнике на <#ffb900ff>12 с<> и применяет S1 и S2 автоматически из его позиции, а <#5ad0e6ff>кукла<> над ним обозначает связь. Прикрепление прерывается, если носитель погибает или становится недоступным для выбора; повторное применение снимает его сразу. Перезарядка <#ffb900ff>40 с<>.",
        "passive": "<#5ad0e6ff>Умное сердце<>: каждое использование навыка даёт скорость передвижения на <#ffb900ff>4 с<> Анжеле, а при прикреплении — носителю. До <#ffb900ff>4 стаков<> суммарно на <#ffb900ff>7%, 15%, 22%, 30%<>; обновление на пределе его не превышает, а применения и перезарядки сохраняются при прикреплении."
      },
      "mlbb_eudora": {
        "name": "Эйдора",
        "attack": "Базовые атаки выпускают молнию и наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> физического урона.",
        "skill": "<#5ad0e6ff>Разветвлённая молния<>: Бьёт молнией по вееру, нанося <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100 + 55% AP<> магического урона; миньонам на линиях наносится двойной урон. Уже отмеченные враги соединяются с Эйдорой на срок до <#ffb900ff>1<> с: <#ffb900ff>4<> импульса по <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>4 + 2% AP<>, затем <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100 + 55% AP<>, если связь сохранилась. Пока связь действует, скорость передвижения повышена на <#ffb900ff>20%<>. Финальное попадание сокращает перезарядку на <#ffb900ff>1.5<> с, один раз за применение. Связь рвётся на расстоянии свыше <#ffb900ff>95,000<>. Перезарядка: <#ffb900ff>7<> с. Первое попадание наносит вражеским чемпионам <#a974ffff>120 + 65% AP<> магического урона.",
        "skill2": "<#5ad0e6ff>Шаровая молния<>: Выпускает сферу, которая снижает магическое сопротивление цели на <#ffb900ff>8<> на <#ffb900ff>1.8<> с, наносит <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>115 + 45% AP<> магического урона и оглушает на <#ffb900ff>0.8<> с. Если цель уже была отмечена, те же эффекты действуют на ближайших врагов. Каждый враг получает одно попадание. Перезарядка: <#ffb900ff>11<> с.",
        "ult": "<#e64a6aff>Гнев грома<>: Бьёт по области на земле: <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>260 + 110% AP<> магического урона в центре или <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 55% AP<> во внешнем кольце. Уже отмеченные враги оставляют предупреждение в месте попадания. Через <#ffb900ff>0.6<> с эти области взрываются, нанося <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>160 + 72% AP<> магического урона. Перекрывающиеся взрывы одного применения поражают каждого врага один раз. Перезарядка: <#ffb900ff>32<> с.",
        "passive": "<#5ad0e6ff>Сверхпроводник<>: Попадания навыками отмечают вражеских героев и монстров леса на <#ffb900ff>5<> с. Против уже отмеченных врагов навыки получают дополнительные эффекты. Базовые атаки не оставляют метки. Метки не суммируются."
      },
      "mlbb_julian": {
        "name": "Julian",
        "attack": "Базовые атаки наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% физической атаки<> физического урона. В течение <#ffb900ff>2<>с после применения навыка они наносят <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% физической атаки<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 55% AP<> магического урона и притягивают цель к Julian.",
        "skill": "<#5ad0e6ff>Коса<>: Бросает косу в выбранном направлении, нанося <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>155 + 72% AP<> магического урона врагам на пути и замедляя их на <#ffb900ff>30<>% на <#ffb900ff>1<>с. Пробивает миньонов и останавливается на первом другом враге. Усиленная: наносит <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>215 + 100% AP<> и замедляет на <#ffb900ff>50<>%. У первого не-миньона или на максимальной дистанции косы продолжают лететь медленнее, нанося <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26 + 11% AP<> магического урона каждые <#ffb900ff>0.1<>с по области в течение <#ffb900ff>1.6<>с.",
        "skill2": "<#5ad0e6ff>Меч<>: Призывает летящий меч и совершает рывок в выбранном направлении, нанося <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 52% AP<> магического урона врагам на пути. Усиленная: призывает множество мечей, нанося <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 14% AP<> магического урона каждые <#ffb900ff>0.1<>с во время рывка, до <#ffb900ff>6<> раз. Во время рывка Julian неуязвим для выбора цели и невидим, затем появляется в дальней точке.",
        "ult": "<#e64a6aff>Цепи<>: Призывает цепи в указанной области. Через <#ffb900ff>0.3<>с они наносят <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>112 + 50% AP<> магического урона в радиусе <#ffb900ff>18,000<> и обездвиживают врагов на <#ffb900ff>1<>с. Усиленная: наносит <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12 + 6% AP<> каждые <#ffb900ff>0.2<>с и замедляет на <#ffb900ff>30<>%, затем оставшиеся враги получают <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>205 + 88% AP<> и подбрасываются на <#ffb900ff>0.8<>с. До открытия Цепей Julian применяет их автоматически во время комбо.",
        "passive": "<#5ad0e6ff>Наследие кузнеца<>: После применения двух разных навыков Julian усиливает оставшийся навык. Усиленное применение переводит все три навыка на общее время восстановления <#ffb900ff>9<>–<#ffb900ff>6<>с, уменьшающееся с уровнем. Каждый навык можно использовать один раз за серию; незавершённая серия истекает через <#ffb900ff>4<>с. Попадание навыком по врагу-герою даёт <#ffb900ff>10<>% гибридного вампиризма на <#ffb900ff>5<>с, до <#ffb900ff>30<>%."
      },
      "mlbb_popol_kupa": {
        "name": "Popol & Kupa",
        "attack": "Popol throws a spear that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact. Kupa bites nearby enemies for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45% AD<> physical damage, increased to <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75% AD<> in Alpha Wolf Form. Kupa’s ordinary bites use Popol’s basic-attack item effects.",
        "skill": "<#5ad0e6ff>Bite ’em, Kupa!<>: Popol throws a spear for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50 + 50% AD<> physical damage and commands Kupa to bite the target for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60 + 60% AD<> physical damage, <#ef5350ff>slowing<> it by <#ffb900ff>50%<> for <#ffb900ff>1s<>. Alpha Wolf Form: the bite instead deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90 + 75% AD<> physical damage to nearby enemies and knocks them <#ef5350ff>airborne<> for <#ffb900ff>0.6s<>.",
        "skill2": "<#5ad0e6ff>Kupa, Help!<>: Popol gains a <#ffb900ff>90 + 50% AD<> shield for <#ffb900ff>3s<> and calls Kupa back. When Kupa arrives, Popol mounts him for up to <#ffb900ff>1.5s<>, gaining <#ffb900ff>50%<> Movement Speed while Kupa recovers <#ffb900ff>25%<> Max HP over the ride. Attacks, other skills and hard crowd control end the ride. Alpha Wolf Form: the shield increases to <#ffb900ff>140 + 70% AD<> and Kupa fully recovers HP at mount start.",
        "ult": "<#e64a6aff>We Are Angry!<>: Kupa fully recovers HP and enters <#5ad0e6ff>Alpha Wolf Form<> for <#ffb900ff>9s<>, gaining <#ffb900ff>35%<> Max HP and enhancing Bite ’em, Kupa! and Kupa, Help! Cooperative stack bonuses are doubled. Requires a living Kupa.",
        "passive": "<#5ad0e6ff>We Are Friends<>: When Popol and Kupa damage the same enemy within <#ffb900ff>2s<>, both gain <#ffb900ff>5%<> Attack Speed and <#ffb900ff>2%<> Movement Speed for <#ffb900ff>4s<>, stacking up to <#ffb900ff>3<> times. Each paired exchange grants one stack.\nKupa has <#ffb900ff>560 + 80 per level after Lv.1 + 50% of Popol’s bonus Max HP<> HP and inherits Popol’s current Armor, Magic Resist and Attack Speed. After <#ffb900ff>5s<> out of combat, Kupa recovers <#ffb900ff>8%<> Max HP per second. If Kupa falls, Popol begins a stationary <#ffb900ff>3s<> prayer after <#ffb900ff>3s<> without combat; movement, damage or another action interrupts it. Successful revival has a <#ffb900ff>30s<> cooldown.\n<#5ad0e6ff>Popol’s Surprise<>: During combat, Popol automatically places a trap every <#ffb900ff>10s<>, up to <#ffb900ff>2<>. Traps arm after <#ffb900ff>0.5s<> and last <#ffb900ff>15s<>. An enemy triggers <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25 + 20% AD<> physical damage and <#ffb900ff>0.6s<> of <#ef5350ff>immobilization<>, leaving frost for <#ffb900ff>3s<> that <#ef5350ff>slows<> enemies by <#ffb900ff>20%<> and reduces Armor by <#ffb900ff>12%<>. Frost from the same Popol does not stack. Placement pauses during casting, recall, riding and prayer."
      },
      "mlbb_granger": {
        "name": "Granger",
        "attack": "Fires a handgun round that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact.",
        "skill": "<#5ad0e6ff>Rhapsody<>: Locks onto an enemy and fires <#ffb900ff>6<> homing rounds over <#ffb900ff>1.5s<>, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>36 + 45% AD<> physical damage and consuming <#ffb900ff>70<> Gun Energy. Requires more than <#ffb900ff>420<> Gun Energy. Movement Speed increases by <#ffb900ff>10%<> while firing. Each hit reduces Rondo’s cooldown by <#ffb900ff>0.5s<>. The final round gains <#ffb900ff>100%<> Critical Chance for its impact. Rondo and Death Sonata can be used during the barrage.",
        "skill2": "<#5ad0e6ff>Rondo<>: Dashes a short distance and restores <#ffb900ff>15%<> of maximum Gun Energy. Walls and movement-disabling effects stop the dash. Equipment cooldown reduction increases Attack instead of shortening Rondo’s effective cooldown.",
        "ult": "<#5ad0e6ff>Death Sonata<>: Consumes <#ffb900ff>250<> Cannon Energy to fire a homing cannon round at an enemy champion. Impact triggers an explosion, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>155 + 110% AD<> physical damage to nearby enemies and <#ef5350ff>slowing<> them by <#ffb900ff>30%<> for <#ffb900ff>0.6s<>. Granger then rolls a short distance away from the firing direction.",
        "passive": "<#5ad0e6ff>Capriccio<>: Uses separate Gun and Cannon Energy pools, each starting at <#ffb900ff>800<>. Gun Energy regenerates at <#ffb900ff>8%<> of its maximum per second; Cannon Energy regenerates at <#ffb900ff>2%<>. Credited lane-minion kills increase maximum Gun Energy by <#ffb900ff>6<> and restore <#ffb900ff>5%<>; jungle kills grant the same benefit to Cannon Energy. Champion kills and assists increase both maxima by <#ffb900ff>12<> and restore <#ffb900ff>10%<>. Capacity growth persists through death. Equipment cooldown reduction grants <#ffb900ff>0.5<> Attack per percentage point, up to <#ffb900ff>20<> Attack."
      },
      "mlbb_hanzo": {
        "name": "Hanzo",
        "attack": "Strikes for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Attack<> physical damage and applies a mark.",
        "skill": "<#5ad0e6ff>Demon Feast<>: At <#ffb900ff>5 marks<>, bites champions for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200 + 7 per level after Lv.1 + 115% bonus Attack<> physical damage, heals and refunds <#ffb900ff>60%<> cooldown. Ordinary camps are devoured, healing <#66cc66ff>20% maximum Health<>.\n<#5ad0e6ff>Soul Snatch<>: Lunges for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>135 + 6 per level after Lv.1 + 95% bonus Attack<> physical damage, increased <#ffb900ff>24% per mark<> against champions and <#ffb900ff>20% per mark<> against other targets. At <#ffb900ff>5 marks<>, adds damage based on maximum Health and heals.\nCooldown: <#ffb900ff>12s / 10s<>.",
        "skill2": "<#5ad0e6ff>Dark Mist<>: Dashes and gains <#ffb900ff>15% Movement Speed<> for <#ffb900ff>2s<>. Leaves <#ffb900ff>5<> mist pulses.\n<#5ad0e6ff>Black Mist<>: Dashes through walls for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110 + 4 per level + 55% bonus Attack<> physical damage and <#ef5350ff>0.4s airborne<>. Leaves <#ffb900ff>4<> pulses.\nMist deals physical damage every <#ffb900ff>0.5s<>, applies marks and <#ef5350ff>slows 35%<>; it cannot critically strike. Cooldown: <#ffb900ff>10s per form<>.",
        "ult": "Projects Hanekage for up to <#ffb900ff>15s<>, leaving an invulnerable body. Gains <#ffb900ff>35% Movement Speed<>, <#ffb900ff>25% Attack Speed<> and wall traversal, with <#ffb900ff>30% less maximum Health<>.\nRecast returns and heals <#66cc66ff>90 + 50% bonus Attack<>. Empty Energy draws the body to Hanekage. Defeat forces a return to the body, <#ef5350ff>slows Hanzo 50% for 6s<> and sets a <#ffb900ff>52s<> cooldown (normally <#ffb900ff>26s<>).",
        "passive": "Basic attacks and mist hits apply up to <#ffb900ff>5 marks<> for <#ffb900ff>6s<>. New hits refresh them. Hanekage starts with <#ffb900ff>100 Energy<> and spends <#ffb900ff>10 per second<>; hits and nearby deaths restore Energy."
      },
      "mlbb_atlas": {
        "name": "Atlas",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Skill casts create a moving frost aura for <#ffb900ff>4s<> and grant <#66cc66ff>10 armor and magic resistance<>. Nearby enemy champions slow up to <#ef5350ff>25%<> and freeze for <#ef5350ff>0.5s<> after 2s of continuous exposure. Freeze cooldown per target: <#ffb900ff>4s<>.",
        "skill": "Slams three times for <#5ad0e6ff>30 + 10% Magic Power<> magic damage per pulse. The suit also slams while separated. Overlapping hits deal <#5ad0e6ff>45 + 15% Magic Power<> once per pulse. Cooldown: <#ffb900ff>7s<>.",
        "skill2": "Ejects for up to <#ffb900ff>2s<>, gaining <#ffb900ff>25% Movement Speed<> while the suit follows. Reunion deals <#5ad0e6ff>65 + 20% Magic Power<> magic damage and <#ef5350ff>stuns for 0.6s<>. Cooldown: <#ffb900ff>10s<>.",
        "ult": "Links nearby enemy champions for <#5ad0e6ff>35 + 10% Magic Power<> magic damage and <#ef5350ff>30% slow<>. After <#ffb900ff>0.4s<>, Atlas pulls them in for <#5ad0e6ff>105 + 25% Magic Power<> magic damage and <#ef5350ff>0.35s airborne<>. While ejected, reunites immediately with a <#ef5350ff>40% slow<> in place of the reunion hit. Cooldown: <#ffb900ff>34s<>."
      },
      "mlbb_yu_zhong": {
        "name": "Yu Zhong",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage. Soul Grip can empower the next basic attack.",
        "passive": "Basic attacks and direct skill hits apply Sha Residue to enemy heroes and jungle monsters, including Morgard and Serpen, for <#ffb900ff>5s<>. At three marks, the target pulses five times. Each pulse deals <#ff9028ff>32 + 18% Attack + 2% of the target’s missing HP<> as physical damage and heals Yu Zhong for <#66cc66ff>8% of his missing HP<>. Against jungle monsters, the missing-HP damage bonus is capped at 40 per pulse. When the eruption starts, Yu Zhong gains 15% Movement Speed for 1.5s.",
        "skill": "After 0.4s, sweeps nearby enemies for <#ff9028ff>80 + 65% Attack<> physical damage. The outer edge instead deals <#ff9028ff>138 + 95% Attack<> and applies two marks to eligible targets. Cooldown is 7s.",
        "skill2": "Sends a wave that deals <#ff9028ff>95 + 68% Attack<> physical damage and slows by 30% for 1s. On hit, the next basic attack within 3s deals <#ff9028ff>55 + 40% Attack<> extra physical damage and can lunge toward the champion struck by Soul Grip if the route is clear. Hitting a champion at a useful distance triggers Furious Dive if the landing is safe. The leap deals damage on landing and allows one short dash in his movement direction. After 0.4s, the original landing area erupts, knocking enemy champions airborne for 0.5s. Both hits deal a combined <#ff9028ff>64 + 45% Attack<> physical damage. Cooldown is 10s.",
        "ult": "Channels for 0.6s, then flies as a dragon for up to 3.5s with 35% Movement Speed, wall traversal and crowd-control immunity. Passing an enemy hero deals <#ff9028ff>125 + 85% Attack<> physical damage and knocks them back once. On landing, enters Dragonoid Form for 15s, increasing skill reach and width by 20%. Cooldown is 46s."
      }
    },
