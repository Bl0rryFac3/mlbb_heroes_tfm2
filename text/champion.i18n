  "vi": {
    "description": {
      "mlbb_valir": {
        "name": "Valir",
        "attack": "Throws an ember that deals <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Direct spell hits apply Ablaze for <#ffb900ff>3s<>. The burn deals <#5ad0e6ff>0.8% max HP<> magic damage per second. At <#ffb900ff>3 stacks<>, it detonates for <#5ad0e6ff>4% max HP + 25% Magic Power<> magic damage and <#ef5350ff>stuns for 0.65s<>. Stun cooldown per target is <#ffb900ff>8s<>. Monster damage is capped. Bosses are immune to the stun.",
        "skill": "Fires a bolt that deals <#5ad0e6ff>70 + 65% Magic Power<> magic damage and <#ef5350ff>slows by 25% for 0.7s<>. The impact area bursts after <#ffb900ff>0.75s<> for <#5ad0e6ff>42 + 30% Magic Power<> magic damage. Stores <#ffb900ff>2 charges<> and restores one every <#ffb900ff>9s<>. A direct hit on a champion or boss refunds a charge up to once every <#ffb900ff>3.6s<>. Hitting a lane minion takes <#ffb900ff>2s<> off the recharge. Minimum recast is <#ffb900ff>1.8s<>.",
        "skill2": "Sends a wave that deals <#5ad0e6ff>95 + 65% Magic Power<> magic damage and <#ef5350ff>knocks back enemy champions, lane minions and regular jungle monsters<>. While empowered, it leaves a firewall for <#ffb900ff>3s<> that deals <#5ad0e6ff>27 + 22% Magic Power<> magic damage each second and briefly <#ef5350ff>slows by 20%<>. Cooldown is <#ffb900ff>10s<>.",
        "ult": "Can activate automatically when ready to <#ef5350ff>break a stun or other supported disable<>. Suppression still applies. Grants <#ffb900ff>30% Movement Speed<>, tapering over <#ffb900ff>3s<>. Empowers the next <#ffb900ff>4 casts<> within <#ffb900ff>9s<>. Fireball gains <#ffb900ff>30% projectile reach<> and Torrent leaves a firewall. Cooldown is <#ffb900ff>42s<>."
      },
      "mlbb_lesley": {
        "name": "Lesley",
        "attack": "Fires a rifle shot for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "<#5ad0e6ff>Lethal Shot<>. Casting a skill or going 5s without taking damage readies the next basic. It gains <#ffb900ff>17 range<> and deals <#ff9028ff>75 + 110% Attack<> true damage to champions or <#ff9028ff>75 + 125% Attack<> physical damage to lane and jungle enemies. Structures take normal basic damage.",
        "skill": "<#5ad0e6ff>Master of Camouflage<>. Camouflages for up to <#ffb900ff>2.5s<> and gains 30% Movement Speed. Enemies lose direct targeting, but area effects can still hit her. Attacking, casting another skill, or taking damage after the first 0.5s ends camouflage.",
        "skill2": "<#5ad0e6ff>Tactical Grenade<>. Deals <#ff9028ff>115 + 65% Attack<> physical damage in a short cone and pushes surviving enemy champions away. Lesley hops backward if the path is clear. During Ultimate Snipe, she fires an available round before ending the volley.",
        "ult": "<#e64a6aff>Ultimate Snipe<>. Locks onto an enemy champion and fires up to <#ffb900ff>four rounds<>. Each deals <#ff9028ff>70 + 32% Attack + 6% of the target’s missing HP<> as physical damage. Another enemy champion in the firing line can intercept a round."
      },
      "mlbb_aldous": {
        "name": "Aldous",
        "attack": "Đấm bằng găng tay dung nham khổng lồ gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> <#ff9028ff>sát thương vật lý<>.",
        "skill": "<#ff9028ff>Khế Ước: Cướp Hồn<> : mục tiêu chính chịu <#ff9028ff>40 + tỷ lệ cấp + 100% Công Vật Lý + 2,5 sát thương mỗi điểm Cướp Hồn<> sát thương vật lý; kẻ địch gần đó chịu <#ff9028ff>40%<> sát thương lan. Tại <#ffb900ff>1.000<> điểm, thưởng cộng dồn là <#ffb900ff>+2.500 sát thương gốc<> trước giáp.",
        "skill2": "<#ffb900ff>Khế Ước: Nổ<> : triệu hồi rào chắn rune rực lửa trong <#ffb900ff>2 giây<> (<#ffb900ff>90<> Khiên, <#ffb900ff>+25%<> Tốc Chạy), sau đó phát nổ gây <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> <#ff9028ff>sát thương vật lý<> và <#ef5350ff>choáng<> kẻ địch gần đó trong <#ffb900ff>1 giây<>.",
        "ult": "<#e64a6aff>Khế Ước: Truy Nã Định Mệnh<> : khóa <#e64a6aff>Mắt Định Mệnh<> lên kẻ địch và lao xuyên đấu trường như thiên thạch dung nham, gây <#ff9028ff>130<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160% Công Vật Lý<> <#ff9028ff>sát thương vật lý<> và <#ef5350ff>choáng<> trong <#ffb900ff>1,2 giây<>.",
        "passive": "Khế Ước: Biến Đổi — Aldous hấp thụ năng lượng linh hồn: <#ffb900ff>+1<> điểm mỗi <#ffb900ff>5 giây<>, <#ffb900ff>+10<> khi hạ gục, và thêm khi <#5ad0e6ff>Đánh Cắp Linh Hồn<> trúng đích (tối đa <#ffb900ff>1.000<>). Cứ mỗi <#ffb900ff>3<> đòn đánh thường (hồi <#ffb900ff>5 giây<>), các điểm này hóa thành khiên trong <#ffb900ff>2 giây<>: <#ffb900ff>35<> + <#ffb900ff>5<> mỗi cấp + <#ffb900ff>0,45<> mỗi điểm. Điểm số cũng cường hóa <#5ad0e6ff>Đánh Cắp Linh Hồn<>."
      },
      "mlbb_alpha": {
        "name": "Alpha",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#5ad0e6ff>Beta, Tiến Lên!<> Mỗi ba đòn hợp lệ trúng tướng địch, tia laze của Beta gây 30 + 3 mỗi cấp sau cấp 1 + 15% Công vật lý sát thương vật lý và làm chậm 30% trong 1 giây.",
        "skill": "<#5ad0e6ff>Xoáy Ốc Xung Kích<> Sóng gây 70 + 80% Công vật lý sát thương vật lý và làm chậm 40% trong 1 giây. Beta bắn theo, gây 25 + 1 mỗi cấp sau cấp 1 + 20% Công vật lý sát thương chuẩn.",
        "skill2": "<#5ad0e6ff>Cú Vung Lực<> Quét về phía trước, gây 100 + 80% Công vật lý sát thương vật lý. Beta gây thêm 25 + 1 mỗi cấp sau cấp 1 + 20% Công vật lý sát thương chuẩn. Alpha hồi 100 + 20% Công vật lý máu một lần mỗi lần dùng chiêu.",
        "ult": "<#e64a6aff>Thương Alpha<> Beta lao xuống gây 70 + 20% Công vật lý sát thương vật lý và làm choáng 1 giây. Alpha đáp xuống gây 130 + 80% Công vật lý sát thương vật lý, hất tung 0,67 giây và làm chậm 30% trong 1,25 giây. Beta bắn 5 lần, mỗi lần gây 8 + 10% Công vật lý sát thương vật lý."
      },
      "mlbb_arlott": {
        "name": "Arlott",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#5ad0e6ff>Ác Quỷ Nhìn<> : đánh dấu tướng địch gần nhất mỗi <#ffb900ff>7 giây<>, và đánh dấu mọi kẻ địch trúng hiệu ứng khống chế của Arlott. Mục tiêu <#e64a6aff>bị đánh dấu<> nhận sát thương gấp đôi từ Báo Thù. Dấu hiệu tồn tại <#ffb900ff>7 giây<>.",
        "skill": "<#5ad0e6ff>Đòn Đánh Bất Khuất<> : phóng giáo xuống đất, gây <#ff9028ff>110 + 55% Tổng Công Vật Lý<> sát thương vật lý theo đường thẳng và choáng. Mục tiêu <#ffb900ff>càng xa<> thì thời gian choáng <#ffb900ff>càng lâu<> — từ <#ffb900ff>0,5 giây<> ở cự ly gần đến <#ffb900ff>1 giây<> ở rìa xa. Cú phóng đánh dấu những kẻ trúng đòn.",
        "skill2": "<#5ad0e6ff>Báo Thù<> : lao tới kẻ địch, gây <#ff9028ff>100 + 55% Tổng Công Vật Lý<> sát thương vật lý và đánh dấu mục tiêu. Arlott <#ffb900ff>không thể bị ngắt<> khi đang lướt. Với mục tiêu <#e64a6aff>bị đánh dấu<>, chiêu gây <#ffb900ff>gấp đôi<> sát thương, <#ffb900ff>làm mới thời gian hồi chiêu<> và hồi máu cho Arlott <#ffb900ff>30% Tổng Công Vật Lý<> (một nửa với mục tiêu không phải tướng).",
        "ult": "<#e64a6aff>Nhát Chém Cuối Cùng<> : quét rộng hai lưỡi giáo gây <#ff9028ff>160 + 75% Tổng Công Vật Lý<> sát thương vật lý và <#ffb900ff>kéo<> mọi kẻ địch về <#ffb900ff>phía bên phải<> của Arlott. Mỗi kẻ địch bị kéo đều bị <#e64a6aff>đánh dấu<>."
      },
      "mlbb_balmond": {
        "name": "Balmond",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#5ad0e6ff>Khát Máu<> : hồi <#ffb900ff>5%<> Máu Tối Đa sau khi tiêu diệt lính hoặc quái, và <#ffb900ff>10%<> sau khi hạ gục hoặc hỗ trợ hạ gục tướng.",
        "skill": "<#5ad0e6ff>Khóa Linh Hồn<> : lao tới tướng địch được chọn, gây sát thương cho kẻ địch dọc đường thẳng với <#ff9028ff>150–275 + 60% Tổng Công Vật Lý<> sát thương vật lý. Tướng trúng đòn bị đẩy lùi ngắn và làm chậm <#ffb900ff>40%<> trong <#ffb900ff>3 giây<>. Bản thử nghiệm TFM2 nhắm vào một vị trí rồi lao tới; sát thương đường thẳng được giữ lại, và tướng địch gần nhất khi tới nơi sẽ chịu đòn.",
        "skill2": "<#5ad0e6ff>Quét Lốc Xoáy<> : xoay trong <#ffb900ff>3 giây<>, gây sát thương qua 14 nhịp. Mỗi nhịp gây <#ff9028ff>24–44 + 1,3% Tổng Máu + 25% Tổng Công Vật Lý<> sát thương vật lý và giảm Phòng Thủ Vật Lý của mục tiêu <#ffb900ff>5%<> mỗi nhịp, tối đa <#ffb900ff>8 điểm cộng dồn<>. Nhận <#ffb900ff>15%<> Tốc Chạy khi đang dùng.",
        "ult": "<#e64a6aff>Đòn Đáp Trả Chí Mạng<> : đánh vùng rộng phía trước gây <#ff9028ff>150 + 70% Tổng Công Vật Lý + 30–45% Máu đã mất của mỗi mục tiêu<> dưới dạng sát thương chuẩn. Sát thương lên mục tiêu không phải tướng bị giới hạn ở <#ffb900ff>1.000 / 1.500 / 2.000<> theo cấp tướng."
      },
      "mlbb_chou": {
        "name": "Chou",
        "attack": "Đòn đánh thường gây 100% Công Vật Lý sát thương vật lý.",
        "passive": "<#5ad0e6ff>Duy Tốc Độ<> : sau khi di chuyển khoảng <#ffb900ff>42.000<> đơn vị thế giới TFM2, đòn đánh thường kế tiếp của Chou gây <#ff9028ff>180% Công Vật Lý<> sát thương vật lý, làm chậm <#ffb900ff>80%<> trong <#ffb900ff>1 giây<> và giảm 10 Phòng Thủ Vật Lý trong <#ffb900ff>2 giây<> (tối đa <#ffb900ff>2<> điểm cộng dồn). Khoảng cách được tinh chỉnh theo tỷ lệ bản đồ TFM2.",
        "skill": "<#ff9028ff>Jeet Kune Do<> : tung tối đa <#ffb900ff>3<> lần: đá vọt lên, đấm xốc khi lướt tới, rồi đạp xuống hất kẻ địch lên không. Mỗi đòn gây <#ff9028ff>100–165 + 45% Tổng Công Vật Lý<>. Hai lần đầu làm mới chiêu để tiếp tục combo; lần thứ ba bắt đầu thời gian hồi. Lần tung chiêu thứ ba trúng tướng địch sẽ hồi ngay Shunpo.",
        "skill2": "<#5ad0e6ff>Shunpo<> : lướt theo hướng đã chọn, nhận <#ffb900ff>Miễn Nhiễm Khống Chế<> trong lúc lướt. Khi tới nơi, nhận khiên bằng <#5bd18aff>200–300 + 100% Công Vật Lý Thêm Vào<> và <#ffb900ff>15<> Xuyên Phòng Thủ Vật Lý trong <#ffb900ff>2,5 giây<>.",
        "ult": "<#e64a6aff>Đạo Rồng<> : đá xoay người vào tướng địch gây <#ff9028ff>275–420 + 110% Công Vật Lý Thêm Vào<> và đẩy họ văng ra. Nếu mục tiêu đó vẫn trong tầm truy đuổi, Chou lao theo và tung bốn đòn khi đến nơi, gây tổng cộng <#ff9028ff>330–500 + 132% Công Vật Lý Thêm Vào<> sát thương vật lý."
      },
      "mlbb_estes": {
        "name": "Estes",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#5ad0e6ff>Kinh Văn Tiên Nữ Ánh Trăng<> : nhận <#ffb900ff>1<> điểm mỗi giây, hoặc <#ffb900ff>2<> điểm khi đang liên kết Đắm Mình Trong Ánh Trăng. Tại 100 điểm, đòn đánh thường kế tiếp được cường hóa: <#a974ffff>sát thương phép<> cộng tối đa 2 lần nảy và làm chậm <#ffb900ff>40%<> trong <#ffb900ff>1,5 giây<>. Thanh hiển thị nằm ở Chiêu 1.",
        "skill": "<#5ad0e6ff>Đắm Mình Trong Ánh Trăng<> : hồi máu cho tướng đồng minh <#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85% Công Phép<> ngay lập tức, sau đó <#5bd18aff>24<> + <#a974ffff>18% Công Phép<> mỗi <#ffb900ff>0,5 giây<> trong <#ffb900ff>5 giây<>. Cấp cho đồng minh <#ffb900ff>+7<> phòng thủ vật lý và phép thuật, và Estes <#ffb900ff>+15%<> Tốc Chạy. Liên kết và thưởng tích lũy nội tại ngừng ngoài tầm <#ffb900ff>120.000<>; hiệu ứng hồi máu theo thời gian vẫn chạy hết thời lượng.",
        "skill2": "<#5ad0e6ff>Lãnh Địa Nữ Thần Mặt Trăng<> : đặt một vùng ánh trăng <#5ad0e6ff>đứng yên<> trong <#ffb900ff>2,5 giây<>. Mỗi <#ffb900ff>0,5 giây<>, kẻ địch trong bán kính <#ffb900ff>52.000<> chịu <#a974ffff>15<> + <#a974ffff>45% Công Phép<> sát thương phép và bị làm chậm <#ffb900ff>35%<> trong <#ffb900ff>0,75 giây<>. Phiên bản TFM2 làm chậm trong toàn bộ vùng thay vì chỉ xét rìa ngoài.",
        "ult": "<#e64a6aff>Phước Lành Nữ Thần Mặt Trăng<> : lập tức hồi máu cho đồng minh gần đó trong bán kính <#ffb900ff>105.000<> với <#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65% Công Phép<>; sau đó hồi <#5bd18aff>20<> + <#a974ffff>12% Công Phép<> mỗi <#ffb900ff>0,5 giây<> trong <#ffb900ff>8 giây<> và cấp <#ffb900ff>+8<> phòng thủ vật lý và phép thuật."
      },
      "mlbb_fanny": {
        "name": "Fanny",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#ff9028ff>Ưu Thế Trên Không<> : khi bay bằng cáp, Fanny nhận <#ffb900ff>10–25%<> sát thương cộng thêm dựa trên tốc độ bay. Trúng tướng địch khi đang bay sẽ áp dụng hoặc nâng cấp <#ff9028ff>Dấu Ấn Con Mồi<> (tối đa 2 điểm, <#ffb900ff>5 giây<>) và kích hoạt Đột Kích Lốc Xoáy.",
        "skill": "<#ff9028ff>Đột Kích Lốc Xoáy<> : gây <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% Công Vật Lý<> trong bán kính <#ffb900ff>22.000<>. Khi đang bay bằng Cáp Thép, va vào kẻ địch sẽ tự động kích hoạt Đột Kích Lốc Xoáy trên không gây <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70% Công Vật Lý<> và áp dụng Dấu Ấn Con Mồi lên tướng địch.",
        "skill2": "<#ff9028ff>Cáp Thép<> : phóng cáp (tầm <#ffb900ff>165.000<>) vào bức tường tốt nhất hoặc ranh giới ngoài của đường, đưa Fanny vượt qua vật cản hướng tới mục tiêu, nối nhiều cú bám tường xuyên bản đồ với chi phí năng lượng <#ffb900ff>0<>. Ưu tiên tướng địch trong tầm nhìn, hoặc quái rừng gần đó khi không có tướng địch nào khả kiến.",
        "ult": "<#ff9028ff>Cắt Cổ<> : lao tới mục tiêu và gây <#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125% Công Vật Lý<>; mỗi Dấu Ấn Con Mồi cộng thêm <#ff9028ff>35% Công Vật Lý<> (tối đa 2 dấu). Trúng đòn sẽ tiêu hao các dấu ấn."
      },
      "mlbb_franco": {
        "name": "Franco",
        "attack": "Vung chiến búa gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> <#ff9028ff>sát thương vật lý<>.",
        "passive": "<#5ad0e6ff>Sức Mạnh Hoang Dã<> : sau <#ffb900ff>5 giây<> không chịu sát thương, Franco nhận <#ffb900ff>10%<> Tốc Chạy, hồi <#ffb900ff>1%<> Máu Tối Đa mỗi giây và tích lũy tối đa <#ffb900ff>10<> điểm. Chiêu kế tiếp tiêu hao toàn bộ điểm để nhận tới <#ffb900ff>+150%<> sát thương chiêu.",
        "skill": "<#5ad0e6ff>Móc Sắt<> : phóng móc sắt trúng kẻ địch đầu tiên, gây <#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> <#ff9028ff>sát thương vật lý<> và kéo họ về phía Franco. Móc <#ef5350ff>choáng<> trước, rồi mới kéo — mục tiêu không thể di chuyển vẫn bị đứng yên.",
        "skill2": "<#5ad0e6ff>Chấn Động Thịnh Nộ<> : quất ra, gây <#ff9028ff>160<> + <#ff9028ff>4%<> <#ffb900ff>Máu Tối Đa<> của Franco thành <#ff9028ff>sát thương vật lý<> lên kẻ địch gần đó và <#ffb900ff>làm chậm<> chúng <#ffb900ff>70%<> trong <#ffb900ff>1,5 giây<>. Có thể dùng lên quái rừng và mục tiêu lớn.",
        "ult": "<#e64a6aff>Săn Máu<> : <#ef5350ff>khống chế<> tướng địch trong <#ffb900ff>1,8 giây<> và đánh <#ffb900ff>sáu<> nhát, xen kẽ búa và móc, mỗi nhát <#ff9028ff>50<> + <#ff9028ff>70% Công Vật Lý<>. Chiêu kết thúc sớm nếu Franco bị khống chế."
      },
      "mlbb_gusion": {
        "name": "Gusion",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#5ad0e6ff>Chuyên Gia Dao Găm<> : mỗi lần tung chiêu nhận <#ffb900ff>1 Rune<>, tối đa <#ffb900ff>4<>. Đòn đánh thường kế tiếp tiêu hao toàn bộ Rune; mỗi Rune gây <#a974ffff>3% Máu Tối Đa của mục tiêu<> thành sát thương phép và hồi <#5bd18aff>50 + 25% Công Phép<> máu (tối đa 12% Máu Tối Đa sát thương và 200 + 100% Công Phép hồi máu).",
        "skill": "<#5ad0e6ff>Mũi Kiếm<> : ném dao găm vào kẻ địch đầu tiên trúng phải, gây <#a974ffff>200 + 50% Tổng Công Phép<> sát thương phép và đánh dấu họ trong <#ffb900ff>5 giây<>. Tái kích hoạt để lướt ra sau mục tiêu bị đánh dấu và gây <#a974ffff>200 + 100% Tổng Công Phép<> sát thương phép.",
        "skill2": "<#a974ffff>Tàn Sát Kiếm Bóng<> : ném <#ffb900ff>5 dao găm<> hình quạt; mỗi nhát trúng gây <#a974ffff>65 + 40% Tổng Công Phép<> sát thương phép. Tái kích hoạt để thu hồi. Sau khi được Ultimate làm mới, Chiêu 2 có thể ném loạt quạt thứ hai trước khi thu hồi cả hai loạt.",
        "ult": "<#e64a6aff>Rực Sáng<> : lướt ra sau kẻ địch được chọn và làm mới Chiêu 1 và 2. Nếu dao găm Chiêu 2 đã được ném, dùng lại Chiêu 2 để ném loạt thứ hai; lần dùng Chiêu 2 kế tiếp sẽ thu hồi cả hai loạt. Tái kích hoạt trong <#ffb900ff>2,5 giây<> để lướt lần nữa."
      },
      "mlbb_hanabi": {
        "name": "Hanabi",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#5ad0e6ff>Nhẫn Thuật: Mưa Cánh Hoa<> : đòn đánh thường và chiêu trúng đích phóng Lưỡi Cánh Hoa nảy qua kẻ địch gần đó. Khi Hanabi có <#ffb900ff>bất kỳ nguồn khiên nào<>, cô miễn nhiễm hiệu ứng khống chế. Điều này không xóa khống chế đã dính trước đó.",
        "skill": "<#5ad0e6ff>Nhẫn Thuật: Phân Điểm<> : nhận khiên <#ff9028ff>120 + 35% Công Vật Lý<> trong <#ffb900ff>5 giây<>, cộng <#ffb900ff>12%<> Tốc Chạy và <#ffb900ff>20%<> Tốc Đánh. Khi khiên này đang hoạt động, <#ffb900ff>20%<> sát thương gây lên tướng và <#ffb900ff>10%<> sát thương gây lên đơn vị khác được cộng vào khiên. Giới hạn khiên là <#ffb900ff>50% Máu Tối Đa<>; phần hiện thực tính mọi lớp khiên vào giới hạn đó. Bất kỳ khiên nào cũng cấp miễn nhiễm khống chế từ nội tại.",
        "skill2": "<#5ad0e6ff>Nhẫn Thuật: Quyển Hồn<> : bắn đạn xuyên gồm kunai và quyển trục, gây <#ff9028ff>65 + 75% Công Vật Lý<> sát thương vật lý lên kẻ địch trên đường đi và làm chậm chúng <#ffb900ff>30%<> trong <#ffb900ff>1 giây<>. Mỗi mục tiêu bị đánh dấu trong <#ffb900ff>5 giây<>. Cú nảy cánh hoa từ đòn đánh thường kế tiếp của Hanabi lên mục tiêu bị đánh dấu gây thêm <#ff9028ff>20 + 50% Công Vật Lý<> sát thương không bị giảm theo quy luật nảy, sau đó tiêu hao dấu ấn.",
        "ult": "<#e64a6aff>Cấm Thuật: Higanbana<> : ném một đóa Higanbana lớn trúng tướng địch đầu tiên, gây <#ff9028ff>150 + 80% Công Vật Lý<> sát thương vật lý và trói họ trong <#ffb900ff>0,8 giây<>. Sau <#ffb900ff>0,8 giây<>, đóa hoa nở tại vị trí đó gây <#ff9028ff>105 + 55% Công Vật Lý<> sát thương vật lý trong bán kính <#ffb900ff>34.000<>. Kẻ địch khác trúng phải bị làm chậm <#ffb900ff>20%<> trong <#ffb900ff>0,6 giây<>."
      },
      "mlbb_karrie": {
        "name": "Karrie",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> <#ff9028ff>sát thương vật lý<> bằng một bánh xe ánh sáng.",
        "passive": "<#5ad0e6ff>Dấu Ấn Bánh Xe Ánh Sáng<> : đòn đánh thường và Chiêu 1, 2 cộng <#ffb900ff>1 dấu ấn<>. Tại <#ffb900ff>5 dấu ấn<>, chúng phát nổ gây <#ff9028ff>4% Máu Tối Đa của mục tiêu<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% Công Vật Lý<> dưới dạng <#e64a6aff>sát thương chuẩn<>, giới hạn <#ffb900ff>250<> với tướng và <#ffb900ff>300<> với quái rừng/quái lớn.",
        "skill": "<#5ad0e6ff>Bánh Xe Xoay<> : ném một bánh xe ánh sáng hình khuyên theo hướng đã chọn. Khi trúng, nó gây <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% Công Vật Lý<> sát thương vật lý lên mục tiêu chính và <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35% Công Vật Lý<> sát thương vật lý lên kẻ địch gần đó không phải trụ, làm chậm chúng <#ffb900ff>35%<> trong <#ffb900ff>1 giây<>. Vị trí trúng để lại vùng làm chậm màu tím trong <#ffb900ff>1,5 giây<>; kẻ địch bên trong bị làm chậm lại <#ffb900ff>35%<> và chịu hai nhịp <#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% Công Vật Lý<> sát thương vật lý, cách nhau <#ffb900ff>0,5 giây<>. Các nhịp lưu lại không cộng thêm Dấu Ấn Bánh Xe Ánh Sáng.",
        "skill2": "<#5ad0e6ff>Ảnh Bước<> : lướt một khoảng cố định về vị trí đã chọn, rồi bắn vào kẻ địch hợp lệ gần điểm hạ cánh nhất. Gây <#ff9028ff>75 + 70% Tổng Công Vật Lý<>; khi Bánh Xe Ánh Sáng Tốc Độ đang hoạt động, tỷ lệ trở thành <#ff9028ff>100%<>. Áp dụng <#ffb900ff>1 Dấu Ấn Bánh Xe Ánh Sáng<>.",
        "ult": "<#e64a6aff>Bánh Xe Ánh Sáng Tốc Độ<> : trong <#ffb900ff>6 giây<>, nhận <#ffb900ff>+20%<> Tốc Chạy và <#ffb900ff>+35%<> Tốc Đánh. Khi đang hoạt động, Ảnh Bước gây <#ff9028ff>75 + 100% Tổng Công Vật Lý<>."
      },
      "mlbb_lancelot": {
        "name": "Lancelot",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#5ad0e6ff>Kẻ Cắt Linh Hồn<> : Đâm Thủng và Hành Quyết Ảnh Ảnh cấp <#ffb900ff>7,5%<> sát thương tăng thêm trong <#ffb900ff>4 giây<> mỗi điểm, tối đa <#ffb900ff>4 điểm (30%)<>.",
        "skill": "<#ff9028ff>Đâm Thủng<> : lướt tới kẻ địch được chọn, gây <#ff9028ff>80–178 + 40% Công Vật Lý<> sát thương vật lý. Kẻ địch chưa bị đánh dấu đầu tiên trúng đòn nhận <#5ad0e6ff>Dấu Ấn Kiếm<>; áp dụng dấu ấn mới sẽ làm mới Đâm Thủng. Mỗi lần tung nhận một điểm <#ffb900ff>Kẻ Cắt Linh Hồn<>.",
        "skill2": "<#ffb900ff>Hoa Hồng Gai<> : đánh theo ba đợt, mỗi đợt gây <#ff9028ff>85–155 + 30% Công Vật Lý<> sát thương vật lý và làm chậm kẻ địch trúng đòn <#ffb900ff>20%<> trong <#ffb900ff>0,5 giây<>. Lancelot miễn nhiễm sát thương và khống chế trong chuỗi đòn; các đòn trùng nhau áp dụng hệ số giảm khi trúng đám đông.",
        "ult": "<#e64a6aff>Hành Quyết Ảnh Ảnh<> : lướt tới tướng địch được chọn và gây <#ff9028ff>100–156 + 100% Công Vật Lý<> sát thương vật lý khi tới nơi. Lancelot miễn nhiễm sát thương và khống chế trong lúc lướt và nhận một điểm <#ffb900ff>Kẻ Cắt Linh Hồn<>."
      },
      "mlbb_uranus": {
        "name": "Uranus",
        "attack": "Đòn đánh thường vung tay Uranus gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> <#ff9028ff>sát thương vật lý<>. Đòn đánh thường <#ffb900ff>không<> áp dụng dấu ấn Lưỡi Ion.",
        "passive": "<#5ad0e6ff>Phóng Xạ<> : chịu sát thương nhận <#ffb900ff>1 điểm<> (tối đa <#ffb900ff>12<>, mỗi điểm kéo dài <#ffb900ff>10 giây<>, tối đa 1 điểm mỗi <#ffb900ff>1 giây<>). Mỗi <#ffb900ff>0,8 giây<>, Uranus hồi <#5bd18aff>28–134 Máu tại 12 điểm<>, theo cấp.",
        "skill": "<#5ad0e6ff>Lưỡi Ion<> : phóng hai lưỡi dao ra xa rồi quay lại; mỗi nhát trúng gây <#a974ffff>79–131 (+18% Tổng Công Phép)<> sát thương phép và làm chậm <#ffb900ff>30%<> trong <#ffb900ff>2 giây<>. Mỗi lưỡi chỉ trúng một mục tiêu một lần. Mỗi lần tung áp dụng tối đa <#ffb900ff>1 Dấu Ion mỗi mục tiêu<> trong <#ffb900ff>6 giây<>; mỗi dấu tăng sát thương Chiêu 1 về sau thêm <#ffb900ff>20%<>, tối đa <#ffb900ff>8 dấu<>; Trụ và Nexus không thể bị đánh dấu.",
        "skill2": "<#5ad0e6ff>Khiên Siêu Việt<> : lướt tới vị trí đã chọn. Kẻ địch trên đường đi chịu <#a974ffff>48–120 (+12% Tổng Công Phép)<> sát thương phép; kẻ địch gần điểm đến chịu <#a974ffff>96–240 (+48% Tổng Công Phép)<> và bị làm chậm <#ffb900ff>25%<>. Nhận khiên <#5bd18aff>300–750 (+200% Tổng Công Phép)<> trong <#ffb900ff>4 giây<>. Khi khiên vỡ hoặc hết hạn, nó phát nổ gây <#a974ffff>156–390 (+78% Tổng Công Phép)<> sát thương phép lên kẻ địch gần đó.",
        "ult": "<#e64a6aff>Thánh Hóa<> : xóa <#ef5350ff>mọi hiệu ứng khống chế<> (phiên bản TFM2; bản gốc chỉ xóa làm chậm), hồi <#5bd18aff>200–400 Máu<> và cấp <#ffb900ff>60%<> Tốc Chạy giảm dần trong <#ffb900ff>8 giây<>. Cộng <#ffb900ff>5–12 điểm Phóng Xạ<>. Trong <#ffb900ff>8 giây<>, tăng Hồi Máu và khiên Khiên Siêu Việt của Uranus thêm <#ffb900ff>20%<>."
      },
      "mlbb_zhask": {
        "name": "Zhask",
        "attack": "Bắn mũi tên bóng tối gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> <#ff9028ff>sát thương vật lý<>.",
        "passive": "<#5ad0e6ff>Tàn Sát<> : khi tử vong, Zhask triệu hồi một Sinh Vật cuồng loạn tại vị trí cuối cùng. Nó tồn tại tối đa <#ffb900ff>6 giây<> và mất <#ffb900ff>2%<> Máu Tối Đa mỗi giây.",
        "skill": "<#5ad0e6ff>Sinh Vật Ác Mộng<> : triệu hồi một Sinh Vật đứng yên trong tối đa <#ffb900ff>12 giây<>. Nó kế thừa <#ffb900ff>55–100%<> Máu, phòng thủ và Công Phép của Zhask theo cấp. Tia Tử Thần của nó đánh mỗi <#a974ffff>15 tick (0,25 giây)<> gây <#a974ffff>30 (+25% Công Phép)<> sát thương phép và làm chậm <#ffb900ff>30%<> trong <#ffb900ff>36 tick (0,6 giây)<>. Ngắm lại để đổi vị trí. Nếu Zhask di chuyển xa hơn <#ffb900ff>120.000<> đơn vị, Tia sẽ tạm ngưng cho đến khi anh quay lại trong tầm.",
        "skill2": "<#5ad0e6ff>Kẻ Nuốt Tâm Trí<> : bắn đạn xuyên theo hướng, gây <#a974ffff>87 + 6 mỗi cấp trên cấp 1 (+60% Công Phép)<> sát thương phép và <#ef5350ff>choáng<> kẻ địch trúng đòn trong <#ffb900ff>30 tick (0,5 giây)<>. Nếu Sinh Vật còn sống, nó sẽ tiếp tục đánh mỗi kẻ địch trúng đòn gây thêm <#a974ffff>35 (+50% Công Phép)<> sát thương phép.",
        "ult": "<#e64a6aff>Thống Trị Giáng Lâm<> : dịch chuyển đến điểm mục tiêu và tạo Sinh Vật hợp nhất trong tối đa <#ffb900ff>10 giây<>. Zhask biến mất khỏi tầm nhìn, không thể bị chọn làm mục tiêu và bị khóa thao tác trong thời gian hợp nhất. Sinh Vật hợp nhất kế thừa 100% chỉ số của Zhask; sát thương Tia Tử Thần của nó là <#ffb900ff>×1,8<>."
      },
      "mlbb_obsidia": {
        "name": "Obsidia",
        "attack": "Đòn Đánh Thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 65% Công Vật Lý<> sát thương vật lý.",
        "passive": "<#5ad0e6ff>Trở Về Xương Tủy<>：Gây sát thương lên kẻ địch sẽ nhận Năng Lượng Xương — <#ffb900ff>2<> mỗi Đòn Đánh Thường lên tướng, <#ffb900ff>4<> mỗi lần Kỹ Năng trúng, hoặc <#ffb900ff>1<> mỗi đòn lên lính hoặc trụ. Quái rừng không cho năng lượng. Mỗi <#ffb900ff>30<> Năng Lượng rèn thành một Mảnh Xương, tối đa <#ffb900ff>25<> mảnh. Mỗi mảnh khiến Đòn Đánh Thường gây thêm <#ffb900ff>7%<> Tổng Vật Lý Công Kích. Hạ gục tướng địch sẽ nhận ngay một mảnh.",
        "skill": "<#5ad0e6ff>Kim Xương Vực Sâu<>：Bắn một mũi kim xương theo đường thẳng, gây <#ff9028ff>90–140 + 60% Tổng Công Vật Lý<> sát thương vật lý lên kẻ địch trúng đòn và cấp Năng Lượng Xương cho tướng địch đầu tiên bị trúng.",
        "skill2": "<#5ad0e6ff>Ảo Ảnh Ẩn Thân<>：Chìm vào Vực Sâu, lướt theo hướng mục tiêu và nhận <#ffb900ff>+20% Tốc Chạy<> trong <#ffb900ff>0,3 giây<>.",
        "ult": "<#e64a6aff>Săn Xương<>：Bắn ra Xương Phẫn Nộ, gây <#ff9028ff>55 + 50% Tổng Công Vật Lý<> sát thương vật lý, <#ffb900ff>choáng<> tướng địch đầu tiên trúng đòn trong thời gian ngắn và <#ffb900ff>kéo bản thân lại gần chúng<>. Trói chúng trong <#ffb900ff>3 giây<>：bản thân không thể di chuyển xa hơn <#ffb900ff>4 đơn vị<>, kẻ địch không thể dùng kỹ năng di chuyển, và mỗi bước đi của chúng sẽ kéo bản thân theo. Nhận <#ffb900ff>5 Mảnh Xương tạm thời<> vượt quá giới hạn, một lớp <#ffb900ff>khiên<> và <#ffb900ff>+30% Tốc Đánh<>. Có thể đi xuyên vật cản và Đánh Thường khi đang di chuyển, đồng thời Ảo Ảnh Ẩn Thân kéo dài <#ffb900ff>1 giây<>."
      },
      "mlbb_gord": {
        "name": "Gord",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công vật lý<> sát thương vật lý, tầm xa.",
        "passive": "<#5ad0e6ff>Ân sủng thần bí<>: Mỗi <#ffb900ff>3<> lần trúng kỹ năng lên kẻ địch sẽ tích lũy, lần trúng kỹ năng tiếp theo gây thêm <#a974ffff>12 (+2 mỗi cấp) (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>8% Sức mạnh phép thuật) sát thương chuẩn<> và làm chậm mục tiêu <#ffb900ff>20%<> trong <#ffb900ff>1 giây<>. Hiệu ứng làm chậm cộng dồn tối đa <#ffb900ff>2<> lần, tới <#ffb900ff>40%<>.",
        "skill": "<#5ad0e6ff>Đạn thần bí<>: Bắn một quả cầu năng lượng dừng lại ở kẻ địch đầu tiên trúng phải và nổ, gây <#a974ffff>105 + 52% Sức mạnh phép thuật<> sát thương phép và <#ffb900ff>làm choáng<> trong <#ffb900ff>1 giây<>.",
        "skill2": "<#5ad0e6ff>Cấm chế thần bí<>: Tạo một vùng năng lượng tại vị trí chỉ định trong <#ffb900ff>4 giây<>, gây <#a974ffff>6 + 12% Sức mạnh phép thuật<> sát thương phép mỗi <#ffb900ff>0,25 giây<> — tối đa <#ffb900ff>16<> lần.",
        "ult": "<#e64a6aff>Phun trào thần bí<>: Kênh một luồng tia năng lượng trong <#ffb900ff>3,2 giây<>, gây <#a974ffff>12 + 17% Sức mạnh phép thuật<> sát thương phép mỗi <#ffb900ff>0,2 giây<> — tối đa <#ffb900ff>16<> lần. Mỗi đợt sóng tự nhắm lại vào tướng địch gần nhất phía trước."
      },
      "mlbb_belerick": {
        "name": "Belerick",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công vật lý<> sát thương vật lý. Khi đang được <#5ad0e6ff>Đòn tự nhiên<> cường hóa, đòn đánh sẽ gây <#a974ffff>60<> sát thương phép, hồi <#ffb900ff>150 + 12% Máu đã mất<> và làm chậm mục tiêu <#ffb900ff>60%<> trong <#ffb900ff>1,4 giây<>.",
        "passive": "<#5ad0e6ff>Gai chết chóc<>: mỗi <#ffb900ff>4<> lần Belerick bị đánh, hắn bắn một gai về phía kẻ địch gần nhất, gây <#a974ffff>10 (+1 mỗi cấp) + 1% Máu tối đa<> sát thương phép. Sát thương dưới <#ffb900ff>10<> không được tính, tối đa kích hoạt mỗi <#ffb900ff>1,2 giây<> và trụ không kích hoạt được.",
        "skill": "<#5ad0e6ff>Hạt giống cổ đại<>: phóng dây leo theo một đường thẳng, gây <#a974ffff>115<> sát thương phép và làm chậm kẻ địch trúng phải <#ffb900ff>25%<> trong <#ffb900ff>2 giây<>. Sau <#ffb900ff>1,1 giây<>, hạt giống nổ trên cùng đường, gây <#a974ffff>115<> sát thương phép và <#ffb900ff>khiêu khích<> trong <#ffb900ff>1,2 giây<>.",
        "skill2": "<#5ad0e6ff>Đòn tự nhiên<>: nhận <#ffb900ff>+60%<> Tốc độ di chuyển trong <#ffb900ff>1 giây<>, sau đó <#ffb900ff>+20%<> trong <#ffb900ff>1 giây<> và cường hóa đòn đánh thường tiếp theo trong <#ffb900ff>3 giây<>. Mỗi lần <#5ad0e6ff>Gai chết chóc<> kích hoạt, hồi chiêu giảm <#ffb900ff>1 giây<>.",
        "ult": "<#e64a6aff>Thịnh nộ Dryad<>: triệu hồi dây leo lan ra theo <#ffb900ff>4<> đợt, mỗi đợt gây <#a974ffff>55<> sát thương phép và <#ffb900ff>khiêu khích<> kẻ địch trúng phải trong <#ffb900ff>1,5 giây<>."
      },
      "mlbb_cecilion": {
        "name": "Cecilion",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> sát thương vật lý ở tầm xa.",
        "passive": "<#5ad0e6ff>Tràn Trề<>: mỗi khi kỹ năng của Cecilion trúng kẻ địch, hắn nhận <#ffb900ff>1<> điểm cộng dồn, tối đa một lần mỗi <#ffb900ff>1 giây<>. Mỗi điểm cộng dồn cho hắn <#a974ffff>+3 Sức Mạnh Phép Thuật<> trong suốt trận đấu, và các điểm cộng dồn được giữ lại sau khi chết.",
        "skill": "<#5ad0e6ff>Cú Đánh Dơi<>: phóng một con dơi khổng lồ về phía trước, gây <#a974ffff>30 + 25% Tổng Sức Mạnh Phép Thuật<> sát thương phép lên kẻ địch trên đường đi. Khi đến đích, con dơi lao xuống, gây <#a974ffff>55 + 50% Tổng Sức Mạnh Phép Thuật<> sát thương phép.",
        "skill2": "<#5ad0e6ff>Móng Vuốt Máu<>: đánh dấu một vị trí. Sau <#ffb900ff>0,6 giây<>, những móng vuốt máu khép lại, gây <#a974ffff>60 + 60% Tổng Sức Mạnh Phép Thuật<> sát thương phép lên kẻ địch trúng phải và <#ffb900ff>làm choáng<> chúng trong <#ffb900ff>1 giây<> và kéo chúng về trung tâm vùng đánh dấu.",
        "ult": "<#e64a6aff>Yến Tiệc Dơi<>: bắn ra <#ffb900ff>40<> mũi máu trong <#ffb900ff>3 giây<>, mỗi mũi trúng một tướng địch gần đó gây <#a974ffff>5 + 8% Tổng Sức Mạnh Phép Thuật<> sát thương phép; hắn có thể di chuyển khi đang tung, nhận <#a974ffff>+60% Tốc Chạy<> trong <#ffb900ff>1,5 giây<> và hồi <#a974ffff>8<> máu cho mỗi mũi máu."
      },
      "mlbb_johnson": {
        "name": "Johnson",
        "attack": "Vung cờ lê hạng nặng, gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% AD<> <#ff9028ff>sát thương vật lý<>.",
        "passive": "<#5ad0e6ff>Túi Khí Điện Tử<>: khi máu dưới <#ffb900ff>30%<>, nhận khiên <#a974ffff>120 (+240% Tổng Phòng Thủ Vật Lý)<> trong <#ffb900ff>10 giây<>. Hồi chiêu <#ffb900ff>100 giây<>.",
        "skill": "<#5ad0e6ff>Cờ Lê Xung Kích<>: ném cờ lê, gây <#a974ffff>80 (+110% Tổng Phòng Thủ Vật Lý)<> sát thương phép lên kẻ địch trên đường đi. Kẻ địch gần điểm rơi bị choáng <#ffb900ff>0,8 giây<>.",
        "skill2": "<#5ad0e6ff>Sóng Điện Từ<>: giương khiên, gây <#a974ffff>40 (+45% Tổng Phòng Thủ Vật Lý)<> sát thương phép phía trước và giảm Tốc Độ Di Chuyển cùng Phòng Thủ Phép của kẻ địch. Cộng dồn tối đa <#ffb900ff>3<> lần.",
        "ult": "<#5ad0e6ff>Tăng Tốc Tối Đa<>: biến thành xe hơi. Tướng đồng minh gần đó có thể lên xe. Khi đâm vào tướng địch, xe phát nổ gây <#a974ffff>90 (+150% đến +220% Tổng Phòng Thủ Vật Lý)<> sát thương phép, choáng <#ffb900ff>0,5 đến 1 giây<> theo thời gian lái, và để lại vùng điện từ. Anh ta cũng có thể chở đồng minh đến nơi an toàn."
      },
      "mlbb_angela": {
        "name": "Angela",
        "attack": "Bắn tia tim gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Công Vật Lý<> sát thương vật lý trong tầm <#ffb900ff>88.000<>.",
        "skill": "<#5ad0e6ff>Sóng Tình Yêu<>: tiêu hao một tích trữ để phóng sóng tới <#ffb900ff>92.000<> về phía trước, gây <#a974ffff>80 + 30% Sức Mạnh Phép<> sát thương phép lên kẻ địch và hồi máu cho đồng đội nó đi qua với <#5bd18aff>46 + 40% Sức Mạnh Phép<>. Kẻ địch trúng đòn nhận một tầng <#5ad0e6ff>Dấu Ấn Tình Nhân<> trong <#ffb900ff>3 giây<> (tối đa <#ffb900ff>5<>), mỗi tầng thêm <#ffb900ff>+12%<> sát thương cho các đợt sóng sau và đòn cuối của S2, đồng thời làm chậm <#ffb900ff>6%<>. Dùng liên tiếp tối đa <#ffb900ff>5 lần<>; lần cuối bắt đầu hồi chiêu <#ffb900ff>5 giây<>.",
        "skill2": "<#5ad0e6ff>Con Rối Dây<>: nối một kẻ địch trong tầm <#ffb900ff>95.000<> trong <#ffb900ff>3 giây<>, gây <#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25% Sức Mạnh Phép<> sát thương phép và làm chậm chúng tới <#ffb900ff>45%<> dần theo thời gian. Nếu vẫn còn nối khi kết thúc, gây thêm <#a974ffff>140 + 35% Sức Mạnh Phép<> (tăng theo tầng <#5ad0e6ff>Dấu Ấn Tình Nhân<>) và trói <#ffb900ff>0,7 giây<>. Đứt vô hại khi cách xa quá <#ffb900ff>150.000<> hoặc khi chết; dây đứt không gây đòn cuối.",
        "ult": "<#e64a6aff>Hộ Vệ Trái Tim<>: tạo khiên cho một tướng đồng minh ở bất kỳ đâu trên bản đồ với <#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>180% Sức Mạnh Phép<> trong <#ffb900ff>6 giây<>. Angela biến mất vào đồng minh đó trong <#ffb900ff>12 giây<>, tự động dùng S1 và S2 từ vị trí của họ, còn <#5ad0e6ff>búp bê<> trên đầu đánh dấu mối liên kết. Kết thúc sớm nếu chủ thể chết hoặc không còn có thể chọn; tái kích hoạt sẽ gỡ ngay. Hồi chiêu <#ffb900ff>40 giây<>.",
        "passive": "<#5ad0e6ff>Trái Tim Thông Tuệ<>: mỗi lần dùng kỹ năng nhận Tốc Độ Di Chuyển trong <#ffb900ff>4 giây<> cho Angela, hoặc cho chủ thể khi đang nhập thể. Cộng dồn tối đa <#ffb900ff>4 tầng<> với tổng <#ffb900ff>7%, 15%, 22%, 30%<>; làm mới khi đã đạt mức tối đa không vượt quá mức đó, và số lần dùng lẫn hồi chiêu được giữ nguyên qua lần nhập thể."
      },
      "mlbb_eudora": {
        "name": "Eudora",
        "attack": "Đòn đánh thường phóng tia sét, gây sát thương vật lý bằng <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<>.",
        "skill": "<#5ad0e6ff>Sét Phân Nhánh<>: Giáng sét theo hình quạt, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100 + 55% AP<> sát thương phép; sát thương lên lính đường tăng gấp đôi. Kẻ địch đã có dấu ấn bị nối tối đa <#ffb900ff>1<> giây, chịu <#ffb900ff>4<> lần sát thương <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>4 + 2% AP<> và thêm <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>100 + 55% AP<> nếu liên kết được duy trì đến cuối. Eudora tăng <#ffb900ff>20%<> tốc chạy khi còn liên kết. Đòn kết thúc giảm hồi chiêu <#ffb900ff>1.5<> giây, chỉ một lần mỗi lượt dùng. Liên kết đứt khi khoảng cách vượt <#ffb900ff>95,000<>. Hồi chiêu: <#ffb900ff>7<> giây. Đòn đầu gây <#a974ffff>120 + 65% AP<> sát thương phép lên tướng địch.",
        "skill2": "<#5ad0e6ff>Cầu Sét<>: Phóng cầu sét, giảm <#ffb900ff>8<> kháng phép trong <#ffb900ff>1.8<> giây, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>115 + 45% AP<> sát thương phép và làm choáng <#ffb900ff>0.8<> giây. Nếu mục tiêu đã có dấu ấn, kẻ địch ở gần cũng chịu các hiệu ứng tương tự. Mỗi kẻ địch chỉ trúng một lần. Hồi chiêu: <#ffb900ff>11<> giây.",
        "ult": "<#e64a6aff>Thịnh Nộ Lôi Đình<>: Giáng sét xuống một vùng đất, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>260 + 110% AP<> sát thương phép ở tâm hoặc <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 55% AP<> ở vòng ngoài. Kẻ địch đã có dấu ấn để lại cảnh báo tại vị trí trúng đòn. Sau <#ffb900ff>0.6<> giây, các vùng đó phát nổ, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>160 + 72% AP<> sát thương phép. Các vụ nổ chồng nhau trong cùng lượt dùng chỉ đánh mỗi kẻ địch một lần. Hồi chiêu: <#ffb900ff>32<> giây.",
        "passive": "<#5ad0e6ff>Siêu Dẫn<>: Kỹ năng đánh trúng sẽ đánh dấu tướng địch và quái rừng trong <#ffb900ff>5<> giây. Kỹ năng có thêm hiệu ứng lên kẻ địch đã được đánh dấu. Đòn đánh thường không tạo dấu ấn; dấu ấn không cộng dồn."
      },
      "mlbb_julian": {
        "name": "Julian",
        "attack": "Đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% sát thương vật lý<> dưới dạng sát thương vật lý. Trong <#ffb900ff>2<>s sau khi dùng kỹ năng, đòn đánh thường gây <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% sát thương vật lý<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 55% AP<> sát thương phép và kéo mục tiêu về phía Julian.",
        "skill": "<#5ad0e6ff>Lưỡi hái<>: Ném lưỡi hái theo hướng chỉ định, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>155 + 72% AP<> sát thương phép lên kẻ địch trên đường bay và làm chậm <#ffb900ff>30<>% trong <#ffb900ff>1<>s. Xuyên qua lính và dừng ở kẻ địch đầu tiên không phải lính. Cường hóa: gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>215 + 100% AP<> và làm chậm <#ffb900ff>50<>%. Tại kẻ địch không phải lính đầu tiên hoặc tầm xa tối đa, lưỡi hái tiếp tục bay chậm hơn, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26 + 11% AP<> sát thương phép mỗi <#ffb900ff>0.1<>s trong vùng trong <#ffb900ff>1.6<>s.",
        "skill2": "<#5ad0e6ff>Phi kiếm<>: Triệu hồi phi kiếm và lướt theo hướng chỉ định, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 52% AP<> sát thương phép lên kẻ địch trên đường. Cường hóa: triệu hồi nhiều kiếm, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 14% AP<> sát thương phép mỗi <#ffb900ff>0.1<>s trong lúc lướt, tối đa <#ffb900ff>6<> lần. Julian không thể bị chọn làm mục tiêu và tàng hình khi lướt, sau đó xuất hiện ở điểm xa nhất.",
        "ult": "<#e64a6aff>Xiềng xích<>: Thả xiềng xích tại vị trí chỉ định. Sau <#ffb900ff>0.3<>s, gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>112 + 50% AP<> sát thương phép trong bán kính <#ffb900ff>18,000<> và trói chân kẻ địch <#ffb900ff>1<>s. Cường hóa: gây <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12 + 6% AP<> mỗi <#ffb900ff>0.2<>s và làm chậm <#ffb900ff>30<>%, sau đó kẻ địch còn trong vùng nhận <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>205 + 88% AP<> và bị hất tung <#ffb900ff>0.8<>s. Trước khi mở khóa Xiềng xích, Julian tự động dùng nó trong chuỗi chiêu.",
        "passive": "<#5ad0e6ff>Di sản thợ rèn<>: Sau khi dùng hai kỹ năng khác nhau, Julian cường hóa kỹ năng còn lại. Lần dùng cường hóa đưa cả ba kỹ năng vào thời gian hồi chung <#ffb900ff>9<>–<#ffb900ff>6<>s, giảm theo cấp. Mỗi kỹ năng chỉ dùng một lần mỗi chuỗi; chuỗi chưa hoàn thành hết hạn sau <#ffb900ff>4<>s. Đánh trúng tướng địch bằng kỹ năng cho <#ffb900ff>10<>% hút máu hỗn hợp trong <#ffb900ff>5<>s, tối đa <#ffb900ff>30<>%."
      },
      "mlbb_popol_kupa": {
        "name": "Popol & Kupa",
        "attack": "Popol throws a spear that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact. Kupa bites nearby enemies for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45% AD<> physical damage, increased to <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75% AD<> in Alpha Wolf Form. Kupa’s ordinary bites use Popol’s basic-attack item effects.",
        "skill": "<#5ad0e6ff>Bite ’em, Kupa!<>: Popol throws a spear for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50 + 50% AD<> physical damage and commands Kupa to bite the target for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60 + 60% AD<> physical damage, <#ef5350ff>slowing<> it by <#ffb900ff>50%<> for <#ffb900ff>1s<>. Alpha Wolf Form: the bite instead deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90 + 75% AD<> physical damage to nearby enemies and knocks them <#ef5350ff>airborne<> for <#ffb900ff>0.6s<>.",
        "skill2": "<#5ad0e6ff>Kupa, Help!<>: Popol gains a <#ffb900ff>90 + 50% AD<> shield for <#ffb900ff>3s<> and calls Kupa back. When Kupa arrives, Popol mounts him for up to <#ffb900ff>1.5s<>, gaining <#ffb900ff>50%<> Movement Speed while Kupa recovers <#ffb900ff>25%<> Max HP over the ride. Attacks, other skills and hard crowd control end the ride. Alpha Wolf Form: the shield increases to <#ffb900ff>140 + 70% AD<> and Kupa fully recovers HP at mount start.",
        "ult": "<#e64a6aff>We Are Angry!<>: Kupa fully recovers HP and enters <#5ad0e6ff>Alpha Wolf Form<> for <#ffb900ff>9s<>, gaining <#ffb900ff>35%<> Max HP and enhancing Bite ’em, Kupa! and Kupa, Help! Cooperative stack bonuses are doubled. Requires a living Kupa.",
        "passive": "<#5ad0e6ff>We Are Friends<>: When Popol and Kupa damage the same enemy within <#ffb900ff>2s<>, both gain <#ffb900ff>5%<> Attack Speed and <#ffb900ff>2%<> Movement Speed for <#ffb900ff>4s<>, stacking up to <#ffb900ff>3<> times. Each paired exchange grants one stack.\nKupa has <#ffb900ff>560 + 80 per level after Lv.1 + 50% of Popol’s bonus Max HP<> HP and inherits Popol’s current Armor, Magic Resist and Attack Speed. After <#ffb900ff>5s<> out of combat, Kupa recovers <#ffb900ff>8%<> Max HP per second. If Kupa falls, Popol begins a stationary <#ffb900ff>3s<> prayer after <#ffb900ff>3s<> without combat; movement, damage or another action interrupts it. Successful revival has a <#ffb900ff>30s<> cooldown.\n<#5ad0e6ff>Popol’s Surprise<>: During combat, Popol automatically places a trap every <#ffb900ff>10s<>, up to <#ffb900ff>2<>. Traps arm after <#ffb900ff>0.5s<> and last <#ffb900ff>15s<>. An enemy triggers <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25 + 20% AD<> physical damage and <#ffb900ff>0.6s<> of <#ef5350ff>immobilization<>, leaving frost for <#ffb900ff>3s<> that <#ef5350ff>slows<> enemies by <#ffb900ff>20%<> and reduces Armor by <#ffb900ff>12%<>. Frost from the same Popol does not stack. Placement pauses during casting, recall, riding and prayer."
      },
      "mlbb_granger": {
        "name": "Granger",
        "attack": "Fires a handgun round that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact.",
        "skill": "<#5ad0e6ff>Rhapsody<>: Locks onto an enemy and fires <#ffb900ff>6<> homing rounds over <#ffb900ff>1.5s<>, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>36 + 45% AD<> physical damage and consuming <#ffb900ff>70<> Gun Energy. Requires more than <#ffb900ff>420<> Gun Energy. Movement Speed increases by <#ffb900ff>10%<> while firing. Each hit reduces Rondo’s cooldown by <#ffb900ff>0.5s<>. The final round gains <#ffb900ff>100%<> Critical Chance for its impact. Rondo and Death Sonata can be used during the barrage.",
        "skill2": "<#5ad0e6ff>Rondo<>: Dashes a short distance and restores <#ffb900ff>15%<> of maximum Gun Energy. Walls and movement-disabling effects stop the dash. Equipment cooldown reduction increases Attack instead of shortening Rondo’s effective cooldown.",
        "ult": "<#5ad0e6ff>Death Sonata<>: Consumes <#ffb900ff>250<> Cannon Energy to fire a homing cannon round at an enemy champion. Impact triggers an explosion, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>155 + 110% AD<> physical damage to nearby enemies and <#ef5350ff>slowing<> them by <#ffb900ff>30%<> for <#ffb900ff>0.6s<>. Granger then rolls a short distance away from the firing direction.",
        "passive": "<#5ad0e6ff>Capriccio<>: Uses separate Gun and Cannon Energy pools, each starting at <#ffb900ff>800<>. Gun Energy regenerates at <#ffb900ff>8%<> of its maximum per second; Cannon Energy regenerates at <#ffb900ff>2%<>. Credited lane-minion kills increase maximum Gun Energy by <#ffb900ff>6<> and restore <#ffb900ff>5%<>; jungle kills grant the same benefit to Cannon Energy. Champion kills and assists increase both maxima by <#ffb900ff>12<> and restore <#ffb900ff>10%<>. Capacity growth persists through death. Equipment cooldown reduction grants <#ffb900ff>0.5<> Attack per percentage point, up to <#ffb900ff>20<> Attack."
      },
      "mlbb_hanzo": {
        "name": "Hanzo",
        "attack": "Strikes for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Attack<> physical damage and applies a mark.",
        "skill": "<#5ad0e6ff>Demon Feast<>: At <#ffb900ff>5 marks<>, bites champions for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200 + 7 per level after Lv.1 + 115% bonus Attack<> physical damage, heals and refunds <#ffb900ff>60%<> cooldown. Ordinary camps are devoured, healing <#66cc66ff>20% maximum Health<>.\n<#5ad0e6ff>Soul Snatch<>: Lunges for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>135 + 6 per level after Lv.1 + 95% bonus Attack<> physical damage, increased <#ffb900ff>24% per mark<> against champions and <#ffb900ff>20% per mark<> against other targets. At <#ffb900ff>5 marks<>, adds damage based on maximum Health and heals.\nCooldown: <#ffb900ff>12s / 10s<>.",
        "skill2": "<#5ad0e6ff>Dark Mist<>: Dashes and gains <#ffb900ff>15% Movement Speed<> for <#ffb900ff>2s<>. Leaves <#ffb900ff>5<> mist pulses.\n<#5ad0e6ff>Black Mist<>: Dashes through walls for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110 + 4 per level + 55% bonus Attack<> physical damage and <#ef5350ff>0.4s airborne<>. Leaves <#ffb900ff>4<> pulses.\nMist deals physical damage every <#ffb900ff>0.5s<>, applies marks and <#ef5350ff>slows 35%<>; it cannot critically strike. Cooldown: <#ffb900ff>10s per form<>.",
        "ult": "Projects Hanekage for up to <#ffb900ff>15s<>, leaving an invulnerable body. Gains <#ffb900ff>35% Movement Speed<>, <#ffb900ff>25% Attack Speed<> and wall traversal, with <#ffb900ff>30% less maximum Health<>.\nRecast returns and heals <#66cc66ff>90 + 50% bonus Attack<>. Empty Energy draws the body to Hanekage. Defeat forces a return to the body, <#ef5350ff>slows Hanzo 50% for 6s<> and sets a <#ffb900ff>52s<> cooldown (normally <#ffb900ff>26s<>).",
        "passive": "Basic attacks and mist hits apply up to <#ffb900ff>5 marks<> for <#ffb900ff>6s<>. New hits refresh them. Hanekage starts with <#ffb900ff>100 Energy<> and spends <#ffb900ff>10 per second<>; hits and nearby deaths restore Energy."
      },
      "mlbb_atlas": {
        "name": "Atlas",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Skill casts create a moving frost aura for <#ffb900ff>4s<> and grant <#66cc66ff>10 armor and magic resistance<>. Nearby enemy champions slow up to <#ef5350ff>25%<> and freeze for <#ef5350ff>0.5s<> after 2s of continuous exposure. Freeze cooldown per target: <#ffb900ff>4s<>.",
        "skill": "Slams three times for <#5ad0e6ff>30 + 10% Magic Power<> magic damage per pulse. The suit also slams while separated. Overlapping hits deal <#5ad0e6ff>45 + 15% Magic Power<> once per pulse. Cooldown: <#ffb900ff>7s<>.",
        "skill2": "Ejects for up to <#ffb900ff>2s<>, gaining <#ffb900ff>25% Movement Speed<> while the suit follows. Reunion deals <#5ad0e6ff>65 + 20% Magic Power<> magic damage and <#ef5350ff>stuns for 0.6s<>. Cooldown: <#ffb900ff>10s<>.",
        "ult": "Links nearby enemy champions for <#5ad0e6ff>35 + 10% Magic Power<> magic damage and <#ef5350ff>30% slow<>. After <#ffb900ff>0.4s<>, Atlas pulls them in for <#5ad0e6ff>105 + 25% Magic Power<> magic damage and <#ef5350ff>0.35s airborne<>. While ejected, reunites immediately with a <#ef5350ff>40% slow<> in place of the reunion hit. Cooldown: <#ffb900ff>34s<>."
      },
      "mlbb_yu_zhong": {
        "name": "Yu Zhong",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage. Soul Grip can empower the next basic attack.",
        "passive": "Basic attacks and direct skill hits apply Sha Residue to enemy heroes and jungle monsters, including Morgard and Serpen, for <#ffb900ff>5s<>. At three marks, the target pulses five times. Each pulse deals <#ff9028ff>32 + 18% Attack + 2% of the target’s missing HP<> as physical damage and heals Yu Zhong for <#66cc66ff>8% of his missing HP<>. Against jungle monsters, the missing-HP damage bonus is capped at 40 per pulse. When the eruption starts, Yu Zhong gains 15% Movement Speed for 1.5s.",
        "skill": "After 0.4s, sweeps nearby enemies for <#ff9028ff>80 + 65% Attack<> physical damage. The outer edge instead deals <#ff9028ff>138 + 95% Attack<> and applies two marks to eligible targets. Cooldown is 7s.",
        "skill2": "Sends a wave that deals <#ff9028ff>95 + 68% Attack<> physical damage and slows by 30% for 1s. On hit, the next basic attack within 3s deals <#ff9028ff>55 + 40% Attack<> extra physical damage and can lunge toward the champion struck by Soul Grip if the route is clear. Hitting a champion at a useful distance triggers Furious Dive if the landing is safe. The leap deals damage on landing and allows one short dash in his movement direction. After 0.4s, the original landing area erupts, knocking enemy champions airborne for 0.5s. Both hits deal a combined <#ff9028ff>64 + 45% Attack<> physical damage. Cooldown is 10s.",
        "ult": "Channels for 0.6s, then flies as a dragon for up to 3.5s with 35% Movement Speed, wall traversal and crowd-control immunity. Passing an enemy hero deals <#ff9028ff>125 + 85% Attack<> physical damage and knocks them back once. On landing, enters Dragonoid Form for 15s, increasing skill reach and width by 20%. Cooldown is 46s."
      }
    },
