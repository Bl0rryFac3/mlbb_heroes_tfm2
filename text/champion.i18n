  "zh-hans": {
    "description": {
      "mlbb_valir": {
        "name": "Valir",
        "attack": "Throws an ember that deals <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Direct spell hits apply Ablaze for <#ffb900ff>3s<>. The burn deals <#5ad0e6ff>0.8% max HP<> magic damage per second. At <#ffb900ff>3 stacks<>, it detonates for <#5ad0e6ff>4% max HP + 25% Magic Power<> magic damage and <#ef5350ff>stuns for 0.65s<>. Stun cooldown per target is <#ffb900ff>8s<>. Monster damage is capped. Bosses are immune to the stun.",
        "skill": "Fires a bolt that deals <#5ad0e6ff>70 + 65% Magic Power<> magic damage and <#ef5350ff>slows by 25% for 0.7s<>. The impact area bursts after <#ffb900ff>0.75s<> for <#5ad0e6ff>42 + 30% Magic Power<> magic damage. Stores <#ffb900ff>2 charges<> and restores one every <#ffb900ff>9s<>. A direct hit on a champion or boss refunds a charge up to once every <#ffb900ff>3.6s<>. Hitting a lane minion takes <#ffb900ff>2s<> off the recharge. Minimum recast is <#ffb900ff>1.8s<>.",
        "skill2": "Sends a wave that deals <#5ad0e6ff>95 + 65% Magic Power<> magic damage and <#ef5350ff>knocks back enemy champions, lane minions and regular jungle monsters<>. While empowered, it leaves a firewall for <#ffb900ff>3s<> that deals <#5ad0e6ff>27 + 22% Magic Power<> magic damage each second and briefly <#ef5350ff>slows by 20%<>. Cooldown is <#ffb900ff>10s<>.",
        "ult": "Can activate automatically when ready to <#ef5350ff>break a stun or other supported disable<>. Suppression still applies. Grants <#ffb900ff>30% Movement Speed<>, tapering over <#ffb900ff>3s<>. Empowers the next <#ffb900ff>4 casts<> within <#ffb900ff>9s<>. Fireball gains <#ffb900ff>30% projectile reach<> and Torrent leaves a firewall. Cooldown is <#ffb900ff>42s<>."
      },
      "mlbb_lesley": {
        "name": "Lesley",
        "attack": "Fires a rifle shot for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "<#5ad0e6ff>Lethal Shot<>. Casting a skill or going 5s without taking damage readies the next basic. It gains <#ffb900ff>17 range<> and deals <#ff9028ff>75 + 110% Attack<> true damage to champions or <#ff9028ff>75 + 125% Attack<> physical damage to lane and jungle enemies. Structures take normal basic damage.",
        "skill": "<#5ad0e6ff>Master of Camouflage<>. Camouflages for up to <#ffb900ff>2.5s<> and gains 30% Movement Speed. Enemies lose direct targeting, but area effects can still hit her. Attacking, casting another skill, or taking damage after the first 0.5s ends camouflage.",
        "skill2": "<#5ad0e6ff>Tactical Grenade<>. Deals <#ff9028ff>115 + 65% Attack<> physical damage in a short cone and pushes surviving enemy champions away. Lesley hops backward if the path is clear. During Ultimate Snipe, she fires an available round before ending the volley.",
        "ult": "<#e64a6aff>Ultimate Snipe<>. Locks onto an enemy champion and fires up to <#ffb900ff>four rounds<>. Each deals <#ff9028ff>70 + 32% Attack + 6% of the target’s missing HP<> as physical damage. Another enemy champion in the firing line can intercept a round."
      },
      "mlbb_aldous": {
        "name": "奥尔德斯",
        "attack": "挥舞熔岩巨拳造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<><#ff9028ff>物理伤害<>。",
        "skill": "<#ff9028ff>契约：夺魂<>：主目标受到<#ff9028ff>40 + 等级加成 + 100%攻击力 + 每层夺魂2.5点<>物理伤害；附近敌人受到<#ff9028ff>40%<>溅射伤害。达到<#ffb900ff>1,000<>层时，层数额外提供<#ffb900ff>+2,500<>点原始伤害（护甲减免前）。",
        "skill2": "<#ffb900ff>契约：爆裂<>：展开符文护盾<#ffb900ff>2秒<>（<#ffb900ff>90<>护盾与<#ffb900ff>+25%<>移速），随后引爆造成<#ff9028ff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<><#ff9028ff>物理伤害<>并<#ef5350ff>眩晕<>周围敌人<#ffb900ff>1秒<>。",
        "ult": "<#e64a6aff>契约：追命<>：在敌方头顶凝结<#e64a6aff>命运之眼<>并化作熔岩钻头冲撞目标，造成<#ff9028ff>130<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%攻击力<><#ff9028ff>物理伤害<>与<#ffb900ff>1.2秒<><#ef5350ff>眩晕<>。",
        "passive": "契约·变换：奥杜斯吸取灵魂能量——每<#ffb900ff>5秒<>+1层，击杀+10层，<#5ad0e6ff>灵魂窃取<>命中时额外获得（上限<#ffb900ff>1000<>层）。每第<#ffb900ff>3<>次普攻（<#ffb900ff>5秒<>冷却）将层数转化为持续<#ffb900ff>2秒<>的护盾，数值为<#ffb900ff>35<>+<#ffb900ff>5<>/级+<#ffb900ff>0.45<>/层。层数同时强化<#5ad0e6ff>灵魂窃取<>。"
      },
      "mlbb_fanny": {
        "name": "芬妮",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>的物理伤害。",
        "skill": "<#ff9028ff>飓风突刺<>：造成<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%攻击力<>伤害，范围<#ffb900ff>22,000<>。钢索飞行时撞到敌人会自动触发空中飓风突刺，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%攻击力<>伤害。",
        "skill2": "<#ff9028ff>钢索<>：向最佳墙体或边路外墙射出钢索（射程<#ffb900ff>165,000<>），无能量消耗连续多段荡墙追击或撤退。优先锁定可见敌方英雄，无敌方英雄视野时可荡墙清理野怪。",
        "ult": "<#ff9028ff>割喉<>：冲向目标，造成<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125%攻击力<>伤害；每层猎物印记额外造成<#ff9028ff>35%攻击力<>（最多2层）。命中后消耗印记。",
        "passive": "<#ff9028ff>空中优势<>：钢索飞行时，芬妮根据飞行速度获得<#ffb900ff>10–25%<>伤害加成。飞行中命中敌方英雄会施加或升级<#ff9028ff>猎物印记<>（最多2层，持续<#ffb900ff>5秒<>），并触发飓风突刺。"
      },
      "mlbb_lancelot": {
        "name": "兰斯洛特",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>的物理伤害。",
        "skill": "<#ff9028ff>穿刺<>：突进至指定敌人，造成<#ff9028ff>80–178 + 40%攻击力<>物理伤害。命中的第一个未标记敌人获得<#5ad0e6ff>剑印<>；施加新剑印会重置穿刺冷却。每次施放获得一层<#ffb900ff>灵魂切割<>。",
        "skill2": "<#ffb900ff>刺玫瑰<>：连续攻击三次，每次造成<#ff9028ff>85–155 + 30%攻击力<>物理伤害，并使命中的敌人减速<#ffb900ff>20%<>，持续<#ffb900ff>0.5秒<>。连招期间免疫伤害与控制；多目标重叠命中会受到群体伤害折减。",
        "ult": "<#e64a6aff>幻影处决<>：突进至指定敌方英雄，抵达时造成<#ff9028ff>100–156 + 100%攻击力<>物理伤害。突进期间免疫伤害与控制，并获得一层<#ffb900ff>灵魂切割<>。",
        "passive": "<#5ad0e6ff>灵魂切割<>：穿刺和幻影处决会使伤害每层提高<#ffb900ff>7.5%<>，持续<#ffb900ff>4秒<>，最多<#ffb900ff>4层（30%）<>。"
      },
      "mlbb_estes": {
        "name": "埃斯特斯",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>物理伤害。",
        "passive": "<#5ad0e6ff>月精灵之书<>：每秒获得<#ffb900ff>1<>层充能；连接队友时每秒获得<#ffb900ff>2<>层。达到100层后，下次普攻强化，造成<#a974ffff>魔法伤害<>并弹射至最多2名附近敌人，同时减速40%，持续1.5秒。层数显示在一技能图标上。",
        "skill": "<#5ad0e6ff>月光浸礼<>：立即为一名友方英雄回复<#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%法术强度<>生命值，随后每<#ffb900ff>0.5秒<>回复<#5bd18aff>24<> + <#a974ffff>18%法术强度<>，持续<#ffb900ff>5秒<>。友军获得<#ffb900ff>+7<>物理与法术防御，埃斯特斯获得<#ffb900ff>+15%<>移速。超过120,000时，视觉连接与被动充能加成停止；数据驱动的持续治疗仍会完成。",
        "skill2": "<#5ad0e6ff>月之女神领域<>：放置一个<#5ad0e6ff>固定<>月光区域，持续<#ffb900ff>2.5秒<>。每<#ffb900ff>0.5秒<>对<#ffb900ff>52,000<>范围内的敌人造成<#a974ffff>15<> + <#a974ffff>45%法术强度<>魔法伤害，并减速<#ffb900ff>35%<>，持续<#ffb900ff>0.75秒<>。此版本在区域内减速，而非仅检测外圈。",
        "ult": "<#5ad0e6ff>月之女神祝福<>：立即为<#ffb900ff>105,000<>范围内的友军回复<#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%法术强度<>；随后每<#ffb900ff>0.5秒<>回复<#5bd18aff>20<> + <#a974ffff>12%法术强度<>，持续<#ffb900ff>8秒<>，并获得<#ffb900ff>+8<>物理与法术防御。"
      },
      "mlbb_gusion": {
        "name": "古辛",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>物理伤害。",
        "passive": "<#5ad0e6ff>匕首专精<>：每次施放技能获得<#ffb900ff>1<>层符文，最多<#ffb900ff>4<>层。下次普攻消耗全部符文；每层造成目标最大生命值<#a974ffff>3%<>的魔法伤害，并回复<#5bd18aff>50 + 25%法术强度<>生命值。",
        "skill": "<#5ad0e6ff>剑锋<>：投掷匕首，对首个命中的敌人造成<#a974ffff>200 + 50%总魔法强度<>魔法伤害并标记<#ffb900ff>5秒<>。再次施放可突进至标记目标身后，造成<#a974ffff>200 + 100%总魔法强度<>魔法伤害。",
        "skill2": "<#a974ffff>幻影剑舞<>：扇形投出<#ffb900ff>5把匕首<>，每把命中造成<#a974ffff>65 + 40%总魔法强度<>魔法伤害。再次施放召回匕首。大招刷新后可再投一组，并在下次施放技能2时一并召回。",
        "ult": "<#e64a6aff>刀锋冲击<>：突进至所选敌人身后并刷新技能1、2。若技能2匕首仍在场，可再投一组；再次施放技能2会召回两组。<#ffb900ff>2.5秒<>内可再次突进。"
      },
      "mlbb_karrie": {
        "name": "凱莉",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>的<#ff9028ff>物理伤害<>，使用单个光轮。",
        "passive": "<#5ad0e6ff>光轮印记<>：普通攻击、技能1和技能2施加<#ffb900ff>1层印记<>。达到<#ffb900ff>5层<>后爆发，造成目标最大生命值的<#ff9028ff>4%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10%攻击力<>的<#e64a6aff>真实伤害<>；对英雄上限<#ffb900ff>250<>，对野怪／史诗野怪上限<#ffb900ff>300<>。",
        "skill": "<#5ad0e6ff>旋转光轮<>：向指定方向投出环形光轮。命中时对主要目标造成<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%攻击力<>物理伤害，并对附近非防御塔敌人造成<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35%攻击力<>物理伤害，使其减速<#ffb900ff>35%<>，持续<#ffb900ff>1秒<>。命中后留下紫色减速区域，持续<#ffb900ff>1.5秒<>；区域内敌人会再次受到<#ffb900ff>35%<>减速，并每隔<#ffb900ff>0.5秒<>受到一次<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10%攻击力<>物理伤害，共两次。区域脉冲不会额外施加光轮印记。",
        "skill2": "<#5ad0e6ff>幻步<>：朝指定位置冲刺固定距离，然后向落点附近最近的有效敌人发射光轮。造成<#ff9028ff>75 + 70%总物理攻击<>伤害；迅捷光轮期间系数提高至<#ff9028ff>100%<>，并施加<#ffb900ff>1层光轮印记<>。",
        "ult": "<#e64a6aff>迅捷光轮<>：持续<#ffb900ff>6秒<>，获得<#ffb900ff>+20%移动速度<>与<#ffb900ff>+35%攻击速度<>。持续期间，幻步造成<#ff9028ff>75 + 100%总物理攻击<>伤害。"
      },
      "mlbb_uranus": {
        "name": "乌瑞纳斯",
        "attack": "普通攻击以手臂挥击造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>物理伤害<>。普通攻击<#ffb900ff>不会<>施加离子之刃印记。",
        "passive": "<#5ad0e6ff>光辉<>：受到伤害时获得<#ffb900ff>1层<>，最多<#ffb900ff>12层<>，每层持续<#ffb900ff>10秒<>，每<#ffb900ff>1秒<>最多获得1层。每<#ffb900ff>0.8秒<>回复生命；12层时回复<#5bd18aff>28–134生命值<>，随等级成长。",
        "skill": "<#5ad0e6ff>离子之刃<>：释放两枚能量刃，向外飞出后返回；每次命中造成<#a974ffff>79–131（+18%总魔法强度）<>魔法伤害，并使敌人<#ffb900ff>减速30%<>，持续<#ffb900ff>2秒<>。每枚刀刃对同一目标最多命中一次。每次施放对每个目标最多施加<#ffb900ff>1层离子印记<>，持续<#ffb900ff>6秒<>；每层使后续技能1伤害提高<#ffb900ff>20%<>，最多<#ffb900ff>8层<>；防御塔和水晶不会获得印记。",
        "skill2": "<#5ad0e6ff>超然护盾<>：冲向指定位置。路径上的敌人受到<#a974ffff>48–120（+12%总魔法强度）<>魔法伤害；终点附近敌人受到<#a974ffff>96–240（+48%总魔法强度）<>并减速<#ffb900ff>25%<>。获得<#5bd18aff>300–750（+200%总魔法强度）<>护盾，持续<#ffb900ff>4秒<>；护盾破裂或结束时，对附近造成<#a974ffff>156–390（+78%总魔法强度）<>魔法伤害。",
        "ult": "<#e64a6aff>奉献<>：移除<#ef5350ff>所有控制效果<>（TFM2实现；原版仅移除减速），回复<#5bd18aff>200–400生命值<>并获得<#ffb900ff>60%移速<>，持续<#ffb900ff>8秒<>且逐渐衰减。增加<#ffb900ff>5–12层光辉<>。持续<#ffb900ff>8秒<>，生命回复与乌瑞纳斯自身的超然护盾提高<#ffb900ff>20%<>。"
      },
      "mlbb_chou": {
        "name": "周",
        "attack": "普通攻击造成100%物理攻击的物理伤害。",
        "passive": "<#5ad0e6ff>迅捷<>：移动约<#ffb900ff>42,000<>个TFM2世界单位后，下一次普攻造成<#ff9028ff>180%物理攻击<>的物理伤害，使目标减速<#ffb900ff>80%<>持续<#ffb900ff>1秒<>，并降低<#ffb900ff>10<>点物理防御，持续<#ffb900ff>2秒<>，最多<#ffb900ff>2<>层。距离按TFM2地图比例调整。",
        "skill": "<#ff9028ff>截拳道<>：最多施放<#ffb900ff>3<>次：上踢、突进上勾踢，最后跃起下砸并击飞敌人。每次命中造成<#ff9028ff>100–165 + 45%总物理攻击<>伤害。前两次施放会刷新技能以继续连招；第三次后进入冷却。第三次施放命中敌方英雄时重置瞬步的冷却时间。",
        "skill2": "<#5ad0e6ff>瞬步<>：朝指定方向突进，突进期间获得<#ffb900ff>控制免疫<>。抵达后获得护盾，数值为<#5bd18aff>200–300 + 100%额外物理攻击<>，并获得<#ffb900ff>15<>点物理穿透，持续<#ffb900ff>2.5秒<>。",
        "ult": "<#e64a6aff>龙之道<>：回旋踢击敌方英雄，造成<#ff9028ff>275–420 + 110%额外物理攻击<>伤害并将其击退。若同一目标仍在追击范围内，周会追上并在抵达后连续攻击四次，共造成<#ff9028ff>330–500 + 132%额外物理攻击<>物理伤害。"
      },
      "mlbb_zhask": {
        "name": "泽斯",
        "attack": "发射暗影弹，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%物理攻击<>的<#ff9028ff>物理伤害<>。",
        "passive": "<#5ad0e6ff>灭绝<>：泽斯阵亡时，会在死亡位置召唤狂暴的灵体，最多持续<#ffb900ff>6秒<>，每秒失去<#ffb900ff>2%<>最大生命值。",
        "skill": "<#5ad0e6ff>梦魇之灵<>：召唤一个固定位置的灵体，最多持续<#ffb900ff>12秒<>。灵体按等级继承泽斯<#ffb900ff>55–100%<>的生命值、防御和魔法强度。死亡射线每<#a974ffff>15个刻（0.25秒）<>命中一次，造成<#a974ffff>30（+25%魔法强度）<>魔法伤害，并减速<#ffb900ff>30%<>，持续<#ffb900ff>36个刻（0.6秒）<>。再次瞄准可重新安置灵体；若泽斯离开<#ffb900ff>120,000<>单位范围，射线会暂停，直到他返回。",
        "skill2": "<#5ad0e6ff>心灵吞噬<>：朝指定方向发射穿透弹，对路径上的敌人造成<#a974ffff>87 + 每高于1级增加6（+60%魔法强度）<>魔法伤害。若灵体存活，它会追击每个命中的敌人，造成<#a974ffff>35（+50%魔法强度）<>伤害并眩晕<#ffb900ff>30个刻（0.5秒）<>。",
        "ult": "<#e64a6aff>主宰降临<>：传送至目标位置并召唤融合灵体，最多持续<#ffb900ff>10秒<>。融合期间泽斯被放逐、不可被选中且无法操作。融合灵体继承泽斯100%的属性；死亡射线伤害提高至<#ffb900ff>×1.8<>。"
      },
      "mlbb_hanabi": {
        "name": "花火",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>物理伤害。",
        "passive": "<#5ad0e6ff>忍术·花瓣弹幕<>：普通攻击与技能命中后发射花瓣刃，在附近敌人间弹射。花火拥有<#ffb900ff>任意来源的护盾<>时免疫控制效果；不会移除已经生效的控制。",
        "skill": "<#5ad0e6ff>忍术·阴阳<>：获得<#ff9028ff>120 + 35%攻击力<>的护盾，持续<#ffb900ff>5秒<>，并获得<#ffb900ff>12%移动速度<>和<#ffb900ff>20%攻击速度<>。护盾持续期间，对英雄造成伤害的<#ffb900ff>20%<>、对其他单位造成伤害的<#ffb900ff>10%<>转化为护盾。护盾上限为<#ffb900ff>最大生命值的50%<>；此版本的上限计算会将所有护盾层一并计入。任意护盾也会触发被动的控制免疫。",
        "skill2": "<#5ad0e6ff>忍术·灵纸<>：发射可穿透的苦无与卷轴，对路径上的敌人造成<#ff9028ff>65 + 75%攻击力<>物理伤害，并使其减速<#ffb900ff>30%<>，持续<#ffb900ff>1秒<>。命中的敌人被标记<#ffb900ff>5秒<>。花火下一次普通攻击花瓣弹射命中被标记目标时，额外造成<#ff9028ff>20 + 50%攻击力<>伤害，不受常规弹射衰减影响，随后消耗该标记。",
        "ult": "<#e64a6aff>禁术·彼岸花<>：投出大型彼岸花，命中首个敌方英雄时造成<#ff9028ff>150 + 80%攻击力<>物理伤害并束缚<#ffb900ff>0.8秒<>。<#ffb900ff>0.8秒<>后在该位置绽放，对<#ffb900ff>34,000<>范围内敌人造成<#ff9028ff>105 + 55%攻击力<>物理伤害；其他被命中的敌人减速<#ffb900ff>20%<>，持续<#ffb900ff>0.6秒<>。"
      },
      "mlbb_alpha": {
        "name": "Alpha",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>的物理伤害。",
        "passive": "<#5ad0e6ff>贝塔，前进！<> 对敌方英雄的每第三次有效命中召唤贝塔发射激光，造成30 + 1级后每级3 + 15%攻击力的物理伤害，并减速30%，持续1秒。",
        "skill": "<#5ad0e6ff>回旋冲击<> 发射能量波，造成70 + 80%攻击力的物理伤害，并减速40%，持续1秒。贝塔追击造成25 + 1级后每级1 + 20%攻击力的真实伤害。",
        "skill2": "<#5ad0e6ff>强力挥击<> 向前横扫，造成100 + 80%攻击力的物理伤害。贝塔追击造成25 + 1级后每级1 + 20%攻击力的真实伤害。每次施放回复100 + 20%攻击力的生命值。",
        "ult": "<#e64a6aff>阿尔法之矛<> 贝塔俯冲造成70 + 20%攻击力的物理伤害并眩晕1秒。阿尔法落地产生130 + 80%攻击力的物理伤害，击飞0.67秒并减速30%，持续1.25秒。贝塔再攻击5次，每次造成8 + 10%攻击力的物理伤害。"
      },
      "mlbb_arlott": {
        "name": "阿尔洛特",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>物理伤害。",
        "passive": "<#5ad0e6ff>恶魔凝视<>：每<#ffb900ff>7秒<>标记最近的敌方英雄，被阿尔洛特控制效果命中的敌人也会被标记。被<#e64a6aff>标记<>的目标会受到复仇的双倍效果。标记持续<#ffb900ff>7秒<>。",
        "skill": "<#5ad0e6ff>无畏突刺<>：长枪下劈，对一条直线上的敌人造成<#ff9028ff>110 + 55%总物理攻击<>物理伤害并眩晕。目标<#ffb900ff>越远<>，眩晕<#ffb900ff>越长<>——近身为<#ffb900ff>0.5秒<>，最远可达<#ffb900ff>1秒<>。劈砍会标记被其控制的敌人。",
        "skill2": "<#5ad0e6ff>复仇<>：向敌人突进，造成<#ff9028ff>100 + 55%总物理攻击<>物理伤害，并以控制效果标记目标。突进期间阿尔洛特<#ffb900ff>不会被打断<>。对<#e64a6aff>标记<>目标造成<#ffb900ff>双倍<>伤害、<#ffb900ff>刷新自身冷却<>，并回复<#ffb900ff>30%总物理攻击<>的生命值（对非英雄单位减半）。",
        "ult": "<#e64a6aff>终结斩<>：双枪横扫，造成<#ff9028ff>160 + 75%总物理攻击<>物理伤害，并将所有敌人<#ffb900ff>拖拽<>至阿尔洛特的<#ffb900ff>右侧<>。每个被拖拽的敌人都会被<#e64a6aff>标记<>。"
      },
      "mlbb_franco": {
        "name": "弗兰克",
        "attack": "挥舞战锤造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>物理伤害<>。",
        "skill": "<#5ad0e6ff>铁钩<>：掷出铁钩，钩住命中的第一个敌人，造成 <#ff9028ff>190<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>物理伤害<>并将其拖向弗兰克。铁钩先<#ef5350ff>眩晕<>，再拉拽——即使目标无法被拖动，也会被定住。",
        "skill2": "<#5ad0e6ff>狂怒震慑<>：挥击四周，对附近敌人造成 <#ff9028ff>160<> + 自身<#ffb900ff>最大生命值<>的 <#ff9028ff>4%<> 的 <#ff9028ff>物理伤害<>，并使其<#ffb900ff>减速<> <#ffb900ff>70%<>，持续 <#ffb900ff>1.5秒<>。可对野怪与远古生物释放。移动中可施放。",
        "ult": "<#e64a6aff>血猎<>：<#ef5350ff>压制<>一名敌方英雄 <#ffb900ff>1.8秒<>，期间攻击 <#ffb900ff>六<> 次，战锤与铁钩交替，每次造成 <#ff9028ff>50<> + <#ff9028ff>70% AD<> 伤害。若弗兰克被控制，技能会提前结束。",
        "passive": "<#5ad0e6ff>荒原之力<>：<#ffb900ff>5秒<>内未受到伤害后，弗兰克获得 <#ffb900ff>10%<> 移动速度、每秒回复 <#ffb900ff>1%<> 最大生命值，并最多积累 <#ffb900ff>10<> 层。下一次技能将消耗全部层数，最多提升 <#ffb900ff>+150%<> 技能伤害。"
      },
      "mlbb_balmond": {
        "name": "巴蒙德",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>的物理伤害。",
        "passive": "<#5ad0e6ff>嗜血<>：击杀小兵或野怪后恢复<#ffb900ff>5%<>最大生命值，击杀或助攻英雄后恢复<#ffb900ff>10%<>。",
        "skill": "<#5ad0e6ff>灵魂锁定<>：冲向选定的敌方英雄，沿直线对沿途敌人造成<#ff9028ff>150–275 + 60%总物理攻击<>物理伤害。被击中的英雄会被短暂击退并减速<#ffb900ff>40%<>，持续<#ffb900ff>3秒<>。TFM2原型改为瞄准位置冲刺；保留直线路径伤害，抵达后对最近的敌方英雄造成伤害。",
        "skill2": "<#5ad0e6ff>旋风扫击<>：旋转<#ffb900ff>3秒<>，共造成14段伤害。每段造成<#ff9028ff>24–44 + 1.3%总生命值 + 25%总物理攻击<>物理伤害，并使目标的物理防御降低<#ffb900ff>5%<>，最多<#ffb900ff>8层<>。持续期间获得<#ffb900ff>15%<>移动速度。",
        "ult": "<#e64a6aff>致命反击<>：对前方大范围造成<#ff9028ff>150 + 70%总物理攻击 + 每个目标已损失生命值的30–45%<>真实伤害。对非英雄单位的伤害上限为<#ffb900ff>1,000 / 1,500 / 2,000<>（按英雄等级段）。"
      },
      "mlbb_obsidia": {
        "name": "奥布西迪亚",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 65%物理攻击<>物理伤害。",
        "passive": "<#5ad0e6ff>归骨<>：伤害敌人会获得骨能——对敌方英雄普攻<#ffb900ff>2<>点，技能命中<#ffb900ff>4<>点，攻击小兵或防御塔<#ffb900ff>1<>点。野怪不提供骨能。每<#ffb900ff>30<>点骨能铸就一枚骨片，最多<#ffb900ff>25<>枚。每枚骨片使其普攻额外造成总物理攻击<#ffb900ff>7%<>的伤害。击杀敌方英雄立即获得一枚骨片。",
        "skill": "<#5ad0e6ff>深渊骨针<>：沿直线射出一根骨针，对命中的敌人造成<#ff9028ff>90–140 + 60%总物理攻击<>物理伤害，并对第一个被命中的敌方英雄给予骨能。",
        "skill2": "<#5ad0e6ff>幻影影遁<>：沉入深渊，向目标方向突进，并获得<#ffb900ff>+20%移动速度<>，持续<#ffb900ff>0.3秒<>。",
        "ult": "<#e64a6aff>猎骨<>：射出愤怒之骨，造成<#ff9028ff>55 + 50%总物理攻击<>物理伤害，短暂<#ffb900ff>眩晕<>第一个被命中的敌方英雄，并<#ffb900ff>将自身拉至其附近<>。束缚其<#ffb900ff>3秒<>：自身无法离开超过<#ffb900ff>4个单位<>，敌人无法使用位移技能，敌人移动时会拖动自身。获得<#ffb900ff>5枚临时骨片<>（可超过上限）、一层<#ffb900ff>护盾<>与<#ffb900ff>+30%攻击速度<>。期间可穿越障碍并边移动边普攻，幻影影遁持续<#ffb900ff>1秒<>。"
      },
      "mlbb_gord": {
        "name": "戈尔",
        "attack": "普通攻击造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻击<> 的物理伤害，射程较远。",
        "passive": "<#5ad0e6ff>神秘恩赐<>：用技能命中敌人 <#ffb900ff>3<> 次后，下一次技能命中将额外造成 <#a974ffff>12（每级 +2）（+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>8% 法术强度）真实伤害<>，并使目标减速 <#ffb900ff>20%<>，持续 <#ffb900ff>1 秒<>。减速最多叠加 <#ffb900ff>2<> 层，最高 <#ffb900ff>40%<>。",
        "skill": "<#5ad0e6ff>神秘飞弹<>：发射一颗能量球，命中第一个敌人后停下并爆裂，造成 <#a974ffff>105 + 52% 法术强度<> 的法术伤害，并 <#ffb900ff>眩晕<> 目标 <#ffb900ff>1 秒<>。",
        "skill2": "<#5ad0e6ff>神秘禁制<>：在指定位置创造一片能量场，持续 <#ffb900ff>4 秒<>，每 <#ffb900ff>0.25 秒<> 造成 <#a974ffff>6 + 12% 法术强度<> 的法术伤害，最多 <#ffb900ff>16<> 次。",
        "ult": "<#e64a6aff>神秘喷涌<>：引导一道能量光束，持续 <#ffb900ff>3.2 秒<>，每 <#ffb900ff>0.2 秒<> 造成 <#a974ffff>12 + 17% 法术强度<> 的法术伤害，最多 <#ffb900ff>16<> 次。每一道波都会重新锁定身前最近的敌方英雄。"
      },
      "mlbb_belerick": {
        "name": "贝拉里克",
        "attack": "普通攻击造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻击<> 的物理伤害。<#5ad0e6ff>自然之击<> 强化期间，改为造成 <#a974ffff>60<> 的法术伤害，恢复 <#ffb900ff>150 + 12% 已损失生命值<> 的生命，并使目标减速 <#ffb900ff>60%<>，持续 <#ffb900ff>1.4 秒<>。",
        "passive": "<#5ad0e6ff>致命荆棘<>：贝拉里克每被命中 <#ffb900ff>4<> 次，便向最近的敌人射出一根荆棘，造成 <#a974ffff>10（每级 +1）+ 1% 最大生命值<> 的法术伤害。低于 <#ffb900ff>10<> 点的伤害不计入，每 <#ffb900ff>1.2 秒<> 最多触发一次，防御塔不会触发。",
        "skill": "<#5ad0e6ff>远古之种<>：沿直线释放藤蔓，造成 <#a974ffff>115<> 的法术伤害，并使被命中的敌人减速 <#ffb900ff>25%<>，持续 <#ffb900ff>2 秒<>。<#ffb900ff>1.1 秒<> 后种子在同一路径上爆裂，再次造成 <#a974ffff>115<> 的法术伤害，并 <#ffb900ff>嘲讽<> 目标 <#ffb900ff>1.2 秒<>。",
        "skill2": "<#5ad0e6ff>自然之击<>：获得 <#ffb900ff>+60%<> 移动速度，持续 <#ffb900ff>1 秒<>，随后 <#ffb900ff>+20%<>，持续 <#ffb900ff>1 秒<>，并强化下一次普通攻击，持续 <#ffb900ff>3 秒<>。每次 <#5ad0e6ff>致命荆棘<> 触发，该技能冷却时间减少 <#ffb900ff>1 秒<>。",
        "ult": "<#e64a6aff>树妖之怒<>：召唤向外蔓延的藤蔓，分 <#ffb900ff>4<> 波，每波造成 <#a974ffff>55<> 的法术伤害，并 <#ffb900ff>嘲讽<> 被命中的敌人 <#ffb900ff>1.5 秒<>。"
      },
      "mlbb_cecilion": {
        "name": "塞西利翁",
        "attack": "普通攻击造成 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻击<>的远程物理伤害。",
        "passive": "<#5ad0e6ff>满溢<>：塞西利翁的技能每次命中敌人，便获得 <#ffb900ff>1<> 层满溢，每 <#ffb900ff>1 秒<>最多触发一次。每层为他提供 <#a974ffff>+3 魔法力量<>，持续整场对局，且死亡后层数保留。",
        "skill": "<#5ad0e6ff>蝙蝠冲击<>：放出一只巨大的蝙蝠，对路径上的敌人造成 <#a974ffff>30 + 25% 总魔法力量<>的魔法伤害。抵达终点时蝙蝠俯冲，造成 <#a974ffff>55 + 50% 总魔法力量<>的爆发魔法伤害。",
        "skill2": "<#5ad0e6ff>血腥之爪<>：标记一处地点。<#ffb900ff>0.6 秒<>后血爪收拢，对被卷入的敌人造成 <#a974ffff>60 + 60% 总魔法力量<>的魔法伤害，并<#ffb900ff>眩晕<><#ffb900ff>1 秒<>，并将被卷入的敌人拉向标记中心。",
        "ult": "<#e64a6aff>蝠群盛宴<>：在 <#ffb900ff>3 秒<>内释放 <#ffb900ff>40<> 道血箭，每道对附近的敌方英雄造成 <#a974ffff>5 + 8% 总魔法力量<>的魔法伤害；施法期间可以移动，<#ffb900ff>1.5 秒<>内获得 <#a974ffff>+60% 移动速度<>，每道血箭为其恢复 <#a974ffff>8<> 点生命。"
      },
      "mlbb_johnson": {
        "name": "强森",
        "attack": "挥动重型扳手，造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% 物理攻击<>的<#ff9028ff>物理伤害<>。",
        "passive": "<#5ad0e6ff>电子安全气囊<>: 生命值低于<#ffb900ff>30%<>时获得<#a974ffff>120 (+240% 总物理防御)<>的护盾，持续<#ffb900ff>10秒<>。冷却<#ffb900ff>100秒<>。",
        "skill": "<#5ad0e6ff>冲击扳手<>: 投掷扳手，对路径上的敌人造成<#a974ffff>80 (+110% 总物理防御)<>魔法伤害。落点附近的敌人被眩晕<#ffb900ff>0.8秒<>。",
        "skill2": "<#5ad0e6ff>电磁波<>: 举起盾牌，对身前敌人造成<#a974ffff>40 (+45% 总物理防御)<>魔法伤害，并降低其移动速度与魔法防御。最多叠加<#ffb900ff>3<>层。",
        "ult": "<#5ad0e6ff>全速前进<>: 变身为赛车，附近友方英雄可上车。撞到敌方英雄时爆炸，造成<#a974ffff>90 (+150% 至 +220% 总物理防御)<>魔法伤害，按行驶时间眩晕<#ffb900ff>0.5秒至1秒<>，并留下电磁区域。也可载着队友驶向安全地带。"
      },
      "mlbb_angela": {
        "name": "安琪拉",
        "attack": "发射心形飞弹，在<#ffb900ff>88,000<>射程内造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻击<>的物理伤害。",
        "skill": "<#5ad0e6ff>爱意波动<>：消耗<#ffb900ff>1层<>充能，向前方<#ffb900ff>92,000<>释放波动，对敌人造成<#a974ffff>80<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术攻击的30%<>法术伤害，并为经过的友方回复<#5bd18aff>46<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#5bd18aff>法术攻击的40%<>生命。被命中的敌人获得<#ffb900ff>1层<><#5ad0e6ff>恋人印记<>，持续<#ffb900ff>3秒<>（最多<#ffb900ff>5层<>），每层使后续波动与S2最终一击的伤害提高<#ffb900ff>+12%<>，并降低<#ffb900ff>6%<>移动速度。最多可连续施放<#ffb900ff>5次<>，最后一次施放后进入<#ffb900ff>5秒<>冷却。",
        "skill2": "<#5ad0e6ff>傀儡之线<>：牵连<#ffb900ff>95,000<>射程内的一名敌人<#ffb900ff>3秒<>，造成<#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术攻击的25%<>法术伤害，并在持续期间最多降低其<#ffb900ff>45%<>移动速度。结束时若仍相连，则额外造成<#a974ffff>140<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术攻击的35%<>伤害（受<#5ad0e6ff>恋人印记<>层数提高），并<#ffb900ff>束缚0.7秒<>。相距超过<#ffb900ff>150,000<>或目标死亡则连线中断，不会造成最终伤害。",
        "ult": "<#e64a6aff>真心守护<>：为全图任意一名友方英雄提供<#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>法术攻击的180%<>护盾，持续<#ffb900ff>6秒<>。安琪拉随之消失并在<#ffb900ff>12秒<>内附身于该友方，从其位置自动施放S1与S2，其头顶的<#5ad0e6ff>人偶<>标示羁绊。宿主死亡或无法被选取时提前结束，再次施放可立即解除。冷却<#ffb900ff>40秒<>。",
        "passive": "<#5ad0e6ff>灵心<>：每次施放技能获得移动速度，持续<#ffb900ff>4秒<>；附身期间该加成归于宿主。最多叠加<#ffb900ff>4层<>，合计<#ffb900ff>7%、15%、22%、30%<>。达到上限后刷新不会超过上限，使用次数与冷却会跨附身保留。"
      },
      "mlbb_eudora": {
        "name": "尤朵拉",
        "attack": "普攻发射闪电，造成<#ffb900ff>100%<> AD物理伤害。",
        "skill": "<#5ad0e6ff>叉状闪电<>: 以扇形闪电造成<#ffb900ff>100<> + <#ffb900ff>55%<> AP魔法伤害，对兵线小兵伤害翻倍。已被标记的敌人会被连接最多<#ffb900ff>1<>秒，承受<#ffb900ff>4<>次<#ffb900ff>4<> + <#ffb900ff>2%<> AP伤害；连接保持至结束时，再造成<#ffb900ff>100<> + <#ffb900ff>55%<> AP伤害。连接期间，尤朵拉获得<#ffb900ff>20%<>移速。终结命中使本技能冷却减少<#ffb900ff>1.5<>秒，每次施放仅触发一次。距离超过<#ffb900ff>95,000<>时连接断开。冷却：<#ffb900ff>7<>秒。 首击对敌方英雄造成<#a974ffff>120 + 65%<> AP魔法伤害。",
        "skill2": "<#5ad0e6ff>雷电法球<>: 发射雷球，使目标魔抗降低<#ffb900ff>8<>点，持续<#ffb900ff>1.8<>秒，并造成<#ffb900ff>115<> + <#ffb900ff>45%<> AP魔法伤害及<#ffb900ff>0.8<>秒眩晕。若目标已有标记，附近敌人也受到相同效果。每个敌人仅命中一次。冷却：<#ffb900ff>11<>秒。",
        "ult": "<#e64a6aff>雷霆之怒<>: 轰击地面区域，中心造成<#ffb900ff>260<> + <#ffb900ff>110%<> AP魔法伤害，外环造成<#ffb900ff>130<> + <#ffb900ff>55%<> AP伤害，两者不叠加。已有标记的敌人在命中位置留下预警，<#ffb900ff>0.6<>秒后爆炸，造成<#ffb900ff>160<> + <#ffb900ff>72%<> AP魔法伤害。同次施放的重叠爆炸对每个敌人仅命中一次。冷却：<#ffb900ff>32<>秒。",
        "passive": "<#5ad0e6ff>超导<>: 技能命中敌方英雄和野怪时施加<#ffb900ff>5<>秒标记。技能对已有标记的敌人产生额外效果。普攻不施加标记，标记不叠层。"
      },
      "mlbb_julian": {
        "name": "Julian",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻击<>的物理伤害。施放技能后<#ffb900ff>2<>秒内，普通攻击改为造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 物理攻击<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 55% AP<>法术伤害，并将目标拉向Julian。",
        "skill": "<#5ad0e6ff>镰刀<>：向指定方向掷出镰刀，对路径上的敌人造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>155 + 72% AP<>法术伤害并使其减速<#ffb900ff>30<>%，持续<#ffb900ff>1<>秒。镰刀会穿透小兵，并在第一个非小兵敌人处停止。强化：造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>215 + 100% AP<>法术伤害，减速提升至<#ffb900ff>50<>%。在首个非小兵敌人处或达到最大距离后，镰刀会以较低速度继续飞行，在区域内每<#ffb900ff>0.1<>秒造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>26 + 11% AP<>法术伤害，持续<#ffb900ff>1.6<>秒，可反复命中同一敌人。",
        "skill2": "<#5ad0e6ff>飞剑<>：召唤飞剑并向指定方向突进，对路径上的敌人造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>130 + 52% AP<>法术伤害。强化：召唤大量飞剑，突进途中每<#ffb900ff>0.1<>秒造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>30 + 14% AP<>法术伤害，最多<#ffb900ff>6<>次。突进期间Julian无法被选中且隐身，随后在最远端现身。",
        "ult": "<#e64a6aff>锁链<>：在指定位置施放锁链。<#ffb900ff>0.3<>秒后对<#ffb900ff>18,000<>单位范围内的敌人造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>112 + 50% AP<>法术伤害并禁锢<#ffb900ff>1<>秒。强化：每<#ffb900ff>0.2<>秒造成<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>12 + 6% AP<>法术伤害并减速<#ffb900ff>30<>%，结束时仍在范围内的敌人额外受到<i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>205 + 88% AP<>法术伤害并被击飞<#ffb900ff>0.8<>秒。锁链尚未解锁时，Julian会在连招中自动施放。",
        "passive": "<#5ad0e6ff>铁匠的遗产<>：施放两个不同技能后，Julian会强化剩余技能。强化施放后，三个技能共同进入<#ffb900ff>9<>–<#ffb900ff>6<>秒冷却，冷却随等级降低。每个技能每套连招只能使用一次；未完成的连招在<#ffb900ff>4<>秒后失效。技能命中敌方英雄可获得<#ffb900ff>10<>%混合吸血，持续<#ffb900ff>5<>秒，最多叠加<#ffb900ff>30<>%。同一次施放重复命中只计一层。"
      },
      "mlbb_popol_kupa": {
        "name": "Popol & Kupa",
        "attack": "Popol throws a spear that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact. Kupa bites nearby enemies for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>45% AD<> physical damage, increased to <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>75% AD<> in Alpha Wolf Form. Kupa’s ordinary bites use Popol’s basic-attack item effects.",
        "skill": "<#5ad0e6ff>Bite ’em, Kupa!<>: Popol throws a spear for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>50 + 50% AD<> physical damage and commands Kupa to bite the target for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>60 + 60% AD<> physical damage, <#ef5350ff>slowing<> it by <#ffb900ff>50%<> for <#ffb900ff>1s<>. Alpha Wolf Form: the bite instead deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>90 + 75% AD<> physical damage to nearby enemies and knocks them <#ef5350ff>airborne<> for <#ffb900ff>0.6s<>.",
        "skill2": "<#5ad0e6ff>Kupa, Help!<>: Popol gains a <#ffb900ff>90 + 50% AD<> shield for <#ffb900ff>3s<> and calls Kupa back. When Kupa arrives, Popol mounts him for up to <#ffb900ff>1.5s<>, gaining <#ffb900ff>50%<> Movement Speed while Kupa recovers <#ffb900ff>25%<> Max HP over the ride. Attacks, other skills and hard crowd control end the ride. Alpha Wolf Form: the shield increases to <#ffb900ff>140 + 70% AD<> and Kupa fully recovers HP at mount start.",
        "ult": "<#e64a6aff>We Are Angry!<>: Kupa fully recovers HP and enters <#5ad0e6ff>Alpha Wolf Form<> for <#ffb900ff>9s<>, gaining <#ffb900ff>35%<> Max HP and enhancing Bite ’em, Kupa! and Kupa, Help! Cooperative stack bonuses are doubled. Requires a living Kupa.",
        "passive": "<#5ad0e6ff>We Are Friends<>: When Popol and Kupa damage the same enemy within <#ffb900ff>2s<>, both gain <#ffb900ff>5%<> Attack Speed and <#ffb900ff>2%<> Movement Speed for <#ffb900ff>4s<>, stacking up to <#ffb900ff>3<> times. Each paired exchange grants one stack.\nKupa has <#ffb900ff>560 + 80 per level after Lv.1 + 50% of Popol’s bonus Max HP<> HP and inherits Popol’s current Armor, Magic Resist and Attack Speed. After <#ffb900ff>5s<> out of combat, Kupa recovers <#ffb900ff>8%<> Max HP per second. If Kupa falls, Popol begins a stationary <#ffb900ff>3s<> prayer after <#ffb900ff>3s<> without combat; movement, damage or another action interrupts it. Successful revival has a <#ffb900ff>30s<> cooldown.\n<#5ad0e6ff>Popol’s Surprise<>: During combat, Popol automatically places a trap every <#ffb900ff>10s<>, up to <#ffb900ff>2<>. Traps arm after <#ffb900ff>0.5s<> and last <#ffb900ff>15s<>. An enemy triggers <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>25 + 20% AD<> physical damage and <#ffb900ff>0.6s<> of <#ef5350ff>immobilization<>, leaving frost for <#ffb900ff>3s<> that <#ef5350ff>slows<> enemies by <#ffb900ff>20%<> and reduces Armor by <#ffb900ff>12%<>. Frost from the same Popol does not stack. Placement pauses during casting, recall, riding and prayer."
      },
      "mlbb_granger": {
        "name": "Granger",
        "attack": "Fires a handgun round that deals <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage on impact.",
        "skill": "<#5ad0e6ff>Rhapsody<>: Locks onto an enemy and fires <#ffb900ff>6<> homing rounds over <#ffb900ff>1.5s<>, each dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>36 + 45% AD<> physical damage and consuming <#ffb900ff>70<> Gun Energy. Requires more than <#ffb900ff>420<> Gun Energy. Movement Speed increases by <#ffb900ff>10%<> while firing. Each hit reduces Rondo’s cooldown by <#ffb900ff>0.5s<>. The final round gains <#ffb900ff>100%<> Critical Chance for its impact. Rondo and Death Sonata can be used during the barrage.",
        "skill2": "<#5ad0e6ff>Rondo<>: Dashes a short distance and restores <#ffb900ff>15%<> of maximum Gun Energy. Walls and movement-disabling effects stop the dash. Equipment cooldown reduction increases Attack instead of shortening Rondo’s effective cooldown.",
        "ult": "<#5ad0e6ff>Death Sonata<>: Consumes <#ffb900ff>250<> Cannon Energy to fire a homing cannon round at an enemy champion. Impact triggers an explosion, dealing <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>155 + 110% AD<> physical damage to nearby enemies and <#ef5350ff>slowing<> them by <#ffb900ff>30%<> for <#ffb900ff>0.6s<>. Granger then rolls a short distance away from the firing direction.",
        "passive": "<#5ad0e6ff>Capriccio<>: Uses separate Gun and Cannon Energy pools, each starting at <#ffb900ff>800<>. Gun Energy regenerates at <#ffb900ff>8%<> of its maximum per second; Cannon Energy regenerates at <#ffb900ff>2%<>. Credited lane-minion kills increase maximum Gun Energy by <#ffb900ff>6<> and restore <#ffb900ff>5%<>; jungle kills grant the same benefit to Cannon Energy. Champion kills and assists increase both maxima by <#ffb900ff>12<> and restore <#ffb900ff>10%<>. Capacity growth persists through death. Equipment cooldown reduction grants <#ffb900ff>0.5<> Attack per percentage point, up to <#ffb900ff>20<> Attack."
      },
      "mlbb_hanzo": {
        "name": "Hanzo",
        "attack": "Strikes for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% Attack<> physical damage and applies a mark.",
        "skill": "<#5ad0e6ff>Demon Feast<>: At <#ffb900ff>5 marks<>, bites champions for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>200 + 7 per level after Lv.1 + 115% bonus Attack<> physical damage, heals and refunds <#ffb900ff>60%<> cooldown. Ordinary camps are devoured, healing <#66cc66ff>20% maximum Health<>.\n<#5ad0e6ff>Soul Snatch<>: Lunges for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>135 + 6 per level after Lv.1 + 95% bonus Attack<> physical damage, increased <#ffb900ff>24% per mark<> against champions and <#ffb900ff>20% per mark<> against other targets. At <#ffb900ff>5 marks<>, adds damage based on maximum Health and heals.\nCooldown: <#ffb900ff>12s / 10s<>.",
        "skill2": "<#5ad0e6ff>Dark Mist<>: Dashes and gains <#ffb900ff>15% Movement Speed<> for <#ffb900ff>2s<>. Leaves <#ffb900ff>5<> mist pulses.\n<#5ad0e6ff>Black Mist<>: Dashes through walls for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>110 + 4 per level + 55% bonus Attack<> physical damage and <#ef5350ff>0.4s airborne<>. Leaves <#ffb900ff>4<> pulses.\nMist deals physical damage every <#ffb900ff>0.5s<>, applies marks and <#ef5350ff>slows 35%<>; it cannot critically strike. Cooldown: <#ffb900ff>10s per form<>.",
        "ult": "Projects Hanekage for up to <#ffb900ff>15s<>, leaving an invulnerable body. Gains <#ffb900ff>35% Movement Speed<>, <#ffb900ff>25% Attack Speed<> and wall traversal, with <#ffb900ff>30% less maximum Health<>.\nRecast returns and heals <#66cc66ff>90 + 50% bonus Attack<>. Empty Energy draws the body to Hanekage. Defeat forces a return to the body, <#ef5350ff>slows Hanzo 50% for 6s<> and sets a <#ffb900ff>52s<> cooldown (normally <#ffb900ff>26s<>).",
        "passive": "Basic attacks and mist hits apply up to <#ffb900ff>5 marks<> for <#ffb900ff>6s<>. New hits refresh them. Hanekage starts with <#ffb900ff>100 Energy<> and spends <#ffb900ff>10 per second<>; hits and nearby deaths restore Energy."
      },
      "mlbb_atlas": {
        "name": "Atlas",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage.",
        "passive": "Skill casts create a moving frost aura for <#ffb900ff>4s<> and grant <#66cc66ff>10 armor and magic resistance<>. Nearby enemy champions slow up to <#ef5350ff>25%<> and freeze for <#ef5350ff>0.5s<> after 2s of continuous exposure. Freeze cooldown per target: <#ffb900ff>4s<>.",
        "skill": "Slams three times for <#5ad0e6ff>30 + 10% Magic Power<> magic damage per pulse. The suit also slams while separated. Overlapping hits deal <#5ad0e6ff>45 + 15% Magic Power<> once per pulse. Cooldown: <#ffb900ff>7s<>.",
        "skill2": "Ejects for up to <#ffb900ff>2s<>, gaining <#ffb900ff>25% Movement Speed<> while the suit follows. Reunion deals <#5ad0e6ff>65 + 20% Magic Power<> magic damage and <#ef5350ff>stuns for 0.6s<>. Cooldown: <#ffb900ff>10s<>.",
        "ult": "Links nearby enemy champions for <#5ad0e6ff>35 + 10% Magic Power<> magic damage and <#ef5350ff>30% slow<>. After <#ffb900ff>0.4s<>, Atlas pulls them in for <#5ad0e6ff>105 + 25% Magic Power<> magic damage and <#ef5350ff>0.35s airborne<>. While ejected, reunites immediately with a <#ef5350ff>40% slow<> in place of the reunion hit. Cooldown: <#ffb900ff>34s<>."
      },
      "mlbb_yu_zhong": {
        "name": "Yu Zhong",
        "attack": "Strikes for <#ff9028ff>100% Attack<> physical damage. Soul Grip can empower the next basic attack.",
        "passive": "Basic attacks and direct skill hits apply Sha Residue to enemy heroes and jungle monsters, including Morgard and Serpen, for <#ffb900ff>5s<>. At three marks, the target pulses five times. Each pulse deals <#ff9028ff>32 + 18% Attack + 2% of the target’s missing HP<> as physical damage and heals Yu Zhong for <#66cc66ff>8% of his missing HP<>. Against jungle monsters, the missing-HP damage bonus is capped at 40 per pulse. When the eruption starts, Yu Zhong gains 15% Movement Speed for 1.5s.",
        "skill": "After 0.4s, sweeps nearby enemies for <#ff9028ff>80 + 65% Attack<> physical damage. The outer edge instead deals <#ff9028ff>138 + 95% Attack<> and applies two marks to eligible targets. Cooldown is 7s.",
        "skill2": "Sends a wave that deals <#ff9028ff>95 + 68% Attack<> physical damage and slows by 30% for 1s. On hit, the next basic attack within 3s deals <#ff9028ff>55 + 40% Attack<> extra physical damage and can lunge toward the champion struck by Soul Grip if the route is clear. Hitting a champion at a useful distance triggers Furious Dive if the landing is safe. The leap deals damage on landing and allows one short dash in his movement direction. After 0.4s, the original landing area erupts, knocking enemy champions airborne for 0.5s. Both hits deal a combined <#ff9028ff>64 + 45% Attack<> physical damage. Cooldown is 10s.",
        "ult": "Channels for 0.6s, then flies as a dragon for up to 3.5s with 35% Movement Speed, wall traversal and crowd-control immunity. Passing an enemy hero deals <#ff9028ff>125 + 85% Attack<> physical damage and knocks them back once. On landing, enters Dragonoid Form for 15s, increasing skill reach and width by 20%. Cooldown is 46s."
      }
    },
