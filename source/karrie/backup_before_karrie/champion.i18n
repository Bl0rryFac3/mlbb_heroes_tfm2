  "ja": {
    "description": {
      "mlbb_aldous": {
        "name": "オルダス",
        "attack": "溶岩の巨拳で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻撃力<>の<#ff9028ff>物理ダメージ<>を与える。<#ffb900ff>3回目<>の攻撃ごとに<#ffb900ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%攻撃力<>のシールドを得る。",
        "skill": "<#ff9028ff>契約：ソウルスティール<>：主対象に<#ff9028ff>40 + レベル補正 + 攻撃力の100% + ソウルスティール1スタックごとに2.5<>の物理ダメージを与えます。周囲の敵は<#ff9028ff>40%<>の範囲ダメージを受けます。<#ffb900ff>1,000<>スタック時、スタックボーナスは防御適用前で<#ffb900ff>+2,500<>です。",
        "skill2": "<#ffb900ff>契約：エクスプロージョン<>：<#ffb900ff>2秒<>間シールド（<#ffb900ff>90<>）と移動速度（<#ffb900ff>+25%<>）を得てから爆発し、周囲に<#ff9028ff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻撃力<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1秒<><#ef5350ff>スタン<>を与える。",
        "ult": "<#e64a6aff>契約：チェイスフェイト<>：敵に<#e64a6aff>運命の眼<>を刻み溶岩ドリルとなって突撃、<#ff9028ff>130<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%攻撃力<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1.2秒<><#ef5350ff>スタン<>を与える。"
      },
      "mlbb_fanny": {
        "name": "Fanny",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "skill": "<#ff9028ff>Tornado Strike<>: Deals <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<> in a <#ffb900ff>22,000<> radius. During Steel Cable flight, colliding with an enemy automatically triggers a mid-air Tornado Strike for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70% AD<> and applies a Prey Mark to enemy champions.",
        "skill2": "<#ff9028ff>Steel Cable<>: Throws a cable (<#ffb900ff>165,000<> reach) at the best wall or outer lane boundary and swings Fanny past the obstacle toward her target, chaining multiple wall hops across the map with <#ffb900ff>0<> energy cost. Prioritizes visible enemy champions first, or nearby jungle monsters when no enemy champions are visible.",
        "ult": "<#ff9028ff>Cut Throat<>: Dashes to the target enemy and deals <#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125% AD<>; each Prey Mark adds <#ff9028ff>35% AD<> (up to 2 marks). A successful hit consumes the marks.",
        "passive": "<#ff9028ff>Air Superiority<>: While cable-flying, Fanny gains <#ffb900ff>10–25%<> bonus damage based on her flight speed. Hitting an enemy champion during flight applies or upgrades a <#ff9028ff>Prey Mark<> (max 2 stacks, <#ffb900ff>5s<>) and triggers Tornado Strike."
      },
      "mlbb_lancelot": {
        "name": "ランスロット",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。<#5ad0e6ff>ソウルカッター<>はスタックごとに全ダメージを<#ffb900ff>7.5%<>増加させ、<#ffb900ff>4秒<>持続します（最大<#ffb900ff>4スタック、30%<>）。",
        "skill": "<#ff9028ff>パンクチャー<>：指定した敵へ突進し、<#ff9028ff>80–178 + 攻撃力の40%<>の物理ダメージを与えます。最初に命中した未マークの敵に<#5ad0e6ff>剣の印<>を付与し、新しい印を付けるとクールダウンがリセットされます。発動ごとに<#ffb900ff>ソウルカッター<>を1スタック得ます。",
        "skill2": "<#ffb900ff>ソーンローズ<>：3回攻撃し、各攻撃は<#ff9028ff>85–155 + 攻撃力の30%<>の物理ダメージを与え、命中した敵の移動速度を<#ffb900ff>20%<>低下させます（<#ffb900ff>0.5秒<>）。連続攻撃中はダメージと行動妨害を無効化し、複数命中には範囲ダメージ減衰が適用されます。",
        "ult": "<#e64a6aff>ファントムエグゼキューション<>：指定した敵ヒーローへ突進し、到達時に<#ff9028ff>100–156 + 攻撃力の100%<>の物理ダメージを与えます。突進中はダメージと行動妨害を無効化し、<#ffb900ff>ソウルカッター<>を1スタック得ます。",
        "passive": "<#5ad0e6ff>ソウルカッター<>：パンクチャーとファントムエグゼキューションで、スタックごとに与ダメージが<#ffb900ff>7.5%<>増加し、<#ffb900ff>4秒<>持続します。最大<#ffb900ff>4スタック（30%）<>です。"
      },
      "mlbb_estes": {
        "name": "エステス",
        "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。<#5ad0e6ff>月のエルフの書<>は時間でチャージされ、<#ffb900ff>100<>スタックで次の通常攻撃が強化されて<#a974ffff>魔法ダメージ<>を追加し、最大2体の近くの敵に跳ね返って<#ffb900ff>40%<>スロウを与えます（<#ffb900ff>1.5秒<>）。",
        "passive": "<#5ad0e6ff>月のエルフの書<>：毎秒<#ffb900ff>1<>スタック、味方とリンク中は毎秒<#ffb900ff>2<>スタックを獲得。100スタックで次の通常攻撃が強化され、魔法ダメージを与えて最大2体の近くの敵に跳ね返り、40%スロウ（1.5秒）を与えます。スタックはスキル1のアイコンに表示されます。",
        "skill": "<#5ad0e6ff>月光の浸礼<>：味方ヒーロー1体を即座に<#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の85%<>回復し、その後<#ffb900ff>0.5秒<>ごとに<#5bd18aff>24<> + <#a974ffff>魔力の18%<>を5秒間回復します。味方は物理・魔法防御<#ffb900ff>+7<>、エステスは移動速度<#ffb900ff>+15%<>を得ます。距離が120,000を超えると視覚的なリンクとパッシブのチャージボーナスは止まりますが、データ設定の継続回復は残り時間中続きます。",
        "skill2": "<#5ad0e6ff>月の女神の領域<>：<#ffb900ff>2.5秒<>間、固定された月光領域を作ります。<#ffb900ff>0.5秒<>ごとに半径<#ffb900ff>52,000<>内の敵に<#a974ffff>15<> + <#a974ffff>魔力の45%<>魔法ダメージを与え、<#ffb900ff>35%<>スロウを与えます（0.75秒）。TFM2版では外周だけでなく領域内でスロウが発生します。",
        "ult": "<#5ad0e6ff>月の女神の祝福<>：半径<#ffb900ff>105,000<>内の味方を即座に<#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の65%<>回復し、8秒間<#ffb900ff>0.5秒<>ごとに<#5bd18aff>20<> + <#a974ffff>魔力の12%<>を回復。物理・魔法防御<#ffb900ff>+8<>も付与します。"
      },
      "mlbb_gusion": {
        "name": "グシオン",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. At <#ffb900ff>4 Rune<> stacks, the next basic attack consumes them to deal <#a974ffff>3% of the target’s max HP<> as magic damage per stack and heal Gusion for <#5bd18aff>50 + 25% AP<> per stack.",
        "passive": "<#5ad0e6ff>Dagger Specialist<>: Each skill cast grants a <#ffb900ff>Rune<> stack, up to <#ffb900ff>4<>. The next basic attack consumes all stacks, dealing <#a974ffff>3% of the target’s max HP<> as magic damage per stack and restoring <#5bd18aff>50 + 25% Total Magic Power<> HP per stack.",
        "skill": "<#5ad0e6ff>Sword Spike<>: Throws a dagger that deals <#a974ffff>200 + 50% AP<> magic damage and marks the first enemy hit. Recast to dash behind the marked target for <#a974ffff>200 + 100% AP<> magic damage.",
        "skill2": "<#a974ffff>Shadowblade Slaughter<>: Throws <#ffb900ff>5 daggers<> in a fan; each deals <#a974ffff>65 + 40% AP<> magic damage. Recast to recall them; each returning dagger deals the same damage. The dagger and thin streak are separate visual projectiles.",
        "ult": "<#e64a6aff>Incandescence<>: Dashes behind the selected enemy and refreshes Skills 1 and 2. Recast briefly to dash behind a selected enemy again."
      }
    },
