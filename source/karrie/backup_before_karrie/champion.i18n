{
  "en": {
    "description": {
      "mlbb_aldous": {
        "name": "Aldous",
        "attack": "Strikes with his giant molten gauntlet for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>. Passive <#ffb900ff>Contract: Transform<> shields Aldous every <#ffb900ff>3rd<> strike for <#ffb900ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<>.",
        "skill": "<#ff9028ff>Contract: Soul Steal<>: The primary target takes <#ff9028ff>40 + level scaling + 100% AD + 2.5 damage per Soul Steal stack<> as physical damage; nearby enemies take <#ff9028ff>40%<> splash. At <#ffb900ff>1,000<> stacks, the stack bonus is <#ffb900ff>+2,500 raw damage<> before defense.",
        "skill2": "<#ffb900ff>Contract: Explosion<>: Summons a blazing rune barrier for <#ffb900ff>2s<> (<#ffb900ff>90<> Shield, <#ffb900ff>+25%<> Move Speed), then detonates to deal <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>stun<> nearby foes for <#ffb900ff>1s<>.",
        "ult": "<#e64a6aff>Contract: Chase Fate<>: Locks the <#e64a6aff>Eye of Fate<> onto an enemy and drills across the arena as a molten meteor, crashing for <#ff9028ff>130<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>stunning<> for <#ffb900ff>1.2s<>."
      },
      "mlbb_fanny": {
        "name": "Fanny",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
        "skill": "<#ff9028ff>Tornado Strike<>: Deals <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<> in a <#ffb900ff>22,000<> radius. During Steel Cable flight, colliding with an enemy automatically triggers a mid-air Tornado Strike for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70% AD<> and applies a Prey Mark to enemy champions.",
        "skill2": "<#ff9028ff>Steel Cable<>: Throws a cable (<#ffb900ff>165,000<> reach) at the best wall or outer lane boundary and swings Fanny past the obstacle toward her target, chaining multiple wall hops across the map with <#ffb900ff>0<> energy cost. Prioritizes visible enemy champions first, or nearby jungle monsters when no enemy champions are visible.",
        "ult": "<#ff9028ff>Cut Throat<>: Dashes to the target enemy and deals <#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125% AD<>; each Prey Mark adds <#ff9028ff>35% AD<> (up to 2 marks). A successful hit consumes the marks.",
        "passive": "<#ff9028ff>Air Superiority<>: While cable-flying, Fanny gains <#ffb900ff>10–25%<> bonus damage based on her flight speed. Hitting an enemy champion during flight applies or upgrades a <#ff9028ff>Prey Mark<> (max 2 stacks, <#ffb900ff>5s<>) and triggers Tornado Strike."
      },
      "mlbb_lancelot": {
        "name": "Lancelot",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. <#5ad0e6ff>Soul Cutter<> increases all damage by <#ffb900ff>7.5% per stack<> for <#ffb900ff>4s<> (up to <#ffb900ff>4 stacks / 30%<>).",
        "skill": "<#ff9028ff>Puncture<>: Dashes to the selected enemy, dealing <#ff9028ff>80–178 + 40% AD<> physical damage. The first unmarked enemy hit receives a <#5ad0e6ff>Sword Mark<>; applying a new mark resets Puncture. Each cast grants a <#ffb900ff>Soul Cutter<> stack.",
        "skill2": "<#ffb900ff>Thorned Rose<>: Strikes in three waves, each dealing <#ff9028ff>85–155 + 30% AD<> physical damage and slowing enemies hit by <#ffb900ff>20%<> for <#ffb900ff>0.5s<>. Lancelot is damage- and CC-immune during the sequence; overlapping hits use the crowd-hit penalty.",
        "ult": "<#e64a6aff>Phantom Execution<>: Dashes to the selected enemy champion and deals <#ff9028ff>100–156 + 100% AD<> physical damage on arrival. Lancelot is damage- and CC-immune during the dash and gains a <#ffb900ff>Soul Cutter<> stack.",
        "passive": "<#5ad0e6ff>Soul Cutter<>: Puncture and Phantom Execution grant <#ffb900ff>7.5%<> increased damage for <#ffb900ff>4s<> per stack, up to <#ffb900ff>4 stacks (30%)<>."
      },
      "mlbb_estes": {
        "name": "Estes",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. <#5ad0e6ff>Scripture of the Moon Elf<> charges over time; at <#ffb900ff>100<> stacks, the next basic attack adds <#a974ffff>magic damage<>, ricochets to up to <#ffb900ff>2<> nearby enemies and slows them by <#ffb900ff>40%<> for <#ffb900ff>1.5s<>.",
        "passive": "<#5ad0e6ff>Scripture of the Moon Elf<>: gains <#ffb900ff>1<> charge per second, or <#ffb900ff>2<> while Moonlight Immersion is linked. At 100 charges, the next basic attack is empowered: <#a974ffff>magic damage<> plus up to 2 nearby ricochets and a <#ffb900ff>40%<> slow for <#ffb900ff>1.5s<>. The meter is displayed on Skill 1.",
        "skill": "<#5ad0e6ff>Moonlight Immersion<>: heals an allied hero for <#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85% AP<> immediately, then <#5bd18aff>24<> + <#a974ffff>18% AP<> every <#ffb900ff>0.5s<> for <#ffb900ff>5s<>. Grants the ally <#ffb900ff>+7<> physical and magic defense and Estes <#ffb900ff>+15%<> move speed. The tether and passive charge bonus stop beyond <#ffb900ff>120,000<> range; the data-driven heal-over-time completes its duration.",
        "skill2": "<#5ad0e6ff>Domain of Moon Goddess<>: places a <#5ad0e6ff>stationary<> moonlight zone for <#ffb900ff>2.5s<>. Every <#ffb900ff>0.5s<>, enemies in the <#ffb900ff>52,000<> radius take <#a974ffff>15<> + <#a974ffff>45% AP<> magic damage and are slowed by <#ffb900ff>35%<> for <#ffb900ff>0.75s<>. TFM2 version slows within the zone rather than detecting only the outer edge.",
        "ult": "<#5ad0e6ff>Blessing of Moon Goddess<>: immediately heals nearby allies within <#ffb900ff>105,000<> for <#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65% AP<>; then restores <#5bd18aff>20<> + <#a974ffff>12% AP<> every <#ffb900ff>0.5s<> for <#ffb900ff>8s<> and grants <#ffb900ff>+8<> physical and magic defense."
      },
      "mlbb_gusion": {
        "name": "Gusion",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. At <#ffb900ff>4 Rune<> stacks, the next attack consumes all 4, dealing <#a974ffff>12% of the target’s max HP<> as magic damage and restoring <#5bd18aff>200 + 100% AP<> HP.",
        "passive": "<#5ad0e6ff>Dagger Specialist<>: Each skill cast grants <#ffb900ff>1 Rune<>, up to <#ffb900ff>4<>. The next Basic Attack consumes all Runes; each deals <#a974ffff>3% of the target’s max HP<> as magic damage and restores <#5bd18aff>50 + 25% AP<> HP (up to 12% max HP damage and 200 + 100% AP healing).",
        "skill": "<#5ad0e6ff>Sword Spike<>: Throw a dagger that deals <#a974ffff>200 + 50% AP<> magic damage to the first enemy hit and marks them for <#ffb900ff>5s<>. Recast to dash behind the marked target and deal <#a974ffff>200 + 100% AP<> magic damage.",
        "skill2": "<#a974ffff>Shadowblade Slaughter<>: Throw <#ffb900ff>5 daggers<> in a fan; each hit deals <#a974ffff>65 + 40% AP<> magic damage. Recast to recall them; each returning hit deals the same damage. Each dagger and its thin trail use separate visuals.",
        "ult": "<#e64a6aff>Incandescence<>: Dash behind the selected enemy and refresh Skills 1 and 2. Recast within <#ffb900ff>2.5s<> to dash behind another selected enemy."
      }
    },
    "skill_name": {
      "mlbb_aldous": {
        "skill1": "Contract: Soul Steal",
        "skill2": "Contract: Explosion",
        "ult": "Contract: Chase Fate"
      },
      "mlbb_fanny": {
        "skill1": "Tornado Strike",
        "skill2": "Steel Cable",
        "ult": "Cut Throat"
      },
      "mlbb_lancelot": {
        "passive": "Soul Cutter",
        "skill1": "Puncture",
        "skill2": "Thorned Rose",
        "ult": "Phantom Execution"
      },
      "mlbb_estes": {
        "passive": "Scripture of the Moon Elf",
        "skill1": "Moonlight Immersion",
        "skill2": "Domain of Moon Goddess",
        "ult": "Blessing of Moon Goddess"
      },
      "mlbb_gusion": {
        "passive": "Dagger Specialist",
        "skill1": "Sword Spike",
        "skill2": "Shadowblade Slaughter",
        "ult": "Incandescence"
      }
    }
  },
  "zh-hans": {
    "description": {
      "mlbb_aldous": {
        "name": "奥尔德斯",
        "attack": "挥舞熔岩巨拳造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<><#ff9028ff>物理伤害<>。被动<#ffb900ff>契约：蜕变<>每第<#ffb900ff>3<>击获得<#ffb900ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%攻击力<>护盾。",
        "skill": "<#ff9028ff>契约：夺魂<>：主目标受到<#ff9028ff>40 + 等级加成 + 100%攻击力 + 每层夺魂2.5点<>物理伤害；附近敌人受到<#ff9028ff>40%<>溅射伤害。达到<#ffb900ff>1,000<>层时，层数额外提供<#ffb900ff>+2,500<>点原始伤害（护甲减免前）。",
        "skill2": "<#ffb900ff>契约：爆裂<>：展开符文护盾<#ffb900ff>2秒<>（<#ffb900ff>90<>护盾与<#ffb900ff>+25%<>移速），随后引爆造成<#ff9028ff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<><#ff9028ff>物理伤害<>并<#ef5350ff>眩晕<>周围敌人<#ffb900ff>1秒<>。",
        "ult": "<#e64a6aff>契约：追命<>：在敌方头顶凝结<#e64a6aff>命运之眼<>并化作熔岩钻头冲撞目标，造成<#ff9028ff>130<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%攻击力<><#ff9028ff>物理伤害<>与<#ffb900ff>1.2秒<><#ef5350ff>眩晕<>。"
      },
      "mlbb_fanny": {
        "name": "芬妮",
        "attack": "普攻造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>的物理伤害。",
        "skill": "<#ff9028ff>飓风突刺<>：造成<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80%攻击力<>伤害，范围<#ffb900ff>22,000<>。钢索飞行时撞到敌人会自动触发空中飓风突刺，造成<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70%攻击力<>伤害。",
        "skill2": "<#ff9028ff>钢索<>：向最佳墙体或边路外墙射出钢索（射程<#ffb900ff>165,000<>），无能量消耗连续多段荡墙追击或撤退。优先锁定可见敌方英雄，无敌方英雄视野时可荡墙清理野怪。",
        "ult": "<#ff9028ff>割喉<>：冲向目标，造成<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125%攻击力<>伤害；每层猎物印记额外造成<#ff9028ff>35%攻击力<>（最多2层）。命中后消耗印记。",
        "passive": "<#ff9028ff>空中优势<>：钢索飞行时，芬妮根据飞行速度获得<#ffb900ff>10–25%<>伤害加成。飞行中命中敌方英雄会施加或升级<#ff9028ff>猎物印记<>（最多2层，持续<#ffb900ff>5秒<>），并触发飓风突刺。"
      },
      "mlbb_lancelot": {
        "name": "兰斯洛特",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>的物理伤害。<#5ad0e6ff>灵魂切割<>使所有伤害每层提高<#ffb900ff>7.5%<>，持续<#ffb900ff>4秒<>，最多<#ffb900ff>4层（30%）<>。",
        "skill": "<#ff9028ff>穿刺<>：突进至指定敌人，造成<#ff9028ff>80–178 + 40%攻击力<>物理伤害。命中的第一个未标记敌人获得<#5ad0e6ff>剑印<>；施加新剑印会重置穿刺冷却。每次施放获得一层<#ffb900ff>灵魂切割<>。",
        "skill2": "<#ffb900ff>刺玫瑰<>：连续攻击三次，每次造成<#ff9028ff>85–155 + 30%攻击力<>物理伤害，并使命中的敌人减速<#ffb900ff>20%<>，持续<#ffb900ff>0.5秒<>。连招期间免疫伤害与控制；多目标重叠命中会受到群体伤害折减。",
        "ult": "<#e64a6aff>幻影处决<>：突进至指定敌方英雄，抵达时造成<#ff9028ff>100–156 + 100%攻击力<>物理伤害。突进期间免疫伤害与控制，并获得一层<#ffb900ff>灵魂切割<>。",
        "passive": "<#5ad0e6ff>灵魂切割<>：穿刺和幻影处决会使伤害每层提高<#ffb900ff>7.5%<>，持续<#ffb900ff>4秒<>，最多<#ffb900ff>4层（30%）<>。"
      },
      "mlbb_estes": {
        "name": "埃斯特斯",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>物理伤害。<#5ad0e6ff>月精灵之书<>随时间充能；达到<#ffb900ff>100<>层后，下次普攻追加<#a974ffff>魔法伤害<>，最多弹射至<#ffb900ff>2<>名附近敌人并使其减速<#ffb900ff>40%<>，持续<#ffb900ff>1.5秒<>。",
        "passive": "<#5ad0e6ff>月精灵之书<>：每秒获得<#ffb900ff>1<>层充能；连接队友时每秒获得<#ffb900ff>2<>层。达到100层后，下次普攻强化，造成<#a974ffff>魔法伤害<>并弹射至最多2名附近敌人，同时减速40%，持续1.5秒。层数显示在一技能图标上。",
        "skill": "<#5ad0e6ff>月光浸礼<>：立即为一名友方英雄回复<#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85%法术强度<>生命值，随后每<#ffb900ff>0.5秒<>回复<#5bd18aff>24<> + <#a974ffff>18%法术强度<>，持续<#ffb900ff>5秒<>。友军获得<#ffb900ff>+7<>物理与法术防御，埃斯特斯获得<#ffb900ff>+15%<>移速。超过120,000时，视觉连接与被动充能加成停止；数据驱动的持续治疗仍会完成。",
        "skill2": "<#5ad0e6ff>月之女神领域<>：放置一个<#5ad0e6ff>固定<>月光区域，持续<#ffb900ff>2.5秒<>。每<#ffb900ff>0.5秒<>对<#ffb900ff>52,000<>范围内的敌人造成<#a974ffff>15<> + <#a974ffff>45%法术强度<>魔法伤害，并减速<#ffb900ff>35%<>，持续<#ffb900ff>0.75秒<>。此版本在区域内减速，而非仅检测外圈。",
        "ult": "<#5ad0e6ff>月之女神祝福<>：立即为<#ffb900ff>105,000<>范围内的友军回复<#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65%法术强度<>；随后每<#ffb900ff>0.5秒<>回复<#5bd18aff>20<> + <#a974ffff>12%法术强度<>，持续<#ffb900ff>8秒<>，并获得<#ffb900ff>+8<>物理与法术防御。"
      },
      "mlbb_gusion": {
        "name": "古辛",
        "attack": "普通攻击造成<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻击力<>物理伤害。达到<#ffb900ff>4<>层符文后，下次普攻消耗全部符文，造成目标最大生命值<#a974ffff>12%<>的魔法伤害，并回复<#5bd18aff>200 + 100%法术强度<>生命值。",
        "passive": "<#5ad0e6ff>匕首专精<>：每次施放技能获得<#ffb900ff>1<>层符文，最多<#ffb900ff>4<>层。下次普攻消耗全部符文；每层造成目标最大生命值<#a974ffff>3%<>的魔法伤害，并回复<#5bd18aff>50 + 25%法术强度<>生命值。",
        "skill": "<#5ad0e6ff>剑锋<>：投掷匕首，对首个命中的敌人造成<#a974ffff>200 + 50%法术强度<>魔法伤害，并标记<#ffb900ff>5秒<>。再次施放可突进至标记目标身后，造成<#a974ffff>200 + 100%法术强度<>魔法伤害。",
        "skill2": "<#a974ffff>幻影剑舞<>：扇形投出<#ffb900ff>5把匕首<>，每次命中造成<#a974ffff>65 + 40%法术强度<>魔法伤害。再次施放召回匕首，每把返回命中造成相同伤害；匕首与细长轨迹使用独立视觉素材。",
        "ult": "<#e64a6aff>刀锋冲击<>：突进至指定敌人身后并刷新一、二技能。可在<#ffb900ff>2.5秒<>内再次施放，突进至另一名指定敌人身后。"
      }
    },
