  "ko": {
    "description": {
      "mlbb_aldous": {
        "name": "올더스",
        "attack": "거대한 용암 건틀릿으로 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 공격력<>의 <#ff9028ff>물리 피해<>를 입힙니다. <#ffb900ff>3번째<> 공격마다 <#ffb900ff>60<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% 공격력<> 보호막을 얻습니다.",
        "skill": "<#ff9028ff>계약: 영혼 탈취<>: 주 대상에게 <#ff9028ff>40 + 레벨 보정 + 공격력의 100% + 영혼 탈취 중첩당 2.5<>의 물리 피해를 줍니다. 주변 적은 <#ff9028ff>40%<>의 광역 피해를 받습니다. <#ffb900ff>1,000<>중첩에서는 중첩 보너스가 방어력 적용 전 <#ffb900ff>+2,500<>입니다.",
        "skill2": "<#ffb900ff>계약: 폭발<>: <#ffb900ff>2초<>간 보호막(<#ffb900ff>90<>)과 이동 속도(<#ffb900ff>+25%<>)를 얻은 뒤 폭발하여 <#ff9028ff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% 공격력<>의 <#ff9028ff>물리 피해<>와 <#ffb900ff>1초<> <#ef5350ff>기절<>을 부여합니다.",
        "ult": "<#e64a6aff>계약: 운명 추적<>: 적에게 <#e64a6aff>운명의 눈<>을 각인하고 용암 운석으로 돌진해 <#ff9028ff>130<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160% 공격력<>의 <#ff9028ff>물리 피해<>와 <#ffb900ff>1.2초<> <#ef5350ff>기절<>을 입힙니다."
      },
      "mlbb_fanny": {
        "name": "파니",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다.",
        "skill": "<#ff9028ff>토네이도 스트라이크<>: 반경<#ffb900ff>22,000<> 안의 적에게 <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 80%<> 피해를 줍니다. 케이블 비행 중 적과 충돌하면 <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 70%<> 토네이도 스트라이크를 자동 발동합니다.",
        "skill2": "<#ff9028ff>스틸 케이블<>: 최적의 벽이나 외곽 라인 경계로 케이블(사거리 <#ffb900ff>165,000<>)을 발사해 에너지 소모 없이 연속 다중 벽 타기로 추격하거나 탈출합니다. 시야 내 적 영웅을 최우선으로 조준하며, 적 영웅이 없을 때만 정글 몬스터에게 케이블을 사용합니다.",
        "ult": "<#ff9028ff>컷 스로트<>: 대상에게 돌진해<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 125%<> 피해를 줍니다. 먹잇감 표식마다<#ff9028ff>공격력의 35%<> 추가 피해 (최대 2중첩). 적중하면 표식을 소모합니다.",
        "passive": "<#ff9028ff>공중 우세<>: 케이블 비행 중 이동 속도에 따라<#ffb900ff>10–25%<> 피해가 증가합니다. 비행 중 적 영웅을 맞히면<#ff9028ff>먹잇감 표식<>을 적용/강화(최대 2중첩,<#ffb900ff>5초<>)하고 토네이도 스트라이크를 발동합니다."
      },
      "mlbb_lancelot": {
        "name": "랜슬롯",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다. <#5ad0e6ff>소울 커터<>는 중첩당 모든 피해를 <#ffb900ff>7.5%<> 증가시키며 <#ffb900ff>4초<> 동안 지속됩니다(최대 <#ffb900ff>4중첩, 30%<>).",
        "skill": "<#ff9028ff>펑처<>: 지정한 적에게 돌진해 <#ff9028ff>80–178 + 공격력의 40%<> 물리 피해를 줍니다. 처음 적중한 미표식 적에게 <#5ad0e6ff>검 표식<>을 남기며, 새 표식을 적용하면 펑처의 재사용 대기시간이 초기화됩니다. 시전할 때마다 <#ffb900ff>소울 커터<> 중첩을 얻습니다.",
        "skill2": "<#ffb900ff>가시 장미<>: 세 번 공격하며, 각 타격은 <#ff9028ff>85–155 + 공격력의 30%<> 물리 피해를 주고 적중한 적의 이동 속도를 <#ffb900ff>20%<> 낮춥니다(<#ffb900ff>0.5초<>). 연속 공격 중 피해와 군중 제어에 면역이며, 다수 적중 시 광역 피해 감소가 적용됩니다.",
        "ult": "<#e64a6aff>팬텀 처형<>: 지정한 적 영웅에게 돌진해 도착 시 <#ff9028ff>100–156 + 공격력의 100%<> 물리 피해를 줍니다. 돌진 중 피해와 군중 제어에 면역이며 <#ffb900ff>소울 커터<> 중첩을 얻습니다.",
        "passive": "<#5ad0e6ff>소울 커터<>: 펑처와 팬텀 처형은 중첩당 피해를 <#ffb900ff>7.5%<> 증가시키며 <#ffb900ff>4초<> 동안 지속됩니다. 최대 <#ffb900ff>4중첩(30%)<>입니다."
      },
      "mlbb_estes": {
        "name": "에스테스",
        "attack": "기본 공격은 <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>공격력의 100%<> 물리 피해를 줍니다. <#5ad0e6ff>달의 요정 서약<>은 시간에 따라 충전되며, <#ffb900ff>100<>중첩에서 다음 기본 공격이 강화되어 <#a974ffff>마법 피해<>를 추가하고 최대 2명의 주변 적에게 튕기며 <#ffb900ff>40%<> 둔화시킵니다(<#ffb900ff>1.5초<>).",
        "passive": "<#5ad0e6ff>달의 요정 서약<>: 초당<#ffb900ff>1<>중첩, 아군 연결 중 초당<#ffb900ff>2<>중첩을 얻습니다. 100중첩에서 다음 기본 공격이 강화되어 마법 피해를 주고 최대 2명의 주변 적에게 튕기며 40% 둔화(1.5초)를 부여합니다. 중첩은 스킬 1 아이콘에 표시됩니다.",
        "skill": "<#5ad0e6ff>달빛의 강림<>: 아군 영웅 하나를 즉시<#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 85%<>만큼 치유하고, 이후<#ffb900ff>0.5초<>마다<#5bd18aff>24<> + <#a974ffff>주문력의 18%<>를 5초간 회복시킵니다. 아군은 물리/마법 방어력<#ffb900ff>+7<>을, 에스테스는 이동 속도<#ffb900ff>+15%<>를 얻습니다. 거리가 120,000을 넘으면 시각 연결과 패시브 충전 보너스가 멈추며, 데이터 기반 지속 치유는 남은 시간 동안 계속됩니다.",
        "skill2": "<#5ad0e6ff>달의 여신 영역<>: <#ffb900ff>2.5초<> 동안 고정된 달빛 영역을 생성합니다. 매<#ffb900ff>0.5초<>마다 반경<#ffb900ff>52,000<> 안의 적에게<#a974ffff>15<> + <#a974ffff>주문력의 45%<> 마법 피해를 주고<#ffb900ff>35%<> 둔화시킵니다(0.75초). TFM2 버전은 바깥 가장자리만이 아니라 영역 안에서 둔화를 적용합니다.",
        "ult": "<#5ad0e6ff>달의 여신의 축복<>: 반경<#ffb900ff>105,000<> 안의 아군을 즉시<#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>주문력의 65%<> 치유하고, 이후 8초 동안 매 0.5초마다<#5bd18aff>20<> + <#a974ffff>주문력의 12%<>를 회복시키며 물리/마법 방어력<#ffb900ff>+8<>을 부여합니다."
      },
      "mlbb_gusion": {
        "name": "구시온",
        "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. At <#ffb900ff>4 Rune<> stacks, the next basic attack consumes them to deal <#a974ffff>3% of the target’s max HP<> as magic damage per stack and heal Gusion for <#5bd18aff>50 + 25% AP<> per stack.",
        "passive": "<#5ad0e6ff>Dagger Specialist<>: Each skill cast grants a <#ffb900ff>Rune<> stack, up to <#ffb900ff>4<>. The next basic attack consumes all stacks, dealing <#a974ffff>3% of the target’s max HP<> as magic damage per stack and restoring <#5bd18aff>50 + 25% Total Magic Power<> HP per stack.",
        "skill": "<#5ad0e6ff>Sword Spike<>: Throws a dagger that deals <#a974ffff>200 + 50% AP<> magic damage and marks the first enemy hit. Recast to dash behind the marked target for <#a974ffff>200 + 100% AP<> magic damage.",
        "skill2": "<#a974ffff>Shadowblade Slaughter<>: Throws <#ffb900ff>5 daggers<> in a fan; each deals <#a974ffff>65 + 40% AP<> magic damage. Recast to recall them; each returning dagger deals the same damage. The dagger and thin streak are separate visual projectiles.",
        "ult": "<#e64a6aff>Incandescence<>: Dashes behind the selected enemy and refreshes Skills 1 and 2. Recast briefly to dash behind a selected enemy again."
      }
    },
    "skill_name": {
      "mlbb_aldous": {
        "skill1": "계약: 영혼 탈취",
        "skill2": "계약: 폭발",
