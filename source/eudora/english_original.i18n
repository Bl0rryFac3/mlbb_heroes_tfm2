 "ja": {
  "description": {
   "mlbb_aldous": {
    "name": "オルダス",
    "attack": "溶岩の巨拳で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻撃力<>の<#ff9028ff>物理ダメージ<>を与える。",
    "skill": "<#ff9028ff>契約：ソウルスティール<>：主対象に<#ff9028ff>40 + レベル補正 + 攻撃力の100% + ソウルスティール1スタックごとに2.5<>の物理ダメージを与えます。周囲の敵は<#ff9028ff>40%<>の範囲ダメージを受けます。<#ffb900ff>1,000<>スタック時、スタックボーナスは防御適用前で<#ffb900ff>+2,500<>です。",
    "skill2": "<#ffb900ff>契約：エクスプロージョン<>：<#ffb900ff>2秒<>間シールド（<#ffb900ff>90<>）と移動速度（<#ffb900ff>+25%<>）を得てから爆発し、周囲に<#ff9028ff>70<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100%攻撃力<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1秒<><#ef5350ff>スタン<>を与える。",
    "ult": "<#e64a6aff>契約：チェイスフェイト<>：敵に<#e64a6aff>運命の眼<>を刻み溶岩ドリルとなって突撃、<#ff9028ff>130<>+<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160%攻撃力<>の<#ff9028ff>物理ダメージ<>と<#ffb900ff>1.2秒<><#ef5350ff>スタン<>を与える。",
    "passive": "契約：変容 — アルダスは魂のエネルギーを吸収する：<#ffb900ff>5秒<>ごとに<#ffb900ff>+1<>、キルで<#ffb900ff>+10<>、<#5ad0e6ff>ソウルスティール<>命中時にも獲得（上限<#ffb900ff>1,000<>）。<#ffb900ff>3<>回目の通常攻撃ごとに（<#ffb900ff>5秒<>クールダウン）<#ffb900ff>2秒<>間のシールドを得る。数値は<#ffb900ff>35<>+レベル×<#ffb900ff>5<>+スタック×<#ffb900ff>0.45<>。スタックは<#5ad0e6ff>ソウルスティール<>も強化する。"
   },
   "mlbb_fanny": {
    "name": "ファニー",
    "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
    "skill": "<#ff9028ff>トルネードストライク<>：半径<#ffb900ff>22,000<>以内の敵に<#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の80%<>のダメージを与える。スチールケーブル飛行中に敵と衝突すると、<#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の70%<>の空中トルネードストライクが自動で発動する。",
    "skill2": "<#ff9028ff>スチールケーブル<>：最適な壁または外周レーン境界へケーブル（射程<#ffb900ff>165,000<>）を投げ、エネルギー消費<#ffb900ff>0<>で連続壁乗りにより追撃または離脱する。視界内の敵英雄を最優先に狙い、敵英雄が視界にいない場合のみジャングルモンスターに使用する。",
    "ult": "<#ff9028ff>カットスロート<>：対象へ突進し<#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の125%<>のダメージを与える。獲物の印1つごとに<#ff9028ff>攻撃力の35%<>の追加ダメージ（最大2スタック）。命中すると印を消費する。",
    "passive": "<#ff9028ff>空中優勢<>：ケーブル飛行中、移動速度に応じて<#ffb900ff>10–25%<>のダメージが増加する。飛行中に敵英雄へ命中すると<#ff9028ff>獲物の印<>を付与・強化（最大2スタック、<#ffb900ff>5秒<>）し、トルネードストライクを発動する。"
   },
   "mlbb_lancelot": {
    "name": "ランスロット",
    "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
    "skill": "<#ff9028ff>パンクチャー<>：指定した敵へ突進し、<#ff9028ff>80–178 + 攻撃力の40%<>の物理ダメージを与えます。最初に命中した未マークの敵に<#5ad0e6ff>剣の印<>を付与し、新しい印を付けるとクールダウンがリセットされます。発動ごとに<#ffb900ff>ソウルカッター<>を1スタック得ます。",
    "skill2": "<#ffb900ff>ソーンローズ<>：3回攻撃し、各攻撃は<#ff9028ff>85–155 + 攻撃力の30%<>の物理ダメージを与え、命中した敵の移動速度を<#ffb900ff>20%<>低下させます（<#ffb900ff>0.5秒<>）。連続攻撃中はダメージと行動妨害を無効化し、複数命中には範囲ダメージ減衰が適用されます。",
    "ult": "<#e64a6aff>ファントムエグゼキューション<>：指定した敵ヒーローへ突進し、到達時に<#ff9028ff>100–156 + 攻撃力の100%<>の物理ダメージを与えます。突進中はダメージと行動妨害を無効化し、<#ffb900ff>ソウルカッター<>を1スタック得ます。",
    "passive": "<#5ad0e6ff>ソウルカッター<>：パンクチャーとファントムエグゼキューションで、スタックごとに与ダメージが<#ffb900ff>7.5%<>増加し、<#ffb900ff>4秒<>持続します。最大<#ffb900ff>4スタック（30%）<>です。"
   },
   "mlbb_estes": {
    "name": "エステス",
    "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
    "passive": "<#5ad0e6ff>月のエルフの書<>：毎秒<#ffb900ff>1<>スタック、味方とリンク中は毎秒<#ffb900ff>2<>スタックを獲得。100スタックで次の通常攻撃が強化され、魔法ダメージを与えて最大2体の近くの敵に跳ね返り、40%スロウ（1.5秒）を与えます。スタックはスキル1のアイコンに表示されます。",
    "skill": "<#5ad0e6ff>月光の浸礼<>：味方ヒーロー1体を即座に<#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の85%<>回復し、その後<#ffb900ff>0.5秒<>ごとに<#5bd18aff>24<> + <#a974ffff>魔力の18%<>を5秒間回復します。味方は物理・魔法防御<#ffb900ff>+7<>、エステスは移動速度<#ffb900ff>+15%<>を得ます。距離が120,000を超えると視覚的なリンクとパッシブのチャージボーナスは止まりますが、データ設定の継続回復は残り時間中続きます。",
    "skill2": "<#5ad0e6ff>月の女神の領域<>：<#ffb900ff>2.5秒<>間、固定された月光領域を作ります。<#ffb900ff>0.5秒<>ごとに半径<#ffb900ff>52,000<>内の敵に<#a974ffff>15<> + <#a974ffff>魔力の45%<>魔法ダメージを与え、<#ffb900ff>35%<>スロウを与えます（0.75秒）。TFM2版では外周だけでなく領域内でスロウが発生します。",
    "ult": "<#5ad0e6ff>月の女神の祝福<>：半径<#ffb900ff>105,000<>内の味方を即座に<#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の65%<>回復し、8秒間<#ffb900ff>0.5秒<>ごとに<#5bd18aff>20<> + <#a974ffff>魔力の12%<>を回復。物理・魔法防御<#ffb900ff>+8<>も付与します。"
   },
   "mlbb_gusion": {
    "name": "グシオン",
    "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
    "passive": "<#5ad0e6ff>Dagger Specialist<>: Each skill cast grants a <#ffb900ff>Rune<> stack, up to <#ffb900ff>4<>. The next basic attack consumes all stacks, dealing <#a974ffff>3% of the target’s max HP<> as magic damage per stack and restoring <#5bd18aff>50 + 25% Total Magic Power<> HP per stack.",
    "skill": "<#5ad0e6ff>ソードスパイク<>：短剣を投げ、最初に命中した敵に<#a974ffff>総魔法力の50% + 200<>の魔法ダメージを与え、<#ffb900ff>5秒<>間マークします。再発動でマークした敵の背後へ移動し、<#a974ffff>総魔法力の100% + 200<>の魔法ダメージを与えます。",
    "skill2": "<#a974ffff>シャドウブレードスローター<>：扇状に<#ffb900ff>短剣を5本<>投げ、1本ごとに<#a974ffff>総魔法力の40% + 65<>の魔法ダメージを与えます。再発動で短剣を呼び戻します。アルティメット後にもう一組を投げると、次の再発動で両方のセットを回収します。",
    "ult": "<#e64a6aff>インカンデセンス<>：選択した敵の背後へ移動し、スキル1と2のクールダウンをリセットします。スキル2の短剣が残っていれば、もう一組を投げてから両方を回収できます。<#ffb900ff>2.5秒<>以内に再発動してもう一度移動できます。"
   },
   "mlbb_karrie": {
    "name": "キャリー",
    "attack": "通常攻撃は単一のライトホイールで<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
    "passive": "<#5ad0e6ff>ライトホイールの印<>：通常攻撃とスキル1・2が<#ffb900ff>印を1つ<>付与する。<#ffb900ff>5スタック<>で爆発し、対象の最大HPの<#ff9028ff>4%<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の10%<>に相当する<#e64a6aff>真ダメージ<>を与える。英雄に対しては<#ffb900ff>250<>、ジャングル/エピックモンスターに対しては<#ffb900ff>300<>が上限となる。",
    "skill": "<#5ad0e6ff>スピニングライトホイール<>：指定方向へ環状のライトホイールを投げる。命中時、主対象に<#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の80%<>の物理ダメージ、周囲のタワー以外の敵に<#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の35%<>の物理ダメージを与え、<#ffb900ff>1秒<>間<#ffb900ff>35%<>の移動速度低下を与える。命中地点には<#ffb900ff>1.5秒<>間、紫色の減速地帯が残り、範囲内の敵は再び<#ffb900ff>35%<>減速し、<#ffb900ff>0.5秒<>間隔で2回、<#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の10%<>の物理ダメージを受ける。地帯の追加ダメージではライトホイールの印は付与されない。",
    "skill2": "<#5ad0e6ff>ファントムステップ<>：指定地点に向かって一定距離ダッシュし、着地点付近で最も近い有効な敵へライトホイールを放ちます。<#ff9028ff>75 + 総物理攻撃力の70%<>のダメージを与え、スピーディライトホイール中は係数が<#ff9028ff>100%<>になり、<#ffb900ff>ライトホイールの印を1つ<>付与します。",
    "ult": "<#e64a6aff>スピーディライトホイール<>：<#ffb900ff>6秒<>間、移動速度が<#ffb900ff>20%<>、攻撃速度が<#ffb900ff>35%<>上昇します。効果中、ファントムステップは<#ff9028ff>75 + 総物理攻撃力の100%<>のダメージを与えます。"
   },
   "mlbb_uranus": {
    "name": "ウラノス",
    "attack": "通常攻撃は腕を振り、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>に相当する<#ff9028ff>物理ダメージ<>を与えます。通常攻撃ではイオンエッジの印を<#ffb900ff>付与しません<>。",
    "passive": "<#5ad0e6ff>ラディアンス<>：ダメージを受けると<#ffb900ff>1スタック<>獲得（最大<#ffb900ff>12<>、各<#ffb900ff>10秒<>持続、<#ffb900ff>1秒<>につき最大1スタック）。<#ffb900ff>0.8秒<>ごとに回復し、12スタック時は<#5bd18aff>28～134 HP<>を回復します。",
    "skill": "<#5ad0e6ff>イオンエッジ<>：2枚のエネルギーブレードを外側へ放って戻し、命中ごとに<#a974ffff>79～131（総魔法力の18%加算）<>の魔法ダメージを与え、<#ffb900ff>30%<>のスロウを<#ffb900ff>2秒<>付与します。各刃は同じ対象に1回まで命中。1回の発動につき対象ごとに<#ffb900ff>イオンの印を1つ<>付与し、<#ffb900ff>6秒<>持続します。印1つにつき以降のスキル1ダメージが<#ffb900ff>20%<>増加し、最大<#ffb900ff>8スタック<>。タワーとネクサスには印を付与しません。",
    "skill2": "<#5ad0e6ff>超越の守護<>：指定地点へ突進します。経路上の敵に<#a974ffff>48～120（総魔法力の12%加算）<>、到着地点付近の敵に<#a974ffff>96～240（総魔法力の48%加算）<>の魔法ダメージを与え、<#ffb900ff>25%<>のスロウを付与。<#5bd18aff>300～750（総魔法力の200%加算）<>のシールドを<#ffb900ff>4秒<>獲得し、破壊または終了時に周囲へ<#a974ffff>156～390（総魔法力の78%加算）<>の魔法ダメージを与えます。",
    "ult": "<#e64a6aff>コンセクレーション<>：<#ef5350ff>すべての行動妨害<>を解除します（TFM2版。原作ではスロウのみ解除）。<#5bd18aff>200～400 HP<>を回復し、<#ffb900ff>60%<>の移動速度を得て<#ffb900ff>8秒<>かけて減衰します。ラディアンスを<#ffb900ff>5～12スタック<>獲得。8秒間、HP回復とウラノス自身の超越の守護シールドが<#ffb900ff>20%<>増加します。"
   },
   "mlbb_chou": {
    "name": "チョウ",
    "attack": "通常攻撃は物理攻撃力の100%の物理ダメージを与える。",
    "passive": "<#5ad0e6ff>迅速<>：TFM2ワールド距離で約<#ffb900ff>42,000<>移動すると、次の通常攻撃が<#ff9028ff>物理攻撃力の180%<>の物理ダメージを与え、<#ffb900ff>1秒<>間<#ffb900ff>80%<>減速させ、<#ffb900ff>2秒<>間物理防御を<#ffb900ff>10<>低下させる（最大<#ffb900ff>2<>スタック）。距離はTFM2のマップ規模に合わせて調整。",
    "skill": "<#ff9028ff>截拳道<>：最大<#ffb900ff>3<>回発動。上昇蹴り、突進アッパー、跳び上がって叩きつける蹴りの順に繰り出し、最後の一撃で敵を浮かせる。各攻撃は<#ff9028ff>100–165 + 総物理攻撃力の45%<>ダメージ。最初の2回は再発動でき、3回目でクールダウンが始まる。",
    "skill2": "<#5ad0e6ff>瞬歩<>：指定方向へダッシュし、移動中は<#ffb900ff>行動妨害無効<>を得る。到着時に<#5bd18aff>200–300 + 追加物理攻撃力の100%<>のシールドと、<#ffb900ff>2.5秒<>間物理貫通<#ffb900ff>15<>を得る。",
    "ult": "<#e64a6aff>龍の道<>：敵ヒーローに回し蹴りを放ち、<#ff9028ff>275–420 + 追加物理攻撃力の110%<>ダメージを与えて吹き飛ばす。<#ffb900ff>4秒<>以内に再発動すると対象を追い、空中で連続蹴りを浴びせて<#ff9028ff>330–500 + 追加物理攻撃力の132%<>ダメージを与える。多段ヒットの発動確認までは、ダメージ処理をエンジンイベント1回にまとめる。"
   },
   "mlbb_zhask": {
    "name": "ザスク",
    "attack": "影の弾を放ち、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>にあたる<#ff9028ff>物理ダメージ<>を与える。",
    "passive": "<#5ad0e6ff>殲滅<>：ザスクが倒されると、死亡地点に狂暴化したスポーンを召喚する。最大<#ffb900ff>6秒<>持続し、毎秒最大HPの<#ffb900ff>2%<>を失う。",
    "skill": "<#5ad0e6ff>悪夢のスポーン<>：最大<#ffb900ff>12秒<>その場にとどまるスポーンを召喚する。レベルに応じてザスクのHP、防御力、魔力の<#ffb900ff>55～100%<>を継承する。デスレイは<#a974ffff>15ティック（0.25秒）<>ごとに命中し、<#a974ffff>30（魔力の25%）<>の魔法ダメージを与え、<#ffb900ff>36ティック（0.6秒）<>の間、移動速度を<#ffb900ff>30%<>低下させる。再度照準して位置を変更できる。ザスクから<#ffb900ff>120,000<>ユニット以上離れると、戻るまでビームが停止する。",
    "skill2": "<#5ad0e6ff>マインドイーター<>：指定方向へ貫通弾を放ち、軌道上の敵に<#a974ffff>87 +（レベル1超過分×6）（魔力の60%）<>の魔法ダメージを与える。スポーンが生存中なら、命中した敵ごとに<#a974ffff>35（魔力の50%）<>の追加ダメージを与え、<#ffb900ff>30ティック（0.5秒）<>スタンさせる。",
    "ult": "<#e64a6aff>支配者の降臨<>：指定地点へ瞬間移動し、最大<#ffb900ff>10秒<>融合スポーンを召喚する。融合中、ザスクは追放され、姿が見えず、対象指定と操作ができない。融合スポーンはザスクの能力値を100%継承し、デスレイのダメージは<#ffb900ff>×1.8<>になる。"
   },
   "mlbb_hanabi": {
    "name": "花火",
    "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
    "passive": "<#5ad0e6ff>忍術・花弁乱舞<>：通常攻撃とスキル命中時に花弁刃を放ち、近くの敵へ跳ね返します。花火は<#ffb900ff>出所を問わずシールドがある間<>、行動妨害に免疫を得ます。すでに受けた行動妨害は解除しません。",
    "skill": "<#5ad0e6ff>忍術・エクリプス<>：<#ff9028ff>120 + 攻撃力の35%<>のシールドを<#ffb900ff>5秒<>間獲得し、移動速度が<#ffb900ff>12%<>、攻撃速度が<#ffb900ff>20%<>上昇します。シールド中はヒーローに与えたダメージの<#ffb900ff>20%<>、他のユニットに与えたダメージの<#ffb900ff>10%<>がシールドに変換されます。上限は最大HPの<#ffb900ff>50%<>で、この実装ではすべてのシールド層を上限に算入します。シールドがある間はパッシブの行動妨害耐性も発動します。",
    "skill2": "<#5ad0e6ff>忍術・ソウルスクロール<>：貫通するクナイと巻物を放ち、軌道上の敵に<#ff9028ff>65 + 攻撃力の75%<>の物理ダメージを与え、<#ffb900ff>1秒<>間<#ffb900ff>30%<>スロウにします。命中した敵に<#ffb900ff>5秒<>間印を付与します。次の通常攻撃の花弁が印の対象に跳ね返ると、通常の跳ね返り減衰を受けない<#ff9028ff>20 + 攻撃力の50%<>の追加ダメージを与えて印を消費します。",
    "ult": "<#e64a6aff>禁術・彼岸花<>：大輪の彼岸花を投げ、最初に命中した敵ヒーローに<#ff9028ff>150 + 攻撃力の80%<>の物理ダメージを与え、<#ffb900ff>0.8秒<>間束縛します。<#ffb900ff>0.8秒<>後、その位置で開花し、<#ffb900ff>34,000<>範囲の敵に<#ff9028ff>105 + 攻撃力の55%<>の物理ダメージを与えます。主対象以外の敵は<#ffb900ff>0.6秒<>間<#ffb900ff>20%<>スロウになります。"
   },
   "mlbb_alpha": {
    "name": "Alpha",
    "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
    "passive": "<#5ad0e6ff>ベータ、前進！<>：<#ffb900ff>2回<>ごとの通常攻撃で対象に印を付与し、ベータがロックオンレーザーを発射して<#e64a6aff>真ダメージ<>を与え、<#ffb900ff>30%<>の移動速度低下を与える。",
    "skill": "<#5ad0e6ff>ロータリーインパクト<>：直線上にエネルギー波を放ち、経路上の敵に<#ff9028ff>100 + 総物理攻撃力の90%<>の物理ダメージを与え、<#ffb900ff>1秒<>間<#ffb900ff>40%<>の移動速度低下を与える。ベータが同じ経路を機銃掃射し、真ダメージを与える。",
    "skill2": "<#5ad0e6ff>フォーススイング<>：短い遅延の後に振り抜き、扇形範囲に<#ff9028ff>250 + 総物理攻撃力の100%<>の物理ダメージを与え、命中した敵1体につき<#ffb900ff>100 + 総物理攻撃力の30%<>のHPをアルファが回復する。",
    "ult": "<#e64a6aff>アルファの槍<>：ベータが先に急降下して<#ffb900ff>1秒<>の<#ef5350ff>スタン<>を与える。続いてアルファが対象へ跳躍し、敵を打ち上げて叩き落とし、<#ff9028ff>250 + 総物理攻撃力の100%<>の物理ダメージと<#ffb900ff>1.5秒<>間<#ffb900ff>40%<>の移動速度低下を与える。ベータが<#ffb900ff>5<>回機銃掃射し、真ダメージを与える。"
   },
   "mlbb_arlott": {
    "name": "アーロット",
    "attack": "通常攻撃で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
    "passive": "<#5ad0e6ff>悪魔の凝視<>：<#ffb900ff>7秒<>ごとに最も近い敵ヒーローをマークし、アーロットの行動妨害効果が当たった敵もマークします。<#e64a6aff>マーク<>された対象は復讐の効果が2倍になります。マークは<#ffb900ff>7秒<>間持続します。",
    "skill": "<#5ad0e6ff>無謀な一撃<>：槍を振り下ろし、直線上の敵に<#ff9028ff>110 + 総物理攻撃力の55%<>の物理ダメージを与えてスタンさせます。対象が<#ffb900ff>遠いほど<>スタンが<#ffb900ff>長く<>なり、至近距離で<#ffb900ff>0.5秒<>、最大射程で<#ffb900ff>1秒<>になります。振り下ろしは行動妨害した敵をマークします。",
    "skill2": "<#5ad0e6ff>復讐<>：敵へ突進し、<#ff9028ff>100 + 総物理攻撃力の55%<>の物理ダメージを与え、行動妨害効果で対象をマークします。突進中、アーロットは<#ffb900ff>中断されません<>。<#e64a6aff>マーク<>された対象には<#ffb900ff>2倍<>のダメージを与え、<#ffb900ff>自身のクールダウンをリセット<>し、<#ffb900ff>総物理攻撃力の30%<>のHPを回復します（非ヒーローには半分）。",
    "ult": "<#e64a6aff>最期の一閃<>：二本の槍で大きく薙ぎ払い、<#ff9028ff>160 + 総物理攻撃力の75%<>の物理ダメージを与え、すべての敵をアーロットの<#ffb900ff>右側<>へ<#ffb900ff>引き寄せます<>。引き寄せられた敵はすべて<#e64a6aff>マーク<>されます。"
   },
   "mlbb_franco": {
    "name": "フランコ",
    "attack": "戦槌を振り回し <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> の <#ff9028ff>物理ダメージ<>を与える。",
    "skill": "<#5ad0e6ff>アイアンフック<>：鉤爪を投げ、最初に当たった敵を引っ掛けて <#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> の <#ff9028ff>物理ダメージ<>を与え、フランコの元へ引き寄せる。フックは先に<#ef5350ff>スタン<>させ、その後に引くため、引き寄せられない相手も足止めされる。",
    "skill2": "<#5ad0e6ff>フューリーショック<>：周囲を薙ぎ払い、敵に <#ff9028ff>160<> + 自身の<#ffb900ff>最大HP<>の <#ff9028ff>4%<> の <#ff9028ff>物理ダメージ<>を与え、<#ffb900ff>1.5秒<> の間 <#ffb900ff>70%<> <#ffb900ff>スロウ<>を付与する。ジャングルモンスターやオブジェクトにも使用可能。移動しながら使用できる。",
    "ult": "<#e64a6aff>ブラッディハント<>：敵チャンピオンを <#ffb900ff>1.8秒<> の間 <#ef5350ff>サプレッション<>し、<#ffb900ff>6<> 回攻撃する。ハンマーとフックを交互に使い、毎回 <#ff9028ff>50<> + <#ff9028ff>70% AD<> のダメージを与える。フランコが群衆制御を受けると途中で終了する。",
    "passive": "<#5ad0e6ff>ウェイストランドフォース<>：<#ffb900ff>5秒<> 間ダメージを受けないと、移動速度 <#ffb900ff>10%<>、毎秒最大HPの <#ffb900ff>1%<> を回復し、最大 <#ffb900ff>10<> スタックを蓄積する。次のスキルが全スタックを消費し、スキルダメージを最大 <#ffb900ff>+150%<> 増加させる。"
   },
   "mlbb_balmond": {
    "name": "バルモンド",
    "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の<#ff9028ff>物理ダメージ<>を与える。",
    "passive": "<#5ad0e6ff>ブラッドサースト<>：ミニオンまたは中立モンスターを倒すと最大HPの<#ffb900ff>5%<>を、敵英雄の撃破またはアシストで<#ffb900ff>10%<>を回復する。",
    "skill": "<#5ad0e6ff>ソウルロック<>：選択した敵英雄へ突進し、直線上の敵に<#ff9028ff>150–275 + 総物理攻撃力の60%<>の物理ダメージを与える。命中した英雄は短くノックバックし、<#ffb900ff>3秒<>間<#ffb900ff>40%<>の移動速度低下を受ける。TFM2プロトタイプでは位置を指定して突進し、直線経路上のダメージは維持され、到着地点付近の最も近い敵英雄がダメージを受ける。",
    "skill2": "<#5ad0e6ff>サイクロンスイープ<>：<#ffb900ff>3秒<>間回転し、14回に分けてダメージを与える。各命中は<#ff9028ff>30–55 + 総HPの1.3% + 総物理攻撃力の25%<>の物理ダメージを与え、対象の物理防御を命中ごとに<#ffb900ff>5%<>低下させる（最大<#ffb900ff>8スタック<>）。持続中は移動速度が<#ffb900ff>15%<>上昇する。",
    "ult": "<#e64a6aff>リーサルカウンター<>：前方の広範囲に<#ff9028ff>150 + 総物理攻撃力の70% + 対象の減少HPの30–45%<>に相当する<#e64a6aff>真ダメージ<>を与える。英雄以外へのダメージは英雄レベル区分ごとに<#ffb900ff>1,000 / 1,500 / 2,000<>で上限となる。"
   },
   "mlbb_obsidia": {
    "name": "オブシディア",
    "attack": "通常攻撃は<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 物理攻撃力の65%<>の物理ダメージを与える。",
    "passive": "<#5ad0e6ff>骨への回帰<>：敵にダメージを与えると骨力を獲得する——敵ヒーローへの通常攻撃で<#ffb900ff>2<>、スキル命中で<#ffb900ff>4<>、ミニオンまたはタワーへの攻撃で<#ffb900ff>1<>。ジャングルのモンスターでは獲得できない。骨力<#ffb900ff>30<>ごとに骨片が1枚鍛造され、最大<#ffb900ff>25<>枚。骨片1枚ごとに、通常攻撃が総物理攻撃力の<#ffb900ff>7%<>分だけ追加で命中する。敵ヒーローを倒すと即座に骨片を1枚獲得する。",
    "skill": "<#5ad0e6ff>深淵の骨針<>：直線上に骨の針を放ち、命中した敵に<#ff9028ff>90–140 + 総物理攻撃力の60%<>の物理ダメージを与え、最初に命中した敵ヒーローに骨力を付与する。",
    "skill2": "<#5ad0e6ff>幻影の影隠れ<>：深淵に沈み、対象方向へダッシュし、<#ffb900ff>0.3秒<>間<#ffb900ff>移動速度+20%<>を獲得する。",
    "ult": "<#e64a6aff>骨の狩り<>：憤怒の骨を放ち、<#ff9028ff>55 + 総物理攻撃力の50%<>の物理ダメージを与え、最初に命中した敵ヒーローを短時間<#ffb900ff>スタン<>させ、<#ffb900ff>自身をその近くへ引き寄せる<>。<#ffb900ff>3秒<>間拘束する：自身は<#ffb900ff>4ユニット<>以上離れられず、敵は移動スキルを使用できず、敵の移動に引きずられる。上限を超えて<#ffb900ff>5枚の仮骨片<>、<#ffb900ff>シールド<>、<#ffb900ff>攻撃速度+30%<>を獲得する。障害物をすり抜け、移動しながら通常攻撃が可能になり、幻影の影隠れは<#ffb900ff>1秒<>持続する。"
   },
   "mlbb_gord": {
    "name": "ゴード",
    "attack": "通常攻撃は <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<> の物理ダメージを与えます。射程が長い。",
    "passive": "<#5ad0e6ff>ミスティック・フェイバー<>: スキルで敵に <#ffb900ff>3<> 回命中させるごとに次のスキル命中が強化され、<#a974ffff>12 (+レベルごとに2) (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>魔力の8%) の確定ダメージ<>を追加で与え、対象を <#ffb900ff>1秒<> 間 <#ffb900ff>20%<> スロウにします。スロウは最大 <#ffb900ff>2<> 回まで重なり、<#ffb900ff>40%<> に達します。",
    "skill": "<#5ad0e6ff>ミスティック・プロジェクタイル<>: エネルギー弾を放ち、最初に当たった敵の位置で停止して爆発し、<#a974ffff>魔力の52% + 105<> の魔法ダメージを与え、<#ffb900ff>1秒<> 間 <#ffb900ff>スタン<>させます。",
    "skill2": "<#5ad0e6ff>ミスティック・インジャンクション<>: 指定地点に <#ffb900ff>4秒<> 間エネルギーフィールドを生成し、<#ffb900ff>0.25秒<> ごとに <#a974ffff>魔力の12% + 6<> の魔法ダメージを最大 <#ffb900ff>16<> 回与えます。",
    "ult": "<#e64a6aff>ミスティック・ガッシュ<>: <#ffb900ff>3.2秒<> 間エネルギービームを放ち、<#ffb900ff>0.2秒<> ごとに <#a974ffff>魔力の17% + 12<> の魔法ダメージを最大 <#ffb900ff>16<> 回与えます。各ウェーブは前方の最も近い敵チャンピオンを再照準します。"
   },
   "mlbb_belerick": {
    "name": "ベレリック",
    "attack": "通常攻撃は <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<> の物理ダメージを与えます。<#5ad0e6ff>ネイチャーズ・ストライク<> で強化されている間は代わりに <#a974ffff>60<> の魔法ダメージを与え、<#ffb900ff>150 + 減少HPの12%<> を回復し、対象を <#ffb900ff>1.4秒<> 間 <#ffb900ff>60%<> スロウにします。",
    "passive": "<#5ad0e6ff>デッドリー・ソーンズ<>: ベレリックが <#ffb900ff>4<> 回被弾するごとに最も近い敵へトゲを放ち、<#a974ffff>10 (+レベルごとに1) + 最大HPの1%<> の魔法ダメージを与えます。<#ffb900ff>10<> 未満のダメージはカウントされず、<#ffb900ff>1.2秒<> に一度しか発動しません。タワーの攻撃では発動しません。",
    "skill": "<#5ad0e6ff>エンシェント・シード<>: 直線上にツルを放ち、<#a974ffff>115<> の魔法ダメージを与え、命中した敵を <#ffb900ff>2秒<> 間 <#ffb900ff>25%<> スロウにします。<#ffb900ff>1.1秒<> 後に種が同じ軌道上で破裂し、<#a974ffff>115<> の魔法ダメージを与えて <#ffb900ff>1.2秒<> 間 <#ffb900ff>タウント<>します。",
    "skill2": "<#5ad0e6ff>ネイチャーズ・ストライク<>: <#ffb900ff>1秒<> 間移動速度が <#ffb900ff>+60%<>、その後 <#ffb900ff>1秒<> 間 <#ffb900ff>+20%<> 上昇し、<#ffb900ff>3秒<> 間次の通常攻撃を強化します。<#5ad0e6ff>デッドリー・ソーンズ<> が発動するたび、このスキルのクールダウンが <#ffb900ff>1秒<> 短縮されます。",
    "ult": "<#e64a6aff>ドライアドの怒り<>: 外側へ広がるツルを <#ffb900ff>4<> 波にわたって放ち、各波が <#a974ffff>55<> の魔法ダメージを与え、とらえた敵を <#ffb900ff>1.5秒<> 間 <#ffb900ff>タウント<>します。"
   },
   "mlbb_cecilion": {
    "name": "セシリオン",
    "attack": "通常攻撃で遠距離から <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> の物理ダメージを与えます。",
    "passive": "<#5ad0e6ff>オーバーフローイング<>: セシリオンのスキルが敵に命中するたび<#ffb900ff>1<> スタックを得る。これは <#ffb900ff>1 秒<> に 1 回までしか発生しない。スタックごとに <#a974ffff>魔力 +3<> を得て、試合終了まで持続し、デスしても失われない。",
    "skill": "<#5ad0e6ff>バット・インパクト<>: 巨大なコウモリを放ち、通り道の敵に <#a974ffff>30 + 総魔力の 25%<> の魔法ダメージを与える。目的地に到達するとコウモリが急降下し、<#a974ffff>55 + 総魔力の 50%<> の魔法ダメージを与える。",
    "skill2": "<#5ad0e6ff>サングイン・クロウズ<>: 地点を指定する。<#ffb900ff>0.6 秒<> 後、血の爪がその地点に迫り、捕らえた敵に <#a974ffff>60 + 総魔力の 60%<> の魔法ダメージを与え、<#ffb900ff>1 秒<> 間 <#ffb900ff>スタン<>させ、捕らえた敵を中心へ引き寄せる。",
    "ult": "<#e64a6aff>バット・フィースト<>: <#ffb900ff>3 秒<> にわたり <#ffb900ff>40<> の血の矢を放ち、それぞれ付近の敵チャンピオンに <#a974ffff>5 + 総魔力の 8%<> の魔法ダメージを与える。詠唱中も移動でき、<#ffb900ff>1.5 秒<> の間 <#a974ffff>移動速度 +60%<> を得て、矢1本ごとに <#a974ffff>8<> 回復する。"
   },
   "mlbb_johnson": {
    "name": "ジョンソン",
    "attack": "重いレンチを振り回し、<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% AD<>の<#ff9028ff>物理ダメージ<>を与える。",
    "passive": "<#5ad0e6ff>エレクトロエアバッグ<>: HPが<#ffb900ff>30%<>を下回ると、<#a974ffff>120 (+物理防御の240%)<>のシールドを<#ffb900ff>10秒<>間獲得する。クールダウン<#ffb900ff>100秒<>。",
    "skill": "<#5ad0e6ff>インパクトレンチ<>: レンチを投げつけ、直線上の敵に<#a974ffff>70 (+物理防御の110%)<>の魔法ダメージを与える。着弾地点付近の敵は<#ffb900ff>0.8秒<>間スタンする。",
    "skill2": "<#5ad0e6ff>電磁波<>: 盾を掲げ、前方の敵に<#a974ffff>40 (+物理防御の45%)<>の魔法ダメージを与え、移動速度と魔法防御を低下させる。最大<#ffb900ff>3<>回までスタックする。",
    "ult": "<#5ad0e6ff>フルスロットル<>: 車に変形する。近くの味方英雄が乗り込む。敵英雄に命中すると爆発し、<#a974ffff>90 (+物理防御の150%~220%)<>の魔法ダメージを与え、走行時間に応じて<#ffb900ff>0.5秒~1秒<>間スタンさせ、電撃地帯を残す。味方を乗せたまま安全な場所へ走ることもできる。"
   },
   "mlbb_angela": {
    "name": "アンジェラ",
    "attack": "ハートの弾を放ち、射程<#ffb900ff>88,000<>で<i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>攻撃力の100%<>の物理ダメージを与えます。",
    "skill": "<#5ad0e6ff>ラブウェーブ<>：チャージを<#ffb900ff>1つ<>消費し、前方<#ffb900ff>92,000<>まで波を放ちます。敵に<#a974ffff>80 + 魔力の30%<>の魔法ダメージを与え、通過した味方を<#5bd18aff>46<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#5bd18aff>魔力の40%<>回復します。命中した敵は<#5ad0e6ff>恋人の刻印<>を<#ffb900ff>1スタック<>獲得し、<#ffb900ff>3秒<>持続します（最大<#ffb900ff>5<>）。スタックごとに以降の波とS2の最終打撃のダメージが<#ffb900ff>+12%<>増加し、移動速度が<#ffb900ff>6%<>低下します。最大<#ffb900ff>5回<>まで連続で発動でき、最後の発動で<#ffb900ff>5秒<>のクールダウンに入ります。",
    "skill2": "<#5ad0e6ff>パペットストリング<>：射程<#ffb900ff>95,000<>以内の敵を<#ffb900ff>3秒<>繋ぎ止め、<#a974ffff>95 + 魔力の25%<>の魔法ダメージを与え、持続中に移動速度を最大<#ffb900ff>45%<>まで低下させます。終了時に繋がったままであれば、さらに<#a974ffff>140 + 魔力の35%<>のダメージ（<#5ad0e6ff>恋人の刻印<>のスタックで増加）を与え、<#ffb900ff>0.7秒<>拘束します。距離が<#ffb900ff>150,000<>を超えるか、対象が死亡すると糸は切れ、最終打撃は発生しません。",
    "ult": "<#e64a6aff>ハートガード<>：マップ上の味方英雄1体に<#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>魔力の180%<>のシールドを<#ffb900ff>6秒<>付与します。アンジェラは姿を消し、<#ffb900ff>12秒<>その味方に憑依して、味方の位置からS1・S2を自動で使用します。頭上に現れる<#5ad0e6ff>人形<>が絆を示します。憑依は宿主の死亡または対象外化で終了し、再使用で即座に解除されます。クールダウン<#ffb900ff>40秒<>。",
    "passive": "<#5ad0e6ff>スマートハート<>：スキルを使用するたびに移動速度を<#ffb900ff>4秒<>獲得します（憑依中は宿主に付与）。最大<#ffb900ff>4スタック<>まで重なり、合計は<#ffb900ff>7%、15%、22%、30%<>。上限で更新しても上限は超えず、使用回数とクールダウンは憑依をまたいで引き継がれます。"
   }
  },
