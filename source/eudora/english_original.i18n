{
 "en": {
  "description": {
   "mlbb_aldous": {
    "name": "Aldous",
    "attack": "Strikes with his giant molten gauntlet for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>.",
    "skill": "<#ff9028ff>Contract: Soul Steal<>: The primary target takes <#ff9028ff>40 + level scaling + 100% AD + 2.5 damage per Soul Steal stack<> as physical damage; nearby enemies take <#ff9028ff>40%<> splash. At <#ffb900ff>1,000<> stacks, the stack bonus is <#ffb900ff>+2,500 raw damage<> before defense.",
    "skill2": "<#ffb900ff>Contract: Explosion<>: Summons a blazing rune barrier for <#ffb900ff>2s<> (<#ffb900ff>90<> Shield, <#ffb900ff>+25%<> Move Speed), then detonates to deal <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>stun<> nearby foes for <#ffb900ff>1s<>.",
    "ult": "<#e64a6aff>Contract: Chase Fate<>: Locks the <#e64a6aff>Eye of Fate<> onto an enemy and drills across the arena as a molten meteor, crashing for <#ff9028ff>130<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160% AD<> <#ff9028ff>physical damage<> and <#ef5350ff>stunning<> for <#ffb900ff>1.2s<>.",
    "passive": "Contract: Transform: Aldous absorbs soul energy — <#ffb900ff>+1<> stack every <#ffb900ff>5s<>, <#ffb900ff>+10<> on a kill, and more whenever <#5ad0e6ff>Contract: Soul Steal<> connects (cap <#ffb900ff>1,000<>). Every <#ffb900ff>3rd<> basic attack (<#ffb900ff>5s<> cooldown) turns those stacks into a <#ffb900ff>2s<> shield worth <#ffb900ff>35<> + <#ffb900ff>5<> per level + <#ffb900ff>0.45<> per stack. Stacks also empower <#5ad0e6ff>Contract: Soul Steal<>."
   },
   "mlbb_fanny": {
    "name": "Fanny",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
    "skill": "<#ff9028ff>Tornado Strike<>: Deals <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<> in a <#ffb900ff>22,000<> radius. During Steel Cable flight, colliding with an enemy automatically triggers a mid-air Tornado Strike for <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70% AD<> and applies a Prey Mark to enemy champions.",
    "skill2": "<#ff9028ff>Steel Cable<>: Throws a cable (<#ffb900ff>165,000<> reach) at the best wall or outer lane boundary and swings Fanny past the obstacle toward her target, chaining multiple wall hops across the map with <#ffb900ff>0<> energy cost. Prioritizes visible enemy champions first, or nearby jungle monsters when no enemy champions are visible.",
    "ult": "<#ff9028ff>Cut Throat<>: Dashes to the target enemy and deals <#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125% AD<>; each Prey Mark adds <#ff9028ff>35% AD<> (up to 2 marks). A successful hit consumes the marks.",
    "passive": "<#ff9028ff>Air Superiority<>: While cable-flying, Fanny gains <#ffb900ff>10–25%<> bonus damage based on her flight speed. Hitting an enemy champion during flight applies or upgrades a <#ff9028ff>Prey Mark<> (max 2 stacks, <#ffb900ff>5s<>) and triggers Tornado Strike."
   },
   "mlbb_lancelot": {
    "name": "Lancelot",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
    "skill": "<#ff9028ff>Puncture<>: Dashes to the selected enemy, dealing <#ff9028ff>80–178 + 40% AD<> physical damage. The first unmarked enemy hit receives a <#5ad0e6ff>Sword Mark<>; applying a new mark resets Puncture. Each cast grants a <#ffb900ff>Soul Cutter<> stack.",
    "skill2": "<#ffb900ff>Thorned Rose<>: Strikes in three waves, each dealing <#ff9028ff>85–155 + 30% AD<> physical damage and slowing enemies hit by <#ffb900ff>20%<> for <#ffb900ff>0.5s<>. Lancelot is damage- and CC-immune during the sequence; overlapping hits use the crowd-hit penalty.",
    "ult": "<#e64a6aff>Phantom Execution<>: Dashes to the selected enemy champion and deals <#ff9028ff>100–156 + 100% AD<> physical damage on arrival. Lancelot is damage- and CC-immune during the dash and gains a <#ffb900ff>Soul Cutter<> stack.",
    "passive": "<#5ad0e6ff>Soul Cutter<>: Puncture and Phantom Execution grant <#ffb900ff>7.5%<> increased damage for <#ffb900ff>4s<> per stack, up to <#ffb900ff>4 stacks (30%)<>."
   },
   "mlbb_estes": {
    "name": "Estes",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
    "passive": "<#5ad0e6ff>Scripture of the Moon Elf<>: gains <#ffb900ff>1<> charge per second, or <#ffb900ff>2<> while Moonlight Immersion is linked. At 100 charges, the next basic attack is empowered: <#a974ffff>magic damage<> plus up to 2 nearby ricochets and a <#ffb900ff>40%<> slow for <#ffb900ff>1.5s<>. The meter is displayed on Skill 1.",
    "skill": "<#5ad0e6ff>Moonlight Immersion<>: heals an allied hero for <#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85% AP<> immediately, then <#5bd18aff>24<> + <#a974ffff>18% AP<> every <#ffb900ff>0.5s<> for <#ffb900ff>5s<>. Grants the ally <#ffb900ff>+7<> physical and magic defense and Estes <#ffb900ff>+15%<> move speed. The tether and passive charge bonus stop beyond <#ffb900ff>120,000<> range; the data-driven heal-over-time completes its duration.",
    "skill2": "<#5ad0e6ff>Domain of Moon Goddess<>: places a <#5ad0e6ff>stationary<> moonlight zone for <#ffb900ff>2.5s<>. Every <#ffb900ff>0.5s<>, enemies in the <#ffb900ff>52,000<> radius take <#a974ffff>15<> + <#a974ffff>45% AP<> magic damage and are slowed by <#ffb900ff>35%<> for <#ffb900ff>0.75s<>. TFM2 version slows within the zone rather than detecting only the outer edge.",
    "ult": "<#5ad0e6ff>Blessing of Moon Goddess<>: immediately heals nearby allies within <#ffb900ff>105,000<> for <#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65% AP<>; then restores <#5bd18aff>20<> + <#a974ffff>12% AP<> every <#ffb900ff>0.5s<> for <#ffb900ff>8s<> and grants <#ffb900ff>+8<> physical and magic defense."
   },
   "mlbb_gusion": {
    "name": "Gusion",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
    "passive": "<#5ad0e6ff>Dagger Specialist<>: Each skill cast grants <#ffb900ff>1 Rune<>, up to <#ffb900ff>4<>. The next Basic Attack consumes all Runes; each deals <#a974ffff>3% of the target’s max HP<> as magic damage and restores <#5bd18aff>50 + 25% AP<> HP (up to 12% max HP damage and 200 + 100% AP healing).",
    "skill": "<#5ad0e6ff>Sword Spike<>: Throws a dagger at the first enemy hit, dealing <#a974ffff>200 + 50% Total Magic Power<> magic damage and marking them for <#ffb900ff>5s<>. Recast to dash behind the marked target and deal <#a974ffff>200 + 100% Total Magic Power<> magic damage.",
    "skill2": "<#a974ffff>Shadowblade Slaughter<>: Throws <#ffb900ff>5 daggers<> in a fan; each hit deals <#a974ffff>65 + 40% Total Magic Power<> magic damage. Recast to recall them. After an Ultimate reset, S2 can throw a second fan before recalling both sets.",
    "ult": "<#e64a6aff>Incandescence<>: Dashes behind the selected enemy and resets Skills 1 and 2. If S2 daggers are already out, use S2 again to throw a second set; the next S2 recalls both sets. Recast within <#ffb900ff>2.5s<> to dash again."
   },
   "mlbb_karrie": {
    "name": "Karrie",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<> with a single lightwheel.",
    "passive": "<#5ad0e6ff>Lightwheel Mark<>: Basic attacks and Skills 1 and 2 add <#ffb900ff>1 mark<>. At <#ffb900ff>5 marks<>, they burst for <#ff9028ff>4% of the target’s max HP<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% AD<> as <#e64a6aff>true damage<>, capped at <#ffb900ff>250<> against heroes and <#ffb900ff>300<> against jungle/epic monsters.",
    "skill": "<#5ad0e6ff>Spinning Lightwheel<>: Throws a ring-shaped lightwheel in the chosen direction. On impact, it deals <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% AD<> physical damage to the primary target and <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35% AD<> physical damage to nearby non-tower enemies, slowing them by <#ffb900ff>35%<> for <#ffb900ff>1s<>. The impact leaves a violet slow zone for <#ffb900ff>1.5s<>; enemies inside are re-slowed by <#ffb900ff>35%<> and take two pulses of <#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% AD<> physical damage, <#ffb900ff>0.5s<> apart. The lingering pulses do not add extra Lightwheel Marks.",
    "skill2": "<#5ad0e6ff>Phantom Step<>: Dashes a fixed distance toward the chosen position, then fires at the nearest valid enemy near the landing point. Deals <#ff9028ff>75 + 70% Total Physical Attack<>; while Speedy Lightwheel is active, the ratio becomes <#ff9028ff>100%<>. Applies <#ffb900ff>1 Lightwheel Mark<>.",
    "ult": "<#e64a6aff>Speedy Lightwheel<>: For <#ffb900ff>6s<>, gains <#ffb900ff>+20% movement speed<> and <#ffb900ff>+35% attack speed<>. While active, Phantom Step deals <#ff9028ff>75 + 100% Total Physical Attack<>."
   },
   "mlbb_uranus": {
    "name": "Uranus",
    "attack": "Basic attacks swipe with Uranus’s arm for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>. Basic attacks do <#ffb900ff>not<> apply Ionic Edge marks.",
    "passive": "<#5ad0e6ff>Radiance<>: Taking damage grants <#ffb900ff>1 stack<> (up to <#ffb900ff>12<>, lasting <#ffb900ff>10s<> each, at most one per <#ffb900ff>1s<>). Every <#ffb900ff>0.8s<>, Uranus heals <#5bd18aff>28–134 HP at 12 stacks<>, scaling with level.",
    "skill": "<#5ad0e6ff>Ionic Edge<>: Sends two blades outward and back; each hit deals <#a974ffff>79–131 (+18% Total Magic Power)<> magic damage on hit and slowing by <#ffb900ff>30%<> for <#ffb900ff>2s<>. Each blade can hit a target once. Each cast applies at most <#ffb900ff>1 Ionic Mark per target<> for <#ffb900ff>6s<>; each mark increases later Skill 1 damage by <#ffb900ff>20%<>, up to <#ffb900ff>8 marks<>; Towers and Nexus cannot be marked.",
    "skill2": "<#5ad0e6ff>Transcendent Ward<>: Dashes to the chosen position. Enemies along the path take <#a974ffff>48–120 (+12% Total Magic Power)<> magic damage; enemies near the endpoint take <#a974ffff>96–240 (+48% Total Magic Power)<> and are slowed by <#ffb900ff>25%<>. Gains a <#5bd18aff>300–750 (+200% Total Magic Power)<> shield for <#ffb900ff>4s<>. When it breaks or expires, it bursts for <#a974ffff>156–390 (+78% Total Magic Power)<> magic damage nearby.",
    "ult": "<#e64a6aff>Consecration<>: Clears <#ef5350ff>all crowd control<> (TFM2 version; the source removes slows), restores <#5bd18aff>200–400 HP<>, and grants <#ffb900ff>60% move speed<> that decays over <#ffb900ff>8s<>. Adds <#ffb900ff>5–12 Radiance stacks<>. For <#ffb900ff>8s<>, increases HP Regen and Uranus’s own Transcendent Ward shield by <#ffb900ff>20%<>."
   },
   "mlbb_chou": {
    "name": "Chou",
    "attack": "Basic attacks deal 100% AD physical damage.",
    "passive": "<#5ad0e6ff>Only Fast<>: After moving about <#ffb900ff>42,000<> TFM2 world units, Chou's next Basic Attack deals <#ff9028ff>180% AD<> physical damage, slows by <#ffb900ff>80%<> for <#ffb900ff>1s<>, and reduces Physical Defense by <#ffb900ff>10<> for <#ffb900ff>2s<> (up to <#ffb900ff>2<> stacks). The distance is tuned to TFM2's map scale.",
    "skill": "<#ff9028ff>Jeet Kune Do<>: Cast up to <#ffb900ff>3<> times: a rising kick, a dash uppercut, then a leaping downward slam that knocks enemies airborne. Each hit deals <#ff9028ff>100–165 + 45% Total Physical Attack<>. The first two casts refresh this skill so the combo can continue; the third starts its cooldown.",
    "skill2": "<#5ad0e6ff>Shunpo<>: Dash toward a chosen direction, gaining <#ffb900ff>Control Immunity<> during the dash. On arrival, gain a shield equal to <#5bd18aff>200–300 + 100% Extra Physical Attack<> and <#ffb900ff>15<> Physical Penetration for <#ffb900ff>2.5s<>.",
    "ult": "<#e64a6aff>The Way of Dragon<>: Roundhouse-kick an enemy champion for <#ff9028ff>275–420 + 110% Extra Physical Attack<> and knock them away. Recast within <#ffb900ff>4s<> to chase and perform an aerial kick flurry for <#ff9028ff>330–500 + 132% Extra Physical Attack<>. Damage is one engine event until live proc testing validates splitting it across kicks."
   },
   "mlbb_zhask": {
    "name": "Zhask",
    "attack": "Fires a shadow bolt for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>.",
    "passive": "<#5ad0e6ff>Decimation<>: On death, Zhask summons a frenzied Spawn at his last position. It lasts up to <#ffb900ff>6s<> and loses <#ffb900ff>2%<> of its max HP each second.",
    "skill": "<#5ad0e6ff>Nightmaric Spawn<>: Summons a stationary Spawn for up to <#ffb900ff>12s<>. It inherits <#ffb900ff>55–100%<> of Zhask’s HP, defenses, and Magic Power by level. Its Death Ray hits every <#a974ffff>15 ticks (0.25s)<> for <#a974ffff>30 (+25% Magic Power)<> magic damage and slows by <#ffb900ff>30%<> for <#ffb900ff>36 ticks (0.6s)<>. Aim again to reposition it. If Zhask moves beyond <#ffb900ff>120,000<> units, the Ray pauses until he returns within range.",
    "skill2": "<#5ad0e6ff>Mind Eater<>: Fires a piercing directional projectile, dealing <#a974ffff>87 + 6 per level above level 1 (+60% Magic Power)<> magic damage and stunning enemies hit for <#ffb900ff>30 ticks (0.5s)<>. If a Spawn is alive, it follows up on each hit enemy for <#a974ffff>35 (+50% Magic Power)<> bonus magic damage.",
    "ult": "<#e64a6aff>Dominator’s Descent<>: Teleports to the target point and creates a fused Spawn for up to <#ffb900ff>10s<>. Zhask is banished from view, untargetable, and input-locked for the fusion. The fused Spawn inherits 100% of Zhask’s stats; its Death Ray damage is <#ffb900ff>×1.8<>."
   },
   "mlbb_hanabi": {
    "name": "Hanabi",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
    "passive": "<#5ad0e6ff>Ninjutsu: Petal Barrage<>: Basic attacks and skill hits launch Petal Blades that ricochet through nearby enemies. While Hanabi has <#ffb900ff>any shield source<>, she is immune to control effects. This does not remove control already applied.",
    "skill": "<#5ad0e6ff>Ninjutsu: Equinox<>: Gains a <#ff9028ff>120 + 35% AD<> shield for <#ffb900ff>5s<>, plus <#ffb900ff>12% movement speed<> and <#ffb900ff>20% attack speed<>. While this shield is active, <#ffb900ff>20%<> of damage dealt to heroes and <#ffb900ff>10%<> of damage dealt to other units is added as shield. The shield cap is <#ffb900ff>50% of max HP<>; the implementation counts all shield layers toward that cap. Any shield also grants the passive control immunity.",
    "skill2": "<#5ad0e6ff>Ninjutsu: Soul Scroll<>: Fires a penetrating kunai-and-scroll projectile, dealing <#ff9028ff>65 + 75% AD<> physical damage to enemies along its path and slowing them by <#ffb900ff>30%<> for <#ffb900ff>1s<>. Each target is marked for <#ffb900ff>5s<>. Hanabi’s next basic-attack Petal bounce on a marked target adds <#ff9028ff>20 + 50% AD<> damage without the normal bounce decay, then consumes that mark.",
    "ult": "<#e64a6aff>Forbidden Jutsu: Higanbana<>: Throws a large Higanbana that hits the first enemy hero, dealing <#ff9028ff>150 + 80% AD<> physical damage and binding them for <#ffb900ff>0.8s<>. After <#ffb900ff>0.8s<>, it blooms at that location for <#ff9028ff>105 + 55% AD<> physical damage in a <#ffb900ff>34,000<> radius. Other enemies hit are slowed by <#ffb900ff>20%<> for <#ffb900ff>0.6s<>."
   },
   "mlbb_balmond": {
    "name": "Balmond",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
    "passive": "<#5ad0e6ff>Bloodthirst<>: Restores <#ffb900ff>5%<> of Max HP after a minion or creep kill, and <#ffb900ff>10%<> after a hero kill or assist.",
    "skill": "<#5ad0e6ff>Soul Lock<>: Charges toward the selected enemy hero, damaging foes along its straight route for <#ff9028ff>150–275 + 60% Total Physical Attack<> physical damage. The struck hero is briefly knocked back and slowed by <#ffb900ff>40%<> for <#ffb900ff>3s<>. TFM2 prototype aims at a position and dashes there; sampled straight-line path damage is retained, and the nearest enemy hero near arrival takes the hit.",
    "skill2": "<#5ad0e6ff>Cyclone Sweep<>: Spins for <#ffb900ff>3s<>, dealing damage in 14 pulses. Each hit deals <#ff9028ff>30–55 + 1.3% Total HP + 25% Total Physical Attack<> physical damage and reduces the target’s Physical Defense by <#ffb900ff>5%<> per hit, up to <#ffb900ff>8 stacks<>. Grants <#ffb900ff>15%<> movement speed while active.",
    "ult": "<#e64a6aff>Lethal Counter<>: Strikes a wide frontal area for <#ff9028ff>150 + 70% Total Physical Attack + 30–45% of each target’s lost HP<> as true damage. Non-hero damage is capped at <#ffb900ff>1,000 / 1,500 / 2,000<> by hero-level bracket."
   },
   "mlbb_alpha": {
    "name": "Alpha",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
    "passive": "<#5ad0e6ff>Beta, Advance!<>: Every <#ffb900ff>2nd<> basic attack marks the target; Beta fires a Lock On laser dealing <#ff9028ff>true damage<> and slowing by <#ffb900ff>30%<>.",
    "skill": "<#5ad0e6ff>Rotary Impact<>: Fires an energy wave in a straight line, dealing <#ff9028ff>100 + 90% Total Physical Attack<> physical damage and slowing enemies in the path by <#ffb900ff>40%<> for <#ffb900ff>1s<>. Beta strafes the same path for true damage.",
    "skill2": "<#5ad0e6ff>Force Swing<>: Swings after a short delay, dealing <#ff9028ff>250 + 100% Total Physical Attack<> physical damage in a fan-shaped area and healing Alpha for <#ffb900ff>100 + 30% Total Physical Attack<> per enemy hit.",
    "ult": "<#e64a6aff>Spear of Alpha<>: Beta dives first, stunning for <#ffb900ff>1s<>. Alpha then leaps to the target, carrying enemies airborne, and slams down for <#ff9028ff>250 + 100% Total Physical Attack<> physical damage and a <#ffb900ff>40%<> slow for <#ffb900ff>1.5s<>. Beta strafes <#ffb900ff>5<> times for true damage."
   },
   "mlbb_arlott": {
    "name": "Arlott",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage.",
    "passive": "<#5ad0e6ff>Demon Gaze<>: Marks the nearest enemy hero every <#ffb900ff>7s<>, and marks any enemy struck by Arlott's control effects. A <#e64a6aff>marked<> target is doubled by Vengeance. Mark lasts <#ffb900ff>7s<>.",
    "skill": "<#5ad0e6ff>Dauntless Strike<>: Slams his lance downward, dealing <#ff9028ff>110 + 55% Total Physical Attack<> physical damage in a line and stunning. The <#ffb900ff>further<> the target, the <#ffb900ff>longer<> the stun — <#ffb900ff>0.5s<> up close to <#ffb900ff>1s<> at the far edge. The slam marks what it controls.",
    "skill2": "<#5ad0e6ff>Vengeance<>: Charges an enemy, dealing <#ff9028ff>100 + 55% Total Physical Attack<> physical damage, and marking the target with control. Arlott <#ffb900ff>cannot be interrupted<> while dashing. Against a <#e64a6aff>marked<> target it deals <#ffb900ff>double<> damage, <#ffb900ff>refreshes its own cooldown<> and heals Arlott for <#ffb900ff>30% Total Physical Attack<> (half against non-heroes).",
    "ult": "<#e64a6aff>Final Slash<>: A wide two-lance sweep dealing <#ff9028ff>160 + 75% Total Physical Attack<> physical damage and <#ffb900ff>dragging<> every enemy to Arlott's <#ffb900ff>right side<>. Each displaced enemy is left <#e64a6aff>marked<>."
   },
   "mlbb_franco": {
    "name": "Franco",
    "attack": "Swings his war hammer for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<>.",
    "skill": "<#5ad0e6ff>Iron Hook<>: Launches an iron hook that snags the first enemy it hits, dealing <#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> <#ff9028ff>physical damage<> and dragging them to Franco. The hook <#ef5350ff>stuns<> first, then pulls — a target that cannot be moved is still stopped.",
    "skill2": "<#5ad0e6ff>Fury Shock<>: Lashes out, dealing <#ff9028ff>160<> + <#ff9028ff>4%<> of Franco's <#ffb900ff>Max HP<> as <#ff9028ff>physical damage<> to nearby enemies and <#ffb900ff>slowing<> them by <#ffb900ff>70%<> for <#ffb900ff>1.5s<>. Castable on jungle monsters and objectives. Moving on.",
    "ult": "<#e64a6aff>Bloody Hunt<>: <#ef5350ff>Suppresses<> an enemy hero for <#ffb900ff>1.8s<> and strikes them <#ffb900ff>six<> times, alternating hammer and hook, for <#ff9028ff>50<> + <#ff9028ff>70% AD<> each. The ability ends early if Franco is crowd controlled.",
    "passive": "<#5ad0e6ff>Wasteland Force<>: After <#ffb900ff>5s<> without taking damage, Franco gains <#ffb900ff>10%<> Movement Speed, recovers <#ffb900ff>1%<> Max HP per second, and banks up to <#ffb900ff>10<> stacks. His next skill consumes them all for up to <#ffb900ff>+150%<> skill damage."
   },
   "mlbb_obsidia": {
    "name": "Obsidia",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 65% AD<> physical damage.",
    "passive": "<#5ad0e6ff>Return to Bone<>: Damaging an enemy grants Bone Energy — <#ffb900ff>2<> per basic attack on a hero, <#ffb900ff>4<> per skill hit, or <#ffb900ff>1<> per hit on a minion or turret. Jungle monsters grant none. Every <#ffb900ff>30<> Energy forges a Bone Shard, up to <#ffb900ff>25<>. Each shard makes her basic attack strike for a further <#ffb900ff>7%<> of her Total Physical Attack. Killing an enemy hero grants a shard at once.",
    "skill": "<#5ad0e6ff>Abyssal Bone Needle<>: Launches a bone needle in a line, dealing <#ff9028ff>90-140 + 60% Total Physical Attack<> physical damage to enemies hit and granting Bone Energy on the first enemy hero struck.",
    "skill2": "<#5ad0e6ff>Phantom Shadowmeld<>: Descends into the Abyss, dashing in the target direction and gaining <#ffb900ff>+20% Movement Speed<> for <#ffb900ff>0.3s<>.",
    "ult": "<#e64a6aff>Hunt of Bone<>: Shoots Bones of Wrath for <#ff9028ff>55 + 50% Total Physical Attack<> physical damage, briefly <#ffb900ff>stunning<> the first enemy hero hit and <#ffb900ff>pulling herself near them<>. Tethers her for <#ffb900ff>3s<>: she may not move more than <#ffb900ff>4 units<> away, the enemy cannot use displacement skills, and their movement drags her along. Grants <#ffb900ff>5 temporary Bone Shards<> past the cap, a <#ffb900ff>shield<>, and <#ffb900ff>+30% Attack Speed<>. She can move through obstacles and basic attack while moving, and Phantom Shadowmeld lasts <#ffb900ff>1s<>."
   },
   "mlbb_gord": {
    "name": "Gord",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage at long range.",
    "passive": "<#5ad0e6ff>Mystic Favor<>: Every <#ffb900ff>3<> hits on an enemy with skills arm the next skill hit, which deals an extra <#a974ffff>12 (+2 per level) (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>8% Magic Power) True Damage<> and slows the target by <#ffb900ff>20%<> for <#ffb900ff>1s<>. The slow stacks up to <#ffb900ff>2<> times, reaching <#ffb900ff>40%<>.",
    "skill": "<#5ad0e6ff>Mystic Projectile<>: Fires an orb of energy that stops at the first enemy hit and bursts, dealing <#a974ffff>105 + 52% Total Magic Power<> magic damage and <#ffb900ff>stunning<> them for <#ffb900ff>1s<>.",
    "skill2": "<#5ad0e6ff>Mystic Injunction<>: Creates a field of energy at the target location lasting <#ffb900ff>4s<>, dealing <#a974ffff>6 + 12% Total Magic Power<> magic damage every <#ffb900ff>0.25s<> — up to <#ffb900ff>16<> times.",
    "ult": "<#e64a6aff>Mystic Gush<>: Channels a beam of energy for <#ffb900ff>3.2s<>, dealing <#a974ffff>12 + 17% Total Magic Power<> magic damage every <#ffb900ff>0.2s<> — up to <#ffb900ff>16<> times. Each wave re-aims at the nearest enemy champion ahead of him."
   },
   "mlbb_belerick": {
    "name": "Belerick",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage. While <#5ad0e6ff>Nature's Strike<> empowers him, the attack instead deals <#a974ffff>60<> magic damage, heals him for <#ffb900ff>150 + 12% of his lost HP<> and slows the target by <#ffb900ff>60%<> for <#ffb900ff>1.4s<>.",
    "passive": "<#5ad0e6ff>Deadly Thorns<>: every <#ffb900ff>4th<> time Belerick is hit, he fires a thorn at the nearest enemy for <#a974ffff>10 (+1 per level) + 1% of Max HP<> magic damage. Hits below <#ffb900ff>10<> damage do not count, it fires at most once per <#ffb900ff>1.2s<>, and towers do not set it off.",
    "skill": "<#5ad0e6ff>Ancient Seed<>: releases vines in a line for <#a974ffff>115<> magic damage, slowing enemies hit by <#ffb900ff>25%<> for <#ffb900ff>2s<>. After <#ffb900ff>1.1s<> the seeds burst on the same path for <#a974ffff>115<> magic damage, <#ffb900ff>taunting<> them for <#ffb900ff>1.2s<>.",
    "skill2": "<#5ad0e6ff>Nature's Strike<>: gains <#ffb900ff>+60%<> Move Speed for <#ffb900ff>1s<>, then <#ffb900ff>+20%<> for <#ffb900ff>1s<>, and empowers his next Basic Attack for <#ffb900ff>3s<>. Each time <#5ad0e6ff>Deadly Thorns<> fires, this skill's cooldown drops by <#ffb900ff>1s<>.",
    "ult": "<#e64a6aff>Wrath of Dryad<>: conjures vines that spread outward in <#ffb900ff>4<> waves, each dealing <#a974ffff>55<> magic damage and <#ffb900ff>taunting<> enemies caught for <#ffb900ff>1.5s<>."
   },
   "mlbb_cecilion": {
    "name": "Cecilion",
    "attack": "Basic attacks deal <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage at long range.",
    "passive": "<#5ad0e6ff>Overflowing<>: each time one of Cecilion's skills hits an enemy, he gains <#ffb900ff>1<> stack, up to once per <#ffb900ff>1s<>. Every stack grants him <#a974ffff>+3 Magic Power<> for the rest of the match, and stacks are kept through death.",
    "skill": "<#5ad0e6ff>Bat Impact<>: sends a giant bat forward that deals <#a974ffff>30 + 25% Total Magic Power<> magic damage to enemies in its path. When it reaches its destination the bat dives, dealing <#a974ffff>55 + 50% Total Magic Power<> magic damage in a burst.",
    "skill2": "<#5ad0e6ff>Sanguine Claws<>: marks a location. After <#ffb900ff>0.6s<> claws of blood close in on it, dealing <#a974ffff>60 + 60% Total Magic Power<> magic damage to enemies caught, <#ffb900ff>stunning<> them for <#ffb900ff>1s<> and dragging them to the centre of the mark.",
    "ult": "<#e64a6aff>Bats Feast<>: unleashes <#ffb900ff>40<> bolts of blood over <#ffb900ff>3s<>, each striking a nearby enemy champion for <#a974ffff>5 + 8% Total Magic Power<> magic damage; he can move while channelling, gains <#a974ffff>+60% Move Speed<> for <#ffb900ff>1.5s<> and heals <#a974ffff>8<> per bolt."
   },
   "mlbb_johnson": {
    "name": "Johnson",
    "attack": "Swings his heavy wrench for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% AD<> <#ff9028ff>physical damage<>.",
    "passive": "<#5ad0e6ff>Electro Airbag<>: when Johnson drops below <#ffb900ff>30% HP<> he gains a shield worth <#a974ffff>120 (+240% Total Physical Defence)<> for <#ffb900ff>10s<>. Cooldown <#ffb900ff>100s<>.",
    "skill": "<#5ad0e6ff>Impact Wrench<>: hurls his wrench, dealing <#a974ffff>70 (+110% Total Physical Defence)<> magic damage to enemies in its path. Enemies near the landing point are stunned for <#ffb900ff>0.8s<>.",
    "skill2": "<#5ad0e6ff>Electromagnetic Waves<>: raises his shield, dealing <#a974ffff>40 (+45% Total Physical Defence)<> magic damage in front of him and reducing enemy Movement Speed and Magic Defence. Stacks up to <#ffb900ff>3<> times.",
    "ult": "<#5ad0e6ff>Full Throttle<>: transforms into a car. An allied hero nearby is taken aboard. On hitting an enemy hero the car explodes for <#a974ffff>90 (+150% to +220% Total Physical Defence)<> magic damage, stunning for <#ffb900ff>0.5s to 1s<> by drive time, and leaving an electrified zone. He can instead drive himself and his passenger to safety."
   },
   "mlbb_angela": {
    "name": "Angela",
    "attack": "Fires a heart bolt for <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> physical damage at <#ffb900ff>88,000<> range.",
    "skill": "<#5ad0e6ff>Love Waves<>: spends one charge to send a wave up to <#ffb900ff>92,000<> forward, dealing <#a974ffff>80 + 30% AP<> magic damage to enemies and healing allies it passes through for <#5bd18aff>46 + 40% AP<>. Enemies hit gain one stack of <#5ad0e6ff>Lover's Mark<> for <#ffb900ff>3s<> (max <#ffb900ff>5<>), each adding <#ffb900ff>+12%<> damage to later waves and S2's final hit and slowing by <#ffb900ff>6%<>. Cast up to <#ffb900ff>5 times<> in a row; the last cast starts a <#ffb900ff>5s<> cooldown.",
    "skill2": "<#5ad0e6ff>Puppet-on-a-String<>: connects an enemy within <#ffb900ff>95,000<> for <#ffb900ff>3s<>, dealing <#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25% AP<> magic damage and slowing them by up to <#ffb900ff>45%<> over the duration. If still connected when it ends, it deals a further <#a974ffff>140 + 35% AP<> (raised by <#5ad0e6ff>Lover's Mark<> stacks) and roots for <#ffb900ff>0.7s<>. Breaks harmlessly beyond <#ffb900ff>150,000<> or on death; a broken link deals no final hit.",
    "ult": "<#e64a6aff>Heartguard<>: shields an allied hero anywhere on the map for <#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>180% AP<> for <#ffb900ff>6s<>. Angela vanishes into that ally for <#ffb900ff>12s<>, casting S1 and S2 automatically from the ally's position while the <#5ad0e6ff>doll<> above them marks the bond. Attachment ends early if the host dies or becomes untargetable; recasting ends it immediately. Cooldown <#ffb900ff>40s<>.",
    "passive": "<#5ad0e6ff>Smart Heart<>: casting a skill grants Move Speed for <#ffb900ff>4s<> on Angela, or on her host while attached. Stacks up to <#ffb900ff>4<> times for <#ffb900ff>7%, 15%, 22%, 30%<> in total; refreshing at the cap cannot exceed it, and uses and cooldowns carry across attachment."
   }
  },
