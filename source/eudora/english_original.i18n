 "fr": {
  "description": {
   "mlbb_aldous": {
    "name": "Aldous",
    "attack": "Frappe avec son gantelet de lave pour infliger <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en <#ff9028ff>dégâts physiques<>.",
    "skill": "<#ff9028ff>Contrat : Vol d'âme<> : la cible principale subit <#ff9028ff>40 + échelle de niveau + 100% d'AD + 2,5 dégâts par cumul de Vol d'âme<> en dégâts physiques ; les ennemis proches subissent <#ff9028ff>40%<> de dégâts de zone. À <#ffb900ff>1 000<> cumuls, le bonus est de <#ffb900ff>+2 500 dégâts bruts<> avant défense.",
    "skill2": "<#ffb900ff>Contrat : Explosion<> : invoque une barrière runique ardente pendant <#ffb900ff>2 s<> (<#ffb900ff>90<> de bouclier, <#ffb900ff>+25%<> de vitesse), puis détonne en infligeant <#ff9028ff>70<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> de <#ff9028ff>dégâts physiques<> et en <#ef5350ff>étourdissant<> les ennemis proches pendant <#ffb900ff>1 s<>.",
    "ult": "<#e64a6aff>Contrat : Poursuite du destin<> : verrouille l'<#e64a6aff>Œil du destin<> sur un ennemi et traverse l'arène en météore de lave, infligeant <#ff9028ff>130<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>160% d'AD<> de <#ff9028ff>dégâts physiques<> et un <#ef5350ff>étourdissement<> de <#ffb900ff>1,2 s<>.",
    "passive": "Contrat : Transformation — Aldous absorbe l'énergie animale : <#ffb900ff>+1<> cumul toutes les <#ffb900ff>5 s<>, <#ffb900ff>+10<> par élimination, et davantage chaque fois que <#5ad0e6ff>Vol d'âme<> touche (max <#ffb900ff>1 000<>). Toutes les <#ffb900ff>3e<> attaques de base (<#ffb900ff>5 s<> de recharge), il convertit ces cumuls en un bouclier de <#ffb900ff>2 s<> valant <#ffb900ff>35<> + <#ffb900ff>5<> par niveau + <#ffb900ff>0,45<> par cumul. Les cumuls renforcent aussi <#5ad0e6ff>Vol d'âme<>."
   },
   "mlbb_alpha": {
    "name": "Alpha",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques.",
    "passive": "<#5ad0e6ff>Beta, en avant !<> : toutes les <#ffb900ff>2<> attaques de base marquent la cible ; Beta tire un laser de verrouillage infligeant des <#ff9028ff>dégâts bruts<> et ralentissant de <#ffb900ff>30%<>.",
    "skill": "<#5ad0e6ff>Impact rotatif<> : lance une vague d'énergie en ligne droite, infligeant <#ff9028ff>100 + 90% de l'Attaque Physique Totale<> en dégâts physiques et ralentissant les ennemis sur la trajectoire de <#ffb900ff>40%<> pendant <#ffb900ff>1 s<>. Beta mitraille la même trajectoire pour des dégâts bruts.",
    "skill2": "<#5ad0e6ff>Frappe de force<> : frappe après un court délai, infligeant <#ff9028ff>250 + 100% de l'Attaque Physique Totale<> en dégâts physiques dans une zone en éventail et soignant Alpha de <#ffb900ff>100 + 30% de l'Attaque Physique Totale<> par ennemi touché.",
    "ult": "<#e64a6aff>Lance d'Alpha<> : Beta plonge en premier, étourdissant pendant <#ffb900ff>1 s<>. Alpha bondit ensuite vers la cible, soulève les ennemis dans les airs et les écrase au sol en infligeant <#ff9028ff>250 + 100% de l'Attaque Physique Totale<> en dégâts physiques et un ralentissement de <#ffb900ff>40%<> pendant <#ffb900ff>1,5 s<>. Beta mitraille <#ffb900ff>5<> fois pour des dégâts bruts."
   },
   "mlbb_arlott": {
    "name": "Arlott",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques.",
    "passive": "<#5ad0e6ff>Regard du démon<> : marque le héros ennemi le plus proche toutes les <#ffb900ff>7 s<>, et marque tout ennemi touché par les effets de contrôle d'Arlott. Une cible <#e64a6aff>marquée<> est doublée par Vengeance. La marque dure <#ffb900ff>7 s<>.",
    "skill": "<#5ad0e6ff>Frappe intrépide<> : abat sa lance vers le bas, infligeant <#ff9028ff>110 + 55% de l'Attaque Physique Totale<> en dégâts physiques en ligne et étourdissant. Plus la cible est <#ffb900ff>éloignée<>, plus l'étourdissement est <#ffb900ff>long<> — de <#ffb900ff>0,5 s<> à bout portant à <#ffb900ff>1 s<> au bord extrême. L'impact marque ce qu'il touche.",
    "skill2": "<#5ad0e6ff>Vengeance<> : charge un ennemi, infligeant <#ff9028ff>100 + 55% de l'Attaque Physique Totale<> en dégâts physiques et marquant la cible. Arlott <#ffb900ff>ne peut pas être interrompu<> pendant la charge. Contre une cible <#e64a6aff>marquée<>, il inflige <#ffb900ff>le double<> de dégâts, <#ffb900ff>réinitialise son propre délai de récupération<> et se soigne de <#ffb900ff>30% de l'Attaque Physique Totale<> (moitié contre les non-héros).",
    "ult": "<#e64a6aff>Entaille finale<> : un large balayage à deux lances infligeant <#ff9028ff>160 + 75% de l'Attaque Physique Totale<> en dégâts physiques et <#ffb900ff>attirant<> tous les ennemis du <#ffb900ff>côté droit<> d'Arlott. Chaque ennemi déplacé reste <#e64a6aff>marqué<>."
   },
   "mlbb_balmond": {
    "name": "Balmond",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques.",
    "passive": "<#5ad0e6ff>Soif de sang<> : rend <#ffb900ff>5%<> des PV max après un sbire ou un monstre tué, et <#ffb900ff>10%<> après un héros tué ou une assistance.",
    "skill": "<#5ad0e6ff>Verrou d'âme<> : charge le héros ennemi sélectionné, blessant les ennemis sur sa trajectoire rectiligne pour <#ff9028ff>150–275 + 60% de l'Attaque Physique Totale<> en dégâts physiques. Le héros touché est brièvement repoussé et ralenti de <#ffb900ff>40%<> pendant <#ffb900ff>3 s<>. Le prototype TFM2 vise une position et s'y rue ; les dégâts de trajectoire rectiligne sont conservés, et le héros ennemi le plus proche à l'arrivée encaisse le coup.",
    "skill2": "<#5ad0e6ff>Balayage cyclone<> : tournoie pendant <#ffb900ff>3 s<>, infligeant des dégâts en 14 pulses. Chaque touche inflige <#ff9028ff>30–55 + 1,3% des PV totaux + 25% de l'Attaque Physique Totale<> en dégâts physiques et réduit la Défense Physique de la cible de <#ffb900ff>5%<> par touche, jusqu'à <#ffb900ff>8 cumuls<>. Octroie <#ffb900ff>15%<> de vitesse de déplacement pendant l'activation.",
    "ult": "<#e64a6aff>Contre létal<> : frappe une large zone frontale pour <#ff9028ff>150 + 70% de l'Attaque Physique Totale + 30–45% des PV perdus de chaque cible<> en dégâts bruts. Les dégâts contre les non-héros sont plafonnés à <#ffb900ff>1 000 / 1 500 / 2 000<> selon le palier de niveau."
   },
   "mlbb_chou": {
    "name": "Chou",
    "attack": "Les attaques de base infligent 100% d'AD en dégâts physiques.",
    "passive": "<#5ad0e6ff>Rapide seulement<> : après environ <#ffb900ff>42 000<> unités de monde TFM2 parcourues, l'attaque de base suivante de Chou inflige <#ff9028ff>180% d'AD<> en dégâts physiques, ralentit de <#ffb900ff>80%<> pendant <#ffb900ff>1 s<> et réduit la Défense Physique de <#ffb900ff>10<> pendant <#ffb900ff>2 s<> (jusqu'à <#ffb900ff>2<> cumuls). La distance est ajustée à l'échelle de la carte TFM2.",
    "skill": "<#ff9028ff>Jeet Kune Do<> : jusqu'à <#ffb900ff>3<> lancers : un coup de pied ascendant, un uppercut propulsé, puis un écrasement plongeant qui soulève les ennemis. Chaque touche inflige <#ff9028ff>100–165 + 45% de l'Attaque Physique Totale<>. Les deux premiers lancers réinitialisent la compétence pour enchaîner ; le troisième lance le délai de récupération.",
    "skill2": "<#5ad0e6ff>Shunpo<> : bondit dans la direction choisie, obtenant l'<#ffb900ff>Immunité au contrôle<> pendant le bond. À l'arrivée, obtient un bouclier de <#5bd18aff>200–300 + 100% de l'Attaque Physique Supplémentaire<> et <#ffb900ff>15<> de Pénétration Physique pendant <#ffb900ff>2,5 s<>.",
    "ult": "<#e64a6aff>La Voie du Dragon<> : roundhouse-kick sur un champion ennemi pour <#ff9028ff>275–420 + 110% de l'Attaque Physique Supplémentaire<> et le repousse. Relancez dans les <#ffb900ff>4 s<> pour poursuivre et enchaîner une rafale de coups aériens pour <#ff9028ff>330–500 + 132% de l'Attaque Physique Supplémentaire<>. Les dégâts forment un seul événement moteur jusqu'à ce que des tests en direct valident leur répartition entre les coups."
   },
   "mlbb_estes": {
    "name": "Estes",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques.",
    "passive": "<#5ad0e6ff>Écriture de l'Elfe Lunaire<> : gagne <#ffb900ff>1<> charge par seconde, ou <#ffb900ff>2<> pendant que Immersion au Clair de Lune est liée. À 100 charges, l'attaque de base suivante est renforcée : <#a974ffff>dégâts magiques<>, jusqu'à 2 ricochets et un ralentissement de <#ffb900ff>40%<> pendant <#ffb900ff>1,5 s<>. La jauge s'affiche sur la Compétence 1.",
    "skill": "<#5ad0e6ff>Immersion au Clair de Lune<> : soigne un héros allié de <#5bd18aff>115<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>85% de PA<> immédiatement, puis <#5bd18aff>24<> + <#a974ffff>18% de PA<> toutes les <#ffb900ff>0,5 s<> pendant <#ffb900ff>5 s<>. Octroie à l'allié <#ffb900ff>+7<> de défense physique et magique et à Estes <#ffb900ff>+15%<> de vitesse. Le lien et le bonus de charge passif s'arrêtent au-delà de <#ffb900ff>120 000<> de portée ; le soin par seconde va jusqu'au bout de sa durée.",
    "skill2": "<#5ad0e6ff>Domaine de la Déesse Lune<> : place une zone de clair de lune <#5ad0e6ff>statique<> pendant <#ffb900ff>2,5 s<>. Toutes les <#ffb900ff>0,5 s<>, les ennemis dans un rayon de <#ffb900ff>52 000<> subissent <#a974ffff>15<> + <#a974ffff>45% de PA<> de dégâts magiques et sont ralentis de <#ffb900ff>35%<> pendant <#ffb900ff>0,75 s<>. La version TFM2 ralentit dans toute la zone plutôt qu'au seul bord extérieur.",
    "ult": "<#5ad0e6ff>Bénédiction de la Déesse Lune<> : soigne immédiatement les alliés proches dans un rayon de <#ffb900ff>105 000<> pour <#5bd18aff>150<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>65% de PA<> ; puis restaure <#5bd18aff>20<> + <#a974ffff>12% de PA<> toutes les <#ffb900ff>0,5 s<> pendant <#ffb900ff>8 s<> et octroie <#ffb900ff>+8<> de défense physique et magique."
   },
   "mlbb_fanny": {
    "name": "Fanny",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques.",
    "passive": "<#ff9028ff>Supériorité aérienne<> : en vol câblé, Fanny gagne <#ffb900ff>10–25%<> de dégâts bonus selon sa vitesse de vol. Toucher un champion ennemi en vol applique ou améliore une <#ff9028ff>Marque de proie<> (max 2 cumuls, <#ffb900ff>5 s<>) et déclenche Frappe Tornade.",
    "skill": "<#ff9028ff>Frappe Tornade<> : inflige <#ff9028ff>35<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% d'AD<> dans un rayon de <#ffb900ff>22 000<>. Pendant le vol du Câble d'acier, heurter un ennemi déclenche automatiquement une Frappe Tornade aérienne pour <#ff9028ff>40<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>70% d'AD<> et applique une Marque de proie aux champions ennemis.",
    "skill2": "<#ff9028ff>Câble d'acier<> : lance un câble (portée <#ffb900ff>165 000<>) vers le meilleur mur ou la limite extérieure de voie et propulse Fanny par-dessus l'obstacle vers sa cible, enchaînant plusieurs sauts muraux à travers la carte pour <#ffb900ff>0<> coût d'énergie. Cible en priorité les champions ennemis visibles, ou les monstres de la jungle à proximité si aucun champion n'est visible.",
    "ult": "<#ff9028ff>Égorgement<> : bondit vers l'ennemi ciblé et inflige <#ff9028ff>100<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>125% d'AD<> ; chaque Marque de proie ajoute <#ff9028ff>35% d'AD<> (jusqu'à 2 marques). Une touche réussie consomme les marques."
   },
   "mlbb_franco": {
    "name": "Franco",
    "attack": "Balance son marteau de guerre pour <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en <#ff9028ff>dégâts physiques<>.",
    "passive": "<#5ad0e6ff>Force des friches<> : après <#ffb900ff>5 s<> sans subir de dégâts, Franco gagne <#ffb900ff>10%<> de vitesse de déplacement, récupère <#ffb900ff>1%<> de ses PV max par seconde et accumule jusqu'à <#ffb900ff>10<> charges. Sa prochaine compétence les consomme toutes pour jusqu'à <#ffb900ff>+150%<> de dégâts.",
    "skill": "<#5ad0e6ff>Crochet de fer<> : lance un crochet qui attrape le premier ennemi touché, infligeant <#ff9028ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> de <#ff9028ff>dégâts physiques<> et le tire vers Franco. Le crochet <#ef5350ff>étourdit<> d'abord, puis tire — une cible qui ne peut pas être déplacée est tout de même immobilisée.",
    "skill2": "<#5ad0e6ff>Choc de furie<> : frappe, infligeant <#ff9028ff>160<> + <#ff9028ff>4%<> des <#ffb900ff>PV max<> de Franco en <#ff9028ff>dégâts physiques<> aux ennemis proches et les <#ffb900ff>ralentissant<> de <#ffb900ff>70%<> pendant <#ffb900ff>1,5 s<>. Utilisable sur les monstres de la jungle et les objectifs.",
    "ult": "<#e64a6aff>Chasse sanglante<> : <#ef5350ff>neutralise<> un héros ennemi pendant <#ffb900ff>1,8 s<> et le frappe <#ffb900ff>six<> fois, alternant marteau et crochet, pour <#ff9028ff>50<> + <#ff9028ff>70% d'AD<> chacun. La compétence s'interrompt si Franco subit un contrôle de foule."
   },
   "mlbb_gusion": {
    "name": "Gusion",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques.",
    "passive": "<#5ad0e6ff>Spécialiste des dagues<> : chaque compétence lancée octroie <#ffb900ff>1 Rune<>, jusqu'à <#ffb900ff>4<>. L'attaque de base suivante consomme toutes les Runes ; chacune inflige <#a974ffff>3% des PV max de la cible<> en dégâts magiques et rend <#5bd18aff>50 + 25% de PA<> PV (jusqu'à 12% des PV max en dégâts et 200 + 100% de PA en soin).",
    "skill": "<#5ad0e6ff>Pointe d'épée<> : lance une dague sur le premier ennemi touché, infligeant <#a974ffff>200 + 50% de la Puissance Magique Totale<> en dégâts magiques et le marquant pendant <#ffb900ff>5 s<>. Relancez pour bondir derrière la cible marquée et infliger <#a974ffff>200 + 100% de la Puissance Magique Totale<> en dégâts magiques.",
    "skill2": "<#a974ffff>Carnage de Lame-Ombre<> : lance <#ffb900ff>5 dagues<> en éventail ; chaque touche inflige <#a974ffff>65 + 40% de la Puissance Magique Totale<> en dégâts magiques. Relancez pour les rappeler. Après une réinitialisation par l'Ultime, la Compétence 2 peut lancer un second éventail avant de rappeler les deux séries.",
    "ult": "<#e64a6aff>Incandescence<> : bondit derrière l'ennemi sélectionné et réinitialise les Compétences 1 et 2. Si les dagues de la Compétence 2 sont déjà lancées, réutilisez-la pour une seconde série ; la prochaine Compétence 2 rappelle les deux séries. Relancez dans les <#ffb900ff>2,5 s<> pour bondir à nouveau."
   },
   "mlbb_hanabi": {
    "name": "Hanabi",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques.",
    "passive": "<#5ad0e6ff>Ninjutsu : Pluie de pétales<> : les attaques de base et les touches de compétence lancent des Lames-Pétales qui ricochent entre les ennemis proches. Tant que Hanabi bénéficie d'<#ffb900ff>une source de bouclier quelconque<>, elle est immunisée aux effets de contrôle. Cela ne supprime pas un contrôle déjà appliqué.",
    "skill": "<#5ad0e6ff>Ninjutsu : Équinoxe<> : obtient un bouclier de <#ff9028ff>120 + 35% d'AD<> pendant <#ffb900ff>5 s<>, plus <#ffb900ff>12%<> de vitesse de déplacement et <#ffb900ff>20%<> de vitesse d'attaque. Tant que ce bouclier est actif, <#ffb900ff>20%<> des dégâts infligés aux héros et <#ffb900ff>10%<> des dégâts infligés aux autres unités s'ajoutent au bouclier. Le plafond du bouclier est de <#ffb900ff>50% des PV max<> ; l'implémentation compte toutes les couches de bouclier dans ce plafond. Tout bouclier accorde aussi l'immunité au contrôle du passif.",
    "skill2": "<#5ad0e6ff>Ninjutsu : Parchemin de l'âme<> : tire un projectile perçant kunai-et-parchemin, infligeant <#ff9028ff>65 + 75% d'AD<> en dégâts physiques aux ennemis sur sa trajectoire et les ralentissant de <#ffb900ff>30%<> pendant <#ffb900ff>1 s<>. Chaque cible est marquée pendant <#ffb900ff>5 s<>. Le prochain rebond de pétale d'attaque de base de Hanabi sur une cible marquée ajoute <#ff9028ff>20 + 50% d'AD<> de dégâts sans la décroissance normale de rebond, puis consomme la marque.",
    "ult": "<#e64a6aff>Jutsu interdit : Higanbana<> : lance un grand Higanbana qui touche le premier héros ennemi, infligeant <#ff9028ff>150 + 80% d'AD<> en dégâts physiques et le liant pendant <#ffb900ff>0,8 s<>. Après <#ffb900ff>0,8 s<>, il éclot à cet endroit pour <#ff9028ff>105 + 55% d'AD<> en dégâts physiques dans un rayon de <#ffb900ff>34 000<>. Les autres ennemis touchés sont ralentis de <#ffb900ff>20%<> pendant <#ffb900ff>0,6 s<>."
   },
   "mlbb_karrie": {
    "name": "Karrie",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> de <#ff9028ff>dégâts physiques<> avec une seule roue-lumière.",
    "passive": "<#5ad0e6ff>Marque de roue-lumière<> : les attaques de base et les Compétences 1 et 2 ajoutent <#ffb900ff>1 marque<>. À <#ffb900ff>5 marques<>, elles explosent pour <#ff9028ff>4% des PV max de la cible<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% d'AD<> en <#e64a6aff>dégâts bruts<>, plafonnés à <#ffb900ff>250<> contre les héros et <#ffb900ff>300<> contre les monstres de jungle/épiques.",
    "skill": "<#5ad0e6ff>Roue-lumière tournoyante<> : lance une roue-lumière annulaire dans la direction choisie. À l'impact, elle inflige <#ff9028ff>60<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>80% d'AD<> de dégâts physiques à la cible principale et <#ff9028ff>20<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>35% d'AD<> de dégâts physiques aux ennemis proches non-tourelles, les ralentissant de <#ffb900ff>35%<> pendant <#ffb900ff>1 s<>. L'impact laisse une zone de ralentissement violette pendant <#ffb900ff>1,5 s<> ; les ennemis à l'intérieur sont à nouveau ralentis de <#ffb900ff>35%<> et subissent deux pulses de <#ff9028ff>10<> + <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>10% d'AD<> de dégâts physiques, espacés de <#ffb900ff>0,5 s<>. Les pulses persistants n'ajoutent pas de Marques de roue-lumière.",
    "skill2": "<#5ad0e6ff>Pas fantomatique<> : bondit d'une distance fixe vers la position choisie, puis tire sur l'ennemi valide le plus proche du point d'arrivée. Inflige <#ff9028ff>75 + 70% de l'Attaque Physique Totale<> ; pendant que Roue-lumière rapide est active, le ratio passe à <#ff9028ff>100%<>. Applique <#ffb900ff>1 Marque de roue-lumière<>.",
    "ult": "<#e64a6aff>Roue-lumière rapide<> : pendant <#ffb900ff>6 s<>, gagne <#ffb900ff>+20%<> de vitesse de déplacement et <#ffb900ff>+35%<> de vitesse d'attaque. Pendant l'effet, Pas fantomatique inflige <#ff9028ff>75 + 100% de l'Attaque Physique Totale<>."
   },
   "mlbb_lancelot": {
    "name": "Lancelot",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques.",
    "passive": "<#5ad0e6ff>Coupeur d'âme<> : Perforation et Exécution fantomatique octroient <#ffb900ff>7,5%<> de dégâts supplémentaires pendant <#ffb900ff>4 s<> par cumul, jusqu'à <#ffb900ff>4 cumuls (30%)<>.",
    "skill": "<#ff9028ff>Perforation<> : bondit vers l'ennemi sélectionné, infligeant <#ff9028ff>80–178 + 40% d'AD<> en dégâts physiques. Le premier ennemi non marqué touché reçoit une <#5ad0e6ff>Marque d'épée<> ; appliquer une nouvelle marque réinitialise Perforation. Chaque lancer octroie un cumul de <#ffb900ff>Coupeur d'âme<>.",
    "skill2": "<#ffb900ff>Rose épineuse<> : frappe en trois vagues, chacune infligeant <#ff9028ff>85–155 + 30% d'AD<> en dégâts physiques et ralentissant les ennemis touchés de <#ffb900ff>20%<> pendant <#ffb900ff>0,5 s<>. Lancelot est immunisé aux dégâts et au contrôle pendant la séquence ; les touches superposées utilisent la pénalité de foule.",
    "ult": "<#e64a6aff>Exécution fantomatique<> : bondit vers le champion ennemi sélectionné et inflige <#ff9028ff>100–156 + 100% d'AD<> en dégâts physiques à l'arrivée. Lancelot est immunisé aux dégâts et au contrôle pendant le bond et gagne un cumul de <#ffb900ff>Coupeur d'âme<>."
   },
   "mlbb_uranus": {
    "name": "Uranus",
    "attack": "Les attaques de base frappent avec le bras d'Uranus pour <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> de <#ff9028ff>dégâts physiques<>. Les attaques de base <#ffb900ff>n'appliquent pas<> les marques de Lame ionique.",
    "passive": "<#5ad0e6ff>Radiance<> : subir des dégâts accorde <#ffb900ff>1 cumul<> (jusqu'à <#ffb900ff>12<>, durant <#ffb900ff>10 s<> chacun, un maximum d'un par <#ffb900ff>1 s<>). Toutes les <#ffb900ff>0,8 s<>, Uranus se soigne de <#5bd18aff>28–134 PV à 12 cumuls<>, selon le niveau.",
    "skill": "<#5ad0e6ff>Lame ionique<> : envoie deux lames vers l'extérieur et en retour ; chaque touche inflige <#a974ffff>79–131 (+18% de la Puissance Magique Totale)<> de dégâts magiques et ralentit de <#ffb900ff>30%<> pendant <#ffb900ff>2 s<>. Chaque lame ne peut toucher une cible qu'une fois. Chaque lancer applique au plus <#ffb900ff>1 Marque ionique par cible<> pendant <#ffb900ff>6 s<> ; chaque marque augmente les dégâts ultérieurs de la Compétence 1 de <#ffb900ff>20%<>, jusqu'à <#ffb900ff>8 marques<> ; les Tourelles et le Nexus ne peuvent pas être marqués.",
    "skill2": "<#5ad0e6ff>Garde transcendante<> : bondit vers la position choisie. Les ennemis sur la trajectoire subissent <#a974ffff>48–120 (+12% de la Puissance Magique Totale)<> de dégâts magiques ; les ennemis proches du point d'arrivée subissent <#a974ffff>96–240 (+48% de la Puissance Magique Totale)<> et sont ralentis de <#ffb900ff>25%<>. Obtient un bouclier de <#5bd18aff>300–750 (+200% de la Puissance Magique Totale)<> pendant <#ffb900ff>4 s<>. Lorsqu'il se brise ou expire, il éclate pour <#a974ffff>156–390 (+78% de la Puissance Magique Totale)<> de dégâts magiques à proximité.",
    "ult": "<#e64a6aff>Consécration<> : dissipe <#ef5350ff>tout contrôle de foule<> (version TFM2 ; la source ne retire que les ralentissements), rend <#5bd18aff>200–400 PV<> et accorde <#ffb900ff>60%<> de vitesse de déplacement qui décroît sur <#ffb900ff>8 s<>. Ajoute <#ffb900ff>5–12 cumuls de Radiance<>. Pendant <#ffb900ff>8 s<>, augmente la régénération de PV et le bouclier de Garde transcendante d'Uranus de <#ffb900ff>20%<>."
   },
   "mlbb_zhask": {
    "name": "Zhask",
    "attack": "Tire un trait d'ombre pour <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> de <#ff9028ff>dégâts physiques<>.",
    "passive": "<#5ad0e6ff>Décimation<> : à sa mort, Zhask invoque un Rejeton frénétique à sa dernière position. Il dure jusqu'à <#ffb900ff>6 s<> et perd <#ffb900ff>2%<> de ses PV max chaque seconde.",
    "skill": "<#5ad0e6ff>Rejeton cauchemardesque<> : invoque un Rejeton stationnaire jusqu'à <#ffb900ff>12 s<>. Il hérite de <#ffb900ff>55–100%<> des PV, défenses et Puissance Magique de Zhask selon le niveau. Son Rayon de la mort frappe toutes les <#a974ffff>15 ticks (0,25 s)<> pour <#a974ffff>30 (+25% de la Puissance Magique)<> de dégâts magiques et ralentit de <#ffb900ff>30%<> pendant <#ffb900ff>36 ticks (0,6 s)<>. Visez à nouveau pour le repositionner. Si Zhask s'éloigne au-delà de <#ffb900ff>120 000<> unités, le Rayon s'interrompt jusqu'à ce qu'il revienne à portée.",
    "skill2": "<#5ad0e6ff>Dévoreur d'esprit<> : tire un projectile directionnel perçant, infligeant <#a974ffff>87 + 6 par niveau au-dessus du niveau 1 (+60% de la Puissance Magique)<> de dégâts magiques et étourdissant les ennemis touchés pendant <#ffb900ff>30 ticks (0,5 s)<>. Si un Rejeton est vivant, il enchaîne sur chaque ennemi touché pour <#a974ffff>35 (+50% de la Puissance Magique)<> de dégâts magiques bonus.",
    "ult": "<#e64a6aff>Descente du Dominateur<> : se téléporte au point ciblé et crée un Rejeton fusionné jusqu'à <#ffb900ff>10 s<>. Zhask disparaît de la vue, est inciblable et son contrôle est verrouillé pendant la fusion. Le Rejeton fusionné hérite de 100% des statistiques de Zhask ; les dégâts de son Rayon de la mort sont multipliés par <#ffb900ff>×1,8<>."
   },
   "mlbb_obsidia": {
    "name": "Obsidia",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>40 + 65% de l'AD<> en dégâts physiques.",
    "passive": "<#5ad0e6ff>Retour à l'os<> : blesser un ennemi accorde de l'Énergie osseuse — <#ffb900ff>2<> par attaque de base sur un héros, <#ffb900ff>4<> par coup de compétence, ou <#ffb900ff>1<> par coup sur un sbire ou une tourelle. Les monstres de la jungle n'en accordent aucune. Toutes les <#ffb900ff>30<> Énergies forgent un Éclat d'os, jusqu'à <#ffb900ff>25<>. Chaque éclat ajoute <#ffb900ff>7%<> de son Attaque Physique Totale à son attaque de base. Tuer un héros ennemi accorde un éclat sur-le-champ.",
    "skill": "<#5ad0e6ff>Aiguille osseuse abyssale<> : lance une aiguille d'os en ligne droite, infligeant <#ff9028ff>90–140 + 60% de l'Attaque Physique Totale<> en dégâts physiques aux ennemis touchés et accordant de l'Énergie osseuse sur le premier héros ennemi touché.",
    "skill2": "<#5ad0e6ff>Camouflage fantomatique<> : s'enfonce dans l'Abîme, se rue dans la direction visée et gagne <#ffb900ff>+20% de vitesse de déplacement<> pendant <#ffb900ff>0,3 s<>.",
    "ult": "<#e64a6aff>Chasse d'os<> : tire les Os de Courroux pour <#ff9028ff>55 + 50% de l'Attaque Physique Totale<> en dégâts physiques, <#ffb900ff>étourdit<> brièvement le premier héros ennemi touché et <#ffb900ff>se tire à proximité de lui<>. Le lie pendant <#ffb900ff>3 s<> : elle ne peut pas s'éloigner de plus de <#ffb900ff>4 unités<>, l'ennemi ne peut pas utiliser de compétences de déplacement, et ses mouvements la traînent avec lui. Elle gagne <#ffb900ff>5 éclats d'os temporaires<> au-delà de la limite, un <#ffb900ff>bouclier<> et <#ffb900ff>+30% de vitesse d'attaque<>. Elle peut traverser les obstacles et attaquer de base en se déplaçant, et Camouflage fantomatique dure <#ffb900ff>1 s<>."
   },
   "mlbb_gord": {
    "name": "Gord",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% de l'AT<> en dégâts physiques, à longue portée.",
    "passive": "<#5ad0e6ff>Faveur mystique<> : toutes les <#ffb900ff>3<> touches de compétence sur un ennemi arment la suivante, qui inflige <#a974ffff>12 (+2 par niveau) (+<i#asset/base/ui/banpick/champion_stat_icon:ap_0>8% de la Puissance magique) dégâts bruts<> supplémentaires et ralentit la cible de <#ffb900ff>20%<> pendant <#ffb900ff>1 s<>. Le ralentissement se cumule jusqu'à <#ffb900ff>2<> fois, pour <#ffb900ff>40%<>.",
    "skill": "<#5ad0e6ff>Projectile mystique<> : lance un orbe d'énergie qui s'arrête sur le premier ennemi touché et explose, infligeant <#a974ffff>105 + 52% de la Puissance magique<> dégâts magiques et l'<#ffb900ff>étourdissant<> pendant <#ffb900ff>1 s<>.",
    "skill2": "<#5ad0e6ff>Injonction mystique<> : crée un champ d'énergie à l'endroit visé pendant <#ffb900ff>4 s<>, infligeant <#a974ffff>6 + 12% de la Puissance magique<> dégâts magiques toutes les <#ffb900ff>0,25 s<> — jusqu'à <#ffb900ff>16<> fois.",
    "ult": "<#e64a6aff>Jaillissement mystique<> : canalise un faisceau d'énergie pendant <#ffb900ff>3,2 s<>, infligeant <#a974ffff>12 + 17% de la Puissance magique<> dégâts magiques toutes les <#ffb900ff>0,2 s<> — jusqu'à <#ffb900ff>16<> fois. Chaque vague vise à nouveau le champion ennemi le plus proche devant lui."
   },
   "mlbb_belerick": {
    "name": "Belerick",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% de l'AT<> en dégâts physiques. Tant que <#5ad0e6ff>Frappe de la nature<> le renforce, l'attaque inflige à la place <#a974ffff>60<> dégâts magiques, le soigne de <#ffb900ff>150 + 12% de ses PV perdus<> et ralentit la cible de <#ffb900ff>60%<> pendant <#ffb900ff>1,4 s<>.",
    "passive": "<#5ad0e6ff>Épines mortelles<> : toutes les <#ffb900ff>4<> fois où Belerick est touché, il lance une épine sur l'ennemi le plus proche, infligeant <#a974ffff>10 (+1 par niveau) + 1% des PV max<> dégâts magiques. Les dégâts inférieurs à <#ffb900ff>10<> ne comptent pas, elle ne se déclenche qu'une fois par <#ffb900ff>1,2 s<> et les tourelles ne la déclenchent pas.",
    "skill": "<#5ad0e6ff>Graine ancienne<> : libère des vignes en ligne, infligeant <#a974ffff>115<> dégâts magiques et ralentissant les ennemis touchés de <#ffb900ff>25%<> pendant <#ffb900ff>2 s<>. Après <#ffb900ff>1,1 s<>, les graines éclatent sur la même trajectoire pour <#a974ffff>115<> dégâts magiques et les <#ffb900ff>provoquent<> pendant <#ffb900ff>1,2 s<>.",
    "skill2": "<#5ad0e6ff>Frappe de la nature<> : gagne <#ffb900ff>+60%<> de Vitesse de déplacement pendant <#ffb900ff>1 s<>, puis <#ffb900ff>+20%<> pendant <#ffb900ff>1 s<>, et renforce sa prochaine attaque de base pendant <#ffb900ff>3 s<>. Chaque fois que <#5ad0e6ff>Épines mortelles<> se déclenche, le délai de récupération baisse de <#ffb900ff>1 s<>.",
    "ult": "<#e64a6aff>Courroux de la dryade<> : invoque des vignes qui se propagent vers l'extérieur en <#ffb900ff>4<> vagues, chacune infligeant <#a974ffff>55<> dégâts magiques et <#ffb900ff>provoquant<> les ennemis touchés pendant <#ffb900ff>1,5 s<>."
   },
   "mlbb_cecilion": {
    "name": "Cecilion",
    "attack": "Les attaques de base infligent <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% d'AD<> en dégâts physiques à longue portée.",
    "passive": "<#5ad0e6ff>Débordement<> : chaque fois qu'une compétence de Cecilion touche un ennemi, il gagne <#ffb900ff>1<> cumul, au maximum une fois par <#ffb900ff>1 s<>. Chaque cumul lui accorde <#a974ffff>+3 de Puissance magique<> pour le reste de la partie, et les cumuls survivent à la mort.",
    "skill": "<#5ad0e6ff>Impact de chauve-souris<> : envoie une chauve-souris géante qui inflige <#a974ffff>30 + 25% de la Puissance magique totale<> en dégâts magiques aux ennemis sur sa trajectoire. En atteignant sa destination, la chauve-souris plonge et inflige <#a974ffff>55 + 50% de la Puissance magique totale<> en dégâts magiques.",
    "skill2": "<#5ad0e6ff>Griffes sanglantes<> : marque un emplacement. Après <#ffb900ff>0,6 s<>, des griffes de sang s'y referment, infligeant <#a974ffff>60 + 60% de la Puissance magique totale<> en dégâts magiques aux ennemis pris et les <#ffb900ff>étourdissant<> pendant <#ffb900ff>1 s<> et les attire au centre de la zone.",
    "ult": "<#e64a6aff>Festin de chauves-souris<> : déchaîne <#ffb900ff>40<> traits de sang sur <#ffb900ff>3 s<>, chacun frappant un champion ennemi proche pour <#a974ffff>5 + 8% de la Puissance magique totale<> en dégâts magiques ; il peut se déplacer pendant la canalisation, gagne <#a974ffff>+60% de Vitesse de déplacement<> pendant <#ffb900ff>1,5 s<> et rend <#a974ffff>8<> points de vie par trait."
   },
   "mlbb_johnson": {
    "name": "Johnson",
    "attack": "Frappe avec sa lourde clé en infligeant <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ffb900ff>100% AD<> de <#ff9028ff>dégâts physiques<>.",
    "passive": "<#5ad0e6ff>Airbag électronique<>: quand Johnson passe sous <#ffb900ff>30% de PV<>, il gagne un bouclier de <#a974ffff>120 (+240% de la Défense physique totale)<> pendant <#ffb900ff>10 s<>. Recharge <#ffb900ff>100 s<>.",
    "skill": "<#5ad0e6ff>Clé à chocs<>: lance sa clé, infligeant <#a974ffff>70 (+110% de la Défense physique totale)<> dégâts magiques aux ennemis sur sa trajectoire. Les ennemis proches du point d'arrivée sont étourdis <#ffb900ff>0,8 s<>.",
    "skill2": "<#5ad0e6ff>Ondes électromagnétiques<>: lève son bouclier, infligeant <#a974ffff>40 (+45% de la Défense physique totale)<> dégâts magiques devant lui et réduisant la Vitesse de déplacement et la Défense magique ennemies. Cumulable <#ffb900ff>3<> fois.",
    "ult": "<#5ad0e6ff>Pleins gaz<>: se transforme en voiture. Un héros allié proche peut monter à bord. En percutant un héros ennemi, la voiture explose et inflige <#a974ffff>90 (+150% à +220% de la Défense physique totale)<> dégâts magiques, étourdit <#ffb900ff>0,5 s à 1 s<> selon la durée de conduite, et laisse une zone électrifiée. Il peut aussi conduire son passager en lieu sûr."
   },
   "mlbb_angela": {
    "name": "Angela",
    "attack": "Tire un éclair de cœur infligeant <i#asset/base/ui/banpick/champion_stat_icon:ad_0><#ff9028ff>100% AD<> de dégâts physiques à <#ffb900ff>88 000<> de portée.",
    "skill": "<#5ad0e6ff>Vagues d'Amour<> : dépense une charge pour envoyer une vague jusqu'à <#ffb900ff>92 000<> devant elle, infligeant <#a974ffff>80 + 30% AP<> de dégâts magiques aux ennemis et soignant les alliés traversés de <#5bd18aff>46 + 40% AP<>. Les ennemis touchés gagnent une charge de <#5ad0e6ff>Marque de l'Amante<> pendant <#ffb900ff>3s<> (max <#ffb900ff>5<>), chacune ajoutant <#ffb900ff>+12%<> de dégâts aux vagues suivantes et au coup final de S2, et ralentissant de <#ffb900ff>6%<>. Jusqu'à <#ffb900ff>5 utilisations<> d'affilée ; la dernière lance un rechargement de <#ffb900ff>5s<>.",
    "skill2": "<#5ad0e6ff>Marionnette à Fils<> : relie un ennemi à moins de <#ffb900ff>95 000<> pendant <#ffb900ff>3s<>, lui infligeant <#a974ffff>95<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>25% AP<> de dégâts magiques et le ralentissant jusqu'à <#ffb900ff>45%<> sur la durée. Si le lien tient jusqu'au bout, il inflige <#a974ffff>140 + 35% AP<> supplémentaires (augmentés par les charges de <#5ad0e6ff>Marque de l'Amante<>) et entrave <#ffb900ff>0,7s<>. Se rompt sans effet au-delà de <#ffb900ff>150 000<> ou à la mort ; un lien rompu ne frappe pas une seconde fois.",
    "ult": "<#e64a6aff>Garde du Cœur<> : accorde à un allié où qu'il soit sur la carte un bouclier de <#ffb900ff>220<> + <i#asset/base/ui/banpick/champion_stat_icon:ap_0><#a974ffff>180% AP<> pendant <#ffb900ff>6s<>. Angela disparaît dans cet allié pendant <#ffb900ff>12s<> et lance S1 et S2 automatiquement depuis sa position, tandis que la <#5ad0e6ff>poupée<> au-dessus de lui marque le lien. L'attachement cesse si l'hôte meurt ou devient non ciblable ; le relancer l'interrompt aussitôt. Rechargement <#ffb900ff>40s<>.",
    "passive": "<#5ad0e6ff>Cœur Malin<> : chaque sort lancé accorde de la vitesse de déplacement pendant <#ffb900ff>4s<> à Angela, ou à son hôte pendant l'attachement. Jusqu'à <#ffb900ff>4 cumuls<> pour <#ffb900ff>7%, 15%, 22%, 30%<> au total ; rafraîchir au maximum ne le dépasse pas, et les utilisations comme les rechargements se conservent à travers l'attachement."
   }
  },
