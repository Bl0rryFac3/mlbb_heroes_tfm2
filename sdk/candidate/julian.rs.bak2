//! Julian: source-only candidate. See JULIAN_SPEC.md for deliberate engine adaptations.
use crate::EntityKey;
use mod_api_stable::*;
use std::{collections::{HashMap,HashSet},sync::{LazyLock,Mutex}};
type Pos=(u64,u64);
const EARLY_CHAIN_ASSIST:bool=true;
const RANGE:f64=70_000.;const DASH:f64=50_000.;const WIDTH:f64=8_000.;const RADIUS:f64=18_000.;
const SUSTAIN:&str="mlbb_julian_sustain";
const SCYTHE:(usize,usize)=(120,58);const ENH_SCYTHE:(usize,usize)=(175,82);const SPIN:(usize,usize)=(9,5);
const CONTINUOUS_HITS:usize=16;const CONTINUOUS_PERIOD:usize=6;
const SWORD:(usize,usize)=(105,44);const BLADE:(usize,usize)=(22,11);const CHAIN:(usize,usize)=(92,42);const CHAIN_PULSE:(usize,usize)=(8,4);const LAUNCH:(usize,usize)=(168,72);
fn spell(p:(usize,usize),ap:usize)->usize{p.0.saturating_add(ap.saturating_mul(p.1)/100)}
fn d2(a:Pos,b:Pos)->f64{(a.0 as f64-b.0 as f64).powi(2)+(a.1 as f64-b.1 as f64).powi(2)}
fn pos(s:&StableSim<'_>,id:usize)->Option<Pos>{s.get_entity(id).map(|e|e.pos())}
fn within(a:Pos,b:Pos,r:f64)->bool{d2(a,b)<=r*r}
fn point(a:Pos,d:(f64,f64),dist:f64)->Pos{((a.0 as f64+d.0*dist).clamp(0.,u64::MAX as f64) as u64,(a.1 as f64+d.1*dist).clamp(0.,u64::MAX as f64) as u64)}
fn enemy(s:&StableSim<'_>,c:usize,t:usize)->bool{let(Some(a),Some(b))=(s.get_entity(c),s.get_entity(t))else{return false};a.team()!=b.team()&&b.is_alive()&&b.is_targetable()&&!b.is_tower()&&!matches!(b.kind(),Some(EntityKindV1::Nexus|EntityKindV1::Tower))}
fn foes(s:&StableSim<'_>,c:usize)->Vec<usize>{let mut v:Vec<_>=(0..s.entity_count()).filter_map(|i|s.entity_at(i)).map(|e|e.id()).filter(|t|enemy(s,c,*t)).collect();v.sort_unstable();v}
fn aim(s:&StableSim<'_>,c:usize,i:InputTargetV1)->Option<(Pos,Pos,(f64,f64))>{
 let from=pos(s,c)?;let to=match InputTargetKindV1::from_code(i.kind)?{InputTargetKindV1::Target=>{if !enemy(s,c,i.target_id){return None}pos(s,i.target_id)?},InputTargetKindV1::Pos=>(i.x,i.y),InputTargetKindV1::Dir=>((from.0 as i128+i.dir_x as i128).clamp(0,u64::MAX as i128) as u64,(from.1 as i128+i.dir_y as i128).clamp(0,u64::MAX as i128) as u64),_=>return None};
 let(dx,dy)=(to.0 as f64-from.0 as f64,to.1 as f64-from.1 as f64);let n=dx.hypot(dy);if n<1.{return None}let d=(dx/n,dy/n);Some((from,point(from,d,n.min(RANGE)),d))
}
fn segment(a:Pos,b:Pos,p:Pos,w:f64)->Option<f64>{let(dx,dy)=(b.0 as f64-a.0 as f64,b.1 as f64-a.1 as f64);let n=dx*dx+dy*dy;if n<1.{return within(a,p,w).then_some(0.)}let t=(((p.0 as f64-a.0 as f64)*dx+(p.1 as f64-a.1 as f64)*dy)/n).clamp(0.,1.);within(((a.0 as f64+dx*t) as u64,(a.1 as f64+dy*t) as u64),p,w).then_some(t)}
fn bucket(d:(f64,f64))->usize{((d.1.atan2(d.0).rem_euclid(std::f64::consts::TAU)/std::f64::consts::TAU*16.).round() as usize)%16}
fn fx(s:&mut StableSim<'_>,name:&str,c:usize,p:Pos,time:usize){if s.sim_origin().and_then(|o|SimOriginKindV1::from_code(o.kind)).is_some_and(|k|matches!(k,SimOriginKindV1::ServerPresim|SimOriginKindV1::Tool)){return}s.play_view_effect(name,c,&InputTargetV1::pos(p.0,p.1),0,0,time as u64);}
fn slow(s:&mut StableSim<'_>,c:usize,t:usize,n:i32,time:usize){let name=format!("mlbb_julian_slow_{c}");s.entity_remove_buff(t,&name);s.add_buff(t,&BuffV1{move_speed_mult:-n,..BuffV1::timed(&name,time)});}
#[derive(Clone)]struct Bolt{start:usize,from:Pos,dir:(f64,f64),last:Pos,ap:usize,enhanced:bool,hit:HashSet<EntityKey>,awarded:bool}
#[derive(Clone)]struct Zone{start:usize,next:usize,paid:usize,center:Pos,dir:(f64,f64),ap:usize,kind:u8,awarded:bool}
#[derive(Clone)]struct BladePath{next:usize,paid:usize,from:Pos,to:Pos,ap:usize,awarded:bool}
#[derive(Clone,Default)]struct Runtime{mask:u8,last_cast:Option<usize>,ready:[usize;3],basic_until:usize,stacks:usize,sustain_until:usize,updated:Option<usize>,goal:usize,bolts:Vec<Bolt>,zones:Vec<Zone>,paths:Vec<BladePath>}
impl Runtime{
 fn reset_expired(&mut self,n:usize){if self.last_cast.is_some_and(|t|n.saturating_sub(t)>240){self.mask=0;self.last_cast=None;}}
 fn enhanced(&self,i:usize)->bool{self.mask.count_ones()==2&&self.mask&(1<<i)==0}
 fn can_cast(&self,i:usize,n:usize)->bool{i<3&&self.mask&(1<<i)==0&&n>=self.ready[i]}
 fn accept(&mut self,i:usize,n:usize,cd:usize)->bool{let e=self.enhanced(i);self.mask|=1<<i;self.last_cast=Some(n);self.basic_until=n+120;self.ready[i]=n+360;if e{self.mask=0;self.last_cast=None;self.ready=[n+cd;3];}e}
}
static STATES:LazyLock<Mutex<HashMap<EntityKey,Runtime>>>=LazyLock::new(||Mutex::new(HashMap::new()));
fn take(s:&mut StableSim<'_>,c:usize)->(EntityKey,Runtime){let k=crate::entity_key(s,c);let mut m=STATES.lock().unwrap_or_else(|e|e.into_inner());if m.len()>4096{m.retain(|key,_|key.scope==k.scope);}let mut r=m.remove(&k).unwrap_or_default();if r.updated.is_some_and(|t|t>s.tick()){r=Runtime::default();}r.reset_expired(s.tick());(k,r)}
fn put(k:EntityKey,r:Runtime){STATES.lock().unwrap_or_else(|e|e.into_inner()).insert(k,r);}
fn cooldown(s:&StableSim<'_>,c:usize)->usize{let Some(e)=s.get_entity(c)else{return 540};let base=540-e.level().saturating_sub(1).min(14)*180/14;base}
fn hit(s:&mut StableSim<'_>,c:usize,t:usize,n:usize,r:&mut Runtime,awarded:&mut bool){if !enemy(s,c,t){return}let champion=s.get_entity(t).is_some_and(|e|e.is_champion());s.deal_damage_typed(c,t,n,DamageTypeV1::Ap,AttackTypeV1::Skill);if champion&&!*awarded{*awarded=true;r.stacks=(if s.tick()>=r.sustain_until{0}else{r.stacks}+1).min(3);r.sustain_until=s.tick()+300;s.entity_remove_buff(c,SUSTAIN);s.add_buff(c,&BuffV1{vamp:(r.stacks*10) as i32,..BuffV1::timed(SUSTAIN,300)});}}
fn endpoint(from:Pos,to:Pos)->Pos{let Some((_,g))=crate::choose_current_grid(&[(from.0 as f64,from.1 as f64),(to.0 as f64,to.1 as f64)])else{return from};for step in (0..=20).rev(){let q=step as f64/20.;let p=((from.0 as f64+(to.0 as f64-from.0 as f64)*q) as u64,(from.1 as f64+(to.1 as f64-from.1 as f64)*q) as u64);if !g.solid(p.0 as f64,p.1 as f64){return p}}from}
fn cast(s:&mut StableSim<'_>,c:usize,i:usize,input:InputTargetV1){
 if !s.get_entity(c).is_some_and(|e|e.is_alive()&&e.is_targetable()){return}let Some((from,to,dir))=aim(s,c,input)else{return};if i==2&&input.kind==InputTargetKindV1::Pos.code()&&!within(from,(input.x,input.y),RANGE){return}
 let(k,mut r)=take(s,c);let now=s.tick();if !r.can_cast(i,now){put(k,r);return}let ap=s.get_entity(c).unwrap().stat().magic_power;let cd=cooldown(s,c);let enhanced=r.enhanced(i);let landing=endpoint(from,point(from,dir,d2(from,to).sqrt().min(DASH)));
 if i==1&&(landing==from||!s.entity_set_pos(c,landing.0,landing.1)){put(k,r);return}if r.mask==0{r.goal=choose_goal(s,c);}
 r.accept(i,now,cd);
 match i{
 0=>r.bolts.push(Bolt{start:now,from,dir,last:from,ap,enhanced,hit:HashSet::new(),awarded:false}),
 1=>{fx(s,&format!("julian_sword{}_{}",if enhanced{"_enhanced"}else{""},bucket(dir)),c,from,if enhanced{36}else{18});if enhanced{r.paths.push(BladePath{next:now,paid:0,from,to:landing,ap,awarded:false});s.entity_banish(c,c,36,"","");}else{let mut awarded=false;for t in foes(s,c){if pos(s,t).is_some_and(|p|segment(from,landing,p,WIDTH).is_some()){hit(s,c,t,spell(SWORD,ap),&mut r,&mut awarded);}}}},
 2=>{fx(s,"julian_chain_warning",c,to,18);r.zones.push(Zone{start:now+18,next:now+18,paid:0,center:to,dir:(0.,0.),ap,kind:if enhanced{2}else{0},awarded:false});},_=>{}
 }put(k,r)
}
fn choose_goal(s:&StableSim<'_>,c:usize)->usize{let Some(e)=s.get_entity(c)else{return 0};let(h,m)=e.hp();if h*100<m.max(1)*40{return 1}if foes(s,c).into_iter().filter(|t|s.get_entity(*t).is_some_and(|e|e.is_champion())&&pos(s,*t).is_some_and(|p|within(e.pos(),p,RANGE))).count()>=2{2}else{0}}
fn sequence(g:usize)->[usize;3]{match g{1=>[0,2,1],2=>[0,1,2],_=>[2,1,0]}}
fn next_slot(r:&Runtime)->Option<usize>{sequence(r.goal).into_iter().find(|i|r.mask&(1<<i)==0)}
fn tick_state(s:&mut StableSim<'_>,k:EntityKey,mut r:Runtime){
 let now=s.tick();if r.updated==Some(now){put(k,r);return}r.updated=Some(now);r.reset_expired(now);let c=k.entity_id;
 if !s.get_entity(c).is_some_and(|e|e.is_alive()){s.entity_remove_buff(c,SUSTAIN);put(k,Runtime{updated:Some(now),..Default::default()});return}
 if r.mask==0&&now>=r.ready.iter().copied().max().unwrap_or(0){r.goal=choose_goal(s,c);}
 let mut bolts=std::mem::take(&mut r.bolts);bolts.retain_mut(|b|{
  let dist=((now.saturating_sub(b.start)+1)*4000).min(RANGE as usize) as f64;let end=point(b.from,b.dir,dist);
  let mut hits:Vec<_>=foes(s,c).into_iter().filter_map(|t|pos(s,t).and_then(|p|segment(b.last,end,p,WIDTH)).map(|q|(q,t))).collect();hits.sort_by(|a,b|a.0.total_cmp(&b.0).then(a.1.cmp(&b.1)));
  let mut stop=None;for(_,t)in hits{let target=crate::entity_key(s,t);if !b.hit.insert(target){continue}hit(s,c,t,spell(if b.enhanced{ENH_SCYTHE}else{SCYTHE},b.ap),&mut r,&mut b.awarded);slow(s,c,t,if b.enhanced{50}else{30},60);if !s.get_entity(t).is_some_and(|e|e.is_minion()){stop=pos(s,t);break}}
  b.last=stop.unwrap_or(end);fx(s,&format!("julian_scythe{}_{}_{}",if b.enhanced{"_enhanced"}else{""},bucket(b.dir),(now.saturating_sub(b.start)/2)%9),c,b.last,2);
  if stop.is_some()||dist>=RANGE{if b.enhanced{r.zones.push(Zone{start:now,next:now,paid:0,center:b.last,dir:b.dir,ap:b.ap,kind:1,awarded:b.awarded});}false}else{true}
 });r.bolts=bolts;
 let mut zones=std::mem::take(&mut r.zones);zones.retain_mut(|z|{
  let center=if z.kind==1{point(z.center,z.dir,now.saturating_sub(z.start).min(96) as f64*250.)}else{z.center};
  if z.kind==1{fx(s,&format!("julian_scythe_spin_{}",(now.saturating_sub(z.start)/4)%9),c,center,2);}
  let(limit,period)=match z.kind{0=>(1,1),1=>(CONTINUOUS_HITS,CONTINUOUS_PERIOD),_=>(4,12)};
  while z.paid<limit&&now>=z.next{
   for t in foes(s,c){if pos(s,t).is_some_and(|p|within(center,p,RADIUS)){hit(s,c,t,spell(match z.kind{0=>CHAIN,1=>SPIN,_=>CHAIN_PULSE},z.ap),&mut r,&mut z.awarded);if z.kind==0{s.apply_cc(t,&CcV1::of_kind(CcKindV1::Bind,60));}else{slow(s,c,t,if z.kind==1{50}else{30},18);}}}
   if z.paid==0&&z.kind!=1{fx(s,match z.kind{0=>"julian_chain_bind",1=>"julian_scythe_spin",_=>"julian_chain_enhanced"},c,center,match z.kind{0=>60,1=>96,_=>48});}z.paid+=1;z.next=z.start+z.paid*period;
  }
  if z.kind==2&&z.paid==limit&&now>=z.start+48{for t in foes(s,c){if pos(s,t).is_some_and(|p|within(center,p,RADIUS)){hit(s,c,t,spell(LAUNCH,z.ap),&mut r,&mut z.awarded);s.apply_cc(t,&CcV1::of_kind(CcKindV1::Airborne,48));}}fx(s,"julian_chain_launch",c,z.center,24);false}else if z.kind==2{true}else if z.kind==1{now<z.start+96}else{z.paid<limit}
 });r.zones=zones;
 let mut paths=std::mem::take(&mut r.paths);paths.retain_mut(|p|{while p.paid<6&&now>=p.next{for t in foes(s,c){if pos(s,t).is_some_and(|q|segment(p.from,p.to,q,WIDTH*1.5).is_some()){hit(s,c,t,spell(BLADE,p.ap),&mut r,&mut p.awarded);}}p.paid+=1;p.next+=6;}p.paid<6});r.paths=paths;
 if now>=r.sustain_until{r.stacks=0;}
 let early=EARLY_CHAIN_ASSIST&&s.get_entity(c).is_some_and(|e|e.is_targetable()&&e.cooldown(SkillSlotV1::Ult).is_some_and(|x|!x.unlocked))&&next_slot(&r)==Some(2)&&r.can_cast(2,now);put(k,r);
 if early{if let Some(t)=foes(s,c).into_iter().filter(|t|pos(s,*t).is_some_and(|p|pos(s,c).is_some_and(|q|within(p,q,RANGE)))).min_by_key(|t|(!s.get_entity(*t).unwrap().is_champion(),*t)){cast(s,c,2,InputTargetV1::target(t));}}
}
pub(crate) fn tick_all(s:&mut StableSim<'_>){let scope=crate::SimScope::of(s);let mut keys:Vec<_>=STATES.lock().unwrap_or_else(|e|e.into_inner()).keys().copied().filter(|k|k.scope==scope&&crate::sim_copy_of(s,k.entity_id)==Some(k.copy)).collect();keys.sort_by_key(|k|k.entity_id);for k in keys{let r=STATES.lock().unwrap_or_else(|e|e.into_inner()).remove(&k);if let Some(r)=r{tick_state(s,k,r)}}}
#[derive(Clone,Copy)]enum Op{Basic,Scythe,Sword,Chain}
impl StableEffectType for Op{
 fn apply(&self,s:&mut StableSim<'_>,_:u64,c:usize,i:InputTargetV1){if let Self::Basic=self{
  if i.kind!=InputTargetKindV1::Target.code(){return}let Some(a)=s.get_entity(c)else{return};let Some(t)=s.get_entity(i.target_id)else{return};if !a.is_alive()||!a.is_targetable()||!t.is_alive()||!t.is_targetable()||a.team()==t.team()||!within(a.pos(),t.pos(),28_000.){return}
  let(ad,ap)=(a.stat().attack,a.stat().magic_power);let(k,r)=take(s,c);let enhanced=s.tick()<r.basic_until&&enemy(s,c,i.target_id);put(k,r);
  if enhanced{s.deal_damage_typed(c,i.target_id,30+ad+ap*55/100,DamageTypeV1::Ap,AttackTypeV1::BaseAttack);s.entity_pull(c,i.target_id,700,8);}else{s.deal_damage_typed(c,i.target_id,ad,DamageTypeV1::Ad,AttackTypeV1::BaseAttack);}return
 }cast(s,c,match self{Self::Scythe=>0,Self::Sword=>1,_=>2},i)}
 fn expected_damage(&self,s:&StatV1)->(usize,usize){match self{Self::Basic=>(s.attack,0),Self::Scythe=>(0,spell(SCYTHE,s.magic_power)),Self::Sword=>(0,spell(SWORD,s.magic_power)),Self::Chain=>(0,spell(CHAIN,s.magic_power))}}
}
#[derive(Clone,Default)]struct Passive{owner:Option<EntityKey>,voice:crate::audio::VoiceLifecycle}
impl StablePassive for Passive{
 fn clone_box(&self)->Box<dyn StablePassive>{Box::new(self.clone())}
 fn on_spawn(&mut self,s:&mut StableSim<'_>,_:usize,c:usize){self.voice.on_spawn(s,c,Some("mlbb_julian_voice_spawn"));if let Some(old)=self.owner.take(){STATES.lock().unwrap_or_else(|e|e.into_inner()).remove(&old);}let k=crate::entity_key(s,c);self.owner=Some(k);s.entity_remove_buff(c,SUSTAIN);STATES.lock().unwrap_or_else(|e|e.into_inner()).insert(k,Runtime::default());}
 fn on_update(&mut self,s:&mut StableSim<'_>,_:u64,_:usize,c:usize){self.voice.on_update(s,c,&[],&["mlbb_julian_voice_move01","mlbb_julian_voice_move03","mlbb_julian_voice_move04","mlbb_julian_voice_move05","mlbb_julian_voice_move07","mlbb_julian_voice_move08","mlbb_julian_voice_move09","mlbb_julian_voice_move10","mlbb_julian_voice_move11"]);let(k,r)=take(s,c);tick_state(s,k,r);}
 fn on_dead(&mut self,s:&mut StableSim<'_>,p:usize){self.voice.on_dead(s,p,&["mlbb_julian_voice_death"]);if let Some(k)=self.owner.take(){STATES.lock().unwrap_or_else(|e|e.into_inner()).remove(&k);s.entity_remove_buff(k.entity_id,SUSTAIN);}}
}
struct JulianAi;
impl StablePlayerAi for JulianAi{
 fn clone_box(&self)->Box<dyn StablePlayerAi>{Box::new(Self)}fn id(&self)->String{"mlbb_julian_combo".into()}fn priority(&self)->i32{160}fn matches(&self,i:&StableAiInit)->bool{["mlbb_julian","julian"].iter().any(|n|i.champion_name.eq_ignore_ascii_case(n))}
 fn think(&mut self,ctx:&mut StableAiContext<'_>,base:Option<InputV1>)->Option<InputV1>{
  let player=ctx.player_id();
  let proposal=(||->Option<InputV1>{let s=ctx.sim()?;let e=s.get_player(player)?.champion()?;if !e.is_alive()||!e.is_targetable(){return None}let c=e.id();let k=crate::entity_key_ro(&s,c);let mut r=STATES.lock().unwrap_or_else(|e|e.into_inner()).get(&k).cloned().unwrap_or_default();r.reset_expired(s.tick());if r.mask==0{r.goal=choose_goal(&s,c);}let i=next_slot(&r)?;
   if !r.can_cast(i,s.tick())||!e.cooldown([SkillSlotV1::Skill,SkillSlotV1::Skill2,SkillSlotV1::Ult][i]).is_some_and(|x|x.unlocked&&x.charges>0&&x.remaining==0){return None}
   let t=foes(&s,c).into_iter().filter(|t|pos(&s,*t).is_some_and(|p|within(e.pos(),p,RANGE))).min_by_key(|t|{let e=s.get_entity(*t).unwrap();let(h,m)=e.hp();(!e.is_champion(),h*1000/m.max(1),e.id())})?;let mut p=pos(&s,t)?;
   if i==1&&r.enhanced(1)&&r.goal==1{let a=e.pos();let dx=a.0 as f64-p.0 as f64;let dy=a.1 as f64-p.1 as f64;let n=dx.hypot(dy).max(1.);p=point(a,(dx/n,dy/n),DASH);}
   Some(InputV1::action([InputKindV1::Skill,InputKindV1::Skill2,InputKindV1::Ult][i],InputTargetV1::pos(p.0,p.1)))})();
  if let Some(input)=proposal{if ctx.is_valid_input(&input){return Some(input)}}
  // A baseline spell proposal must not repeatedly consume animations while our
  // shared ledger rejects it. Preserve ordinary attacks and movement.
  if let Some(input)=base{let slot=if input.kind==InputKindV1::Skill.code(){Some(0)}else if input.kind==InputKindV1::Skill2.code(){Some(1)}else if input.kind==InputKindV1::Ult.code(){Some(2)}else{None};if let Some(i)=slot{if let Some(s)=ctx.sim(){if let Some(e)=s.get_player(player).and_then(|p|p.champion()){let k=crate::entity_key_ro(&s,e.id());if STATES.lock().unwrap_or_else(|e|e.into_inner()).get(&k).is_some_and(|r|!r.can_cast(i,s.tick())){return None}}}}}
  base
 }
}
pub fn register(m:&mut StableMod){for(n,op)in[("basic",Op::Basic),("scythe",Op::Scythe),("sword",Op::Sword),("chain",Op::Chain)]{m.add_native_effect(&format!("mlbb_heroes:julian_{n}"),op);}m.add_native_passive("mlbb_heroes:julian_legacy",Passive::default());m.add_player_input_ai(JulianAi);}
#[cfg(test)]#[path="julian_tests.rs"]mod tests;
